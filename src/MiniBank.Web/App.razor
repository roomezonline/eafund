@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <ErrorBoundary>
                <ChildContent>
                    <MiniBank.Web.Shared.AuthGuardRouteView RouteData="@routeData" DefaultLayout="typeof(Shared.MainLayout)" />
                </ChildContent>
                <ErrorContent>
                    <LayoutView Layout="typeof(Shared.MainLayout)">
                        <MiniBank.Web.Pages.Errors.Error />
                    </LayoutView>
                </ErrorContent>
            </ErrorBoundary>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Shared.MainLayout)">
                <MiniBank.Web.Pages.Errors.NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
