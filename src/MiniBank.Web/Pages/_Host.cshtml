    <script>
      (function(){
        try{
          var k='mb.theme';
          var saved=localStorage.getItem(k);
          var theme=(saved==='light'||saved==='dark')?saved:(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
          document.documentElement.setAttribute('data-theme', theme);
        }catch(e){document.documentElement.setAttribute('data-theme','dark');}
      })();
    </script>
    <script>
      (function(){
        try{
          var k='mb.adminCardTheme';
          var raw=localStorage.getItem(k);
          var t=raw?JSON.parse(raw):null;
          t=t&&typeof t==='object'?t:{};
          var g1=(typeof t.grad1==='string'&&t.grad1.trim())?t.grad1.trim():'#667eea';
          var g2=(typeof t.grad2==='string'&&t.grad2.trim())?t.grad2.trim():'#6f5bd3';
          var g3=(typeof t.grad3==='string'&&t.grad3.trim())?t.grad3.trim():'#764ba2';
          var txt=(typeof t.text==='string'&&t.text.trim())?t.text.trim():'#ffffff';
          var r=document.documentElement;
          r.style.setProperty('--admin-card-grad-1', g1);
          r.style.setProperty('--admin-card-grad-2', g2);
          r.style.setProperty('--admin-card-grad-3', g3);
          r.style.setProperty('--admin-card-text', txt);
        }catch(e){}
      })();
    </script>
