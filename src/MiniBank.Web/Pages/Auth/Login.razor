@page "/login"
@layout MiniBank.Web.Shared.LoginLayout
@using MiniBank.Web.Components.DesignSystem
@using System.ComponentModel.DataAnnotations
@inject MiniBank.Web.Components.DesignSystem.DsToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JS

<style>
  .login-card {
    width: 100%;
    border-radius: 18px;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.16);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 30px 70px rgba(0,0,0,.35);
    padding: 18px;
    color: #e5e7eb;
  }

  .brand { display: grid; justify-items: center; gap: 8px; padding: 10px 4px 14px; }

  .logo {
    width: 68px;
    height: 68px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    background: rgba(255,255,255,.10);
    border: 1px solid rgba(255,255,255,.16);
    position: relative;
    overflow: hidden;
  }

  .logo::after {
    content: '';
    position: absolute;
    inset: -80px;
    background: linear-gradient(120deg, transparent 40%, rgba(255,255,255,.65) 50%, transparent 60%);
    transform: rotate(20deg) translateX(-40%);
    animation: shine 2.2s ease-in-out infinite;
    opacity: .85;
  }

  .logo i { font-size: 22px; color: #ffffff; position: relative; z-index: 1; }

  .title { font-weight: 900; font-size: 18px; }
  .subtitle { font-size: 13px; opacity: .85; }

  .form { display: grid; gap: 12px; }
  .field { display: grid; gap: 6px; }
  .field label { font-size: 12px; font-weight: 800; color: rgba(255,255,255,.9); }

  .login-input {
    width: 100%;
    height: 48px;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,.18);
    background: rgba(255,255,255,.10);
    color: #fff;
    padding: 0 14px;
    outline: none;
    transition: border-color .15s ease, box-shadow .15s ease;
  }

  .login-input:focus {
    border-color: rgba(167, 139, 250, .65);
    box-shadow: 0 0 0 4px rgba(124, 58, 237, .20);
  }

  .login-input.invalid {
    border-color: rgba(248, 113, 113, .65);
    box-shadow: 0 0 0 4px rgba(239, 68, 68, .16);
  }

  .pw-wrap{position:relative}
  .pw-input{padding-left:46px}
  .pw-eye{position:absolute;left:10px;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:12px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.12);color:#fff;display:grid;place-items:center;cursor:pointer}
  .pw-eye:active{transform:translateY(-50%) scale(.98)}

  .login-btn {
    height: 50px;
    border-radius: 14px;
    border: 0;
    cursor: pointer;
    font-weight: 900;
    color: #fff;
    background: linear-gradient(135deg, rgba(124,58,237,1), rgba(59,130,246,1));
    box-shadow: 0 18px 40px rgba(59,130,246,.22);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform .12s ease, filter .12s ease;
  }

  .login-btn:active { transform: translateY(1px); }
  .login-btn:disabled { cursor: not-allowed; filter: grayscale(.2) brightness(.85); opacity: .9; }

  .hint {
    font-size: 12px;
    line-height: 1.6;
    color: rgba(229,231,235,.85);
    text-align: center;
    margin-top: 4px;
  }

  @@keyframes shine {
    0% { transform: rotate(20deg) translateX(-60%); }
    60% { transform: rotate(20deg) translateX(60%); }
    100% { transform: rotate(20deg) translateX(60%); }
  }
</style>

<div class="login-card">
  <div class="brand">
    <div class="logo" aria-hidden="true">
      <img src="/icons/logo_emam_ali.png" alt="لوگو" style="width:100%;height:100%;object-fit:contain;padding:8px" />
    </div>
    <div class="title">صندوق امام علی (ع)</div>
    <div class="subtitle">ورود به سامانه</div>
  </div>

  <EditForm class="form" Model="_model" OnValidSubmit="HandleLoginAsync">
    <DataAnnotationsValidator />

    <div class="field">
      <label>نام کاربری</label>
      <InputText class="@($"login-input {InputCss(nameof(LoginModel.Username))}")"
                 @bind-Value="_model.Username"
                 placeholder="کد ملی"
                 inputmode="numeric" />
    </div>

    <div class="field">
      <label>رمز عبور</label>
      <div class="pw-wrap">
        <InputText class="@($"login-input pw-input {InputCss(nameof(LoginModel.Password))}")"
                   @bind-Value="_model.Password"
                   type="@(_showPassword ? "text" : "password")"
                   placeholder="۴ رقم آخر کد ملی"
                   inputmode="numeric" />
        <button type="button" class="pw-eye" @onclick="ToggleShowPassword" aria-label="نمایش/مخفی کردن رمز">
          <i class="fa-solid @(_showPassword ? "fa-eye-slash" : "fa-eye")"></i>
        </button>
      </div>
    </div>

    <button class="login-btn" type="submit" disabled="@_busy">
      @if (_busy)
      {
        <i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i>
        <span>در حال ورود…</span>
      }
      else
      {
        <span>ورود</span>
      }
    </button>

    <div class="hint">برای اعضا: نام کاربری کد ملی و رمز ۴ رقم آخر کد ملی است.</div>
  </EditForm>
</div>

@code {
  private sealed class LoginModel
  {
    [Required(ErrorMessage = "نام کاربری را وارد کنید")]
    [MinLength(3, ErrorMessage = "نام کاربری نامعتبر است")]
    public string Username { get; set; } = string.Empty;

    [Required(ErrorMessage = "رمز عبور را وارد کنید")]
    [MinLength(4, ErrorMessage = "رمز عبور باید حداقل ۴ کاراکتر باشد")]
    public string Password { get; set; } = string.Empty;
  }

  private sealed class LoginApiResponse
  {
    public bool ok { get; set; }
    public int status { get; set; }
    public string? error { get; set; }
    public object? debug { get; set; }
  }

  private LoginModel _model = new();
  private string _returnUrl = "/";
  private bool _busy;
  private bool _showPassword;
  private HashSet<string> _invalid = new();

  protected override void OnInitialized()
  {
    try
    {
      var uri = new Uri(Nav.Uri);
      var qs = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
      if (qs.TryGetValue("ReturnUrl", out var ru) && !string.IsNullOrWhiteSpace(ru))
        _returnUrl = ru.ToString();

      if (qs.TryGetValue("error", out var err) && !string.IsNullOrWhiteSpace(err))
      {
        Toasts.Error("ورود ناموفق بود");
      }
    }
    catch { }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
      return;

    try
    {
      await JS.InvokeVoidAsync("eval", @"
        (async function(){
          try {
            if (navigator && navigator.serviceWorker) {
              const regs = await navigator.serviceWorker.getRegistrations();
              for (const r of regs) { try { await r.unregister(); } catch {} }
            }
          } catch {}
        })();
      ");
    }
    catch { }
  }

  private string InputCss(string field)
    => _invalid.Contains(field) ? "invalid" : string.Empty;

  private void SetValidationErrors(params string[] fields)
  {
    _invalid = fields.Where(f => !string.IsNullOrWhiteSpace(f)).ToHashSet(StringComparer.Ordinal);
    StateHasChanged();
  }

  private void ToggleShowPassword() => _showPassword = !_showPassword;

  private async Task HandleLoginAsync()
  {
    if (_busy)
      return;

    _invalid.Clear();
    var username = (_model.Username ?? string.Empty).Trim();
    var password = _model.Password ?? string.Empty;

    if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
    {
      Toasts.Error("نام کاربری و رمز عبور الزامی است");
      SetValidationErrors(nameof(LoginModel.Username), nameof(LoginModel.Password));
      return;
    }

    try
    {
      _busy = true;
      StateHasChanged();

      LoginApiResponse? result = null;
      try { result = await JS.InvokeAsync<LoginApiResponse>("authApi.login", username, password); } catch { }

      try
      {
        if (result?.debug != null)
          await JS.InvokeVoidAsync("console.log", "authApi.login debug:", result.debug);
      }
      catch { }

      if (result?.ok == true)
      {
        Toasts.Success("ورود با موفقیت انجام شد");
        await Task.Delay(250);
        try { await JS.InvokeVoidAsync("authApi.goto", _returnUrl); } catch { }
        return;
      }

      if (result?.status == 401)
      {
        Toasts.Error("نام کاربری یا رمز عبور اشتباه است");
        SetValidationErrors(nameof(LoginModel.Username), nameof(LoginModel.Password));
        return;
      }

      if (!string.IsNullOrWhiteSpace(result?.error) && result.error != "NETWORK")
      {
        Toasts.Error(result.error);
        SetValidationErrors(nameof(LoginModel.Username));
        return;
      }

      Toasts.Error("خطای شبکه/سرور");
    }
    catch
    {
      Toasts.Error("خطای شبکه/سرور");
    }
    finally
    {
      _busy = false;
      StateHasChanged();
    }
  }
}
