@page "/me/messages"

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Globalization
@using MiniBank.Web.Models.Notifications
@using MiniBank.Web.Components.Member

@inject AuthenticationStateProvider AuthStateProvider
@inject MiniBank.Web.Infrastructure.Repositories.AuthRepository AuthRepo
@inject MiniBank.Web.Infrastructure.Repositories.BaleBotRepository BaleRepo
@inject MiniBank.Web.Components.DesignSystem.DsToastService Toasts

<MemberSelector OnMemberChanged="OnMemberSelectorChanged" />

<style>
  .msg-shell{max-width:900px;margin:0 auto;padding:16px 14px 90px;direction:rtl;display:grid;gap:12px}
  .msg-hero{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
    padding:14px;border-radius:18px;border:1px solid #bbf7d0;
    background:linear-gradient(135deg,#ecfdf5,#f0fdf4 60%,#ffffff);
    box-shadow:0 12px 30px rgba(22,163,74,.10)}
  .msg-hero-left{display:flex;align-items:center;gap:12px;min-width:0}
  .msg-hero-icon{position:relative;width:48px;height:48px;border-radius:15px;display:grid;place-items:center;flex:none;
    background:linear-gradient(135deg,#16a34a,#22c55e);color:#fff;font-size:19px;
    box-shadow:0 10px 22px rgba(22,163,74,.30)}
  .msg-hero-badge{position:absolute;top:-6px;left:-6px;min-width:20px;height:20px;padding:0 5px;border-radius:999px;
    background:#f59e0b;color:#fff;font-size:10px;font-weight:950;display:grid;place-items:center;
    border:2px solid #fff;font-variant-numeric:tabular-nums;line-height:1}
  .msg-hero-title{font-weight:950;font-size:16px;color:#065f46}
  .msg-hero-sub{font-weight:800;font-size:11.5px;color:#166534;line-height:1.8;margin-top:2px}
  .msg-hero-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .msg-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:38px;padding:0 14px;
    border-radius:12px;border:1px solid #d1fae5;background:#fff;color:#166534;font-family:inherit;
    font-weight:950;font-size:12px;text-decoration:none;cursor:pointer}
  .msg-btn.primary{background:#16a34a;border-color:#16a34a;color:#fff;box-shadow:0 8px 18px rgba(22,163,74,.24)}
  .msg-btn.primary:hover{background:#15803d}
  .msg-btn:disabled{opacity:.6;cursor:not-allowed}

  .msg-tabs{display:flex;gap:6px;padding:5px;background:#fff;border:1px solid #e5e7eb;border-radius:14px;
    box-shadow:0 6px 18px rgba(15,23,42,.04)}
  .msg-tab{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:38px;
    border:0;border-radius:10px;background:transparent;color:#475569;font-family:inherit;
    font-weight:950;font-size:12px;cursor:pointer;transition:background .15s ease,color .15s ease}
  .msg-tab.active{background:#dcfce7;color:#166534}
  .msg-tab-count{display:inline-grid;place-items:center;min-width:18px;height:18px;padding:0 5px;border-radius:999px;
    background:#16a34a;color:#fff;font-size:10px;font-weight:950}

  .msg-list{display:grid;gap:10px}
  .msg-item{background:#fff;border:1px solid #e5e7eb;border-radius:16px;overflow:hidden;
    box-shadow:0 8px 22px rgba(15,23,42,.05);border-inline-start:4px solid #e5e7eb;
    transition:border-color .15s ease, box-shadow .15s ease}
  .msg-item.unread{border-inline-start-color:#16a34a;background:linear-gradient(180deg,#fff,#f7fef9)}
  .msg-item.open{box-shadow:0 12px 30px rgba(15,23,42,.09)}
  .msg-item-head{display:flex;align-items:flex-start;gap:10px;width:100%;padding:12px;border:0;background:transparent;
    font-family:inherit;text-align:right;cursor:pointer;-webkit-tap-highlight-color:transparent}
  .msg-state-dot{width:9px;height:9px;border-radius:50%;background:#cbd5e1;margin-top:5px;flex:none}
  .msg-item.unread .msg-state-dot{background:#16a34a;box-shadow:0 0 0 4px rgba(22,163,74,.14)}
  .msg-item-main{flex:1;min-width:0;display:grid;gap:4px}
  .msg-item-top{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  .msg-item-title{font-weight:950;font-size:13px;color:#0f172a}
  .msg-new{font-size:9.5px;font-weight:950;color:#166534;background:#dcfce7;border:1px solid #86efac;
    border-radius:999px;padding:1px 8px}
  .msg-item-preview{font-size:11.5px;font-weight:750;color:#64748b;line-height:1.8;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word}
  .msg-item-side{display:grid;justify-items:end;gap:6px;flex:none}
  .msg-date{font-size:10.5px;font-weight:900;color:#475569;white-space:nowrap;font-variant-numeric:tabular-nums}
  .msg-item-side i{font-size:10px;color:#94a3b8}
  .msg-body{padding:12px;border-top:1px dashed #d1fae5;background:#fbfefc;
    font-size:12.5px;font-weight:800;line-height:2;color:#0f172a;white-space:pre-wrap;word-break:break-word}
  .msg-more{display:flex;justify-content:center;margin-top:2px}
  .msg-empty{display:grid;place-items:center;gap:8px;padding:38px 12px;border-radius:16px;
    background:#fff;border:1px dashed #cbd5e1;color:#64748b;font-weight:850;font-size:13px;text-align:center}
  .msg-empty i{font-size:28px;color:#86efac}
  .msg-error{border-radius:14px;border:1px solid #fecaca;background:#fef2f2;color:#b91c1c;
    padding:12px;font-weight:850;font-size:12px;line-height:1.8}
  @@media (max-width: 560px){
    .msg-shell{padding:12px 10px 86px}
    .msg-hero{padding:12px;border-radius:16px}
    .msg-hero-icon{width:42px;height:42px;border-radius:13px;font-size:17px}
    .msg-hero-title{font-size:14.5px}
    .msg-hero-actions{width:100%}
    .msg-btn{flex:1}
    .msg-item-head{padding:10px;gap:8px}
  }
</style>

<div class="msg-shell">
  @if (_loading)
  {
    <div class="msg-empty">در حال بارگذاری پیام‌ها...</div>
  }
  else if (!string.IsNullOrWhiteSpace(_error))
  {
    <div class="msg-error">@_error</div>
  }
  else
  {
    <div class="msg-hero">
      <div class="msg-hero-left">
        <div class="msg-hero-icon">
          <i class="fa-regular fa-bell"></i>
          @if (_unreadCount > 0)
          {
            <span class="msg-hero-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
          }
        </div>
        <div>
          <div class="msg-hero-title">پیام‌های من</div>
          <div class="msg-hero-sub">اطلاع‌رسانی‌های صندوق که از طریق پیام‌رسان بله ارسال شده‌اند</div>
        </div>
      </div>
      <div class="msg-hero-actions">
        <a class="msg-btn" href="/dashboard">
          <i class="fa-solid fa-arrow-right"></i>
          داشبورد
        </a>
        @if (_unreadCount > 0)
        {
          <button type="button" class="msg-btn primary" @onclick="MarkAllReadAsync" disabled="@_busy">
            <i class="fa-solid fa-check-double"></i>
            خواندن همه
          </button>
        }
      </div>
    </div>

    <div class="msg-tabs" role="tablist">
      <button type="button" class="msg-tab @(_onlyUnread ? null : "active")" role="tab" @onclick="(() => SetTabAsync(false))">
        همه پیام‌ها
      </button>
      <button type="button" class="msg-tab @(_onlyUnread ? "active" : null)" role="tab" @onclick="(() => SetTabAsync(true))">
        خوانده‌نشده
        @if (_unreadCount > 0)
        {
          <span class="msg-tab-count">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
        }
      </button>
    </div>

    @if (_items.Count == 0)
    {
      <div class="msg-empty">
        <i class="fa-regular fa-envelope-open"></i>
        <div>@(_onlyUnread ? "پیام خوانده‌نشده‌ای ندارید." : "هنوز پیامی برای شما ارسال نشده است.")</div>
      </div>
    }
    else
    {
      <div class="msg-list">
        @foreach (var m in _items)
        {
          <div class="msg-item @(m.ReadAt == null ? "unread" : null) @(_openId == m.LogId ? "open" : null)">
            <button type="button" class="msg-item-head" @onclick="(() => ToggleAsync(m))">
              <span class="msg-state-dot"></span>
              <span class="msg-item-main">
                <span class="msg-item-top">
                  <span class="msg-item-title">@FeatureLabel(m.FeatureKey)</span>
                  @if (m.ReadAt == null)
                  {
                    <span class="msg-new">جدید</span>
                  }
                </span>
                <span class="msg-item-preview">@Preview(m.MessageText)</span>
              </span>
              <span class="msg-item-side">
                <span class="msg-date">@FormatJalali(m.CreatedAt)</span>
                <i class="fa-solid @(_openId == m.LogId ? "fa-chevron-up" : "fa-chevron-down")"></i>
              </span>
            </button>

            @if (_openId == m.LogId)
            {
              <div class="msg-body">@m.MessageText</div>
            }
          </div>
        }
      </div>

      @if (_hasMore)
      {
        <div class="msg-more">
          <button type="button" class="msg-btn" @onclick="LoadMoreAsync" disabled="@_busy">
            <i class="fa-solid fa-angles-down"></i>
            نمایش پیام‌های قدیمی‌تر
          </button>
        </div>
      }
    }
  }
</div>

@code {
  private const int PageSize = 100;

  private long _memberId;
  private long? _adminSelectedMemberId;

  [SupplyParameterFromQuery(Name = "memberId")]
  public long? QueryMemberId { get; set; }

  private List<BaleMessageLog> _items = new();
  private int _unreadCount;
  private bool _onlyUnread;
  private bool _loading = true;
  private bool _busy;
  private bool _hasMore;
  private int _take = PageSize;
  private long? _openId;
  private string? _error;

  protected override async Task OnInitializedAsync()
  {
    await LoadAsync();
  }

  private async Task OnMemberSelectorChanged(long? memberId)
  {
    _adminSelectedMemberId = memberId;
    _take = PageSize;
    _openId = null;
    await LoadAsync();
  }

  private async Task ResolveMemberAsync()
  {
    _memberId = 0;

    var state = await AuthStateProvider.GetAuthenticationStateAsync();
    var user = state.User;
    var role = user?.FindFirst("role")?.Value ?? user?.FindFirst(ClaimTypes.Role)?.Value;
    var isMemberRole = string.Equals(role, "Member", StringComparison.OrdinalIgnoreCase);

    if (!isMemberRole)
    {
      if (_adminSelectedMemberId is > 0)
        _memberId = _adminSelectedMemberId.Value;
      else if (QueryMemberId is > 0)
        _memberId = QueryMemberId.Value;
    }

    if (_memberId <= 0)
    {
      var memberIdClaim = user?.FindFirst("MemberId")?.Value;
      if (!long.TryParse(memberIdClaim, out _memberId) || _memberId <= 0)
      {
        var userIdClaim = user?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (long.TryParse(userIdClaim, out var userId) && userId > 0)
        {
          var dbUser = await AuthRepo.GetUserByIdAsync(userId);
          if (dbUser?.MemberId.HasValue == true)
            _memberId = dbUser.MemberId.Value;
        }
      }
    }
  }

  private async Task LoadAsync()
  {
    try
    {
      _loading = true;
      _error = null;
      StateHasChanged();

      await ResolveMemberAsync();
      if (_memberId <= 0)
      {
        _error = "برای مشاهده پیام‌ها، ابتدا یک عضو را از لیست بالا انتخاب کنید.";
        return;
      }

      _unreadCount = await BaleRepo.GetUnreadMessageCountAsync(_memberId);
      _items = (await BaleRepo.GetMemberInboxAsync(_memberId, _onlyUnread, _take)).ToList();
      _hasMore = _items.Count >= _take;

      if (_openId.HasValue && _items.All(x => x.LogId != _openId.Value))
        _openId = null;
    }
    catch (Exception ex)
    {
      _error = $"خطا در بارگذاری پیام‌ها: {ex.Message}";
    }
    finally
    {
      _loading = false;
      StateHasChanged();
    }
  }

  private async Task SetTabAsync(bool onlyUnread)
  {
    if (_onlyUnread == onlyUnread)
      return;

    _onlyUnread = onlyUnread;
    _take = PageSize;
    _openId = null;
    await LoadAsync();
  }

  private async Task LoadMoreAsync()
  {
    if (_busy || _memberId <= 0)
      return;

    _busy = true;
    try
    {
      _take += PageSize;
      _items = (await BaleRepo.GetMemberInboxAsync(_memberId, _onlyUnread, _take)).ToList();
      _hasMore = _items.Count >= _take;
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در بارگذاری پیام‌های بیشتر: {ex.Message}");
    }
    finally
    {
      _busy = false;
    }
  }

  private async Task ToggleAsync(BaleMessageLog message)
  {
    if (_openId == message.LogId)
    {
      _openId = null;
      return;
    }

    _openId = message.LogId;

    if (message.ReadAt == null)
    {
      try
      {
        if (await BaleRepo.MarkMessageReadAsync(_memberId, message.LogId))
        {
          message.ReadAt = DateTime.UtcNow;
          if (_unreadCount > 0)
            _unreadCount--;
        }
      }
      catch
      {
        // Reading the message locally is still useful even if the read flag fails to persist.
      }
    }
  }

  private async Task MarkAllReadAsync()
  {
    if (_busy || _unreadCount == 0)
      return;

    _busy = true;
    try
    {
      await BaleRepo.MarkAllMessagesReadAsync(_memberId);
      _unreadCount = 0;

      if (_onlyUnread)
      {
        _items.Clear();
        _hasMore = false;
      }
      else
      {
        var now = DateTime.UtcNow;
        foreach (var item in _items)
          item.ReadAt ??= now;
      }

      Toasts.Success("همه پیام‌ها به‌عنوان خوانده‌شده علامت زده شدند.");
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در علامت‌گذاری پیام‌ها: {ex.Message}");
    }
    finally
    {
      _busy = false;
    }
  }

  private static string FeatureLabel(string? key) => key switch
  {
    "deposit_credit" => "واریز به حساب",
    "deposit_interest_run" => "واریز سود سپرده",
    "loan_payment" => "پرداخت تسهیلات",
    "loan_installment_reminder" => "یادآوری قسط",
    "member_updated" => "به‌روزرسانی اطلاعات عضو",
    null or "" => "اطلاع‌رسانی صندوق",
    _ => key
  };

  private static string Preview(string? text)
  {
    var value = (text ?? string.Empty).Replace("\r", " ").Replace("\n", " ").Trim();
    if (value.Length <= 110)
      return value;

    return value[..110] + "…";
  }

  private static string FormatJalali(DateTime utc)
  {
    var local = utc.ToLocalTime();
    var pc = new PersianCalendar();
    return $"{pc.GetYear(local):0000}/{pc.GetMonth(local):00}/{pc.GetDayOfMonth(local):00} {local:HH:mm}";
  }
}
