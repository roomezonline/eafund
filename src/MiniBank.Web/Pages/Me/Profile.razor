@page "/me/profile"

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MiniBank.Web.Models
@using MiniBank.Web.Models.Notifications
@using MiniBank.Web.Components.Member

@inject AuthenticationStateProvider AuthStateProvider
@inject MiniBank.Web.Infrastructure.Repositories.AuthRepository AuthRepo
@inject MiniBank.Web.Services.MemberService MemberService
@inject MiniBank.Web.Services.Auth.AuthService Auth
@inject MiniBank.Web.Components.DesignSystem.DsToastService Toasts
@inject NavigationManager Nav
@inject MiniBank.Web.Infrastructure.Repositories.BaleBotRepository BaleRepo
@inject IJSRuntime JS

<MemberSelector OnMemberChanged="OnMemberSelectorChanged" />

<style>
  :root{--c-bg:#f7f9fc;--c-card:#ffffff;--c-border:#e5e7eb;--c-text:#0f172a;--c-muted:#64748b;--c-brand:#0ea5e9}
  .me-shell{max-width:980px;margin:0 auto;padding:16px 14px 80px;direction:rtl}
  .card{background:var(--c-card);border:1px solid var(--c-border);border-radius:16px;padding:14px;box-shadow:0 10px 25px rgba(15,23,42,.06)}
  .card.accent{border-color:#bae6fd;background:linear-gradient(180deg,#ffffff,#f0f9ff)}
  .title{font-weight:950;color:#0f172a;margin-bottom:10px}
  .kv{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:10px;border-radius:14px;background:linear-gradient(180deg,#f8fafc,#ffffff);border:1px solid #eef2f7}
  .k{font-weight:800;color:#64748b;font-size:12px}
  .v{font-weight:950;color:#0f172a;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .muted{color:#64748b;font-weight:800;font-size:12px}
  .form-grid{display:grid;gap:10px}
  .inp{width:100%;border-radius:14px;border:1px solid #e5e7eb;background:#fff;padding:10px 12px;font-weight:800;outline:none}
  .inp:focus{border-color:#bae6fd;box-shadow:0 0 0 4px rgba(56,189,248,.18)}
  .pw-wrap{position:relative}
  .pw-input{padding-left:44px}
  .pw-eye{position:absolute;left:10px;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:12px;border:1px solid #e5e7eb;background:#fff;color:#0f172a;display:grid;place-items:center;cursor:pointer}
  .pw-eye:active{transform:translateY(-50%) scale(.98)}
  .btn{appearance:none;border:0;border-radius:14px;padding:10px 12px;font-weight:950;cursor:pointer;display:inline-flex;align-items:center;gap:8px}
  .btn.primary{background:linear-gradient(135deg,#0ea5e9,#7c3aed);color:#fff;box-shadow:0 10px 24px rgba(14,165,233,.18)}
  .btn:disabled{opacity:.6;cursor:not-allowed;box-shadow:none}
</style>

<div class="me-shell">
  @if (_loading)
  {
    <div class="card"><div class="muted">در حال بارگذاری...</div></div>
  }
  else if (!string.IsNullOrWhiteSpace(_error))
  {
    <div class="card"><div style="font-weight:950;color:#b91c1c">@_error</div></div>
  }
  else
  {
    <div class="card accent">
      <div class="title">پروفایل</div>

      <div class="kv"><div class="k">کد عضویت</div><div class="v">@_me?.MemberId</div></div>
      <div style="height:10px"></div>
      <div class="kv"><div class="k">نام و نام خانوادگی</div><div class="v">@_me?.FullName</div></div>
      <div style="height:10px"></div>
      <div class="kv"><div class="k">کد ملی</div><div class="v">@_me?.NationalCode</div></div>
      <div style="height:10px"></div>
      <div class="kv"><div class="k">موبایل</div><div class="v">@_me?.MobileNumber</div></div>
      <div style="height:10px"></div>
      <div class="kv"><div class="k">شماره خانوار</div><div class="v">@(_me?.HouseholdCode ?? "-")</div></div>
      <div style="height:10px"></div>
      <div class="kv"><div class="k">نام خانوار</div><div class="v">@(_me?.Household?.Name ?? "-")</div></div>
    </div>

    <div style="height:12px"></div>

    <div class="card">
      <div class="title">اطلاع‌رسانی پیام‌رسان بله</div>

      @if (_baleError != null)
      {
        <div class="muted" style="color:#b91c1c">@_baleError</div>
      }
      else if (_baleSettings == null || !_baleSettings.IsEnabled)
      {
        <div class="muted">سامانه اطلاع‌رسانی بله در حال حاضر فعال نیست.</div>
      }
      else if (_baleSubscriber != null)
      {
        <div class="kv" style="margin-bottom:10px;">
          <div class="k">وضعیت</div>
          <div class="v" style="color:#16a34a">متصل</div>
        </div>
        <div class="kv" style="margin-bottom:10px;">
          <div class="k">تاریخ اتصال</div>
          <div class="v">@_baleSubscriber.LinkedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
        </div>
        <div class="muted" style="margin-bottom:10px;">از این پس اطلاع‌رسانی‌های صندوق را در بله دریافت می‌کنید.</div>
        <div class="muted">اتصال به بله اجباری است و از این بخش قابل قطع نیست. برای تغییر یا قطع اتصال در موارد ضروری با مدیر صندوق تماس بگیرید.</div>
      }
      else
      {
        <div class="muted" style="margin-bottom:10px;">
          با اتصال حساب خود به ربات بله، اطلاع‌رسانی‌های صندوق (واریز، قسط و یادآوری‌ها) را در بله دریافت می‌کنید.
        </div>

        @if (string.IsNullOrWhiteSpace(_baleLink))
        {
          <button class="btn primary" @onclick="CreateBaleLinkAsync" disabled="@_baleBusy">
            <i class="fa-solid fa-link"></i>
            @(_baleBusy ? "در حال ساخت لینک..." : "دریافت لینک اتصال")
          </button>
        }
        else
        {
          <div class="muted" style="margin-bottom:6px;">لینک اختصاصی شما (۱۵ دقیقه اعتبار):</div>
          <input class="inp" readonly dir="ltr" value="@_baleLink" />
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
            <button class="btn primary" @onclick="CopyBaleLinkAsync">
              <i class="fa-solid fa-copy"></i>
              کپی لینک
            </button>
            <a class="btn" style="border:1px solid #e5e7eb;background:#fff;color:#0f172a;text-decoration:none;" href="@_baleLink" target="_blank" rel="noopener">
              باز کردن بله
            </a>
          </div>
          <div class="muted" style="margin-top:8px;">پس از باز شدن بله، دکمه «شروع» را بزنید تا اتصال کامل شود.</div>
        }

        @if (!string.IsNullOrWhiteSpace(_baleSettings.BotUsername))
        {
          <div class="muted" style="margin-top:8px;">
            اگر لینک را باز نکردید،
            <a href="https://ble.ir/@(_baleSettings.BotUsername.Trim().TrimStart('@'))" target="_blank" rel="noopener" style="color:#0369a1;font-weight:900;">ربات را در بله باز کنید</a>
            و شماره موبایل ثبت‌شده در صندوق را ارسال کنید.
          </div>
        }

        @if (string.IsNullOrWhiteSpace(_baleSettings.BotUsername))
        {
          <div class="muted" style="margin-top:8px;color:#b45309;">نام کاربری ربات بله توسط مدیر تنظیم نشده است.</div>
        }
      }
    </div>

    <div style="height:12px"></div>

    <div class="card">
      <div class="title">تغییر رمز عبور</div>
      <div class="muted" style="margin-bottom:10px">برای تغییر رمز، ابتدا رمز فعلی را وارد کنید.</div>

      <div class="form-grid">
        <div class="pw-wrap">
          <input class="inp pw-input" type="@(_showCur ? "text" : "password")" placeholder="رمز فعلی" @bind="_currentPassword" />
          <button type="button" class="pw-eye" @onclick="(() => _showCur = !_showCur)" aria-label="نمایش/مخفی کردن رمز">
            <i class="fa-solid @(_showCur ? "fa-eye-slash" : "fa-eye")"></i>
          </button>
        </div>
        <div class="pw-wrap">
          <input class="inp pw-input" type="@(_showNew ? "text" : "password")" placeholder="رمز جدید" @bind="_newPassword" />
          <button type="button" class="pw-eye" @onclick="(() => _showNew = !_showNew)" aria-label="نمایش/مخفی کردن رمز">
            <i class="fa-solid @(_showNew ? "fa-eye-slash" : "fa-eye")"></i>
          </button>
        </div>
        <div class="pw-wrap">
          <input class="inp pw-input" type="@(_showCnf ? "text" : "password")" placeholder="تکرار رمز جدید" @bind="_confirmPassword" />
          <button type="button" class="pw-eye" @onclick="(() => _showCnf = !_showCnf)" aria-label="نمایش/مخفی کردن رمز">
            <i class="fa-solid @(_showCnf ? "fa-eye-slash" : "fa-eye")"></i>
          </button>
        </div>
        <button class="btn primary" disabled="@_changing" @onclick="ChangePasswordAsync">
          <i class="fa-solid fa-key"></i>
          @(_changing ? "در حال انجام..." : "ثبت تغییر رمز")
        </button>
      </div>
    </div>
  }
</div>

@code {
  private bool _loading = true;
  private string? _error;
  private Member? _me;
  
  // Member selector for admin/staff
  private long? _adminSelectedMemberId;

  private BaleBotSettings? _baleSettings;
  private BaleSubscriber? _baleSubscriber;
  private string _baleLink = string.Empty;
  private string? _baleError;
  private bool _baleBusy;

  private string _currentPassword = string.Empty;
  private string _newPassword = string.Empty;
  private string _confirmPassword = string.Empty;
  private bool _changing;

  private bool _showCur;
  private bool _showNew;
  private bool _showCnf;

  private sealed class ChangePasswordRequest
  {
    public string CurrentPassword { get; set; } = string.Empty;
    public string NewPassword { get; set; } = string.Empty;
  }

  protected override async Task OnInitializedAsync()
  {
    await LoadProfileAsync();
  }

  private async Task ChangePasswordAsync()
  {
    if (_changing) return;

    var cur = (_currentPassword ?? string.Empty).Trim();
    var nw = (_newPassword ?? string.Empty).Trim();
    var cf = (_confirmPassword ?? string.Empty).Trim();

    if (string.IsNullOrWhiteSpace(cur) || string.IsNullOrWhiteSpace(nw))
    {
      Toasts.Error("رمز فعلی و رمز جدید را وارد کنید");
      return;
    }

    if (!string.Equals(nw, cf, StringComparison.Ordinal))
    {
      Toasts.Error("تکرار رمز جدید صحیح نیست");
      return;
    }

    _changing = true;
    try
    {
      var res = await Auth.ChangePasswordForCurrentUserAsync(cur, nw);
      if (res.ok)
      {
        Toasts.Success("رمز عبور با موفقیت تغییر کرد");
        _currentPassword = string.Empty;
        _newPassword = string.Empty;
        _confirmPassword = string.Empty;
      }
      else
      {
        Toasts.Error(string.IsNullOrWhiteSpace(res.error) ? "خطا در تغییر رمز" : res.error);
      }
    }
    catch
    {
      Toasts.Error("خطا در تغییر رمز");
    }
    finally
    {
      _changing = false;
    }
  }

  private async Task OnMemberSelectorChanged(long? memberId)
  {
    _adminSelectedMemberId = memberId;
    
    // Reload profile with new member selection
    await LoadProfileAsync();
  }

  private async Task LoadProfileAsync()
  {
    try
    {
      _loading = true;
      _error = null;

      long targetMemberId;
      
      // If admin has selected a member, load that member's profile
      if (_adminSelectedMemberId.HasValue && _adminSelectedMemberId.Value > 0)
      {
        targetMemberId = _adminSelectedMemberId.Value;
      }
      else
      {
        // Load logged-in user's profile
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        var role = user?.FindFirst("role")?.Value ?? user?.FindFirst(ClaimTypes.Role)?.Value;
        var isMemberRole = string.Equals(role, "Member", StringComparison.OrdinalIgnoreCase);

        var memberIdClaim = user?.FindFirst("MemberId")?.Value;
        if (!long.TryParse(memberIdClaim, out targetMemberId) || targetMemberId <= 0)
        {
          var userIdClaim = user?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
          if (long.TryParse(userIdClaim, out var userId) && userId > 0)
          {
            var dbUser = await AuthRepo.GetUserByIdAsync(userId);
            if (dbUser?.MemberId.HasValue == true)
              targetMemberId = dbUser.MemberId.Value;
          }
        }

        if (!isMemberRole && targetMemberId <= 0)
        {
          _me = null;
          _error = "برای مشاهده اطلاعات، ابتدا یک عضو را از لیست بالا انتخاب کنید.";
          return;
        }
      }

      if (targetMemberId <= 0)
      {
        _error = "اطلاعات عضویت برای این کاربر ثبت نشده است.";
        return;
      }

      _me = await MemberService.GetByIdAsync(targetMemberId);
      if (_me == null)
      {
        _error = "عضو یافت نشد.";
        return;
      }

      await LoadBaleAsync(_me.MemberId);
    }
    catch (Exception ex)
    {
      _error = $"خطا در بارگذاری پروفایل: {ex.Message}";
    }
    finally
    {
      _loading = false;
    }
  }

  private async Task LoadBaleAsync(long memberId)
  {
    try
    {
      _baleError = null;
      _baleSettings = await BaleRepo.GetSettingsAsync();
      _baleSubscriber = await BaleRepo.GetActiveByMemberAsync(memberId);
      _baleLink = string.Empty;
    }
    catch
    {
      _baleSettings = null;
      _baleSubscriber = null;
      _baleError = "اطلاعات اطلاع‌رسانی بله در دسترس نیست.";
    }
  }

  private async Task CreateBaleLinkAsync()
  {
    if (_me == null)
      return;

    try
    {
      _baleBusy = true;

      if (_baleSettings == null || !_baleSettings.IsEnabled)
      {
        Toasts.Warning("سامانه اطلاع‌رسانی بله فعال نیست.");
        return;
      }

      var username = (_baleSettings.BotUsername ?? string.Empty).Trim().TrimStart('@');
      if (string.IsNullOrWhiteSpace(username))
      {
        Toasts.Warning("نام کاربری ربات بله توسط مدیر تنظیم نشده است.");
        return;
      }

      var token = await BaleRepo.CreateLinkTokenAsync(_me.MemberId, TimeSpan.FromMinutes(15));
      _baleLink = $"https://ble.ir/{username}?start={token}";
      Toasts.Success("لینک اتصال ساخته شد.");
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در ساخت لینک اتصال: {ex.Message}");
    }
    finally
    {
      _baleBusy = false;
    }
  }

  private async Task CopyBaleLinkAsync()
  {
    try
    {
      if (string.IsNullOrWhiteSpace(_baleLink))
        return;

      await JS.InvokeVoidAsync("navigator.clipboard.writeText", _baleLink);
      Toasts.Success("لینک کپی شد.");
    }
    catch
    {
      Toasts.Warning("کپی خودکار ممکن نشد؛ لینک را دستی انتخاب کنید.");
    }
  }
}
