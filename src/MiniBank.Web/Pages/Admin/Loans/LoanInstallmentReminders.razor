@page "/admin/loan-installment-reminders"
@using MiniBank.Web.Components.DesignSystem
@using MiniBank.Web.Infrastructure.Repositories
@using MiniBank.Web.Models.Sms
@using MiniBank.Web.Services
@using MiniBank.Web.Services.Notifications
@using System.Globalization
@using System.Text.Json
@inject DsToastService Toasts
@inject LoanInstallmentReminderRepository ReminderRepo
@inject SmsMessageLogRepository SmsLogRepo
@inject NotificationService Notifications

<PageTitle>یادآوری اقساط</PageTitle>

<DsPageHeader Title="یادآوری اقساط"
             Icon="fa-solid fa-bell"
             Subtitle="اقساط نزدیک سررسید یا معوق + ارسال دستی یادآوری با تاریخچه"
             ShowBackButton="true" />

<style>
  .lir-page{direction:rtl; padding:16px 14px 80px; max-width:1200px; margin:0 auto}
  .lir-card{background:#fff;border:1px solid #e5e7eb;border-radius:14px; padding:12px}
  .lir-card-title{font-weight:950; color:#0f172a}
  .lir-muted{font-size:12px; color:#64748b; font-weight:800}
  .lir-actions{display:flex; gap:8px; flex-wrap:wrap}

  .lir-filters{display:grid; gap:10px}
  .lir-grid-2{display:grid; gap:10px; grid-template-columns:1fr 1fr; align-items:end}
  @@media (max-width: 720px){.lir-grid-2{grid-template-columns:1fr}}
  .lir-label{font-weight:900; font-size:12px; color:#0f172a}
  .lir-input{height:40px; border-radius:12px; border:1px solid #cbd5e1; padding:0 12px; font-weight:900; background:#fff; outline:none}
  .lir-input:focus{border-color:#93c5fd; box-shadow:0 0 0 4px rgba(59,130,246,.12)}

  .lir-btn{height:40px; border-radius:12px; border:1px solid #e2e8f0; background:#fff; color:#0f172a; font-weight:950; padding:0 14px; cursor:pointer; display:inline-flex; align-items:center; gap:8px}
  .lir-btn.primary{border-color:#0ea5e9; background:#0ea5e9; color:#fff}
  .lir-btn:disabled{opacity:.6; cursor:not-allowed}

  .lir-list{display:grid; gap:10px; margin-top:10px}
  .lir-row{border:1px solid #e5e7eb; border-radius:16px; overflow:hidden; background:#fff}
  .lir-row-head{padding:12px; background:linear-gradient(180deg,#f8fafc,#ffffff); cursor:pointer}
  .lir-row-grid{display:grid; grid-template-columns:1fr auto; gap:10px; align-items:start}
  @@media (max-width: 720px){.lir-row-grid{grid-template-columns:1fr}}

  .lir-chips{display:flex; gap:8px; align-items:center; flex-wrap:wrap}
  .lir-chip{display:inline-flex; align-items:center; gap:6px; padding:2px 10px; border-radius:999px; font-weight:950; font-size:12px; border:1px solid rgba(15,23,42,.10); background:#f8fafc; color:#0f172a}
  .lir-chip.badge{border-color:rgba(2,132,199,0.15)}
  .lir-kv{display:flex; gap:10px; flex-wrap:wrap; font-size:12px; color:#475569; font-weight:800}
  .lir-name{font-weight:950; font-size:14px; color:#0f172a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
  .lir-sub{font-size:12px; color:#64748b; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; direction:ltr; text-align:left}
  .lir-amount{margin-top:6px; display:flex; gap:8px; align-items:center; font-weight:950; color:#0f172a}
  .lir-amount strong{direction:ltr}
  .lir-meta{margin-top:8px; font-size:12px; color:#475569; font-weight:800}
  .lir-meta b{font-weight:950; color:#0f172a}

  .lir-row-action{display:grid; gap:8px; justify-items:end}
  @@media (max-width: 720px){.lir-row-action{justify-items:stretch}}
  .lir-send{height:36px; border-radius:12px; border:1px solid #0ea5e9; background:#0ea5e9; color:#fff; font-weight:950; padding:0 12px; font-size:12px; cursor:pointer}
  .lir-send:disabled{opacity:.6; cursor:not-allowed}

  .lir-details{padding:12px; border-top:1px solid #e5e7eb; background:#fff}
  .lir-details-head{display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap}
  .lir-mini-btn{height:34px; border-radius:12px; border:1px solid #e2e8f0; background:#fff; color:#0f172a; font-weight:950; padding:0 12px; font-size:12px; cursor:pointer}
  .lir-mini-btn:disabled{opacity:.6; cursor:not-allowed}

  .lir-log{border:1px solid #e5e7eb; border-radius:14px; padding:12px; background:#f8fafc}
  .lir-log-head{display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap}
  .lir-log-meta{display:flex; gap:8px; align-items:center; flex-wrap:wrap}
  .lir-log-time{font-size:12px; color:#64748b; font-weight:800; white-space:nowrap; direction:ltr}
  .lir-pre{white-space:pre-wrap; margin:10px 0 0 0; font-family:inherit; font-weight:800; line-height:1.9; font-size:12px; color:#0f172a}
</style>

<section class="lir-page">
    <div class="lir-card">
        <div class="lir-card-title" style="margin-bottom:10px;">فیلترها</div>

        <div class="lir-filters">
            <div class="lir-grid-2">
                <div style="display:grid; gap:6px;">
                    <label class="lir-label">اقساط چند روز مانده به سررسید</label>
                    <input class="lir-input" style="direction:ltr;" value="@_daysBeforeDueText" @oninput="OnDaysBeforeChanged" placeholder="1" />
                </div>

                <div style="display:grid; gap:6px;">
                    <label class="lir-label">اقساط معوق</label>
                    <select class="lir-input" value="@(_includeOverdue ? 1 : 0)" @onchange="OnIncludeOverdueChanged">
                        <option value="1">نمایش بده</option>
                        <option value="0">نمایش نده</option>
                    </select>
                </div>
            </div>

            <div style="display:grid; gap:6px;">
                <label class="lir-label">جستجو (کد عضو / موبایل / نام / شناسه وام)</label>
                <input class="lir-input" style="width:100%;" value="@_query" @oninput="OnQueryInput" placeholder="مثلاً 0912... یا 11008 یا محمد حسینی" />
            </div>
        </div>

        <div class="lir-actions" style="margin-top:12px;">
            <button class="lir-btn" @onclick="ClearFilters" disabled="@_loading">
                پاک کردن
            </button>
            <button class="lir-btn primary" @onclick="LoadAsync" disabled="@_loading">
                <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                بارگذاری
            </button>
        </div>
    </div>

    <div class="lir-card" style="margin-top:12px;">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;">
            <div class="lir-card-title">نتایج</div>
            <div class="lir-muted">@_items.Count مورد</div>
        </div>

        @if (_loading)
        {
            <div style="margin-top:10px;">در حال بارگذاری...</div>
        }
        else if (_items.Count == 0)
        {
            <div style="margin-top:10px; font-size:12px; opacity:.75;">موردی یافت نشد.</div>
        }
        else
        {
            <div class="lir-list">
                @foreach (var x in _items)
                {
                    var isOpen = IsDetailsOpen(x.InstallmentId);
                    var isTomorrow = x.DaysToDue == 1;
                    var isOverdue = x.OverdueDays > 0;

                    var badgeText = isTomorrow ? "فردا سررسید" : (isOverdue ? $"معوق ({x.OverdueDays} روز)" : $"{x.DaysToDue} روز مانده");
                    var badgeColor = isTomorrow ? "#0ea5e9" : (isOverdue ? "#dc2626" : "#16a34a");
                    var badgeBg = isOverdue ? "rgba(220,38,38,0.08)" : "rgba(14,165,233,0.08)";

                    _reminderSummary.TryGetValue(x.InstallmentId, out var sum);

                    <div class="lir-row">
                        <div class="lir-row-head" @onclick="(() => ToggleDetails(x.InstallmentId))">
                            <div class="lir-row-grid">
                                <div style="min-width:0;">
                                    <div class="lir-chips">
                                        <span class="lir-chip badge" style="background:@badgeBg; color:@badgeColor;">
                                            @badgeText
                                        </span>
                                        <span class="lir-chip">
                                            <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                                            سررسید: @FormatJalaliDate(x.DueDate)
                                        </span>
                                        <span class="lir-chip">قسط: @x.InstallmentNo</span>
                                        <span class="lir-chip" style="direction:ltr;">Loan #@x.LoanId</span>
                                    </div>

                                    <div class="lir-name" style="margin-top:8px;">@x.MemberFullName</div>

                                    <div class="lir-sub" style="margin-top:4px;">
                                        <span>@(string.IsNullOrWhiteSpace(x.MemberCode) ? "-" : x.MemberCode)</span>
                                        <span style="opacity:.45; padding:0 8px;">|</span>
                                        <span style="color:#dc2626; font-weight:950;">@(string.IsNullOrWhiteSpace(x.MobileNumber) ? "-" : x.MobileNumber)</span>
                                    </div>

                                    <div class="lir-amount">
                                        <i class="fa-solid fa-money-bill-wave" style="color:#16a34a" aria-hidden="true"></i>
                                        <span>مبلغ قسط:</span>
                                        <strong>@x.EmiAmount.ToString("N0")</strong>
                                        <span>ریال</span>
                                    </div>

                                    <div class="lir-meta">
                                        @if (sum == null || sum.SendCount <= 0)
                                        {
                                            <span style="color:#64748b; font-weight:900;">تا حالا پیامک یادآوری ارسال نشده</span>
                                        }
                                        else
                                        {
                                            <span><b>@sum.SendCount</b> بار ارسال شده</span>
                                            <span style="opacity:.45; padding:0 8px;">|</span>
                                            <span>آخرین ارسال: <b>@(sum.LastSentAt.HasValue ? FormatJalaliDateTime(sum.LastSentAt.Value) : "-")</b></span>
                                        }
                                    </div>
                                </div>

                                <div class="lir-row-action">
                                    <button class="lir-send" @onclick:stopPropagation="true" @onclick="(() => AskSendReminderAsync(x))" disabled="@_sending">
                                        ارسال یادآوری
                                    </button>
                                </div>
                            </div>
                        </div>

                        @if (isOpen)
                        {
                            <div class="lir-details">
                                <div class="lir-details-head">
                                    <div class="lir-card-title" style="font-size:13px;">تاریخچه پیامک‌های یادآوری</div>
                                    <button class="lir-mini-btn" @onclick="(() => ReloadHistoryAsync(x.InstallmentId))" disabled="@_sending">
                                        <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                                        به‌روزرسانی
                                    </button>
                                </div>

                                @if (_historyLoading.Contains(x.InstallmentId))
                                {
                                    <div style="margin-top:8px; font-size:12px; opacity:.75;">در حال بارگذاری تاریخچه...</div>
                                }
                                else if (!_history.TryGetValue(x.InstallmentId, out var logs) || logs.Count == 0)
                                {
                                    <div style="margin-top:8px; font-size:12px; opacity:.75;">تاریخچه‌ای برای این قسط ثبت نشده است.</div>
                                }
                                else
                                {
                                    <div style="margin-top:10px; display:grid; gap:10px;">
                                        @foreach (var l in logs)
                                        {
                                            var ok = l.IsSuccess.HasValue ? l.IsSuccess.Value : (l.ApiStatus.HasValue ? l.ApiStatus.Value == 1 : (bool?)null);
                                            var okText = ok.HasValue ? (ok.Value ? "موفق" : "ناموفق") : "نامشخص";
                                            var okColor = ok.HasValue ? (ok.Value ? "#16a34a" : "#dc2626") : "#64748b";

                                            <div class="lir-log">
                                                <div class="lir-log-head">
                                                    <div class="lir-log-meta">
                                                        <span class="lir-chip" style="color:@okColor; background:rgba(2,132,199,0.06); border-color:rgba(2,132,199,0.12);">@okText</span>
                                                        <span class="lir-muted" style="direction:ltr;">Log #@l.LogId</span>
                                                    </div>
                                                    <div class="lir-log-time">@(l.SentAt.HasValue ? FormatJalaliDateTime(l.SentAt.Value) : "-")</div>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(l.MessageText))
                                                {
                                                    <pre class="lir-pre">@l.MessageText</pre>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

<DsConfirm Show="@_showSendConfirm"
           Title="@($"ارسال یادآوری ({_sendChannelLabel})")"
           Message="@_sendConfirmMessage"
           Variant="info"
           ShowWarning="false"
           ConfirmText="ارسال"
           CancelText="انصراف"
           OnConfirm="ConfirmSendReminderAsync"
           OnCancel="CancelSendReminder" />

@code {
    private const string ReminderFeatureKey = "loan_installment_reminder";
    private const int ReminderTemplateId = 387302;

    private bool _loading;
    private bool _sending;

    private string _daysBeforeDueText = "1";
    private int _daysBeforeDue = 1;
    private bool _includeOverdue = true;
    private string _query = string.Empty;

    private List<LoanInstallmentReminderRepository.ReminderRow> _items = new();
    private Dictionary<long, SmsMessageLogRepository.ReminderSummaryRow> _reminderSummary = new();

    private readonly HashSet<long> _openDetails = new();
    private readonly Dictionary<long, List<SmsMessageLog>> _history = new();
    private readonly HashSet<long> _historyLoading = new();

    private bool _showSendConfirm;
    private LoanInstallmentReminderRepository.ReminderRow? _pendingSend;
    private string _sendConfirmMessage = string.Empty;
    private string _sendChannelLabel = "پیامک";
    private bool _sendBaleReady;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _items = (await ReminderRepo.SearchAsync(
                daysBeforeDue: _daysBeforeDue,
                includeOverdue: _includeOverdue,
                query: _query,
                take: 200)).ToList();

            var ids = _items.Select(x => x.InstallmentId).Distinct().ToList();
            var sum = await SmsLogRepo.GetLoanInstallmentReminderSummaryAsync(ids, ReminderFeatureKey);
            _reminderSummary = sum.ToDictionary(x => x.InstallmentId, x => x);

            // Clear any stale history if list changed
            var valid = ids.ToHashSet();
            foreach (var key in _history.Keys.ToList())
            {
                if (!valid.Contains(key))
                    _history.Remove(key);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در بارگذاری اقساط: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadHistoryAsync(long installmentId)
    {
        if (_historyLoading.Contains(installmentId))
            return;

        try
        {
            _historyLoading.Add(installmentId);
            StateHasChanged();

            var logs = await SmsLogRepo.GetLoanInstallmentReminderLogsAsync(installmentId, ReminderFeatureKey, take: 50);
            _history[installmentId] = logs.ToList();

            // Update summary too
            var sum = await SmsLogRepo.GetLoanInstallmentReminderSummaryAsync(new[] { installmentId }, ReminderFeatureKey);
            var s = sum.FirstOrDefault();
            if (s != null)
                _reminderSummary[installmentId] = s;
            else
                _reminderSummary.Remove(installmentId);
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در بارگذاری تاریخچه: {ex.Message}");
        }
        finally
        {
            _historyLoading.Remove(installmentId);
            StateHasChanged();
        }
    }

    private void ToggleDetails(long installmentId)
    {
        if (_openDetails.Contains(installmentId))
        {
            _openDetails.Clear();
            return;
        }

        _openDetails.Clear();
        _openDetails.Add(installmentId);
        _ = ReloadHistoryAsync(installmentId);
    }

    private bool IsDetailsOpen(long installmentId) => _openDetails.Contains(installmentId);

    private void ClearFilters()
    {
        _daysBeforeDueText = "1";
        _daysBeforeDue = 1;
        _includeOverdue = true;
        _query = string.Empty;
        _openDetails.Clear();
        _history.Clear();
        _reminderSummary.Clear();
    }

    private void OnDaysBeforeChanged(ChangeEventArgs e)
    {
        _daysBeforeDueText = e?.Value?.ToString() ?? "";
        if (int.TryParse(new string((_daysBeforeDueText ?? string.Empty).Where(char.IsDigit).ToArray()), out var n))
        {
            if (n < 0) n = 0;
            if (n > 365) n = 365;
            _daysBeforeDue = n;
        }
    }

    private void OnIncludeOverdueChanged(ChangeEventArgs e)
    {
        var v = e?.Value?.ToString() ?? "1";
        _includeOverdue = string.Equals(v, "1", StringComparison.OrdinalIgnoreCase);
    }

    private void OnQueryInput(ChangeEventArgs e)
    {
        _query = e?.Value?.ToString() ?? string.Empty;
    }

    private async Task AskSendReminderAsync(LoanInstallmentReminderRepository.ReminderRow row)
    {
        _pendingSend = null;

        try
        {
            var availability = await Notifications.GetAvailabilityAsync(ReminderFeatureKey, row.MobileNumber, row.MemberId);
            if (!availability.Enabled || !availability.HasAnyChannel)
            {
                Toasts.Warning(availability.Reason ?? "کانال ارسال در دسترس نیست.");
                return;
            }

            _sendChannelLabel = availability.EffectiveLabel;
            _sendBaleReady = availability.BaleReady;
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در بررسی کانال ارسال: {ex.Message}");
            return;
        }

        _pendingSend = row;

        var due = FormatJalaliDate(row.DueDate);
        var amount = row.EmiAmount.ToString("N0");
        var status = row.OverdueDays > 0 ? $"{row.OverdueDays} روز معوق" : $"{row.DaysToDue} روز مانده";
        var mobileText = string.IsNullOrWhiteSpace(row.MobileNumber) ? "-" : row.MobileNumber;

        var NAME = NormalizeNameForSms(row.MemberFullName);
        var PRICE = $"{amount} ریال";
        var DATE = due;
        var messageText = $"عضومحترم {NAME}\nلطفا نسبت به پرداخت قسط خود به مبلغ {PRICE}\nدر سررسید {DATE} اقدام نمایید.\nصندوق همیاری امام علی (ع)";
        var baleText = NotificationText.BuildLoanReminderBaleMessage(
            row.MemberFullName, row.FatherName, amount, DATE);

        _sendConfirmMessage = BuildReminderSmsConfirmMarkup(
            NAME,
            mobileText,
            row.LoanId,
            row.InstallmentNo,
            due,
            amount,
            status,
            messageText,
            _sendChannelLabel,
            _sendBaleReady ? baleText : null);
        _showSendConfirm = true;
    }

    private void CancelSendReminder()
    {
        _showSendConfirm = false;
        _pendingSend = null;
        _sendConfirmMessage = string.Empty;
    }

    private async Task ConfirmSendReminderAsync()
    {
        _showSendConfirm = false;
        StateHasChanged();

        if (_pendingSend == null)
            return;

        var row = _pendingSend;
        _pendingSend = null;

        try
        {
            _sending = true;
            StateHasChanged();

            var dueJalali = FormatJalaliDate(row.DueDate);
            var amount = row.EmiAmount.ToString("N0");

            var NAME = NormalizeNameForSms(row.MemberFullName);
            var PRICE = $"{amount} ریال";
            var DATE = dueJalali;

            var messageText = $"عضومحترم {NAME}\nلطفا نسبت به پرداخت قسط خود به مبلغ {PRICE}\nدر سررسید {DATE} اقدام نمایید.\nصندوق همیاری امام علی (ع)";

            var result = await Notifications.NotifyAsync(new NotificationRequest
            {
                FeatureKey = ReminderFeatureKey,
                MessageText = messageText,
                BaleMessageText = NotificationText.BuildLoanReminderBaleMessage(
                    row.MemberFullName, row.FatherName, amount, DATE),
                MemberId = row.MemberId,
                HeadMemberId = row.MemberId,
                RecipientMobile = row.MobileNumber,
                RecipientName = row.MemberFullName,
                SmsTemplateId = ReminderTemplateId,
                SmsParams = new Dictionary<string, string>
                {
                    ["NAME"] = NAME,
                    ["PRICE"] = PRICE,
                    ["DATE"] = DATE
                },
                CreatedBy = "manual-reminder"
            });

            if (result.Ok)
            {
                Toasts.Success(result.Message);
                await ReloadHistoryAsync(row.InstallmentId);
            }
            else
            {
                Toasts.Warning(result.Message);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در ارسال یادآوری: {ex.Message}");
        }
        finally
        {
            _sending = false;
            StateHasChanged();
        }
    }

    private static string FormatJalaliDate(DateTime dt)
    {
        var local = dt.ToLocalTime();
        var pc = new PersianCalendar();
        var y = pc.GetYear(local);
        var m = pc.GetMonth(local);
        var d = pc.GetDayOfMonth(local);
        return $"{y:0000}/{m:00}/{d:00}";
    }

    private static string FormatJalaliDateTime(DateTime dt)
    {
        var local = dt.ToLocalTime();
        var pc = new PersianCalendar();
        var y = pc.GetYear(local);
        var m = pc.GetMonth(local);
        var d = pc.GetDayOfMonth(local);
        return $"{local:HH:mm} {y:0000}/{m:00}/{d:00}";
    }

    private static string NormalizeNameForSms(string? fullName)
    {
        var name = (fullName ?? string.Empty).Trim();
        if (name.Length == 0)
            return string.Empty;

        var starIndex = name.IndexOf('☆');
        if (starIndex >= 0)
            name = name.Substring(0, starIndex).Trim();

        return name;
    }

    private static string BuildReminderSmsConfirmMarkup(
        string memberName,
        string mobile,
        long loanId,
        int installmentNo,
        string due,
        string amount,
        string status,
        string messageText,
        string channelLabel,
        string? baleText = null)
    {
        static string EscapeMessage(string? value)
            => (value ?? string.Empty)
                .Replace("&", "&amp;")
                .Replace("<", "&lt;")
                .Replace(">", "&gt;")
                .Replace("\r\n", "\n")
                .Replace("\r", "\n")
                .Replace("\n", "<br/>");

        var safeMsg = EscapeMessage(messageText);

        var baleBlock = string.IsNullOrWhiteSpace(baleText)
            ? string.Empty
            : $@"
  <div style='border:1px solid #dbeafe; background:#f8fbff; border-radius:12px; padding:10px;'>
    <div style='display:flex; gap:8px; align-items:center;'>
      <i class='fa-solid fa-comments' style='color:#2563eb;'></i>
      <div style='font-weight:900;'>متن ارسال در بله</div>
    </div>
    <div style='margin-top:8px; line-height:1.9; font-weight:800;'>{EscapeMessage(baleText)}</div>
  </div>";

        var note = channelLabel.Contains("پیامک", StringComparison.Ordinal)
            ? "با تایید شما، پیام ارسال می‌شود و از اعتبار پنل پیامک کسر خواهد شد."
            : "با تایید شما، پیام از طریق بله ارسال می‌شود.";

        return $@"
