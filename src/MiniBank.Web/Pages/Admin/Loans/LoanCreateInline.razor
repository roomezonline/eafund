  {
    get
    {
      if (string.IsNullOrWhiteSpace(_memberCode)) return "-";
      var item = _memberItems.FirstOrDefault(x => x.Value == _memberCode);
      return !string.IsNullOrWhiteSpace(item?.Text) ? item!.Text : _memberCode;
