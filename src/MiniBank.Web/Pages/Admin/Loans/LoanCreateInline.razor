              </div>
              @if (_guarantorCoverageError)
              {
                <div class="field-error" style="margin-top: 6px; text-align:right">@_guarantorCoverageErrorText</div>
              }
            }
          </div>
        </div>
      }
      else if (_currentStep == 4)
      {
        <div id="loan-step-4-top"></div>
        <div class="review-container">
          <div class="review-header">
            <div class="review-title">بازبینی نهایی وام</div>
            <div class="review-subtitle">قبل از تایید نهایی، اطلاعات زیر را بررسی کنید</div>
          </div>

          <div class="review-grid">
            <div class="review-card review-card-applicant">
              <div class="review-card-title">متقاضی</div>
              <div class="review-kv review-kv-member">
                <div class="k">عضو</div>
                <div class="v review-member-name">@SelectedMemberDisplay</div>
              </div>
              <div class="review-kv">
                <div class="k">خالص سپرده آزاد متقاضی</div>
                <div class="v amount-td"><span class="money-inline" style=" direction: rtl;"><span class="money-num" dir="ltr">@_applicantAvailableCapitalStr</span><span class="money-cur" dir="rtl">&nbsp;ریال</span></span></div>
              </div>
              <div class="review-kv">
                <div class="k">خالص سپرده آزاد خانوار</div>
                <div class="v amount-td"><span class="money-inline" style=" direction: rtl;"><span class="money-num" dir="ltr">@_householdAvailableCapitalStr</span><span class="money-cur" dir="rtl">&nbsp;ریال</span></span></div>
              </div>
            </div>

            <div class="review-card review-card-loan">
              <div class="review-card-title">مشخصات وام</div>
              <div class="review-kv">
                <div class="k">شماره وام</div>
                <div class="v">@_nextLoanNumberText</div>
              </div>
              <div class="review-kv">
                <div class="k">مبلغ اصل وام</div>
                <div class="v amount-td"><span class="money-inline" style=" direction: rtl;"><span class="money-num" dir="ltr">@ToMoney(ReviewPrincipal)</span><span class="money-cur" dir="rtl">&nbsp;ریال</span></span></div>
              </div>
              <div class="review-kv">
                <div class="k">مبلغ سود وام</div>
                <div class="v amount-td"><span class="money-inline" style=" direction: rtl;"><span class="money-num" dir="ltr">@ToMoney(Math.Max(0m, ReviewTotalPayable - ReviewPrincipal))</span><span class="money-cur" dir="rtl">&nbsp;ریال</span></span></div>
              </div>
              <div class="review-kv">
                <div class="k">مبلغ کل وام</div>
                <div class="v amount-td"><span class="money-inline" style=" direction: rtl;"><span class="money-num" dir="ltr">@ToMoney(ReviewTotalPayable)</span><span class="money-cur" dir="rtl">&nbsp;ریال</span></span></div>
              </div>
              <div class="review-kv">
