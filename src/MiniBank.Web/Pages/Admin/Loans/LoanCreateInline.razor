  private async Task LoadCurrentRateAndPreviewAsync()
  {
    try
    {
      var isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;

      if (_disbursedAt == default)
      {
        if (!isEditMode)
        {
          if (!_annualRateTouched) _currentAnnualRateText = string.Empty;
          if (!_penaltyRateTouched) _currentPenaltyRateText = string.Empty;
        }
        _previewEmiText = string.Empty;
        StateHasChanged();
        return;
      }

      var plan = await LoanRateService.GetActiveForDateOrLatestAsync(_disbursedAt.Date);
      if (plan == null)
      {
        if (!isEditMode)
        {
          if (!_annualRateTouched) _currentAnnualRateText = "-";
          if (!_penaltyRateTouched) _currentPenaltyRateText = "-";
        }
        _previewEmiText = "-";
        StateHasChanged();
        return;
      }

      if (!isEditMode)
      {
        if (!_annualRateTouched)
          _currentAnnualRateText = plan.AnnualRatePercent.ToString("0", CultureInfo.InvariantCulture);
        if (!_penaltyRateTouched)
          _currentPenaltyRateText = plan.PenaltyAnnualRatePercent.ToString("0", CultureInfo.InvariantCulture);
      }

      var p = ParseMoney(_principalStr);
      var n = ParseInt(_termMonthsStr);
      if (p > 0 && n > 0)
      {
        var annualForPreview = ParseDecimal(_currentAnnualRateText);
        if (annualForPreview <= 0m) annualForPreview = plan.AnnualRatePercent;
        var (emi, _) = LoanCalculator.GenerateSchedule(0, p, n, _disbursedAt.Date.AddPersianMonths(1), annualForPreview);
        _previewEmiText = ToMoney(emi);
      }
      else
      {
        _previewEmiText = string.Empty;
      }

      StateHasChanged();
    }
    catch
    {
    }
  }

  private void Validate(bool showToasts)
  {
    var isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;
    var memberId = ResolveSelectedMemberId();
    var principal = ParseMoney(_principalStr);
    var term = ParseInt(_termMonthsStr);
    var approvedPrincipal = ParseMoney(_approvedPrincipalStr);
    var maxApproved = _householdAvailableCapital > 0 ? (_householdAvailableCapital * 20m) : 0m;

    _memberError = string.IsNullOrWhiteSpace(_memberCode) || memberId <= 0;
    _step1HasActiveLoanBlock = _currentStep >= 1 && !_memberError && !isEditMode && _activeLoans.Count > 0;
    _applicantAvailableError = _currentStep >= 1 && !_memberError && !isEditMode && _applicantAvailableCapital <= 0;

    _approvedPrincipalError = false;
    _approvedPrincipalErrorText = null;
    if (_currentStep >= 1 && !_memberError)
    {
      if (_householdAvailableCapital <= 0)
      {
        _approvedPrincipalError = true;
        _approvedPrincipalErrorText = "خالص سپرده آزاد خانوار باید بیشتر از ۰ باشد";
      }
      else if (approvedPrincipal <= 0)
      {
        _approvedPrincipalError = true;
        _approvedPrincipalErrorText = "مبلغ وام مصوب باید بیشتر از ۰ باشد";
      }
      else if (maxApproved > 0 && approvedPrincipal > maxApproved)
      {
        _approvedPrincipalError = true;
        _approvedPrincipalErrorText = $"مبلغ وام مصوب نباید بیشتر از {ToMoney(maxApproved)} باشد";
      }
    }

    _principalError = _currentStep >= 2 && principal <= 0;
    _termError = _currentStep >= 2 && term <= 0;
    _disbursedError = _currentStep >= 2 && _disbursedAt == default;

    var annualOk = decimal.TryParse((_currentAnnualRateText ?? string.Empty).Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var annualRate) && annualRate >= 0;
    var penaltyOk = decimal.TryParse((_currentPenaltyRateText ?? string.Empty).Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var penaltyRate) && penaltyRate >= 0;
    _annualRateError = _currentStep >= 2 && (!annualOk || string.IsNullOrWhiteSpace(_currentAnnualRateText) || (_currentAnnualRateText ?? string.Empty).Trim() == "-");
    _penaltyRateError = _currentStep >= 2 && (!penaltyOk || string.IsNullOrWhiteSpace(_currentPenaltyRateText) || (_currentPenaltyRateText ?? string.Empty).Trim() == "-");

    var factor = ClampLoanFactorTo2Decimals(ParseDecimal(_loanFactorStr));
    var allowZeroBecauseApprovedIsValid = factor == 0m && approvedPrincipal > 0m;
    _loanFactorError = _currentStep >= 1 && !string.IsNullOrWhiteSpace(_loanFactorStr) && !allowZeroBecauseApprovedIsValid && (factor < 0m || factor > 20m);

    foreach (var g in _guarantors)
    {
      g.MemberError = _currentStep >= 3 && (string.IsNullOrWhiteSpace(g.GuarantorMemberIdStr) || !_memberIdByCode.ContainsKey(g.GuarantorMemberIdStr));
      g.AmountError = _currentStep >= 3 && ParseMoney(g.AmountStr) <= 0;

      if (_currentStep >= 3 && !g.MemberError)
      {
        var lockAmount = ParseMoney(g.AmountStr);
        var available = ParseMoney(g.AvailableCapitalStr);
        if (lockAmount > 0 && (available <= 0 || lockAmount > available))
          g.AmountError = true;
      }
    }

    var totalPayable = ReviewTotalPayable;
    var guaranteed = _guarantors.Sum(x => ParseMoney(x.AmountStr));
    var pct = (totalPayable > 0) ? (guaranteed / totalPayable * 100m) : 0m;

    _guarantorCoveragePercentText = totalPayable > 0
      ? pct.ToString("0.##", CultureInfo.InvariantCulture) + "%"
      : "-";

    _guarantorCoverageError = false;
    _guarantorCoverageErrorText = null;
    if (_currentStep >= 3 && !_ignoreGuarantorCoverage)
    {
      if (totalPayable > 0 && pct < 100m)
      {
        _guarantorCoverageError = true;
        _guarantorCoverageErrorText = $"درصد تضمین باید حداقل ۱۰۰٪ مبلغ کل وام (اصل + سود) باشد یا گزینه چشم‌پوشی را فعال کنید. مبلغ کل: {ToMoney(totalPayable)}";
      }
    }

    if (!showToasts) return;
    if (_memberError) Toasts.Warning("انتخاب عضو الزامی است");
    if (_step1HasActiveLoanBlock) Toasts.Warning("متقاضی دارای وام فعال است و امکان دریافت وام مجدد ندارد");
    if (_applicantAvailableError) Toasts.Warning("خالص سپرده آزاد متقاضی باید بیشتر از 0 ریال باشد");
    if (_approvedPrincipalError && !string.IsNullOrWhiteSpace(_approvedPrincipalErrorText)) Toasts.Warning(_approvedPrincipalErrorText);
    if (_principalError) Toasts.Warning("مبلغ وام معتبر نیست");
    if (_termError) Toasts.Warning("تعداد اقساط معتبر نیست");
    if (_disbursedError) Toasts.Warning("تاریخ الزامی است");
    if (_annualRateError) Toasts.Warning("نرخ سود معتبر وارد کنید");
    if (_penaltyRateError) Toasts.Warning("نرخ دیرکرد معتبر وارد کنید");
    if (_currentStep >= 3 && _guarantors.Count == 0) Toasts.Warning("حداقل یک ضامن وارد کنید");
    if (_currentStep >= 3)
    {
      var bad = _guarantors
        .Where(g => !g.MemberError)
        .Select(g => new { g.GuarantorMemberIdStr, Lock = ParseMoney(g.AmountStr), Av = ParseMoney(g.AvailableCapitalStr) })
        .FirstOrDefault(x => x.Lock > 0 && x.Av > 0 && x.Lock > x.Av);

      if (bad != null)
      {
        var name = GetMemberDisplayByCode(bad.GuarantorMemberIdStr);
        Toasts.Warning($"مبلغ بلوکه ضامن ({name}) بیشتر از سپرده آزاد او است");
      }
    }
    if (_currentStep >= 3 && _guarantorCoverageError && !string.IsNullOrWhiteSpace(_guarantorCoverageErrorText)) Toasts.Warning(_guarantorCoverageErrorText);
  }

  private string? _nextStepError;
  private string? _finalSubmitError;

  private bool CanProceedToNextStep()
  {
    Validate(showToasts: false);
    _nextStepError = null;
    
    // Check if we're in edit mode
    bool isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;
    
    if (_currentStep == 1)
    {
      if (_memberError) 
        _nextStepError = "لطفاً متقاضی را انتخاب کنید";
      else if (!isEditMode && _step1HasActiveLoanBlock) 
        _nextStepError = "متقاضی دارای وام فعال است و امکان دریافت وام مجدد ندارد";
      else if (!isEditMode && _applicantAvailableError) 
        _nextStepError = "خالص سپرده آزاد متقاضی باید بیشتر از 0 ریال باشد";
      else if (_loanFactorError) 
        _nextStepError = "ضریب وام معتبر نیست";
      else if (_approvedPrincipalError) 
        _nextStepError = _approvedPrincipalErrorText ?? "مبلغ وام مصوب معتبر نیست";
    }
    else if (_currentStep == 2)
    {
      if (_memberError) 
        _nextStepError = "لطفاً متقاضی را انتخاب کنید";
      else if (_principalError) 
        _nextStepError = "لطفاً مبلغ وام را به درستی وارد کنید";
      else if (_termError) 
        _nextStepError = "لطفاً تعداد اقساط را به درستی وارد کنید";
      else if (_disbursedError) 
        _nextStepError = "لطفاً تاریخ پرداخت را انتخاب کنید";
      else if (_annualRateError)
        _nextStepError = "نرخ سود معتبر وارد کنید";
      else if (_penaltyRateError)
        _nextStepError = "نرخ دیرکرد معتبر وارد کنید";
    }
    else if (_currentStep == 3)
    {
      if (_memberError) 
      {
        _nextStepError = "لطفاً متقاضی را انتخاب کنید";
      }
      else if (_guarantors.Count == 0) 
      {
        _nextStepError = "حداقل یک ضامن اضافه کنید";
      }
      else
      {
        var invalidGuarantor = _guarantors.FirstOrDefault(g => g.MemberError || g.AmountError);
        if (invalidGuarantor != null)
        {
          if (invalidGuarantor.MemberError)
            _nextStepError = "لطفاً اطلاعات ضامن را به درستی وارد کنید";
          else
          {
            var available = ParseMoney(invalidGuarantor.AvailableCapitalStr);
            var amount = ParseMoney(invalidGuarantor.AmountStr);
            if (amount > available)
            {
              var name = GetMemberDisplayByCode(invalidGuarantor.GuarantorMemberIdStr);
              _nextStepError = $"مبلغ بلوکه ضامن ({name}) بیشتر از سپرده آزاد او است";
            }
            else
              _nextStepError = "مبلغ تضمین ضامن معتبر نیست";
          }
        }
        else if (_guarantorCoverageError)
        {
          _nextStepError = _guarantorCoverageErrorText ?? "پوشش تضمین کافی نیست";
        }
      }
    }

    return string.IsNullOrEmpty(_nextStepError);
  }

  private bool CanSubmitFinal()
  {
    Validate(showToasts: false);
    
    // Check if we're in edit mode
    bool isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;

    _finalSubmitError = null;

    if (_memberError) _finalSubmitError = "لطفاً متقاضی را انتخاب کنید";
    else if (_principalError) _finalSubmitError = "لطفاً مبلغ وام را به درستی وارد کنید";
    else if (_termError) _finalSubmitError = "لطفاً تعداد اقساط را به درستی وارد کنید";
    else if (_disbursedError) _finalSubmitError = "لطفاً تاریخ پرداخت را انتخاب کنید";
    
    // For edit mode, only validate basic required fields
    if (isEditMode)
    {
      return _finalSubmitError == null;
    }
    
    if (_finalSubmitError != null) return false;

    // For new loans, apply all validations
    if (_guarantors.Count == 0) { _finalSubmitError = "حداقل یک ضامن وارد کنید"; return false; }
    if (_guarantors.Any(g => g.MemberError || g.AmountError)) { _finalSubmitError = "اطلاعات ضامنین کامل نیست"; return false; }
    if (_guarantorCoverageError && !_ignoreGuarantorCoverage) { _finalSubmitError = _guarantorCoverageErrorText ?? "پوشش تضمین کافی نیست"; return false; }
    return true;
  }

  private decimal ReviewPrincipal => ParseMoney(_principalStr);
  private decimal ReviewApprovedPrincipal => ParseMoney(_approvedPrincipalStr);
  private int ReviewTerm => ParseInt(_termMonthsStr);
  private decimal ReviewGuaranteed => _guarantors.Sum(x => ParseMoney(x.AmountStr));
  
  // Total payable amount (principal + interest)
  private decimal ReviewTotalPayable
  {
    get
    {
      var principal = ParseMoney(_principalStr);
      var emi = _scheduleRows.Count > 0 ? _scheduleRows.Sum(x => x.InterestAmount) : 0m;
      return principal + emi;
    }
  }

  private bool _ignoreGuarantorCoverage;
  private bool _guarantorCoverageError;
  private string? _guarantorCoverageErrorText;
  private string _guarantorCoveragePercentText = "-";

  private int? _pendingScrollToStep;
  private async Task OnNext()
  {
    if (_isSaving) return;
    
    // First validate and show any field-level errors
    Validate(showToasts: true);
    
    // Then check if we can proceed to next step
    if (!CanProceedToNextStep())
    {
      if (!string.IsNullOrEmpty(_nextStepError))
        Toasts.Warning(_nextStepError);
      else
        Toasts.Warning("امکان رفتن به مرحله بعد وجود ندارد. لطفاً اطلاعات را بررسی کنید.");
      return;
    }

    var isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;
    if (_currentStep == 3 && !isEditMode)
    {
      // Hard gate: before entering step 4, re-check guarantors against latest snapshot/locks
      var ok = await RefreshGuarantorsAndValidateAsync(showToasts: true);
      if (!ok)
      {
        _pendingScrollToStep = _currentStep;
        StateHasChanged();
        await Task.CompletedTask;
        return;
      }
    }

    if (_currentStep == 1)
    {
      var v = ParseMoney(_approvedPrincipalStr);
      if (v > 0)
      {
        _principalStr = ToMoney(Math.Round(v, 0, MidpointRounding.AwayFromZero));
        await LoadCurrentRateAndPreviewAsync();
      }

      if (!isEditMode)
      {
        try
        {
          _nextLoanNumberText = (await LoanService.GetNextLoanNumberAsync()).ToString(CultureInfo.InvariantCulture);
        }
        catch
        {
          _nextLoanNumberText = "-";
        }

        _manualEmiTouched = false;
        _manualEmiStr = null;
      }

      await RecalcScheduleAsync();
    }

    if (_currentStep < 4) _currentStep++;
    if (_currentStep == 2)
      await EnsureDefaultRatesLoadedAsync();
    _pendingScrollToStep = _currentStep;
    StateHasChanged();
    await Task.CompletedTask;
  }

  private Task OnLoanFactorInput(ChangeEventArgs e)
  {
    var raw = e.Value?.ToString() ?? "";
    var factor = ClampLoanFactorTo2Decimals(ParseDecimal(raw));

    if (_householdAvailableCapital <= 0)
    {
      _loanFactorStr = "0";
      _approvedPrincipalStr = "0";
      Validate(showToasts: false);
      StateHasChanged();
      return Task.CompletedTask;
    }

    // keep factor formatted as decimal with up to 2 decimals
    _loanFactorStr = factor.ToString("0.##", CultureInfo.InvariantCulture);

    var max = _householdAvailableCapital * 20m;
    var approved = Math.Round(_householdAvailableCapital * factor, 0, MidpointRounding.AwayFromZero);
    if (approved > max) approved = max;
    if (approved < 0) approved = 0;
    _approvedPrincipalStr = ToMoney(approved);

    Validate(showToasts: false);
    StateHasChanged();
    return Task.CompletedTask;
  }

  private Task OnApprovedPrincipalChanged(string? value)
  {
    var approved = ParseMoney(value);

    if (_householdAvailableCapital <= 0)
    {
      _approvedPrincipalStr = "0";
      _loanFactorStr = "0";
      Validate(showToasts: false);
      StateHasChanged();
      return Task.CompletedTask;
    }

    var max = _householdAvailableCapital * 20m;
    if (approved < 0) approved = 0;
    if (approved > max) approved = max;

    // Push the clamped value back to the input immediately
    _approvedPrincipalStr = ToMoney(approved);

    // sync factor from approved (0..3, up to 2 decimals, truncated)
    var factor = ClampLoanFactorTo2Decimals(approved / _householdAvailableCapital);
    _loanFactorStr = factor.ToString("0.##", CultureInfo.InvariantCulture);

    Validate(showToasts: false);
    StateHasChanged();
    return Task.CompletedTask;
  }

  private async Task OnPrev()
  {
    if (_isSaving) return;
    if (_currentStep > 1) _currentStep--;
    _pendingScrollToStep = _currentStep;
    StateHasChanged();
    await Task.CompletedTask;
  }

  private async Task Cancel()
  {
    if (_isSaving) return;
    await OnCancel.InvokeAsync();
  }

