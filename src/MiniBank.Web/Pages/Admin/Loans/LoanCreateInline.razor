  private static decimal ParseMoney(string? s)
  {
    if (string.IsNullOrWhiteSpace(s)) return 0m;
    // Keep only integer part if user types decimal separators to avoid accidental huge numbers.
    // Example: "2,070,991,377.0000" should be treated as 2,070,991,377 not 20,709,913,770,000,000.
    var chars = s.Trim();
    var digits = new List<char>(chars.Length);
    foreach (var ch in chars)
    {
      if (ch == '.' || ch == '/' || ch == '\\') break;
      if (char.IsDigit(ch)) digits.Add(ch);
    }
    var digitsStr = new string(digits.ToArray());
    if (string.IsNullOrEmpty(digitsStr)) return 0m;
    return decimal.TryParse(digitsStr, NumberStyles.None, CultureInfo.InvariantCulture, out var d) ? d : 0m;
  }

  private static int ParseInt(string? s)
    => int.TryParse(new string((s ?? string.Empty).Where(char.IsDigit).ToArray()), out var n) ? n : 0;

  private static string ToMoney(decimal v)
    => v.ToString("N0", CultureInfo.InvariantCulture);

  private static decimal ParseDecimal(string? s)
  {
    if (string.IsNullOrWhiteSpace(s)) return 0m;
    var t = s.Trim().Replace(",", ".");
    return decimal.TryParse(t, NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var n) ? n : 0m;
  }

  private static decimal ClampLoanFactorTo2Decimals(decimal factor)
  {
    if (factor < 0m) factor = 0m;
    if (factor > 20m) factor = 20m;
    // Truncate (NOT round) to avoid bumping tiny ratios (e.g. <1%) to 0.01
    return Math.Truncate(factor * 100m) / 100m;
  }

  private static decimal GetTotalPayable(Loan l)
  {
    if (l == null) return 0m;
    return l.EmiAmount > 0 && l.TermMonths > 0 ? (l.EmiAmount * l.TermMonths) : l.Principal;
  }

  private static decimal GetOutstandingWithInterest(Loan l)
  {
    if (l == null) return 0m;
    var totalPayable = l.EmiAmount > 0 && l.TermMonths > 0 ? (l.EmiAmount * l.TermMonths) : l.Principal;
    var totalInterest = totalPayable - l.Principal;
    if (totalInterest < 0) totalInterest = 0;
    return l.OutstandingPrincipal + totalInterest;
  }

  private static decimal GetTotalPayable(MiniBank.Web.Services.LoanService.GuaranteedLoanRow l)
  {
    if (l == null) return 0m;
    return l.EmiAmount > 0 && l.TermMonths > 0 ? (l.EmiAmount * l.TermMonths) : l.Principal;
  }

  private static decimal GetOutstandingWithInterest(MiniBank.Web.Services.LoanService.GuaranteedLoanRow l)
  {
    if (l == null) return 0m;
    var totalPayable = l.EmiAmount > 0 && l.TermMonths > 0 ? (l.EmiAmount * l.TermMonths) : l.Principal;
    var totalInterest = totalPayable - l.Principal;
    if (totalInterest < 0) totalInterest = 0;
    return l.OutstandingPrincipal + totalInterest;
  }

