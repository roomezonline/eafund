  private async Task EnsureDefaultRatesLoadedAsync()
  {
    try
    {
      var isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;
      if (isEditMode) return;
      if (_disbursedAt == default)
      {
        if (_disbursedAtTouched) return;
        _disbursedAt = DateTime.Today;
      }

      var needAnnual = !_annualRateTouched && (string.IsNullOrWhiteSpace(_currentAnnualRateText) || (_currentAnnualRateText ?? string.Empty).Trim() == "-");
      var needPenalty = !_penaltyRateTouched && (string.IsNullOrWhiteSpace(_currentPenaltyRateText) || (_currentPenaltyRateText ?? string.Empty).Trim() == "-");
      if (!needAnnual && !needPenalty) return;

      var plan = await LoanRateService.GetActiveForDateOrLatestAsync(_disbursedAt.Date);
      if (plan == null) return;

      if (needAnnual) _currentAnnualRateText = plan.AnnualRatePercent.ToString("0", CultureInfo.InvariantCulture);
      if (needPenalty) _currentPenaltyRateText = plan.PenaltyAnnualRatePercent.ToString("0", CultureInfo.InvariantCulture);

      await LoadCurrentRateAndPreviewAsync();
    }
    catch
    {
    }
  }

