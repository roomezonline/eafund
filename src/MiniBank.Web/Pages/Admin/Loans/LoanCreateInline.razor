@code {
  [Parameter] public EventCallback OnCancel { get; set; }
  [Parameter] public EventCallback OnSaved { get; set; }
  [Parameter] public long? EditLoanId { get; set; }

  private bool _isSaving;

  private int _currentStep = 1;
  private readonly List<string> _stepLabels = new() { "اعتبارسنجی", "تصویب مبلغ", "ضامنین", "تایید نهایی" };

  private List<DsDropdown.DsDropdownItem> _memberItems = new();
  private string? _memberCode;
  private readonly Dictionary<string, long> _memberIdByCode = new(StringComparer.OrdinalIgnoreCase);
  private readonly Dictionary<long, Member> _membersById = new();

  private readonly List<Loan> _activeLoans = new();
  private bool _activeLoansLoading;

  private readonly List<MiniBank.Web.Models.Reports.MemberBankingBalanceRow> _householdBalances = new();
  private bool _householdLoading;

  private readonly Dictionary<string, decimal> _householdLockedByCode = new(StringComparer.OrdinalIgnoreCase);

  private decimal _applicantAvailableCapital;
  private string _applicantAvailableCapitalStr = "0";
  private bool _applicantAvailableError;

  private decimal _householdAvailableCapital;
  private string _householdAvailableCapitalStr = "0";

  private readonly Dictionary<string, decimal> _editingLoanLockedByCode = new(StringComparer.OrdinalIgnoreCase);

  private string _loanFactorStr = "";
  private bool _loanFactorError;
  private string _approvedPrincipalStr = "0";

  private bool _approvedPrincipalError;
  private string? _approvedPrincipalErrorText;

  private string _nextLoanNumberText = "-";

  private string? _penaltyDailyAmountText = "0";

  private string? _manualEmiStr;
  private bool _manualEmiTouched;
  private bool _scheduleLoading;
  private string? _scheduleErrorText;
  private readonly List<LoanInstallment> _scheduleRows = new();

  private readonly List<MiniBank.Web.Services.LoanService.HouseholdLoanRiskRow> _householdRiskRows = new();
  private bool _householdRiskLoading;

  private string? _step1BlockMessage;

  private bool _step1HasActiveLoanBlock;

  private bool _showGuaranteedLoansSheet;
  private bool _guaranteedLoansLoading;
  private string _guaranteedLoansSheetTitle = "وام‌های ضمانت‌شده";
  private readonly List<MiniBank.Web.Services.LoanService.GuaranteedLoanRow> _guaranteedLoans = new();

  private string? _principalStr;
  private string _termMonthsStr = "";
  private DateTime _disbursedAt = DateTime.Today;
  private bool _disbursedAtTouched;

  private string? _currentAnnualRateText;
  private string? _currentPenaltyRateText;
  private string? _previewEmiText;

  private bool _annualRateTouched;
  private bool _penaltyRateTouched;

  private string? _notes;

  private string _creditCheckResult = "-";
  private string _creditCheckNotes = "-";

  private sealed class GuarantorRow
  {
    public string? GuarantorMemberIdStr { get; set; }
    public string LockPercentStr { get; set; } = "100";
    public string AmountStr { get; set; } = "0";
    public string NetPrincipalStr { get; set; } = "0";
    public string NetInterestStr { get; set; } = "0";
    public string ExistingLockedStr { get; set; } = "0";
    public string AvailableCapitalStr { get; set; } = "0";
    public bool IsApplicantSelfGuarantee { get; set; }
    public bool MemberError { get; set; }
    public bool AmountError { get; set; }
  }

  private readonly List<GuarantorRow> _guarantors = new();

  private string? _newGuarantorMemberCode;
  private bool _newGuarantorMemberError;
  private bool _newGuarantorAmountError;

  private string _newGuarantorLockPercentStr = "100";
  private string? _newGuarantorAmountStr = "0";

  private string _newGuarantorNetPrincipalStr = "0";
  private string _newGuarantorNetInterestStr = "0";
  private string _newGuarantorExistingLockedStr = "0";
  private string _newGuarantorAvailableCapitalStr = "0";

  private bool _memberError;
  private bool _principalError;
  private bool _termError;
  private bool _disbursedError;

  private bool _annualRateError;
  private bool _penaltyRateError;

  private string HeaderStepTitle => _currentStep switch
  {
    1 => "مرحله ۱ : اعتبارسنجی متقاضی",
    2 => "مرحله ۲ : تصویب مبلغ وام",
    3 => "مرحله ۳ : ضامنین",
    _ => "مرحله ۴ : بازبینی و تایید"
  };

  private string DisbursedAtString
  {
    get => _disbursedAt == default ? string.Empty : _disbursedAt.ToPersianDate();
    set
    {
      if (string.IsNullOrWhiteSpace(value))
      {
        _disbursedAt = default;
      }
      else
      {
        _disbursedAt = DateTimeExtensions.FromPersianDate(value);
      }
    }
  }

  private string? ManualEmiDisplay => _manualEmiTouched ? _manualEmiStr : _previewEmiText;
  private decimal EffectiveEmi => _manualEmiTouched ? ParseMoney(_manualEmiStr) : ParseMoney(_previewEmiText);

  protected override async Task OnInitializedAsync()
  {
    await Task.Delay(50);
    await InitJalaliPicker();
    await LoadMembersAsync();

    if (EditLoanId.HasValue && EditLoanId.Value > 0)
      await LoadLoanForEditAsync(EditLoanId.Value);

    await LoadCurrentRateAndPreviewAsync();
    await RunCreditCheckAsync();
  }

  private async Task LoadLoanForEditAsync(long loanId)
  {
    try
    {
      var loan = await LoanService.GetByIdAsync(loanId);
      if (loan == null)
      {
        Toasts.Warning("وام یافت نشد");
        return;
      }

      _memberCode = !string.IsNullOrWhiteSpace(loan.MemberCode) ? loan.MemberCode : _memberCode;
      _principalStr = ToMoney(loan.Principal);
      _approvedPrincipalStr = ToMoney(loan.Principal);
      _termMonthsStr = loan.TermMonths.ToString(CultureInfo.InvariantCulture);
      _disbursedAt = loan.DisbursedAt.Date;
      _notes = loan.Notes;
      _nextLoanNumberText = loan.LoanId.ToString(CultureInfo.InvariantCulture);

      _currentAnnualRateText = loan.AnnualRatePercent.ToString("0.##", CultureInfo.InvariantCulture);
      _currentPenaltyRateText = loan.PenaltyAnnualRatePercent.ToString("0.##", CultureInfo.InvariantCulture);

      _annualRateTouched = true;
      _penaltyRateTouched = true;

      _manualEmiTouched = loan.EmiAmount > 0;
      _manualEmiStr = loan.EmiAmount > 0 ? ToMoney(loan.EmiAmount) : null;

      _editingLoanLockedByCode.Clear();
      var holds = (await CreditHoldRepo.GetByLoanIdAsync(loanId)).ToList();
      foreach (var h in holds.Where(x => x.Status == CreditHoldStatus.Active && !string.IsNullOrWhiteSpace(x.MemberCode) && x.LockedAmount > 0))
      {
        var code = h.MemberCode!.Trim();
        if (string.IsNullOrWhiteSpace(code)) continue;
        if (_editingLoanLockedByCode.ContainsKey(code))
          _editingLoanLockedByCode[code] += h.LockedAmount;
        else
          _editingLoanLockedByCode[code] = h.LockedAmount;
      }

      await LoadMemberActiveLoansAsync();
      await LoadHouseholdBalancesAsync();

      if (_householdAvailableCapital > 0)
      {
        var approved = ParseMoney(_approvedPrincipalStr);
        if (approved > 0)
        {
          var factor = approved / _householdAvailableCapital;
          if (factor < 0) factor = 0;
          if (factor > 20m) factor = 20m;
          factor = Math.Round(factor, 2, MidpointRounding.AwayFromZero);
          _loanFactorStr = factor.ToString("0.##", CultureInfo.InvariantCulture);
        }
      }

      _guarantors.Clear();

      // Load applicant self-guarantee (if exists) as a visible row in step 3
      var applicantCodeForHold = (_memberCode ?? string.Empty).Trim();
      var selfHold = holds
        .Where(x => x.Status == CreditHoldStatus.Active && x.Role == CreditHoldRole.Applicant)
        .Where(x => !string.IsNullOrWhiteSpace(x.MemberCode))
        .FirstOrDefault(x => string.Equals(x.MemberCode!.Trim(), applicantCodeForHold, StringComparison.OrdinalIgnoreCase) && x.LockedAmount > 0);

      if (selfHold != null && !string.IsNullOrWhiteSpace(applicantCodeForHold) && !_guarantors.Any(x => string.Equals(x.GuarantorMemberIdStr, applicantCodeForHold, StringComparison.OrdinalIgnoreCase)))
      {
        var snap = await MemberFinancial.GetSnapshotByMemberCodeAsync(applicantCodeForHold);
        _snapshotsByMemberCode[applicantCodeForHold] = snap;

        var available = snap.AvailableCapital;
        if (_editingLoanLockedByCode.TryGetValue(applicantCodeForHold, out var lockedByThisLoan))
          available += lockedByThisLoan;
        if (available < 0) available = 0;

        var locked = snap.LockedAmount;
        if (_editingLoanLockedByCode.TryGetValue(applicantCodeForHold, out var lockedByThisLoan2))
          locked = locked - lockedByThisLoan2;
        if (locked < 0) locked = 0;

        _guarantors.Add(new GuarantorRow
        {
          GuarantorMemberIdStr = applicantCodeForHold,
          LockPercentStr = selfHold.LockPercent.ToString(CultureInfo.InvariantCulture),
          AmountStr = ToMoney(selfHold.LockedAmount),
          NetPrincipalStr = ToMoney(snap.NetPrincipal),
          NetInterestStr = ToMoney(snap.NetInterest),
          ExistingLockedStr = ToMoney(locked),
          AvailableCapitalStr = ToMoney(available),
          IsApplicantSelfGuarantee = true,
          MemberError = false,
          AmountError = false
        });
      }

      var guarantees = (await LoanService.GetGuaranteesAsync(loanId)).ToList();
      foreach (var g in guarantees.Where(x => x.Type == LoanGuaranteeType.GuarantorMember && !string.IsNullOrWhiteSpace(x.GuarantorMemberCode) && x.Amount > 0))
      {
        var code = g.GuarantorMemberCode!.Trim();
        if (string.IsNullOrWhiteSpace(code)) continue;

        var snap = await MemberFinancial.GetSnapshotByMemberCodeAsync(code);
        _snapshotsByMemberCode[code] = snap;
        var available = snap.AvailableCapital;
        if (_editingLoanLockedByCode.TryGetValue(code, out var lockedByThisLoan))
          available += lockedByThisLoan;
        if (available < 0) available = 0;

        var pct = (available > 0) ? (int)Math.Round((g.Amount / available) * 100m, 0, MidpointRounding.AwayFromZero) : 100;
        if (pct <= 0) pct = 1;
        if (pct > 100) pct = 100;

        _guarantors.Add(new GuarantorRow
        {
          GuarantorMemberIdStr = code,
          LockPercentStr = pct.ToString(CultureInfo.InvariantCulture),
          AmountStr = ToMoney(g.Amount),
          NetPrincipalStr = ToMoney(snap.NetPrincipal),
          NetInterestStr = ToMoney(snap.NetInterest),
          ExistingLockedStr = ToMoney(snap.LockedAmount),
          AvailableCapitalStr = ToMoney(available),
          MemberError = false,
          AmountError = false
        });
      }

      _currentStep = 1;
      _pendingScrollToStep = _currentStep;
      StateHasChanged();
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در بارگذاری وام برای ویرایش: {ex.Message}");
    }
  }

