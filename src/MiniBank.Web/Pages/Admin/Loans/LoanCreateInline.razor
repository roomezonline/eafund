@using System.Globalization
@using MiniBank.Web.Models
@using MiniBank.Web.Components.Extensions
@using MiniBank.Web.Components.DesignSystem
@inject MiniBank.Web.Services.LoanService LoanService
@inject MiniBank.Web.Services.MemberFinancialSnapshotService MemberFinancial
@inject MiniBank.Web.Services.LoanRateService LoanRateService
@inject MiniBank.Web.Services.LoanCalculatorService LoanCalculator
@inject MiniBank.Web.Infrastructure.Repositories.MemberRepository MemberRepo
@inject MiniBank.Web.Infrastructure.Repositories.AccountsRepository AccountsRepo
@inject MiniBank.Web.Infrastructure.Repositories.TransactionReportRepository TxReportRepo
@inject MiniBank.Web.Infrastructure.Repositories.CreditHoldRepository CreditHoldRepo
@inject MiniBank.Web.Components.DesignSystem.DsToastService Toasts
@inject IJSRuntime JS

<div class="loan-mje2-container">
  <div class="header-blue-bar">@(EditLoanId.HasValue && EditLoanId.Value > 0 ? "ویرایش وام" : "ایجاد وام")</div>
  <div class="header-yellow-bar-1">@HeaderStepTitle</div>
  <div class="form-section">

    <DsMultiStepForm CurrentStep="@_currentStep"
                     TotalSteps="4"
                     StepLabels="@_stepLabels"
                     CanProceedToNext="@CanProceedToNextStep()"
                     CanSubmit="@CanSubmitFinal()"
                     IsNavigationDisabled="true"
                     ShowNavigation="false"
                     OnStepChanged="OnStepChanged"
                     OnFinalSubmit="OnFinalSubmit">

      @if (_currentStep == 1)
      {
        <div id="loan-step-1-top"></div>
        <table class="form-table">
          <tr class="form-row">
            <td colspan="2" style="text-align:right">متقاضی</td>
          </tr>
          <tr class="form-row">
            <td colspan="2">
              <div class="applicant-dropdown">
                <DsDropdown Placeholder="-- انتخاب عضو --"
                            Items="@_memberItems"
                            Value="@_memberCode"
                            ValueChanged="OnMemberChanged"
                            Searchable="true"
                            SearchPlaceholder="جستجوی نام/کدملی..."
                            UseFixedMenu="true"
                            ErrorMessage="@(_memberError ? "انتخاب عضو الزامی است" : null)" />
              </div>
            </td>
          </tr>
        </table>

        @if (_activeLoansLoading)
        {
          <div class="loading-container" style="margin-top: 10px">در حال بررسی وام‌های فعال...</div>
        }
        else if (_activeLoans.Count > 0)
        {
          <div class="active-loans-container" style="margin-top: 10px">
            <div class="active-loans-header" style="margin-bottom: 10px; padding-bottom: 8px">
              <h2 style="font-size: 14px">وام‌های فعال متقاضی</h2>
            </div>

            <div class="active-loans-table-container">
              <div class="active-loans-table-scroll">
                <table class="active-loans-table">
                  <thead>
                    <tr>
                      <th>تاریخ</th>
                      <th>مبلغ وام</th>
                      <th>مانده</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var l in _activeLoans)
                    {
                      <tr>
                        <td>@l.DisbursedAt.ToPersianDate()</td>
                        <td class="amount-td">@ToMoney(GetTotalPayable(l))</td>
                        <td class="amount-td loan-outstanding-td">@ToMoney(GetOutstandingWithInterest(l))</td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        }

        @if (_householdLoading)
        {
          <div class="loading-container">در حال بارگذاری اطلاعات خانوار...</div>
        }
        else if (_householdBalances.Count > 0)
        {
          <div class="journal-history-container" style="margin-top: 12px">
            <div class="journal-history-header" style="margin-bottom: 10px; padding-bottom: 8px">
              <h2 style="font-size: 14px">سپرده خانوار</h2>
            </div>

            <div class="journals-table-container">
              <div class="journals-table-scroll">
                <table class="journals-table">
                  <thead>
                    <tr>
                      <th>تفصیلی</th>
                      <th>نام و نام خانوادگی</th>
                      <th>اصل سپرده</th>
                      <th>سود سپرده</th>
                      <th>رهن/مسدود</th>
                      <th>خالص در دسترس</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var r in _householdBalances.OrderBy(x => x.MemberId))
                    {
                      var code = string.IsNullOrWhiteSpace(r.BankAccountNumber) ? "" : r.BankAccountNumber;
                      var locked = (!string.IsNullOrWhiteSpace(code) && _householdLockedByCode.TryGetValue(code, out var la)) ? la : 0m;
                      var available = r.TotalBalance - locked;
                      if (available < 0) available = 0;
                      <tr>
                        <td>@(string.IsNullOrWhiteSpace(r.BankAccountNumber) ? "-" : r.BankAccountNumber)</td>
                        <td style="text-align:right">@r.MemberName</td>
                        <td class="amount-td">@ToMoney(r.PrincipalBalance)</td>
                        <td class="amount-td">@ToMoney(r.InterestBalance)</td>
                        <td class="amount-td">@ToMoney(locked)</td>
                        <td class="amount-td">@ToMoney(available)</td>
                      </tr>
                    }
                    <tr class="household-total-row">
                      <td></td>
                      <td style="text-align:right; font-weight:900">جمع کل سپرده خانوار</td>
                      <td class="amount-td">@ToMoney(_householdBalances.Sum(x => x.PrincipalBalance))</td>
                      <td class="amount-td">@ToMoney(_householdBalances.Sum(x => x.InterestBalance))</td>
                      <td class="amount-td">@ToMoney(_householdBalances.Sum(x => string.IsNullOrWhiteSpace(x.BankAccountNumber) ? 0m : (_householdLockedByCode.TryGetValue(x.BankAccountNumber, out var l) ? l : 0m)))</td>
                      <td class="amount-td">@ToMoney(_householdBalances.Sum(x => {
                        var code2 = x.BankAccountNumber;
                        var l2 = (!string.IsNullOrWhiteSpace(code2) && _householdLockedByCode.TryGetValue(code2, out var ll2)) ? ll2 : 0m;
                        var av2 = x.TotalBalance - l2;
                        return av2 < 0 ? 0m : av2;
                      }))</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          @if (_householdRiskLoading)
          {
            <div class="loading-container" style="margin-top: 10px">در حال اعتبارسنجی خانوار...</div>
          }
          else if (_householdRiskRows.Count > 0)
          {
            <div class="household-risk-container" style="margin-top: 10px">
              <div class="household-risk-header" style="margin-bottom: 10px; padding-bottom: 8px">
                <h2 style="font-size: 14px">اعتبارسنجی خانوار</h2>
              </div>

              <div class="household-risk-table-container">
                <div class="household-risk-table-scroll">
                  <table class="household-risk-table">
                    <thead>
                      <tr>
                        <th>تفصیلی</th>
                        <th>عضو</th>
                        <th>وام فعال</th>
                        <th>ضامن وام فعال</th>
                      </tr>
                    </thead>
                    <tbody>
                      @foreach (var r in _householdRiskRows)
                      {
                        var isApplicant = !string.IsNullOrWhiteSpace(_memberCode) && string.Equals(r.MemberCode, _memberCode, StringComparison.OrdinalIgnoreCase);
                        <tr class="@(isApplicant ? "household-risk-applicant" : null)">
                          <td>@(string.IsNullOrWhiteSpace(r.MemberCode) ? "-" : r.MemberCode)</td>
                          <td style="text-align:right">@r.MemberName</td>
                          <td>
                            @if (r.ActiveLoanCount > 0)
                            {
                              <span class="risk-badge risk-badge-danger">@r.ActiveLoanCount</span>
                            }
                            else
                            {
                              <span class="risk-badge risk-badge-success">ندارد</span>
                            }
                          </td>
                          <td>
                            @if (r.ActiveGuarantorCount > 0)
                            {
                              @if (isApplicant)
                              {
                                <button type="button" class="risk-cell-button" @onclick="() => OpenGuaranteedLoansAsync(r)">
                                  <span class="risk-badge risk-badge-warning">@r.ActiveGuarantorCount</span>
                                </button>
                              }
                              else
                              {
                                <span class="risk-badge risk-badge-warning">@r.ActiveGuarantorCount</span>
                              }
                            }
                            else
                            {
                              <span class="risk-badge risk-badge-muted">نیست</span>
                            }
                          </td>
                        </tr>
                      }
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_step1BlockMessage))
            {
              <div class="step1-block-message" style="margin-top: 10px">@_step1BlockMessage</div>
            }
          }
        }
        else if (!string.IsNullOrWhiteSpace(_memberCode) && !_memberError)
        {
          <div class="empty-container" style="margin-top: 10px">برای این خانوار اطلاعات سپرده‌ای یافت نشد</div>
        }

        @if (!string.IsNullOrWhiteSpace(_memberCode) && !_memberError)
        {
          @if (_step1HasActiveLoanBlock)
          {
            <div class="ds-msg ds-msg-danger">
              <i class="fa-solid fa-circle-xmark ds-msg-icon"></i>
              <span>متقاضی دارای وام فعال است و امکان ثبت وام جدید وجود ندارد</span>
            </div>
          }

          @if (_applicantAvailableError)
          {
            <div class="ds-msg ds-msg-warn">
              <i class="fa-solid fa-triangle-exclamation ds-msg-icon"></i>
              <span>خالص سپرده آزاد متقاضی باید بیشتر از ۰ باشد</span>
            </div>
          }

          @if (_approvedPrincipalError)
          {
            <div class="ds-msg ds-msg-warn">
              <i class="fa-solid fa-triangle-exclamation ds-msg-icon"></i>
              <span>@_approvedPrincipalErrorText</span>
            </div>
          }

          @if (!_step1HasActiveLoanBlock && !_applicantAvailableError)
          {
            <div class="ds-msg ds-msg-success" style="margin-top: 10px">
              <i class="fa-solid fa-circle-check ds-msg-icon"></i>
              <span>متقاضی شرایط دریافت وام را دارد</span>
            </div>
          }

          <div class="loan-factor-card">
            <div class="loan-factor-title">محاسبه مبلغ وام مصوب</div>

            <div class="loan-factor-grid">
              <div class="loan-factor-item">
                <div class="loan-factor-label">خالص سپرده آزاد متقاضی</div>
                <div class="loan-factor-value amount-td">@_applicantAvailableCapitalStr</div>
              </div>

              <div class="loan-factor-item">
                <div class="loan-factor-label">خالص سپرده آزاد خانوار</div>
                <div class="loan-factor-value amount-td">@_householdAvailableCapitalStr</div>
              </div>
            </div>

            <div class="loan-factor-input-row">
              <div class="loan-factor-input-col">
                <div class="loan-factor-label">ضریب</div>
                <input class="form-input center-text loan-factor-textbox" inputmode="numeric" value="@_loanFactorStr" @oninput="OnLoanFactorInput" />
                @if (_loanFactorError)
                {
                  <div class="field-error">ضریب معتبر نیست</div>
                }
              </div>

              <div class="loan-factor-input-col">
                <div class="loan-factor-label">مبلغ وام مصوب</div>
                <DsMoneyInput Value="@_approvedPrincipalStr"
                              ValueChanged="OnApprovedPrincipalChanged"
                              Class="center-text" />
                @if (_approvedPrincipalError)
                {
                  <div class="field-error">@_approvedPrincipalErrorText</div>
                }
              </div>
            </div>

          </div>
        }
      }
      else if (_currentStep == 2)
      {
        <div id="loan-step-2-top"></div>
        <div class="step2-container">
          <div class="step2-card-header">
            <div class="step2-card-title">
              <i class="fa-solid fa-sack-dollar"></i>
              <span>تصویب مبلغ وام</span>
            </div>
            <div class="step2-card-subtitle">مبلغ از مرحله قبل تعیین می‌شود و در این مرحله قابل تغییر نیست</div>
          </div>

          <div class="step2-grid">
            <div class="step2-field">
              <div class="step2-label">شماره وام</div>
              <input class="form-input center-text step2-loan-number" value="@_nextLoanNumberText" disabled />
            </div>

            <div class="step2-field">
              <div class="step2-label">مبلغ وام مصوب</div>
              <DsMoneyInput Value="@_principalStr" Disabled="true" Class="center-text step2-readonly" style="text-align: center;" />
              @if (_principalError)
              {
                <div class="field-error">مبلغ وام معتبر نیست</div>
              }
            </div>

            <div class="step2-field">
              <div class="step2-label">تعداد اقساط</div>
              <input class="form-input center-text step2-input" inputmode="numeric" pattern="[0-9]*" value="@_termMonthsStr" @oninput="OnTermMonthsInput" />
              @if (_termError)
              {
                <div class="field-error">تعداد اقساط معتبر نیست</div>
              }
            </div>

            <div class="step2-field">
              <div class="step2-label">تاریخ</div>
              <input class="form-input center-text step2-input" value="@DisbursedAtString" @onchange="OnDisbursedAtChanged" data-jdp="true" data-jdp-only-date="true" />
              @if (_disbursedError)
              {
                <div class="field-error">تاریخ الزامی است</div>
              }
            </div>

            <div class="step2-field">
              <div class="step2-label">نرخ سود (%)</div>
              <input class="form-input center-text step2-input" inputmode="decimal" value="@_currentAnnualRateText" @oninput="OnAnnualRateInput" />
            </div>

            <div class="step2-field">
              <div class="step2-label">نرخ دیرکرد (%)</div>
              <input class="form-input center-text step2-input" inputmode="decimal" value="@_currentPenaltyRateText" @oninput="OnPenaltyRateInput" />
            </div>

            <div class="step2-field">
              <div class="step2-label">مبلغ روزشمار جریمه </div>
              <input class="form-input center-text step2-readonly" value="@_penaltyDailyAmountText" disabled />
            </div>

            <div class="step2-field">
              <div class="step2-label">قسط تقریبی</div>
              <input class="form-input center-text step2-readonly" value="@_previewEmiText" disabled />
            </div>

            <div class="step2-field">
              <div class="step2-label">قسط ماهانه (قابل ویرایش)</div>
              <DsMoneyInput Value="@ManualEmiDisplay"
                            ValueChanged="OnManualEmiChanged"
                            Class="center-text step2-input" style="text-align: center;" />
              @if (!string.IsNullOrWhiteSpace(_scheduleErrorText))
              {
                <div class="field-error">@_scheduleErrorText</div>
              }
            </div>

            <div class="step2-field step2-field-wide">
              <div class="step2-label">یادداشت</div>
              <input class="form-input step2-input" @bind="_notes" />
            </div>
          </div>

          <div class="step2-schedule">
            @if (_scheduleLoading)
            {
              <div class="loading-container">در حال محاسبه جدول تقسیط...</div>
            }
            else if (_scheduleRows.Count > 0)
            {
              decimal cumPrincipal = 0m;
              decimal cumInterest = 0m;
              var totalPrincipal = _scheduleRows.Sum(x => x.PrincipalAmount);
              var totalInterest = _scheduleRows.Sum(x => x.InterestAmount);
              var totalEmi = _scheduleRows.Sum(x => x.EmiAmount);

              <div class="journals-table-scroll">
                <table class="journals-table">
                  <thead>
                    <tr>
                      <th>شماره قسط</th>
                      <th>تاریخ قسط</th>
                      <th>مانده وام (ابتدای ماه)</th>
                      <th>مبلغ قسط وام</th>
                      <th>مبلغ قسط سود</th>
                      <th>اقساط سود تجمیعی</th>
                      <th>مبلغ قسط اصل</th>
                      <th>اقساط اصل تجمیعی</th>
                      <th>مانده وام (انتهای ماه)</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var it in _scheduleRows)
                    {
                      cumPrincipal += it.PrincipalAmount;
                      cumInterest += it.InterestAmount;
                      <tr>
                        <td>@it.InstallmentNo</td>
                        <td>@it.DueDate.ToPersianDate()</td>
                        <td class="amount-td">@ToMoney(it.OpeningBalance)</td>
                        <td class="amount-td">@ToMoney(it.EmiAmount)</td>
                        <td class="amount-td">@ToMoney(it.InterestAmount)</td>
                        <td class="amount-td">@ToMoney(cumInterest)</td>
                        <td class="amount-td">@ToMoney(it.PrincipalAmount)</td>
                        <td class="amount-td">@ToMoney(cumPrincipal)</td>
                        <td class="amount-td">@ToMoney(it.ClosingBalance)</td>
                      </tr>
                    }

                    <tr>
                      <td colspan="3" style="text-align:right; font-weight:900">جمع</td>
                      <td class="amount-td">@ToMoney(totalEmi)</td>
                      <td class="amount-td">@ToMoney(totalInterest)</td>
                      <td class="amount-td">@ToMoney(totalInterest)</td>
                      <td class="amount-td">@ToMoney(totalPrincipal)</td>
                      <td class="amount-td">@ToMoney(totalPrincipal)</td>
                      <td class="amount-td">@ToMoney(0)</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            }
            else
            {
              <div class="empty-container">برای نمایش جدول تقسیط، تعداد اقساط و تاریخ را مشخص کنید</div>
            }
          </div>
        </div>
      }
      else if (_currentStep == 3)
      {
        <div id="loan-step-3-top"></div>

        <div class="step3-summary">
          <div class="step3-summary-title">خلاصه</div>
          <div class="step3-summary-grid">
            <div class="sum-item">
              <div class="sum-k">متقاضی</div>
              <div class="sum-v">@SelectedMemberDisplay</div>
            </div>
            <div class="sum-item">
              <div class="sum-k">شماره وام</div>
              <div class="sum-v">@_nextLoanNumberText</div>
            </div>
            <div class="sum-item">
              <div class="sum-k">کل مبلغ قابل ضمانت (اصل + سود)</div>
              <div class="sum-v amount-td">@ToMoney(ReviewTotalPayable)</div>
            </div>
            <div class="sum-item">
              <div class="sum-k">قسط مبنا</div>
              <div class="sum-v amount-td">@ToMoney(EffectiveEmi)</div>
            </div>
          </div>
        </div>

        <div class="guarantors-container">
          <div class="guarantor-add-card">
            <div class="guarantor-add-title">افزودن ضامن</div>

            <div class="guarantor-add-selector guarantor-dropdown">
              <DsDropdown Placeholder="-- انتخاب ضامن --"
                          Items="@_memberItems"
                          Value="@_newGuarantorMemberCode"
                          ValueChanged="OnNewGuarantorMemberChanged"
                          Searchable="true"
                          UseFixedMenu="true"
                          ErrorMessage="@(_newGuarantorMemberError ? "ضامن را انتخاب کنید" : null)" />
            </div>

            <div class="guarantor-summary">
              <table class="guarantor-summary-table">
                <thead>
                  <tr>
                    <th>خالص</th>
                    <th>مسدود</th>
                    <th>آزاد</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="amount-td">@ToMoney(ParseMoney(_newGuarantorNetPrincipalStr) + ParseMoney(_newGuarantorNetInterestStr))</td>
                    <td class="amount-td">@_newGuarantorExistingLockedStr</td>
                    <td class="amount-td">@_newGuarantorAvailableCapitalStr</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="guarantor-add-row"  style="align-items: flex-start;">
              <div class="guarantor-add-field">
                <div class="guarantor-field-label">درصد</div>
                <div class="percent-input-wrap">
                  <input class="form-input guarantor-percent-input" type="text"
                         inputmode="numeric" autocomplete="off"
                         value="@_newGuarantorLockPercentStr"
                         @oninput="OnNewGuarantorPercentInput" />
                  <span class="percent-suffix">%</span>
                </div>
              </div>

              <div class="guarantor-add-field" >
                <div class="guarantor-field-label">مبلغ بلوکه (ریال)</div>
                <DsMoneyInput Value="@_newGuarantorAmountStr"
                              ValueChanged="OnNewGuarantorAmountChanged"
                              ErrorMessage="@(_newGuarantorAmountError ? " " : null)"  style="height:36px; text-align:center"/>
              </div>

              <div class="guarantor-add-actions">
                <button type="button" class="btn-next" @onclick="AddGuarantorFromForm">افزودن</button>
              </div>
            </div>
          </div>

          <div class="guarantors-list-card">
            <div class="guarantors-list-title">لیست ضامنین</div>

            @if (_guarantors.Count == 0)
            {
              <div class="empty-container" style="margin-top: 8px">هنوز ضامنی اضافه نشده است</div>
            }
            else
            {
              <div class="guarantors-table-scroll">
                <table class="guarantors-table">
                  <thead>
                    <tr>
                      <th>ضامن</th>
                      <th>خالص</th>
                      <th>مسدود</th>
                      <th>آزاد</th>
                      <th>درصد</th>
                      <th>مبلغ بلوکه</th>
                      <th>پوشش از مبلغ وام</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    @for (var i = 0; i < _guarantors.Count; i++)
                    {
                      var idx = i;
                      var approvedForCoverage = ReviewTotalPayable;
                      var gAmount = ParseMoney(_guarantors[idx].AmountStr);
                      var gPct = (approvedForCoverage > 0) ? (gAmount / approvedForCoverage * 100m) : 0m;
                      var gNet = ParseMoney(_guarantors[idx].NetPrincipalStr) + ParseMoney(_guarantors[idx].NetInterestStr);
                      <tr>
                        <td>
                          @GetMemberDisplayByCode(_guarantors[idx].GuarantorMemberIdStr)
                          @if (_guarantors[idx].IsApplicantSelfGuarantee)
                          {
                            <span class="self-guarantee-badge">خودضمانت</span>
                          }
                        </td>
                        <td class="amount-td">@ToMoney(gNet)</td>
                        <td class="amount-td">@_guarantors[idx].ExistingLockedStr</td>
                        <td class="amount-td">@_guarantors[idx].AvailableCapitalStr</td>
                        <td class="amount-td">@_guarantors[idx].LockPercentStr</td>
                        <td class="amount-td">@_guarantors[idx].AmountStr</td>
                        <td class="amount-td">@(approvedForCoverage > 0 ? gPct.ToString("0.##", CultureInfo.InvariantCulture) + "%" : "-")</td>
                        <td>
                          <button type="button" class="history-delete-btn" @onclick="(() => RemoveGuarantor(idx))">حذف</button>
                        </td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>

              <div class="guarantors-total">
                <div >جمع تضمین:</div>
                <div class="amount-td">@ToMoney(_guarantors.Sum(x => ParseMoney(x.AmountStr)))</div>
              </div>

              <div class="guarantors-total" style="margin-top: 6px">
                <div>درصد تضمین نسبت به وام:</div>
                <div class="amount-td">@_guarantorCoveragePercentText</div>
              </div>

              <div style="margin-top: 8px; display:flex; align-items:center; gap:8px; justify-content:flex-start;color:#B30000">
                <input type="checkbox" id="ignoreCoverage" @bind="_ignoreGuarantorCoverage" />
