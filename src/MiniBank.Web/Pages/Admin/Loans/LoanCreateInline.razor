    _newGuarantorMemberError = false;
    await LoadNewGuarantorFinancialsAsync();

    if (!string.IsNullOrWhiteSpace(_newGuarantorMemberCode))
    {
      var av = ParseMoney(_newGuarantorAvailableCapitalStr);
      if (av <= 0)
      {
        Toasts.Warning("سپرده آزاد ضامن برای ضمانت کافی نیست");
        _newGuarantorMemberCode = null;
        _newGuarantorNetPrincipalStr = "0";
        _newGuarantorNetInterestStr = "0";
        _newGuarantorExistingLockedStr = "0";
        _newGuarantorAvailableCapitalStr = "0";
        _newGuarantorAmountStr = "0";
        _newGuarantorLockPercentStr = "100";
        StateHasChanged();
        return;
      }
    }

    await RecalcNewGuarantorLockedAmountAsync();
  }

  private Task OnNewGuarantorPercentInput(ChangeEventArgs e)
  {
    _newGuarantorLockPercentStr = e.Value?.ToString() ?? "";
    _ = RecalcNewGuarantorLockedAmountAsync();
    return Task.CompletedTask;
  }

  private async Task OnNewGuarantorAmountChanged(string? v)
  {
    _newGuarantorAmountStr = v ?? "0";
    await SyncNewGuarantorPercentFromAmountAsync();
  }

  private async Task LoadNewGuarantorFinancialsAsync()
  {
    if (string.IsNullOrWhiteSpace(_newGuarantorMemberCode))
    {
      _newGuarantorNetPrincipalStr = "0";
      _newGuarantorNetInterestStr = "0";
      _newGuarantorExistingLockedStr = "0";
      _newGuarantorAvailableCapitalStr = "0";
      _newGuarantorAmountStr = "0";
      StateHasChanged();
      return;
    }

    var code = _newGuarantorMemberCode.Trim();
    if (!_snapshotsByMemberCode.TryGetValue(code, out var snap))
    {
      snap = await MemberFinancial.GetSnapshotByMemberCodeAsync(code);
      _snapshotsByMemberCode[code] = snap;
    }

    var isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;
    var available = snap.AvailableCapital;
    if (isEditMode && _editingLoanLockedByCode.TryGetValue(code, out var lockedByThisLoan))
      available += lockedByThisLoan;
    if (available < 0) available = 0;

    var locked = snap.LockedAmount;
    if (isEditMode && _editingLoanLockedByCode.TryGetValue(code, out var lockedByThisLoan2))
      locked = locked - lockedByThisLoan2;
    if (locked < 0) locked = 0;

    _newGuarantorNetPrincipalStr = ToMoney(snap.NetPrincipal);
    _newGuarantorNetInterestStr = ToMoney(snap.NetInterest);
    _newGuarantorExistingLockedStr = ToMoney(locked);
    _newGuarantorAvailableCapitalStr = ToMoney(available);
    StateHasChanged();
  }

  private async Task RecalcNewGuarantorLockedAmountAsync()
  {
    try
    {
      if (string.IsNullOrWhiteSpace(_newGuarantorMemberCode))
      {
        _newGuarantorAmountStr = "0";
        return;
      }

      var code = _newGuarantorMemberCode.Trim();
      if (!_snapshotsByMemberCode.TryGetValue(code, out var snap)) snap = new MemberFinancialSnapshot { MemberCode = code };

      var isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;
      var available = snap.AvailableCapital;
      if (isEditMode && _editingLoanLockedByCode.TryGetValue(code, out var lockedByThisLoan))
        available += lockedByThisLoan;
      if (available < 0) available = 0;

      var pct = ParseInt(_newGuarantorLockPercentStr);
      if (pct <= 0) pct = 1;
      if (pct > 100) pct = 100;
      _newGuarantorLockPercentStr = pct.ToString(CultureInfo.InvariantCulture);

      var locked = Math.Round(available * pct / 100m, 0, MidpointRounding.AwayFromZero);
      _newGuarantorAmountStr = ToMoney(locked);
    }
    finally
    {
      await Task.Yield();
      StateHasChanged();
    }
  }

  private async Task SyncNewGuarantorPercentFromAmountAsync()
  {
    try
    {
      if (string.IsNullOrWhiteSpace(_newGuarantorMemberCode)) return;
      var code = _newGuarantorMemberCode.Trim();
      if (!_snapshotsByMemberCode.TryGetValue(code, out var snap)) snap = new MemberFinancialSnapshot { MemberCode = code };

      var isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;
      var available = snap.AvailableCapital;
      if (isEditMode && _editingLoanLockedByCode.TryGetValue(code, out var lockedByThisLoan))
        available += lockedByThisLoan;
      if (available <= 0)
      {
        _newGuarantorLockPercentStr = "0";
        _newGuarantorAmountStr = "0";
        return;
      }

      var amt = ParseMoney(_newGuarantorAmountStr);
      if (amt < 0) amt = 0;
      if (amt > available) amt = available;

      var pct = (int)Math.Round((amt / available) * 100m, 0, MidpointRounding.AwayFromZero);
      if (pct <= 0) pct = 1;
      if (pct > 100) pct = 100;
      _newGuarantorLockPercentStr = pct.ToString(CultureInfo.InvariantCulture);
      _newGuarantorAmountStr = ToMoney(Math.Round(amt, 0, MidpointRounding.AwayFromZero));
    }
    finally
    {
      await Task.Yield();
      StateHasChanged();
    }
  }

  private void AddGuarantorFromForm()
  {
    _newGuarantorMemberError = string.IsNullOrWhiteSpace(_newGuarantorMemberCode);
    _newGuarantorAmountError = ParseMoney(_newGuarantorAmountStr) <= 0;
    if (_newGuarantorMemberError || _newGuarantorAmountError)
    {
      StateHasChanged();
      return;
    }

    var code = _newGuarantorMemberCode!.Trim();

    if (_guarantors.Any(x => string.Equals(x.GuarantorMemberIdStr, code, StringComparison.OrdinalIgnoreCase)))
    {
      Toasts.Warning("این ضامن قبلاً اضافه شده است");
      return;
    }

    var row = new GuarantorRow
    {
      GuarantorMemberIdStr = code,
      LockPercentStr = _newGuarantorLockPercentStr,
      AmountStr = _newGuarantorAmountStr ?? "0",
      NetPrincipalStr = _newGuarantorNetPrincipalStr,
      NetInterestStr = _newGuarantorNetInterestStr,
      ExistingLockedStr = _newGuarantorExistingLockedStr,
      AvailableCapitalStr = _newGuarantorAvailableCapitalStr,
      MemberError = false,
      AmountError = false
    };

    _guarantors.Add(row);
    _newGuarantorMemberCode = null;
    _newGuarantorLockPercentStr = "100";
    _newGuarantorAmountStr = "0";
    _newGuarantorNetPrincipalStr = "0";
    _newGuarantorNetInterestStr = "0";
    _newGuarantorExistingLockedStr = "0";
    _newGuarantorAvailableCapitalStr = "0";
    _newGuarantorMemberError = false;
    _newGuarantorAmountError = false;
    StateHasChanged();
  }


  private async Task OnFinalSubmit()
  {
    if (_isSaving) return;

    Validate(showToasts: true);
    if (!CanSubmitFinal())
    {
      if (!string.IsNullOrWhiteSpace(_finalSubmitError))
        Toasts.Warning(_finalSubmitError);
      else
        Toasts.Warning("امکان تایید نهایی وجود ندارد. لطفاً اطلاعات را بررسی کنید.");
      return;
    }

    if (!await RefreshGuarantorsAndValidateAsync(showToasts: true))
    {
      StateHasChanged();
      return;
    }

    var principal = ParseMoney(_principalStr);
    var term = ParseInt(_termMonthsStr);
    var memberId = ResolveSelectedMemberId();

    var applicantCode = (_memberCode ?? string.Empty).Trim();

    var guarantees = _guarantors
      .Select(g => new LoanGuarantee
      {
        Type = LoanGuaranteeType.GuarantorMember,
        GuarantorMemberId = !string.IsNullOrWhiteSpace(g.GuarantorMemberIdStr) && _memberIdByCode.TryGetValue(g.GuarantorMemberIdStr, out var gid) ? gid : null,
        GuarantorMemberCode = g.GuarantorMemberIdStr,
        Amount = ParseMoney(g.AmountStr),
        IsActive = true
      })
      .ToList();

    _ = applicantCode; // keep for readability/debug

    _isSaving = true;
    try
    {
      var fixedEmi = EffectiveEmi > 0 ? EffectiveEmi : (decimal?)null;
      var annualOverride = ParseDecimal(_currentAnnualRateText);
      var penaltyOverride = ParseDecimal(_currentPenaltyRateText);
      decimal? annualRatePercentOverride = annualOverride >= 0m ? annualOverride : null;
      decimal? penaltyAnnualRatePercentOverride = (_currentPenaltyRateText ?? string.Empty).Trim() == string.Empty ? null : penaltyOverride;
      if (EditLoanId.HasValue && EditLoanId.Value > 0)
      {
        await LoanService.UpdateLoanWithScheduleAsync(
          EditLoanId.Value,
          _memberCode!,
          principal,
          term,
          _disbursedAt,
          fixedEmi,
          null,
          _notes,
          guarantees,
          _ignoreGuarantorCoverage,
          annualRatePercentOverride,
          penaltyAnnualRatePercentOverride);
      }
      else
      {
        await LoanService.CreateLoanWithScheduleAsync(
          _memberCode!,
          null,
          principal,
          term,
          _disbursedAt,
          fixedEmi,
          null,
          _notes,
          guarantees,
          _ignoreGuarantorCoverage,
          annualRatePercentOverride,
          penaltyAnnualRatePercentOverride);
      }
      await OnSaved.InvokeAsync();
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در ایجاد وام: {ex.Message}");
    }
    finally
    {
      _isSaving = false;
      StateHasChanged();
    }
  }
}
