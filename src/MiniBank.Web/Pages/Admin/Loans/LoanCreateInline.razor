  private int _scheduleCalcVersion;

  private async Task RecalcScheduleAsync()
  {
    var calcVersion = ++_scheduleCalcVersion;
    _scheduleRows.Clear();
    _scheduleErrorText = null;
    _penaltyDailyAmountText = "0";

    var p = ParseMoney(_principalStr);
    var n = ParseInt(_termMonthsStr);
    if (p <= 0 || n <= 0 || _disbursedAt == default)
    {
      StateHasChanged();
      return;
    }

    var annualOk = decimal.TryParse((_currentAnnualRateText ?? string.Empty).Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var annualRate) && annualRate >= 0;
    var penaltyOk = decimal.TryParse((_currentPenaltyRateText ?? string.Empty).Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var penaltyAnnualRate) && penaltyAnnualRate >= 0;

    if (!annualOk || !penaltyOk)
    {
      try
      {
        var plan = await LoanRateService.GetActiveForDateOrLatestAsync(_disbursedAt.Date);
        if (plan != null)
        {
          if (!annualOk)
          {
            _currentAnnualRateText = plan.AnnualRatePercent.ToString("0", CultureInfo.InvariantCulture);
            annualRate = plan.AnnualRatePercent;
            annualOk = annualRate >= 0;
          }

          if (!penaltyOk)
          {
            _currentPenaltyRateText = plan.PenaltyAnnualRatePercent.ToString("0", CultureInfo.InvariantCulture);
            penaltyAnnualRate = plan.PenaltyAnnualRatePercent;
            penaltyOk = penaltyAnnualRate >= 0;
          }
        }
      }
      catch
      {
      }

      if (!annualOk)
      {
        StateHasChanged();
        return;
      }
    }

    var firstDue = _disbursedAt.Date.AddPersianMonths(1);

    _scheduleLoading = true;
    StateHasChanged();
    var isLatest = false;
    try
    {
      var manualEmi = _manualEmiTouched ? ParseMoney(_manualEmiStr) : 0m;

      var standard = LoanCalculator.GenerateSchedule(0, p, n, firstDue, annualRate);
      var used = manualEmi > 0
        ? LoanCalculator.GenerateScheduleWithFixedEmi(0, p, n, firstDue, annualRate, manualEmi)
        : standard;

      isLatest = calcVersion == _scheduleCalcVersion;
      if (!isLatest)
        return;

      // Keep preview EMI always based on the standard amortization
      _previewEmiText = ToMoney(standard.emiAmount);

      _scheduleRows.AddRange(used.installments);

      if (_manualEmiTouched)
        _manualEmiStr = manualEmi > 0 ? ToMoney(manualEmi) : null;

      // Option B: penalty daily amount based on overdue installment amount (EMI) and penalty annual rate
      if (penaltyOk && penaltyAnnualRate > 0)
      {
        var emiForPenalty = _scheduleRows.Count > 0 ? _scheduleRows[0].EmiAmount : used.emiAmount;
        var daily = Math.Round((emiForPenalty * (penaltyAnnualRate / 100m) / 365m), 0, MidpointRounding.AwayFromZero);
        if (daily < 0) daily = 0;
        _penaltyDailyAmountText = ToMoney(daily);
      }
    }
    catch (Exception ex)
    {
      if (calcVersion == _scheduleCalcVersion)
        _scheduleErrorText = ex.Message;
    }
    finally
    {
      if (calcVersion == _scheduleCalcVersion)
      {
        _scheduleLoading = false;
        StateHasChanged();
      }
      await Task.CompletedTask;
    }
  }

