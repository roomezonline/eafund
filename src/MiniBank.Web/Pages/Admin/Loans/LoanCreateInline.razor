  private void RemoveGuarantor(int index)
  {
    if (index < 0 || index >= _guarantors.Count) return;
    _guarantors.RemoveAt(index);
    StateHasChanged();
  }

  private async Task<bool> RefreshGuarantorsAndValidateAsync(bool showToasts)
  {
    try
    {
      if (_guarantors.Count == 0) return true;

      var isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;

      var applicantCode = (_memberCode ?? string.Empty).Trim();

      var codes = _guarantors
        .Select(g => g.GuarantorMemberIdStr)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Select(c => c!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

      if (codes.Count == 0) return true;

      var snaps = await MemberFinancial.GetSnapshotsByMemberCodesAsync(codes);
      foreach (var kv in snaps)
        _snapshotsByMemberCode[kv.Key] = kv.Value;

      foreach (var g in _guarantors)
      {
        var code = (g.GuarantorMemberIdStr ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(code)) continue;
        if (!snaps.TryGetValue(code, out var snap)) continue;

        var available = snap.AvailableCapital;
        if (isEditMode && _editingLoanLockedByCode.TryGetValue(code, out var lockedByThisLoan))
          available += lockedByThisLoan;
        if (available < 0) available = 0;

        g.NetPrincipalStr = ToMoney(snap.NetPrincipal);
        g.NetInterestStr = ToMoney(snap.NetInterest);
        var locked = snap.LockedAmount;
        if (isEditMode && _editingLoanLockedByCode.TryGetValue(code, out var lockedByThisLoan2))
          locked = locked - lockedByThisLoan2;
        if (locked < 0) locked = 0;
        g.ExistingLockedStr = ToMoney(locked);
        g.AvailableCapitalStr = ToMoney(available);

        // Same safety check as LoanService: existing locked + new lock must not exceed total net.
        // In edit mode we exclude locks created by the loan being edited.
        var lockAmount = ParseMoney(g.AmountStr);
        if (lockAmount > 0 && (locked + lockAmount) > snap.TotalNet)
          g.AmountError = true;
      }

      // Block submit with a clear message
      var bad = _guarantors
        .Where(g => !g.MemberError)
        .Select(g => new
        {
          g.GuarantorMemberIdStr,
          Lock = ParseMoney(g.AmountStr),
          Av = ParseMoney(g.AvailableCapitalStr),
          NetTotal = ParseMoney(g.NetPrincipalStr) + ParseMoney(g.NetInterestStr),
          ExistingLocked = ParseMoney(g.ExistingLockedStr)
        })
        // Self-guarantee is validated as applicant lock in service; do not block as guarantor here
        .Where(x => string.IsNullOrWhiteSpace(applicantCode)
          || string.IsNullOrWhiteSpace(x.GuarantorMemberIdStr)
          || !string.Equals(x.GuarantorMemberIdStr.Trim(), applicantCode, StringComparison.OrdinalIgnoreCase))
        .FirstOrDefault(x => x.Lock > 0 && (x.ExistingLocked + x.Lock) > x.NetTotal);

      if (bad != null)
      {
        if (showToasts)
        {
          var name = GetMemberDisplayByCode(bad.GuarantorMemberIdStr);
          Toasts.Warning($"اعتبار آزاد ضامن ({name}) برای قفل شدن کافی نیست — خالص: {ToMoney(bad.NetTotal)} | مسدود فعلی: {ToMoney(bad.ExistingLocked)} | مبلغ جدید: {ToMoney(bad.Lock)}");
        }
        return false;
      }

      return true;
    }
    catch (Exception ex)
    {
      if (showToasts)
        Toasts.Error($"خطا در بروزرسانی اطلاعات ضامنین: {ex.Message}");
      return false;
    }
  }

  private readonly Dictionary<string, MemberFinancialSnapshot> _snapshotsByMemberCode = new(StringComparer.OrdinalIgnoreCase);

  private string GetMemberDisplayByCode(string? code)
  {
    if (string.IsNullOrWhiteSpace(code)) return "-";
    var item = _memberItems.FirstOrDefault(x => x.Value == code);
    return !string.IsNullOrWhiteSpace(item?.Text) ? item!.Text : code;
  }

  private async Task OnNewGuarantorMemberChanged(string? v)
  {
