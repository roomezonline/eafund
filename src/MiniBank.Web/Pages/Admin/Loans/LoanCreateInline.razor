              <div class="review-kv">
                <div class="k">نرخ سود</div>
                <div class="v">@(!string.IsNullOrWhiteSpace(_currentAnnualRateText) && _currentAnnualRateText.Contains('%') ? _currentAnnualRateText : (_currentAnnualRateText + "%"))</div>
              </div>
              <div class="review-kv">
                <div class="k">نرخ دیرکرد</div>
                <div class="v">@(!string.IsNullOrWhiteSpace(_currentPenaltyRateText) && _currentPenaltyRateText.Contains('%') ? _currentPenaltyRateText : (_currentPenaltyRateText + "%"))</div>
              </div>
              <div class="review-kv">
                <div class="k">قسط مبنا</div>
                <div class="v amount-td"><span class="money-inline" style=" direction: rtl;"><span class="money-num" dir="ltr">@ToMoney(EffectiveEmi)</span><span class="money-cur" dir="rtl">&nbsp;ریال</span></span></div>
              </div>
              <div class="review-kv">
                <div class="k">مبلغ روزشمار جریمه</div>
                <div class="v amount-td"><span class="money-inline" style=" direction: rtl;"><span class="money-num" dir="ltr">@_penaltyDailyAmountText</span><span class="money-cur" dir="rtl">&nbsp;ریال</span></span></div>
              </div>
            </div>

            <div class="review-card review-card-wide review-card-guarantors">
              <div class="review-card-title">ضامنین و پوشش تضمین</div>

              <div class="review-metrics">
                <div class="metric">
                  <div class="metric-label">تعداد ضامن</div>
                  <div class="metric-value">@_guarantors.Count</div>
                </div>
                <div class="metric">
                  <div class="metric-label">جمع تضمین</div>
                  <div class="metric-value amount-td"><span class="money-inline" style="direction: rtl;"><span class="money-num" dir="ltr">@ToMoney(ReviewGuaranteed)</span><span class="money-cur" dir="rtl"></span></span></div>
                </div>
                <div class="metric">
                  <div class="metric-label">درصد تضمین</div>
                  <div class="metric-value">@(!string.IsNullOrWhiteSpace(_guarantorCoveragePercentText) && _guarantorCoveragePercentText.Contains('%') ? _guarantorCoveragePercentText : (_guarantorCoveragePercentText + "%"))</div>
                </div>
                <div class="metric">
                  <div class="metric-label">چشم‌پوشی</div>
                  <div class="metric-value">@(_ignoreGuarantorCoverage ? "فعال" : "غیرفعال")</div>
                </div>
              </div>

              @if (_guarantors.Count > 0)
              {
                <div class="review-table-scroll">
                  <table class="review-table">
                    <thead>
                      <tr>
                        <th>ضامن</th>
                        <th> بلوکه</th>
                        <th>درصد پوشش </th>
                      </tr>
                    </thead>
                    <tbody>
                      @for (var i = 0; i < _guarantors.Count; i++)
                      {
                        var approvedForCoverage = ReviewTotalPayable;
                        var gAmount = ParseMoney(_guarantors[i].AmountStr);
                        var gPct = (approvedForCoverage > 0) ? (gAmount / approvedForCoverage * 100m) : 0m;
                        <tr>
                          <td style="text-align:right">@GetMemberDisplayByCode(_guarantors[i].GuarantorMemberIdStr)</td>
                          <td class="amount-td">@(_guarantors[i].LockPercentStr + "%")</td>
                          <td class="amount-td">@(approvedForCoverage > 0 ? gPct.ToString("0.##", CultureInfo.InvariantCulture) + "%" : "-")</td>
                        </tr>
                      }
                    </tbody>
                  </table>
                </div>
              }
              else
              {
                <div class="empty-container" style="margin-top: 8px">ضامنی ثبت نشده است</div>
              }
            </div>

            <div class="review-card review-card-wide review-card-notes">
              <div class="review-card-title">یادداشت</div>
              <div class="review-notes">@(!string.IsNullOrWhiteSpace(_notes) ? _notes : "-")</div>
            </div>
          </div>
        </div>
      }

    </DsMultiStepForm>

    <div class="action-buttons">
      <div class="action-buttons-top">
        @if (_currentStep > 1)
        {
          <button type="button" class="btn-cancel" @onclick="OnPrev" disabled="@_isSaving">مرحله قبل</button>
        }

        @if (_currentStep < 4)
      {
        <button type="button" class="btn-next" @onclick="OnNext" disabled="@_isSaving">مرحله بعد</button>
      }
      else
      {
        <button type="button" class="btn-edit" @onclick="OnFinalSubmit" disabled="@_isSaving">@(EditLoanId.HasValue && EditLoanId.Value > 0 ? "ویرایش و تایید نهایی" : "تایید نهایی")</button>
      }
      </div>

      <button type="button" class="btn-delete" @onclick="Cancel" disabled="@_isSaving">انصراف</button>
    </div>

  </div>
</div>

