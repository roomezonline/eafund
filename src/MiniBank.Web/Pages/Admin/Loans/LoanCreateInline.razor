  private async Task LoadHouseholdBalancesAsync()
  {
    _householdBalances.Clear();
    _householdRiskRows.Clear();
    _householdLockedByCode.Clear();
    _step1BlockMessage = null;

    _applicantAvailableCapital = 0m;
    _applicantAvailableCapitalStr = "0";
    _householdAvailableCapital = 0m;
    _householdAvailableCapitalStr = "0";
    var isEditMode = EditLoanId.HasValue && EditLoanId.Value > 0;
    if (!isEditMode)
      _approvedPrincipalStr = "0";

    var memberId = ResolveSelectedMemberId();
    if (memberId <= 0)
    {
      StateHasChanged();
      return;
    }

    if (!_membersById.TryGetValue(memberId, out var member) || string.IsNullOrWhiteSpace(member.HouseholdCode))
    {
      StateHasChanged();
      return;
    }

    _householdLoading = true;
    _householdRiskLoading = false;
    StateHasChanged();

    try
    {
      var rows = (await TxReportRepo.GetHouseholdMemberBankingBalancesAsync(member.HouseholdCode)).ToList();
      _householdBalances.AddRange(rows);

      var codes = _householdBalances
        .Select(x => x.BankAccountNumber)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Select(x => x!)
        .ToList();

      // Preload member snapshots (net principal/interest + locked/available) for reuse in guarantor steps
      var snaps = await MemberFinancial.GetSnapshotsByMemberCodesAsync(codes);
      foreach (var kv in snaps)
        _snapshotsByMemberCode[kv.Key] = kv.Value;

      var lockedMap = await CreditHoldRepo.SumActiveLockedAmountByMemberCodesAsync(codes);
      foreach (var kv in lockedMap)
        _householdLockedByCode[kv.Key] = kv.Value;

      if (isEditMode)
      {
        foreach (var kv in _editingLoanLockedByCode)
        {
          if (!_householdLockedByCode.TryGetValue(kv.Key, out var l)) continue;
          var nl = l - kv.Value;
          _householdLockedByCode[kv.Key] = nl < 0 ? 0m : nl;
        }
      }

      _householdAvailableCapital = _householdBalances.Sum(x =>
      {
        var code = x.BankAccountNumber;
        var locked = (!string.IsNullOrWhiteSpace(code) && _householdLockedByCode.TryGetValue(code, out var l)) ? l : 0m;
        var av = x.TotalBalance - locked;
        return av < 0 ? 0m : av;
      });
      _householdAvailableCapitalStr = ToMoney(_householdAvailableCapital);

      if (!string.IsNullOrWhiteSpace(_memberCode))
      {
        _applicantAvailableCapital = await LoanService.GetMemberAvailableCapitalByCodeAsync(_memberCode);
        if (isEditMode && _editingLoanLockedByCode.TryGetValue(_memberCode, out var lockedByThisLoan))
          _applicantAvailableCapital += lockedByThisLoan;
        if (_applicantAvailableCapital < 0) _applicantAvailableCapital = 0;
        _applicantAvailableCapitalStr = ToMoney(_applicantAvailableCapital);
      }

      var factor = ParseDecimal(_loanFactorStr);
      if (factor > 0 && _householdAvailableCapital > 0)
      {
        var max = _householdAvailableCapital * 20m;
        var v = Math.Round(_householdAvailableCapital * factor, 0, MidpointRounding.AwayFromZero);
        if (v > max) v = max;
        _approvedPrincipalStr = ToMoney(v);
      }

      _householdRiskLoading = true;
      StateHasChanged();
      var risk = await LoanService.GetHouseholdLoanRiskAsync(member.HouseholdCode);
      _householdRiskRows.AddRange(risk);

      _step1BlockMessage = null;
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در بارگذاری اطلاعات خانوار: {ex.Message}");
    }
    finally
    {
      _householdLoading = false;
      _householdRiskLoading = false;
      StateHasChanged();
    }
  }

