  private async Task OpenPrepayConfirmAsync(long loanId)
  {
    _showPrepayConfirm = true;
    _prepayLoading = true;
    _prepayLoanId = loanId;
    _prepayLoan = _items.FirstOrDefault(x => x.LoanId == loanId) ?? _all.FirstOrDefault(x => x.LoanId == loanId);
    _prepayAmountText = string.Empty;
    _prepayAmountError = string.Empty;
    _prepayRemainingPrincipal = 0m;
    _prepayCurrentInstallmentInterest = 0m;
    _prepayWaivedInterest = 0m;
    _prepayOverduePenalty = 0m;
    _prepayMemberFinancialLoading = false;
    _prepayMemberNetPrincipal = 0m;
    _prepayMemberTotalNet = 0m;
    _prepayMemberLocked = 0m;
    _prepayMemberAvailable = 0m;
    _prepayMemberFinancialLoaded = false;
    _prepayMemberLockedSameLoan = 0m;
    _prepayMemberLockedItems = new();
    StateHasChanged();

    try
    {
      await EnsureInstallmentsLoadedAsync(loanId);
      _installments.TryGetValue(loanId, out var inst);
      var list = (inst ?? new List<LoanInstallment>()).OrderBy(x => x.InstallmentNo).ToList();

      var remainingPrincipal = list.Sum(x => Math.Max(0m, x.PrincipalAmount - x.PaidPrincipal));
      var remainingInterest = list.Sum(x => Math.Max(0m, x.InterestAmount - x.PaidInterest));

      var totalInstallments = list.Count;
      var paidInstallments = list.Count(x => x.Status == LoanInstallmentStatus.Paid);
      _prepayPaidInstallments = paidInstallments;
      _prepayRemainingInstallments = Math.Max(0, totalInstallments - paidInstallments);

      var today = DateTime.Today;
      var pc = new PersianCalendar();
      var currentPy = pc.GetYear(today);
      var currentPm = pc.GetMonth(today);
      var dueInterest = list
        .Where(i => {
          var iy = pc.GetYear(i.DueDate);
          var im = pc.GetMonth(i.DueDate);
          return iy < currentPy || (iy == currentPy && im <= currentPm);
        })
        .Sum(i => Math.Max(0m, i.InterestAmount - i.PaidInterest));

      var penaltyDailyRate = (_prepayLoan.PenaltyAnnualRatePercent / 100m) / 365m;
      var penalty = 0m;
      foreach (var it in list)
      {
        var remP = Math.Max(0m, it.PrincipalAmount - it.PaidPrincipal);
        var remI = Math.Max(0m, it.InterestAmount - it.PaidInterest);
        var remainingBase = remP + remI;
        if (remainingBase <= 0m) continue;
        var due = it.DueDate.Date;
        if (due >= today) continue;
        var overdueDays = Math.Max(0, (today - due).Days);
        if (overdueDays <= 0) continue;
        penalty += remainingBase * penaltyDailyRate * overdueDays;
      }

      _prepayRemainingPrincipal = remainingPrincipal;
      _prepayCurrentInstallmentInterest = dueInterest;
      _prepayOverduePenalty = penalty;
      _prepayWaivedInterest = Math.Max(0m, remainingInterest - dueInterest);

      var suggested = remainingPrincipal + dueInterest;
      _prepayAmountText = ToMoney(suggested);
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در آماده‌سازی تسویه: {ex.Message}");
      _showPrepayConfirm = false;
    }
    finally
    {
      _prepayLoading = false;
      StateHasChanged();
    }
  }

  private void ClosePrepayConfirm()
  {
    if (_prepayLoading) return;
    _showPrepayConfirm = false;
    _prepayLoading = false;
    _prepayLoanId = 0;
    _prepayLoan = null;
    _prepayAmountText = string.Empty;
    _prepayAmountError = string.Empty;
    _prepayRemainingPrincipal = 0m;
    _prepayCurrentInstallmentInterest = 0m;
    _prepayWaivedInterest = 0m;
    _prepayPaidInstallments = 0;
    _prepayRemainingInstallments = 0;
    _prepayPreview = null;
    _prepayPaymentMethod = "cash";
    _showPrepayPostConfirm = false;
    _prepayPostConfirmMessage = string.Empty;
    _showPrepayConfirmHidden = false;
    _prepayMemberFinancialLoading = false;
    _prepayMemberTotalNet = 0m;
    _prepayMemberLocked = 0m;
    _prepayMemberAvailable = 0m;
    _prepayMemberFinancialLoaded = false;
    _prepayMemberLockedSameLoan = 0m;
    _prepayMemberLockedItems = new();
    StateHasChanged();
  }

  private async Task LoadPrepayMemberFinancialAsync()
  {
    if (_prepayLoan == null) return;
    if (_prepayMemberFinancialLoading) return;

    _prepayMemberFinancialLoading = true;
    StateHasChanged();
    try
    {
      var snap = await LoanService.GetMemberFinancialSnapshotByMemberIdAsync(_prepayLoan.MemberId);
      _prepayMemberNetPrincipal = snap.NetPrincipal;
      _prepayMemberTotalNet = snap.TotalNet;
      _prepayMemberLocked = snap.LockedAmount;
      _prepayMemberLockedItems = snap.LockedItems ?? new();
      _prepayMemberLockedSameLoan = _prepayMemberLockedItems
        .Where(x => x.LoanId == _prepayLoanId)
        .Sum(x => x.LockedAmount);
      var effectiveLocked = _prepayMemberLocked - _prepayMemberLockedSameLoan;
      if (effectiveLocked < 0) effectiveLocked = 0;
      var effectiveAvailable = _prepayMemberTotalNet - effectiveLocked;
      _prepayMemberAvailable = effectiveAvailable < 0 ? 0 : effectiveAvailable;
      _prepayMemberFinancialLoaded = true;
    }
    catch
    {
      _prepayMemberNetPrincipal = 0m;
      _prepayMemberTotalNet = 0m;
      _prepayMemberLocked = 0m;
      _prepayMemberAvailable = 0m;
      _prepayMemberFinancialLoaded = false;
      _prepayMemberLockedSameLoan = 0m;
      _prepayMemberLockedItems = new();
      throw;
    }
    finally
    {
      _prepayMemberFinancialLoading = false;
      StateHasChanged();
    }
  }

  private async Task OnPrepayPaymentMethodChanged(ChangeEventArgs e)
  {
    var v = e.Value?.ToString() ?? "cash";
    _prepayPaymentMethod = v == "member" ? "member" : "cash";
    _prepayPreview = null;
    _prepayAmountError = string.Empty;
    _showPrepayPostConfirm = false;
    _prepayPostConfirmMessage = string.Empty;
    _showPrepayConfirmHidden = false;
    if (_prepayPaymentMethod == "member")
    {
      try { await LoadPrepayMemberFinancialAsync(); }
      catch (Exception ex) { _prepayAmountError = ex.Message; }
    }
    StateHasChanged();
  }

  private Task OnCancelPrepayPost()
  {
    _showPrepayPostConfirm = false;
    _showPrepayConfirmHidden = false;
    StateHasChanged();
    return Task.CompletedTask;
  }

  private async Task OnConfirmPrepayPostAsync()
  {
    if (_prepayLoanId <= 0 || _prepayPreview == null)
    {
      _showPrepayPostConfirm = false;
      StateHasChanged();
      return;
    }

    _showPrepayPostConfirm = false;
    _prepayLoading = true;
    StateHasChanged();

    try
    {
      var raw = (_prepayAmountText ?? string.Empty).Replace(",", string.Empty).Trim();
      decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount);

      if (_prepayPaymentMethod == "member")
      {
        if (!_prepayMemberFinancialLoaded && !_prepayMemberFinancialLoading)
        {
          try { await LoadPrepayMemberFinancialAsync(); }
          catch (Exception ex)
          {
            Toasts.Error(ex.Message);
            _prepayLoading = false;
            StateHasChanged();
            return;
          }
        }
        var available = _prepayMemberAvailable < 0 ? 0 : _prepayMemberAvailable;
        if (available < amount)
        {
          Toasts.Error("موجودی قابل برداشت عضو کافی نیست (با لحاظ مبالغ بلوکه‌شده)");
          _prepayLoading = false;
          StateHasChanged();
          return;
        }
      }

      var jid = await LoanService.PostPrepayJournalAsync(_prepayLoanId, amount, _prepayPaymentMethod, null, "admin");
      Toasts.Success($"سند تسویه ثبت شد (#{jid})");
      ClosePrepayConfirm();
      _installments.Remove(_prepayLoanId);
      _installmentsLoading.Remove(_prepayLoanId);
      _installmentJournalRefs.Remove(_prepayLoanId);
      _waivedPenaltySums.Remove(_prepayLoanId);
      await LoadAsync();
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در ثبت سند تسویه: {ex.Message}");
      _prepayLoading = false;
      _showPrepayConfirmHidden = false;
      StateHasChanged();
    }
  }

  private void OnPrepayAmountInput(ChangeEventArgs e)
