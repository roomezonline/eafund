@page "/admin/loans"
@using MiniBank.Web.Models
@using MiniBank.Web.Components.Extensions
@using System.Globalization
@using System.Threading
@using Microsoft.AspNetCore.Components.Web
@using MiniBank.Web.Pages.Admin.Loans
@inject MiniBank.Web.Services.LoanService LoanService
@inject MiniBank.Web.Services.LoanRateService LoanRateService
@inject MiniBank.Web.Infrastructure.Repositories.MemberRepository MemberRepo
@inject MiniBank.Web.Infrastructure.Repositories.CreditHoldRepository CreditHoldRepo
@inject MiniBank.Web.Components.DesignSystem.DsToastService Toasts
@inject MiniBank.Web.Services.FiscalYearRangeProvider FiscalRange
@using MiniBank.Web.Components.DesignSystem

<style>
  .prepay-modal {
    max-width: 620px;
    width: min(620px, calc(100vw - 28px));
  }

  .prepay-header-sub {
    font-size: 12px;
    font-weight: 700;
    color: rgba(255,255,255,.82);
    margin-top: 2px;
  }

  .prepay-kv {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 12px;
  }

  .prepay-kv-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 12px;
  }

  .prepay-kv-label {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: #334155;
    font-weight: 800;
    font-size: 13px;
  }

  .prepay-kv-dots {
    flex: 1;
    height: 1px;
    border-bottom: 1px dashed #cbd5e1;
    opacity: .9;
  }

  .prepay-kv-value {
    font-weight: 900;
    font-size: 13px;
    color: #0f172a;
    direction: ltr;
    text-align: left;
    white-space: nowrap;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .prepay-value { color: #0f172a; }
  .prepay-value.principal { color: #1d4ed8; }
  .prepay-value.current-interest { color: #b45309; }
  .prepay-value.waived { color: #047857; }
  .prepay-value.installments { color: #4338ca; }

  .prepay-amount-box {
    margin-top: 12px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 12px;
  }

  .prepay-amount-box label {
    display: block;
    font-size: 12px;
    font-weight: 900;
    color: #0f172a;
    margin-bottom: 8px;
  }

  .prepay-amount-input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid #cbd5e1;
    font-weight: 900;
    font-size: 14px;
    direction: ltr;
    text-align: left;
    font-variant-numeric: tabular-nums lining-nums;
    outline: none;
  }

  .prepay-amount-input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.12); }

  .prepay-amount-hint {
    margin-top: 8px;
    font-size: 12px;
    color: #64748b;
    font-weight: 700;
  }

  .prepay-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  @@media (min-width: 520px) {
    .prepay-actions { grid-template-columns: 1fr 1fr; }
  }

  .loan-disburse-modal-overlay.prepay-under-confirm {
    z-index: 9000 !important;
  }

  .prepay-method {
    margin-top: 14px;
    display: flex;
    justify-content: center;
    gap: 22px;
    align-items: center;
    flex-wrap: wrap;
  }

  .prepay-method label {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-weight: 900;
    font-size: 14px;
    color: #0f172a;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid #e2e8f0;
    background: #f8fafc;
    cursor: pointer;
    user-select: none;
  }

  .prepay-method input[type="radio"] {
    transform: scale(1.05);
    accent-color: #2563eb;
  }

  :global(.ds-confirm-overlay) {
    z-index: 999999 !important;
  }

  .load-more-row {
    display: flex;
    justify-content: center;
    padding: 16px 0;
  }
  .load-more-btn {
    background: rgba(255,255,255,.10);
    border: 1px solid #e2e8f0;
    color: #0f172a;
    padding: 8px 32px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: background .15s;
  }
  .load-more-btn:hover:not(:disabled) {
    background: #e2e8f0;
  }
  .load-more-btn:disabled {
    opacity: .5;
    cursor: default;
  }
</style>

<div class="loan-mje2-page">
  <DsPageHeader Icon="fa-solid fa-money-check-dollar"
                Title="وام‌ها"
                Subtitle="@($"تعداد کل: {_items.Count}")"
                ShowBackButton="true"
                ShowRefreshButton="true"
                ShowAddButton="true"
                AddButtonTitle="ایجاد وام"
                OnRefreshClick="Refresh"
                OnAddClick="ToggleCreateInline">
  </DsPageHeader>

  @if (_showCreateInline)
  {
    <LoanCreateInline OnCancel="HideCreateInline" OnSaved="OnLoanSaved" EditLoanId="@_editLoanId" />
  }

  <div class="journal-history-container">
    <div class="journal-history-header">
      <h2><i class="fas fa-history"></i> لیست وام‌ها</h2>
      <div class="history-actions">
        <button class="refresh-btn" @onclick="Refresh"><i class="fas fa-rotate"></i> بروزرسانی</button>
      </div>
    </div>

    <div class="history-filters">
      <div class="filter-row">
        <div class="filter-group filter-group-search">
          <label>جستجو</label>
          <input class="search-input" value="@_kw" @oninput="OnSearchInput" placeholder="شناسه/عضو/مبلغ/تاریخ..." />
        </div>
        <div class="filter-group filter-group-date">
          <label>بازه تاریخ</label>
          <div style="display:flex; gap:8px; align-items:center">
            <input class="search-input" style="width:120px" value="@_fromDateText" @onchange="OnFromDateChanged" data-jdp="true" data-jdp-only-date="true" data-jdp-min-date="@_fiscalFrom" data-jdp-max-date="@_fiscalTo" placeholder="از" />
            <input class="search-input" style="width:120px" value="@_toDateText" @onchange="OnToDateChanged" data-jdp="true" data-jdp-only-date="true" data-jdp-min-date="@_fiscalFrom" data-jdp-max-date="@_fiscalTo" placeholder="تا" />
          </div>
        </div>
        <div class="filter-group filter-group-status">
          <label>فیلتر</label>
          <DsPillGroup Mode="filter"
                       Items="@_filterItems"
                       ActiveKey="@_filter"
                       OnFilterChanged="OnFilterChanged" />
        </div>
        <div class="filter-group filter-group-sort desktop-only">
          <label>مرتب‌سازی</label>
          <DsPillGroup Mode="sort"
                       Items="@_sortItems"
                       ActiveKey="@_sortKey"
                       ActiveKeyChanged="@(k => _sortKey = k)"
                       Desc="@_sortDesc"
                       DescChanged="@(d => _sortDesc = d)"
                       OnSortChanged="OnSortChanged" />
        </div>
      </div>

      <div class="loan-count-row">تعداد وام‌ها: @_items.Count</div>
    </div>

    <div class="journals-table-container">
      @if (_loading)
      {
        <div class="loading-container">در حال بارگذاری...</div>
      }
      else if (!_items.Any())
      {
        <div class="empty-container">هیچ وامی یافت نشد</div>
      }
      else
      {
        <div class="journals-table-scroll">
          <table class="journals-table">
            <thead>
              <tr>
                <th>ردیف</th>
                <th>شناسه</th>
                <th>تاریخ</th>
                <th>عضو</th>
                <th>اصل وام</th>
                <th>سود وام</th>
                <th>کل وام</th>
                <th>اقساط</th>
                <th>قسط</th>
                <th>مانده وام تا کنون</th>
                <th>سند</th>
                <th>وضعیت</th>
                <th>جزئیات</th>
              </tr>
            </thead>
            <tbody>
              @{
                var idx = 0;

                decimal sumLoansPrincipal = 0m;
                decimal sumLoansInterest = 0m;
                decimal sumLoansTotal = 0m;
                decimal sumLoansEmi = 0m;
                decimal sumLoansRemPrincipal = 0m;
                decimal sumLoansRemInterest = 0m;
                decimal sumLoansRemTotal = 0m;

                foreach (var it in _items)
                {
                  _installments.TryGetValue(it.LoanId, out var instForRowTotal);
                  var itInterest = instForRowTotal != null && instForRowTotal.Count > 0
                    ? instForRowTotal.Sum(x => x.InterestAmount)
                    : (_interestSums.TryGetValue(it.LoanId, out var aggInterestTotal) ? aggInterestTotal : Math.Max(0m, (it.EmiAmount * it.TermMonths) - it.Principal));
                  var itTotal = it.Principal + itInterest;

                  _remainingAgg.TryGetValue(it.LoanId, out var itRemAgg);
                  var itRemPrincipal = itRemAgg?.RemainingPrincipal ?? 0m;
                  var itRemInterest = itRemAgg?.RemainingInterest ?? 0m;
                  var itRemTotal = itRemPrincipal + itRemInterest;

                  sumLoansPrincipal += it.Principal;
                  sumLoansInterest += itInterest;
                  sumLoansTotal += itTotal;
                  sumLoansEmi += it.EmiAmount;
                  sumLoansRemPrincipal += itRemPrincipal;
                  sumLoansRemInterest += itRemInterest;
                  sumLoansRemTotal += itRemTotal;
                }
              }
              @foreach (var item in _items)
              {
                idx++;
                _installments.TryGetValue(item.LoanId, out var instForRow);
                var rowInterest = instForRow != null && instForRow.Count > 0
                  ? instForRow.Sum(x => x.InterestAmount)
                  : (_interestSums.TryGetValue(item.LoanId, out var aggInterest) ? aggInterest : Math.Max(0m, (item.EmiAmount * item.TermMonths) - item.Principal));
                var rowTotal = item.Principal + rowInterest;

                _remainingAgg.TryGetValue(item.LoanId, out var remAgg);
                var remPrincipal = remAgg?.RemainingPrincipal ?? 0m;
                var remInterest = remAgg?.RemainingInterest ?? 0m;
                var remTotal = remPrincipal + remInterest;
                LoanService.DisbursementJournalRef? disbRef = null;
                if (_disbursementJournalRefs.TryGetValue(item.LoanId, out var djr) && djr != null)
                {
                  disbRef = djr;
                }
                <tr class="history-row @(_expanded.Contains(item.LoanId) ? "expanded" : "") @(item.Status == LoanStatus.Settled ? "loan-row-settled" : "")" @onclick="() => ToggleExpand(item.LoanId)">
                  <td class="cell-center">@idx</td>
                  <td class="cell-center">@item.LoanId</td>
                  <td>@item.DisbursedAt.ToString("yyyy/MM/dd")</td>
                  <td>@GetMemberName(item.MemberId)</td>
                  <td class="amount-td">@ToMoney(item.Principal)</td>
                  <td class="amount-td">@ToMoney(rowInterest)</td>
                  <td class="amount-td">@ToMoney(rowTotal)</td>
                  <td class="cell-center">@item.TermMonths</td>
                  <td class="amount-td">@ToMoney(item.EmiAmount)</td>
                  <td class="amount-td">
                    <div style="display:flex; flex-direction:column; gap:2px">
                      <div style="font-weight:800">@ToMoney(remTotal)</div>
                      <div style="font-size:11px; color:#6b7280">اصل: @ToMoney(remPrincipal) | سود: @ToMoney(remInterest)</div>
                    </div>
                  </td>
                  <td class="cell-center">
                    @if (disbRef != null && disbRef.JournalId > 0)
                    {
                      <a class="journal-link" href="javascript:void(0)" @onclick="(async () => await OpenJournalDetailsAsync(disbRef.JournalId))" @onclick:stopPropagation="true">
                        سند #@(disbRef.DocumentNumber?.ToString() ?? $"P-{disbRef.JournalId}")
                      </a>
                    }
                    else
                    {
                      <span>-</span>
                    }
                  </td>
                  <td><span class="status-badge @ToLoanStatusBadge(item.Status)">@ToStatusText(item.Status)</span></td>
                  <td>
                    <div class="history-actions-cell">
                      <button class="history-edit-btn" @onclick="(() => OnEditClick(item.LoanId))" @onclick:stopPropagation="true">ویرایش</button>
                      @if (item.Status == LoanStatus.Approved)
                      {
                        <button class="history-post-btn" @onclick="(() => OpenDisburseConfirmAsync(item.LoanId))" @onclick:stopPropagation="true">تایید و صدور سند</button>
                      }
                      @if (item.Status == LoanStatus.Disbursed || item.Status == LoanStatus.Active)
                      {
                        <button class="history-post-btn" style="background:#0f766e" @onclick="(() => OpenPrepayConfirmAsync(item.LoanId))" @onclick:stopPropagation="true">تسویه پیش از موعد</button>
                      }
                      <button class="history-force-status-btn" @onclick="(() => OpenForceStatusAsync(item.LoanId))" @onclick:stopPropagation="true">تغییر وضعیت</button>
                      <button class="history-delete-btn" @onclick="(() => RequestDelete(item))" @onclick:stopPropagation="true">حذف</button>
                    </div>
                  </td>
                </tr>

                @if (_expanded.Contains(item.LoanId))
                {
                  <tr class="journal-details-row">
                    <td colspan="13">
                      <div class="journal-details-inline">
                        @{
                          _installments.TryGetValue(item.LoanId, out var instForSummary);
                          var summaryInst = (instForSummary ?? new List<LoanInstallment>()).OrderBy(x => x.InstallmentNo).ToList();

                          var totalInstallments = summaryInst.Count;
                          var paidInstallments = summaryInst.Count(x => x.Status == LoanInstallmentStatus.Paid);
                          var remainingInstallments = Math.Max(0, totalInstallments - paidInstallments);

                          var firstDue = item.FirstDueDate;
                          var lastDue = summaryInst.Count > 0 ? summaryInst[^1].DueDate : (DateTime?)null;
                          var firstUnpaidDue = summaryInst.FirstOrDefault(x => x.Status != LoanInstallmentStatus.Paid)?.DueDate;

                          var paidToDate = summaryInst.Sum(x => x.PaidPrincipal + x.PaidInterest + x.PaidPenalty);
                          var paidPrincipalToDate = summaryInst.Sum(x => x.PaidPrincipal);
                          var paidInterestToDate = summaryInst.Sum(x => x.PaidInterest);

                          var remainingPrincipal = summaryInst.Count > 0
                            ? summaryInst.Sum(x => Math.Max(0m, x.PrincipalAmount - x.PaidPrincipal))
                            : Math.Max(0m, item.Principal - paidPrincipalToDate);

                          var remainingInterest = summaryInst.Count > 0
                            ? summaryInst.Sum(x => Math.Max(0m, x.InterestAmount - x.PaidInterest))
                            : Math.Max(0m, 0m - paidInterestToDate);

                          var remainingTotal = remainingPrincipal + remainingInterest;
                        }

                        <div class="journals-table-scroll" style="margin-bottom: 10px">
                          <table class="journals-table loans-loan-summary-table" style="min-width: 1200px">
                            <thead>
                              <tr>
                                <th>اولین سررسید</th>
                                <th>اولین قسط وصول‌نشده</th>
                                <th>آخرین سررسید</th>
                                <th>مبلغ هر قسط</th>
                                <th>اصل وام</th>
                                <th>سود وام</th>
                                <th>کل وام</th>
                                <th>وصول‌شده تاکنون</th>
                                <th>مانده وام تاکنون</th>
                                <th>تعداد کل اقساط</th>
                                <th>اقساط وصول‌شده</th>
                                <th>اقساط باقیمانده</th>
                                <th>نرخ سود</th>
                                <th>نرخ دیرکرد</th>
                              </tr>
                            </thead>
                            <tbody>
                              <tr>
                                @{
                                  var sumInterest = summaryInst.Count > 0
                                    ? summaryInst.Sum(x => x.InterestAmount)
                                    : (_interestSums.TryGetValue(item.LoanId, out var aggInterestSummary) ? aggInterestSummary : Math.Max(0m, (item.EmiAmount * item.TermMonths) - item.Principal));
                                  var sumTotal = item.Principal + sumInterest;
                                }
                                <td class="cell-center">@firstDue.ToPersianDate()</td>
                                <td class="cell-center">@(firstUnpaidDue.HasValue ? firstUnpaidDue.Value.ToPersianDate() : "-")</td>
                                <td class="cell-center">@(lastDue.HasValue ? lastDue.Value.ToPersianDate() : "-")</td>
                                <td class="amount-td">@ToMoney(item.EmiAmount)</td>
                                <td class="amount-td">@ToMoney(item.Principal)</td>
                                <td class="amount-td">@ToMoney(sumInterest)</td>
                                <td class="amount-td">@ToMoney(sumTotal)</td>
                                <td class="amount-td">@(summaryInst.Count > 0 ? ToMoney(paidToDate) : "-")</td>
                                <td class="amount-td">@ToMoney(remainingTotal)</td>
                                <td>@(totalInstallments > 0 ? totalInstallments.ToString(CultureInfo.InvariantCulture) : "-")</td>
                                <td>@(totalInstallments > 0 ? paidInstallments.ToString(CultureInfo.InvariantCulture) : "-")</td>
                                <td>@(totalInstallments > 0 ? remainingInstallments.ToString(CultureInfo.InvariantCulture) : "-")</td>
                                <td>@(item.AnnualRatePercent.ToString("0", CultureInfo.InvariantCulture) + "%")</td>
                                <td>@(item.PenaltyAnnualRatePercent.ToString("0", CultureInfo.InvariantCulture) + "%")</td>
                              </tr>
                            </tbody>
                          </table>
                        </div>

                        @if (_guaranteesLoading.Contains(item.LoanId) || _creditHoldsLoading.Contains(item.LoanId))
                        {
                          <div class="loading-container">در حال بارگذاری ضامنین...</div>
                        }
                        else
                        {
                          _guarantees.TryGetValue(item.LoanId, out var gs);
                          _creditHolds.TryGetValue(item.LoanId, out var hs);
                          gs ??= new List<LoanGuarantee>();
                          hs ??= new List<CreditHold>();

                          var gRows = new List<(string Kind, long? MemberId, string Code, decimal Amount, bool IsActive)>();

                          foreach (var g in gs)
                          {
                            var kind = g.Type switch
                            {
                              LoanGuaranteeType.GuarantorMember => "ضامن",
                              LoanGuaranteeType.DepositHold => "بلوکه سپرده",
                              LoanGuaranteeType.Cheque => "چک",
                              LoanGuaranteeType.Promissory => "سفته",
                              _ => "ضمانت"
                            };

                            var code = g.Type switch
                            {
                              LoanGuaranteeType.GuarantorMember => (string.IsNullOrWhiteSpace(g.GuarantorMemberCode) ? "-" : g.GuarantorMemberCode),
                              LoanGuaranteeType.DepositHold => (g.DepositAccountId.HasValue ? ("#" + g.DepositAccountId.Value.ToString(CultureInfo.InvariantCulture)) : "-"),
                              _ => (string.IsNullOrWhiteSpace(g.GuarantorMemberCode) ? "-" : g.GuarantorMemberCode)
                            };

                            gRows.Add((kind, g.GuarantorMemberId, code!, g.Amount, g.IsActive));
                          }

                          foreach (var h in hs)
                          {
                            var code = string.IsNullOrWhiteSpace(h.MemberCode) ? "-" : h.MemberCode;
                            var kind = h.Role == CreditHoldRole.Applicant ? "متقاضی (خود ضامن)" : "ضامن";
                            // CreditHold has no IsActive; treat Active status as active
                            var active = h.Status == CreditHoldStatus.Active;
                            gRows.Add((kind, h.MemberId, code!, h.LockedAmount, active));
                          }

                          var guarantors = gRows
                            .GroupBy(x => new { x.Kind, x.MemberId, x.Code, x.Amount })
                            .Select(g => g.OrderByDescending(x => x.IsActive).First())
                            .OrderByDescending(x => x.Amount)
                            .ToList();

                          if (guarantors.Count == 0)
                          {
                            <div class="empty-container" style="margin-bottom: 10px">ضامنی ثبت نشده است</div>
                          }
                          else
                          {
                            <div class="journals-table-scroll" style="margin-bottom: 10px">
                              <table class="journals-table loans-guarantors-table" style="min-width: 820px">
                                <thead>
                                  <tr>
                                    <th>نوع</th>
                                    <th>نام ضامن / ضامنین</th>
                                    <th>مبلغ</th>
                                    <th>وضعیت</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  @foreach (var g in guarantors)
                                  {
                                    var display = (g.MemberId.HasValue && g.MemberId.Value > 0)
                                      ? GetMemberName(g.MemberId.Value)
                                      : g.Code;
                                    <tr>
                                      <td style="text-align:right">@g.Kind</td>
                                      <td style="text-align:right">@display</td>
                                      <td class="amount-td">@ToMoney(g.Amount)</td>
                                      <td>
                                        <span class="status-badge @(g.IsActive ? "paid" : "unpaid")">@(g.IsActive ? "فعال" : "غیرفعال")</span>
                                      </td>
                                    </tr>
                                  }

                                  @{
                                    var totalGuarantees = guarantors.Sum(x => x.Amount);
                                  }
                                  <tr class="guarantors-total-row">
                                    <td colspan="2" style="text-align:right; font-weight:900">جمع تضمین ضامنین</td>
                                    <td class="amount-td">@ToMoney(totalGuarantees)</td>
                                    <td></td>
                                  </tr>
                                </tbody>
                              </table>
                            </div>
                          }
                        }

                        @if (_installmentsLoading.Contains(item.LoanId))
                        {
                          <div class="loading-container">در حال بارگذاری اقساط...</div>
                        }
                        else if (_installments.TryGetValue(item.LoanId, out var inst) && inst.Any())
                        {
                          var ordered = inst.OrderBy(x => x.InstallmentNo).ToList();
                          decimal cumPrincipal = 0m;
                          decimal cumInterest = 0m;
                          decimal totalPenalty = 0m;
                          decimal totalWaivedPenalty = 0m;
                          decimal totalPayableComputed = 0m;
                          decimal totalPaidComputed = 0m;
                          decimal totalRemainingComputed = 0m;
                          var totalPrincipal = ordered.Sum(x => x.PrincipalAmount);
                          var totalInterest = ordered.Sum(x => x.InterestAmount);
                          var totalEmi = ordered.Sum(x => x.EmiAmount);

                          <div class="journals-table-scroll">
                            <table class="journals-table loans-installments-table" style="min-width: 1200px">
                              <thead>
                                <tr>
                                  <th>شماره قسط</th>
                                  <th>تاریخ قسط</th>
                                  <th>مانده وام (ابتدای ماه)</th>
                                  <th>مبلغ قسط وام</th>
                                  <th>مبلغ قسط سود</th>
                                  <th>اقساط سود تجمیعی</th>
                                  <th>مبلغ قسط اصل</th>
                                  <th>اقساط اصل تجمیعی</th>
                                  <th>مانده وام (انتهای ماه)</th>
                                  <th>جریمه ماه</th>
                                  <th>جریمه بخشیده</th>
                                  <th>قابل پرداخت</th>
                                  <th>پرداخت‌شده</th>
                                  <th>مانده قسط</th>
                                  <th>وضعیت پرداخت</th>
                                  <th>علت</th>
                                </tr>
                              </thead>
                              <tbody>
                                @foreach (var it in ordered)
                                {
                                  cumPrincipal += it.PrincipalAmount;
                                  cumInterest += it.InterestAmount;

                                  var instRemainingPrincipal = Math.Max(0m, it.PrincipalAmount - it.PaidPrincipal);
                                  var instRemainingInterest = Math.Max(0m, it.InterestAmount - it.PaidInterest);
                                  var remainingBase = instRemainingPrincipal + instRemainingInterest;

                                  var overdueDays = 0;
                                  if (remainingBase > 0m)
                                  {
                                    var today = DateTime.Today;
                                    var due = it.DueDate.Date;
                                    overdueDays = Math.Max(0, (today - due).Days);
                                  }

                                  var penaltyDailyRate = (item.PenaltyAnnualRatePercent / 100m) / 365m;
                                  var penaltyAmount = (overdueDays > 0 && remainingBase > 0m)
                                    ? (remainingBase * penaltyDailyRate * overdueDays)
                                    : 0m;

                                  var waivedPenalty = 0m;
                                  if (_waivedPenaltySums.TryGetValue(item.LoanId, out var wmap) && wmap != null)
                                    waivedPenalty = wmap.TryGetValue(it.InstallmentId, out var w) ? w : 0m;

                                  // For Paid installments, remainingBase becomes 0 and penaltyAmount will be 0.
                                  // To keep the table transparent, show the historical settled penalty
                                  // (paid + waived) for Paid installments.
                                  var computedStatus = (instRemainingPrincipal <= 0.01m && instRemainingInterest <= 0.01m)
                                    ? LoanInstallmentStatus.Paid
                                    : (it.PaidPrincipal + it.PaidInterest + it.PaidPenalty > 0m ? LoanInstallmentStatus.PartiallyPaid : LoanInstallmentStatus.Unpaid);

                                  var effectivePenalty = computedStatus == LoanInstallmentStatus.Paid
                                    ? (it.PaidPenalty + waivedPenalty)
                                    : penaltyAmount;

                                  var payableBase = computedStatus == LoanInstallmentStatus.Paid
                                    ? (it.PrincipalAmount + it.InterestAmount)
                                    : remainingBase;

                                  var payableAmount = payableBase + effectivePenalty;
                                  var paidAmount = it.PaidPrincipal + it.PaidInterest + it.PaidPenalty;

                                  var remainingPenalty = Math.Max(0m, effectivePenalty - (it.PaidPenalty + waivedPenalty));

                                  // For partially/unpaid installments, remaining should reflect remaining principal+interest + remaining penalty.
                                  // Previous logic subtracted total paid from remainingBase and incorrectly showed 0 for partially paid.
                                  var remainingInstallment = computedStatus == LoanInstallmentStatus.Paid
                                    ? 0m
                                    : Math.Max(0m, remainingBase + remainingPenalty);

                                  totalPenalty += penaltyAmount;
                                  totalWaivedPenalty += waivedPenalty;
                                  totalPayableComputed += payableAmount;
                                  totalPaidComputed += paidAmount;
                                  totalRemainingComputed += remainingInstallment;

                                  MarkupString reasonMarkup = computedStatus switch
                                  {
                                    LoanInstallmentStatus.Paid => (waivedPenalty > 0.01m
                                      ? new MarkupString($"<span>اصل/سود تسویه</span> <span class='reason-sep'>|</span> <span class='reason-penalty'>جریمه بخشیده={ToMoney(waivedPenalty)}</span>")
                                      : (it.PaidPenalty > 0.01m
                                        ? new MarkupString($"<span>اصل/سود تسویه</span> <span class='reason-sep'>|</span> <span class='reason-penalty'>جریمه پرداختی={ToMoney(it.PaidPenalty)}</span>")
                                        : new MarkupString("<span>اصل و سود تسویه شده</span>"))),
                                    LoanInstallmentStatus.PartiallyPaid => new MarkupString(
                                      $"<span>مانده اصل={ToMoney(instRemainingPrincipal)}</span> <span class='reason-sep'>|</span> " +
                                      $"<span>مانده سود={ToMoney(instRemainingInterest)}</span> <span class='reason-sep'>|</span> " +
                                      $"<span class='reason-penalty'>مانده جریمه={ToMoney(remainingPenalty)}</span>"),
                                    _ => (overdueDays > 0
                                      ? new MarkupString($"<span>پرداختی ثبت نشده</span> <span class='reason-sep'>|</span> <span class='reason-days'>تاخیر {overdueDays} روز</span> <span class='reason-sep'>|</span> <span class='reason-penalty'>جریمه={ToMoney(penaltyAmount)}</span>")
                                      : new MarkupString("<span>پرداختی ثبت نشده</span>"))
                                  };

                                  LoanService.InstallmentJournalRef? jref = null;
                                  if (_installmentJournalRefs.TryGetValue(item.LoanId, out var byInst) && byInst != null)
                                  {
                                    byInst.TryGetValue(it.InstallmentId, out jref);
                                  }

                                  <tr>
                                    <td class="cell-center">@it.InstallmentNo</td>
                                    <td class="cell-center">@it.DueDate.ToPersianDate()</td>
                                    <td class="amount-td">@ToMoney(it.OpeningBalance)</td>
                                    <td class="amount-td">@ToMoney(it.EmiAmount)</td>
                                    <td class="amount-td">@ToMoney(it.InterestAmount)</td>
                                    <td class="amount-td">@ToMoney(cumInterest)</td>
                                    <td class="amount-td">@ToMoney(it.PrincipalAmount)</td>
                                    <td class="amount-td">@ToMoney(cumPrincipal)</td>
                                    <td class="amount-td">@ToMoney(it.ClosingBalance)</td>
                                    <td class="amount-td td-penalty">@ToMoney(effectivePenalty)</td>
                                    <td class="amount-td td-penalty">@ToMoney(waivedPenalty)</td>
                                    <td class="amount-td">@ToMoney(payableAmount)</td>
                                    <td class="amount-td td-paid">@ToMoney(paidAmount)</td>
                                    <td class="amount-td">@ToMoney(remainingInstallment)</td>
                                    <td>
                                      <span class="status-badge @ToInstallmentBadge(it.Status)">@ToInstallmentStatusText(it.Status)</span>
                                    </td>
                                    <td class="reason-td">
                                      @reasonMarkup
                                      @if (jref != null && jref.JournalId > 0)
                                      {
                                        <span class='reason-sep'>|</span>
                                        <a class="journal-link" href="javascript:void(0)" @onclick="(async () => await OpenJournalDetailsAsync(jref.JournalId))" @onclick:stopPropagation="true">
                                          سند #@(jref.DocumentNumber?.ToString() ?? $"P-{jref.JournalId}")
                                        </a>
                                        <span class="journal-link-date">(@jref.OccurredAt.ToLocalTime().ToPersianDate())</span>
                                      }
                                    </td>
                                  </tr>
                                }

                                <tr class="installments-total-row">
                                  <td colspan="3" style="text-align:right; font-weight:900">جمع</td>
                                  <td class="amount-td">@ToMoney(totalEmi)</td>
                                  <td class="amount-td">@ToMoney(totalInterest)</td>
                                  <td class="amount-td">@ToMoney(totalInterest)</td>
                                  <td class="amount-td">@ToMoney(totalPrincipal)</td>
                                  <td class="amount-td">@ToMoney(totalPrincipal)</td>
                                  <td class="amount-td">@ToMoney(0)</td>
                                  <td class="amount-td">@ToMoney(totalPenalty)</td>
                                  <td class="amount-td">@ToMoney(totalWaivedPenalty)</td>
                                  <td class="amount-td">@ToMoney(totalPayableComputed)</td>
                                  <td class="amount-td">@ToMoney(totalPaidComputed)</td>
                                  <td class="amount-td">@ToMoney(totalRemainingComputed)</td>
                                  <td></td>
                                  <td></td>
                                </tr>
                              </tbody>
                            </table>
                          </div>
                        }
                        else
                        {
                          <div class="empty-container">اقساطی یافت نشد</div>
                        }
                      </div>
                    </td>
                  </tr>
                }
              }

              <tr class="loans-total-row">
                <td colspan="4" class="cell-center">جمع</td>
                <td class="amount-td">@ToMoney(sumLoansPrincipal)</td>
                <td class="amount-td">@ToMoney(sumLoansInterest)</td>
                <td class="amount-td">@ToMoney(sumLoansTotal)</td>
                <td class="cell-center">-</td>
                <td class="amount-td">@ToMoney(sumLoansEmi)</td>
                <td class="amount-td">
                  <div style="display:flex; flex-direction:column; gap:2px">
                    <div style="font-weight:900">@ToMoney(sumLoansRemTotal)</div>
                    <div style="font-size:11px; color:#6b7280">اصل: @ToMoney(sumLoansRemPrincipal) | سود: @ToMoney(sumLoansRemInterest)</div>
                  </div>
                </td>
                <td class="cell-center">-</td>
                <td class="cell-center">-</td>
                <td class="cell-center">-</td>
              </tr>
            </tbody>
          </table>
        </div>

        @if (_hasMore)
        {
          <div class="load-more-row">
            <button class="load-more-btn" @onclick="LoadMoreAsync" disabled="@_loadingMore">
              @(_loadingMore ? "در حال بارگذاری..." : "نمایش بیشتر")
            </button>
          </div>
        }

      }
    </div>
  </div>
</div>

