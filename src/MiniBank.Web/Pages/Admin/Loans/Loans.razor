  private async Task OpenJournalDetailsAsync(long journalId)
  {
    _showJournalDetails = true;
    _journalDetailsLoading = true;
    _journalDetailsId = journalId;
    _journalDetailsDocumentNumber = null;
    _journalDetailsDateText = string.Empty;
    _journalDetailsNotes = string.Empty;
    _journalDetailsLines = new();
    StateHasChanged();

    try
    {
      var h = await LoanService.GetJournalHeaderAsync(journalId);
      if (h != null)
      {
        _journalDetailsDocumentNumber = h.DocumentNumber;
        _journalDetailsDateText = h.OccurredAt.ToLocalTime().ToPersianDate();
        _journalDetailsNotes = h.Notes ?? string.Empty;
      }

      var rows = (await LoanService.GetJournalLinesDetailsAsync(journalId)).ToList();
      foreach (var r in rows)
      {
        bool hasParent = r.ParentAccountId.HasValue && r.ParentAccountId.Value > 0;
        string main = hasParent
          ? ($"{r.ParentCode} - {r.ParentName}")
          : ($"{r.AccCode} - {r.AccName}");
        string sub = hasParent
          ? ($"{r.AccCode} - {r.AccName}")
          : "-";

        _journalDetailsLines.Add(new JournalDetailsLine
        {
          LineNo = r.LineNo,
          MainAccount = main,
          SubsidiaryAccount = sub,
          Debit = r.Debit,
          Credit = r.Credit,
          Description = r.Description ?? string.Empty
        });
      }
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در بارگذاری جزئیات سند: {ex.Message}");
    }
    finally
    {
      _journalDetailsLoading = false;
      StateHasChanged();
    }
  }

  private void CloseJournalDetails()
  {
    _showJournalDetails = false;
    _journalDetailsLoading = false;
    _journalDetailsLines = new();
    StateHasChanged();
  }

  private static string GetDisplayJournalNotes(string? notes)
  {
    if (string.IsNullOrWhiteSpace(notes))
      return string.Empty;

    var parts = notes.Split('|', StringSplitOptions.RemoveEmptyEntries)
      .Select(x => x.Trim())
      .Where(x => x.Length > 0)
      .Where(x => !x.StartsWith("Run:", StringComparison.OrdinalIgnoreCase))
      .Where(x => !x.StartsWith("Member:", StringComparison.OrdinalIgnoreCase))
      .Where(x => !x.StartsWith("Loan:", StringComparison.OrdinalIgnoreCase))
      .Where(x => !x.Equals("LoanDisburse", StringComparison.OrdinalIgnoreCase))
      .ToList();

    return parts.Count == 0 ? (notes ?? string.Empty) : string.Join(" | ", parts);
  }

