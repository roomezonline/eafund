          <div><strong>تعداد اقساط:</strong> @_forceStatusLoan.TermMonths</div>
          <div><strong>وضعیت فعلی:</strong> <span class="status-badge @ToLoanStatusBadge(_forceStatusLoan.Status)">@ToStatusText(_forceStatusLoan.Status)</span></div>
        </div>

        <div class="force-status-field">
          <label>وضعیت جدید</label>
          <select class="force-status-select" @onchange="OnForceStatusNewStatusChanged">
            @foreach (var s in _forceStatusOptions)
            {
              <option value="@((int)s.Value)" selected="@(s.Value == _forceStatusNewStatus)">@s.Text</option>
            }
          </select>
        </div>

        <div class="force-status-warning">
          هشدار: این تغییر بدون بررسی شرایط انجام می‌شود.
        </div>

        <div class="loan-disburse-modal-actions">
          <button type="button" class="loan-disburse-cancel" @onclick="CloseForceStatus" disabled="@_forceStatusBusy">انصراف</button>
          <button type="button" class="loan-disburse-confirm" @onclick="ConfirmForceStatusAsync" disabled="@_forceStatusBusy">@(_forceStatusBusy ? "در حال ثبت..." : "تایید تغییر وضعیت")</button>
        </div>
      }
      else
      {
        <div class="empty-container">اطلاعات وام یافت نشد</div>
      }
    </div>
  </div>
}

