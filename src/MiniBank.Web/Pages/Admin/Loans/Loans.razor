  private async Task LoadPageAsync(bool reset)
  {
    if (reset)
    {
      _offset = 0;
      _hasMore = false;
      _expanded.Clear();
      _installments.Clear();
      _installmentsLoading.Clear();
      _guarantees.Clear();
      _guaranteesLoading.Clear();
      _creditHolds.Clear();
      _creditHoldsLoading.Clear();
      _installmentJournalRefs.Clear();
      _waivedPenaltySums.Clear();
      _interestSums = new Dictionary<long, decimal>();
      _remainingAgg = new Dictionary<long, MiniBank.Web.Infrastructure.Repositories.LoanInstallmentRepository.LoanRemainingAggRow>();
      _disbursementJournalRefs = new Dictionary<long, LoanService.DisbursementJournalRef>();
      _all = new();
      _items = new();
    }

    var statusFilter = _filter switch
    {
      "approved" => LoanStatus.Approved,
      "disbursed" => LoanStatus.Disbursed,
      "settled" => LoanStatus.Settled,
      _ => (LoanStatus?)null
    };
    var page = (await LoanService.GetAllPagedAsync(_offset, _pageSize, statusFilter)).ToList();
    if (page.Count == 0)
    {
      _hasMore = false;
      ApplyFilter();
      return;
    }

    _offset += page.Count;
    _hasMore = page.Count >= _pageSize;

    var loanIds = page.Select(x => x.LoanId).Distinct().ToList();
    var memberIds = page.Select(x => x.MemberId).Distinct().ToList();

    var interest = await LoanService.GetInterestSumsByLoanIdsAsync(loanIds);
    var remaining = await LoanService.GetRemainingSumsByLoanIdsAsync(loanIds);
    var disbRefs = await LoanService.GetDisbursementJournalRefsByLoanIdAsync(loanIds);

    foreach (var kv in interest)
      ((Dictionary<long, decimal>)_interestSums)[kv.Key] = kv.Value;
    foreach (var kv in remaining)
      ((Dictionary<long, MiniBank.Web.Infrastructure.Repositories.LoanInstallmentRepository.LoanRemainingAggRow>)_remainingAgg)[kv.Key] = kv.Value;
    foreach (var kv in disbRefs)
      ((Dictionary<long, LoanService.DisbursementJournalRef>)_disbursementJournalRefs)[kv.Key] = kv.Value;

    await EnsureMemberNamesLoadedAsync(memberIds);

    _all.AddRange(page);
    ApplyFilter();
  }

