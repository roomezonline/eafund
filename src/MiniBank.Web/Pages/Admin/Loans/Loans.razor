  private async Task EnsureMemberNamesLoadedAsync(List<long> memberIds)
  {
    var missing = memberIds.Where(id => !_memberNames.ContainsKey(id)).Take(200).ToList();
    if (!missing.Any()) return;

    // Load members (best-effort). MemberRepository supports limit; we fetch recent and map.
    var members = await MemberRepo.GetAllAsync(limit: 500);
    foreach (var m in members)
    {
      if (!_memberNames.ContainsKey(m.MemberId))
        _memberNames[m.MemberId] = m.FullName;
    }

    // Fallback for still-missing IDs
    foreach (var id in missing)
    {
      if (!_memberNames.ContainsKey(id))
        _memberNames[id] = $"#{id}";
    }
  }

  private void ApplyFilter()
  {
    IEnumerable<Loan> q = _all;

    if (_fromDate.HasValue)
      q = q.Where(x => x.DisbursedAt.Date >= _fromDate.Value.Date);
    if (_toDate.HasValue)
      q = q.Where(x => x.DisbursedAt.Date <= _toDate.Value.Date);

    var key = (_keyword ?? string.Empty).Trim();
    if (!string.IsNullOrEmpty(key))
    {
      var kw = key.ToLowerInvariant();
      q = q.Where(x =>
        x.LoanId.ToString(CultureInfo.InvariantCulture).Contains(kw) ||
        GetMemberName(x.MemberId).ToLowerInvariant().Contains(kw) ||
        x.Principal.ToString(CultureInfo.InvariantCulture).Contains(kw) ||
        x.DisbursedAt.ToPersianDate().ToLowerInvariant().Contains(kw)
      );
    }

    q = (_sortKey, _sortDesc) switch
    {
      ("date", false) => q.OrderBy(x => x.DisbursedAt).ThenBy(x => x.LoanId),
      ("date", true) => q.OrderByDescending(x => x.DisbursedAt).ThenByDescending(x => x.LoanId),
      ("id", false) => q.OrderBy(x => x.LoanId),
      _ => q.OrderByDescending(x => x.LoanId)
    };

    _items = q.ToList();
    StateHasChanged();
  }

  private async Task DebouncedApplyFilterAsync(int delayMs = 180)
  {
    _searchCts?.Cancel();
    _searchCts = new CancellationTokenSource();
    var token = _searchCts.Token;
    try
    {
      await Task.Delay(delayMs, token);
      if (!token.IsCancellationRequested) ApplyFilter();
    }
    catch (TaskCanceledException) { }
  }

  private async Task OnFilterChanged(string key)
  {
    if (_filter == key) return;
    _filter = key;
    await LoadAsync();
  }

  private Task OnFromDateChanged(ChangeEventArgs e)
  {
    _fromDateText = e.Value?.ToString() ?? string.Empty;
    if (string.IsNullOrWhiteSpace(_fromDateText))
      _fromDate = null;
    else
      _fromDate = DateTimeExtensions.FromPersianDate(_fromDateText).Date;
    ApplyFilter();
    return Task.CompletedTask;
  }

  private Task OnToDateChanged(ChangeEventArgs e)
  {
    _toDateText = e.Value?.ToString() ?? string.Empty;
    if (string.IsNullOrWhiteSpace(_toDateText))
      _toDate = null;
    else
      _toDate = DateTimeExtensions.FromPersianDate(_toDateText).Date;
    ApplyFilter();
    return Task.CompletedTask;
  }

  private Task OnSortChanged((string key, bool desc) s)
  { _sortKey = s.key; _sortDesc = s.desc; ApplyFilter(); return Task.CompletedTask; }

  private void ToggleExpand(long id)
  {
    if (_expanded.Contains(id))
    {
      _expanded.Remove(id);
      StateHasChanged();
      return;
    }

    _expanded.Clear();
    _expanded.Add(id);
    _ = EnsureGuaranteesLoadedAsync(id);
    _ = EnsureCreditHoldsLoadedAsync(id);
    _ = EnsureInstallmentsLoadedAsync(id);
    StateHasChanged();
  }

  private async Task OpenInstallments(long loanId)
  {
    _expanded.Clear();
    _expanded.Add(loanId);
    await EnsureGuaranteesLoadedAsync(loanId);
    await EnsureCreditHoldsLoadedAsync(loanId);
    await EnsureInstallmentsLoadedAsync(loanId);
    StateHasChanged();
  }

  private async Task EnsureCreditHoldsLoadedAsync(long loanId)
  {
    if (_creditHolds.ContainsKey(loanId) || _creditHoldsLoading.Contains(loanId)) return;

    _creditHoldsLoading.Add(loanId);
    StateHasChanged();

    try
    {
      var hs = (await CreditHoldRepo.GetByLoanIdAsync(loanId)).ToList();
      _creditHolds[loanId] = hs;

      var ids = hs.Select(x => x.MemberId).Where(x => x > 0).Distinct().Take(200).ToList();
      if (ids.Count > 0)
        await EnsureMemberNamesLoadedAsync(ids);
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در بارگذاری بلوکه‌ها: {ex.Message}");
    }
    finally
    {
      _creditHoldsLoading.Remove(loanId);
      StateHasChanged();
    }
  }

  private async Task EnsureGuaranteesLoadedAsync(long loanId)
  {
    if (_guarantees.ContainsKey(loanId) || _guaranteesLoading.Contains(loanId)) return;

    _guaranteesLoading.Add(loanId);
    StateHasChanged();

    try
    {
      var gs = (await LoanService.GetGuaranteesAsync(loanId)).ToList();
      _guarantees[loanId] = gs;

      var ids = gs.Select(x => x.GuarantorMemberId ?? 0).Where(x => x > 0).Distinct().Take(200).ToList();
      if (ids.Count > 0)
        await EnsureMemberNamesLoadedAsync(ids);
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در بارگذاری ضامنین: {ex.Message}");
    }
    finally
    {
      _guaranteesLoading.Remove(loanId);
      StateHasChanged();
    }
  }

  private async Task EnsureInstallmentsLoadedAsync(long loanId)
  {
    if (_installments.ContainsKey(loanId) || _installmentsLoading.Contains(loanId)) return;

    _installmentsLoading.Add(loanId);
    StateHasChanged();

    try
    {
      var inst = (await LoanService.GetInstallmentsAsync(loanId)).OrderBy(x => x.InstallmentNo).ToList();
      _installments[loanId] = inst;

      var waived = await LoanService.GetWaivedPenaltySumsByInstallmentIdAsync(loanId);
      _waivedPenaltySums[loanId] = waived;

      var refs = await LoanService.GetLastJournalRefsByInstallmentIdAsync(loanId);
      _installmentJournalRefs[loanId] = refs;
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در بارگذاری اقساط: {ex.Message}");
    }
    finally
    {
      _installmentsLoading.Remove(loanId);
      StateHasChanged();
    }
  }

