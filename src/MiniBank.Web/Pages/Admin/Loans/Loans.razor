  private async Task ConfirmPrepayAsync()
  {
    _prepayAmountError = string.Empty;
    var raw = (_prepayAmountText ?? string.Empty).Replace(",", string.Empty).Trim();
    if (!decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount) || amount <= 0)
    {
      _prepayAmountError = "مبلغ وارد شده معتبر نیست";
      StateHasChanged();
      return;
    }

    if (_prepayLoanId <= 0)
    {
      _prepayAmountError = "شناسه وام معتبر نیست";
      StateHasChanged();
      return;
    }

    if (_prepayPaymentMethod == "member")
    {
      if (!_prepayMemberFinancialLoaded && !_prepayMemberFinancialLoading)
      {
        try { await LoadPrepayMemberFinancialAsync(); }
        catch (Exception ex)
        {
          _prepayAmountError = ex.Message;
          StateHasChanged();
          return;
        }
      }
      var available = _prepayMemberAvailable < 0 ? 0 : _prepayMemberAvailable;
      if (available < (amount + _prepayOverduePenalty))
      {
        _prepayAmountError = "موجودی قابل برداشت عضو کافی نیست (با لحاظ مبالغ بلوکه‌شده)";
        StateHasChanged();
        return;
      }
    }
    if (_prepayPreview != null)
    {
      var methodText = _prepayPaymentMethod == "member" ? "برداشت از حساب عضو" : "نقدی";
      _prepayPostConfirmMessage = $@"
<div style='line-height:1.9'>
  <div style='margin-bottom:8px'>آیا از ثبت سند تسویه پیش از موعد مطمئن هستید؟</div>
  <div><strong>وام:</strong> #{_prepayLoanId}</div>
  <div><strong>شیوه پرداخت:</strong> {methodText}</div>
  <div><strong>مبلغ:</strong> {ToMoney(amount)} ریال</div>
</div>";
      _showPrepayPostConfirm = true;
      _showPrepayConfirmHidden = true;
      StateHasChanged();
      return;
    }

    _prepayLoading = true;
    _prepayPreview = null;
    StateHasChanged();

    try
    {
      _prepayPreview = _prepayPaymentMethod == "member"
        ? await LoanService.BuildPrepayMemberAccountJournalPreviewAsync(_prepayLoanId, amount)
        : await LoanService.BuildPrepayCashJournalPreviewAsync(_prepayLoanId, amount);
      Toasts.Info("پیش‌نمایش سند آماده شد. برای ثبت، دوباره روی «ثبت سند» کلیک کنید");
    }
    catch (Exception ex)
    {
      _prepayAmountError = ex.Message;
    }
    finally
    {
      _prepayLoading = false;
      StateHasChanged();
    }
  }

