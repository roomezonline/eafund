  private async Task ConfirmForceStatusAsync()
  {
    if (_forceStatusBusy) return;
    if (_forceStatusLoan == null) return;

    _forceStatusBusy = true;
    StateHasChanged();

    try
    {
      await LoanService.ForceUpdateLoanStatusAsync(_forceStatusLoan.LoanId, _forceStatusNewStatus);
