    private static int EstimateParts(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return 1;
        var len = text.Length;
        var perPart = 70; // UCS-2 safe approximation for Persian
        return (int)Math.Ceiling(len / (double)perPart);
    }

    private static int ParseInt(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return 0;
        var digits = new string(raw.Where(char.IsDigit).ToArray());
        return int.TryParse(digits, out var n) ? n : 0;
    }

    private string DraftKey
        => _draftReceiptIdScope.HasValue
            ? $"mje.manual-journal-entry.draft.v2:receipt:{_draftReceiptIdScope.Value}"
            : "mje.manual-journal-entry.draft.v2:manual";

    private async Task ScheduleDraftSaveAsync()
    {
        if (IsEditMode) return;

        _draftSaveCts?.Cancel();
        _draftSaveCts = new CancellationTokenSource();
        var ct = _draftSaveCts.Token;

        try
        {
            await Task.Delay(50, ct);
            await SaveDraftNowAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task SaveDraftNowAsync()
    {
        if (IsEditMode) return;

        var hasAnyLineData = JournalLines.Any(l =>
            l.AccountId > 0 ||
            (l.SubsidiaryId.HasValue && l.SubsidiaryId.Value > 0) ||
            l.Debit > 0 ||
            l.Credit > 0 ||
            !string.IsNullOrWhiteSpace(l.Description));

        if (!hasAnyLineData && string.IsNullOrWhiteSpace(Description) && string.IsNullOrWhiteSpace(OccurredAt))
        {
            await RemoveDraftAsync();
            return;
        }

        var draft = new ManualJournalDraft
        {
            OccurredAt = OccurredAt,
            Description = Description,
            Lines = JournalLines.Select(l => new ManualJournalDraftLine
            {
                AccountId = l.AccountId,
                SubsidiaryId = l.SubsidiaryId,
                Debit = l.Debit,
                Credit = l.Credit,
                Description = l.Description,
                UseHouseholdMemberFilter = l.UseHouseholdMemberFilter
            }).ToList()
        };

        var json = JsonSerializer.Serialize(draft);
        _ = await SetLocalStorageAsync(DraftKey, json);
    }

    private async Task<bool> RemoveDraftAsync()
    {
        try
        {
            return await RemoveLocalStorageAsync(DraftKey);
        }
        catch
        {
            return false;
        }
    }

    private async Task TryRestoreDraftAsync()
    {
        if (IsEditMode) return;

        try
        {
            var json = await GetLocalStorageAsync(DraftKey);
            if (string.IsNullOrWhiteSpace(json)) return;

            var draft = JsonSerializer.Deserialize<ManualJournalDraft>(json);
            if (draft == null) return;

            // اگر کاربر همین الان در این سشن چیزی وارد کرده، Draft را override نکن.
            if (JournalLines.Count > 0) return;
            if (hasUnsavedChanges) return;

            _isRestoringDraft = true;
            try
            {
                OccurredAt = string.IsNullOrWhiteSpace(draft.OccurredAt) ? OccurredAt : draft.OccurredAt;
                Description = draft.Description ?? string.Empty;

                JournalLines = draft.Lines.Select(dl => new ManualJournalLine
                {
                    AccountId = dl.AccountId,
                    SubsidiaryId = dl.SubsidiaryId,
                    Debit = dl.Debit,
                    Credit = dl.Credit,
                    Description = dl.Description ?? string.Empty,
                    UseHouseholdMemberFilter = dl.UseHouseholdMemberFilter
                }).ToList();

                foreach (var line in JournalLines)
                {
                    LoadSubsidiariesForMainAccount(line);
                }

                foreach (var line in JournalLines)
                {
                    if (line.SubsidiaryId.HasValue && line.SubsidiaryId.Value > 0)
                    {
                        await OnSubsidiarySelected(line);
                    }
                }

                UpdateUsedAmount();
                hasUnsavedChanges = true;
                _pendingAutoResize = true;
            }
            finally
            {
                _isRestoringDraft = false;
            }
        }
        catch
        {
        }
    }

    private async Task<bool> SetLocalStorageAsync(string key, string value)
    {
        try
        {
            var k = JsonSerializer.Serialize(key);
            var v = JsonSerializer.Serialize(value);
            return await JS.InvokeAsync<bool>("eval", $"localStorage.setItem({k}, {v}); true");
        }
        catch
        {
            return false;
        }
    }

    private async Task<string?> GetLocalStorageAsync(string key)
    {
        try
        {
            var k = JsonSerializer.Serialize(key);
            return await JS.InvokeAsync<string?>("eval", $"localStorage.getItem({k})");
        }
        catch
        {
            return null;
        }
    }

    private async Task<bool> RemoveLocalStorageAsync(string key)
    {
        try
        {
            var k = JsonSerializer.Serialize(key);
            return await JS.InvokeAsync<bool>("eval", $"localStorage.removeItem({k}); true");
        }
        catch
        {
