    private async Task EditJournal(long journalId)
    {
        try
        {
            // ورود به حالت ویرایش
            IsEditMode = true;
            EditingJournalId = journalId;

            // بارگذاری هدر سند
            const string journalSql = @"
                SELECT JournalId, OccurredAt, ISNULL(Notes, '') AS Notes, Status
                FROM dbo.Journals
                WHERE JournalId = @JournalId";

            var journal = await _db.QuerySingleAsync<dynamic>(journalSql, new { JournalId = journalId });

            _isTemporary = (byte)journal.Status == 1;

            OccurredAt = GetJalaliDateFromGregorian((DateTime)journal.OccurredAt);

            var rawNotes = (string)journal.Notes;
            _originalJournalNotes = rawNotes;
            Description = StripSystemicMetadata(rawNotes);

            // بارگذاری خطوط سند برای ویرایش
            const string linesSql = @"
                SELECT JournalLineId, AccountId, ParentAccountId, MemberId, LoanId, Debit, Credit, ISNULL(Description,'') AS Description
                FROM dbo.JournalLines
                WHERE JournalId = @JournalId
                ORDER BY [LineNo]";

            var dbLines = await _db.QueryAsync<dynamic>(linesSql, new { JournalId = journalId });

            // For old journal lines without LoanId, try to find correct LoanId from LoanPayments
            var paymentLoanMap = (await _db.QueryAsync<(long LoanId, long? MemberId)>(@"
                SELECT DISTINCT lp.LoanId, lp.MemberId
                FROM dbo.LoanPayments lp
                WHERE lp.Notes LIKE @notes AND lp.LoanId IS NOT NULL",
                new { notes = $"ManualJournal:{journalId}%" })).ToList();

            JournalLines.Clear();

            foreach (var l in dbLines)
            {
                long accountId = l.AccountId;
                long? parentAccountId = l.ParentAccountId == null ? (long?)null : (long)l.ParentAccountId;

                long mainAccountId = parentAccountId ?? accountId;
                long? subsidiaryId = parentAccountId.HasValue ? accountId : (long?)null;

                long? dbLoanId = l.LoanId == null ? (long?)null : (long)l.LoanId;

                // If LoanId is not stored (old data), match by MemberId from LoanPayments
                if (dbLoanId == null && l.MemberId != null)
                {
                    dbLoanId = paymentLoanMap
                        .FirstOrDefault(m => m.MemberId == (long?)l.MemberId)
                        .LoanId;
                }

                var line = new ManualJournalLine
                {
                    JournalLineId = (long)l.JournalLineId,
                    AccountId = mainAccountId,
                    SubsidiaryId = subsidiaryId,
                    MemberId = l.MemberId == null ? (long?)null : (long)l.MemberId,
                    ActiveLoanId = dbLoanId,
                    UseHouseholdMemberFilter = true,
                    Debit = (decimal)l.Debit,
                    Credit = (decimal)l.Credit,
                    Description = (string)l.Description
                };

                // اگر قبلاً تفصیلیِ اعضایی خارج از خانوار رسید انتخاب شده باشد،
                // در حالت ویرایش فیلتر خانوار را برای این خط خاموش کن تا تفصیلی لود شود و اطلاعات ناقص نشود.
                if (line.UseHouseholdMemberFilter
                    && line.MemberId.HasValue
                    && subsidiaryId.HasValue
                    && ReceiptInfo?.TargetHouseholdId != null
                    && ReceiptInfo.DocumentType == 1)
                {
                    var member = AvailableMembers.FirstOrDefault(m => m.MemberId == line.MemberId.Value);
                    if (member == null || !string.Equals(member.HouseholdCode, ReceiptInfo.TargetHouseholdId.ToString(), StringComparison.OrdinalIgnoreCase))
                    {
                        var selectedAccount = AvailableAccounts.FirstOrDefault(a => a.AccountId == subsidiaryId.Value);
                        if (selectedAccount?.Code?.StartsWith("M-", StringComparison.OrdinalIgnoreCase) == true)
                        {
                            line.UseHouseholdMemberFilter = false;
                        }
                    }
                }

                // مقداردهی لیست تفضیلی‌ها بر اساس معین انتخاب شده
                var desiredSubsidiaryId = line.SubsidiaryId;
                LoadSubsidiariesForMainAccount(line);

                // LoadSubsidiariesForMainAccount may reset the selection; restore it for edit mode.
                if (desiredSubsidiaryId.HasValue && desiredSubsidiaryId.Value > 0)
                {
                    var existsInList = line.AvailableSubsidiaries.Any(s => s.AccountId == desiredSubsidiaryId.Value);
                    if (existsInList)
                        line.SubsidiaryId = desiredSubsidiaryId;
                }

                JournalLines.Add(line);
            }

            // Load member snapshot/info for lines with selected subsidiary (edit mode)
            foreach (var line in JournalLines)
            {
                if (line.SubsidiaryId.HasValue && line.SubsidiaryId.Value > 0)
                {
                    // Preserve LoanId loaded from DB (may be a settled loan not found by normal guessing logic)
                    var preservedLoanId = line.ActiveLoanId;
                    await OnSubsidiarySelected(line, markDirty: false);
                    if (preservedLoanId.HasValue)
                        line.ActiveLoanId = preservedLoanId;
                }
            }

            // Recompute remaining/used amounts after hydrating lines (edit mode)
            UpdateUsedAmount();

            // Ensure auto-resize textareas after render so multi-line descriptions fit
            _pendingAutoResize = true;

            // به ابتدای فرم برو (اسکرول نرم و انیمیشن‌دار به بالا)
            await JS.InvokeVoidAsync("eval", "window.scrollTo({top: 0, behavior: 'smooth'});");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در بارگذاری سند برای ویرایش: {ex.Message}");
        }
    }

