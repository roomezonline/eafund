    // دکمه موقت: پاک کردن کامل داده‌های حسابداری (Transactions, Journals, JournalLines)
    private async Task ClearAllAccountingDataAsync()
    {
        try
        {
            // تأییدیه سمت کاربر در مرورگر
            bool confirmed = await JS.InvokeAsync<bool>("confirm",
                "هشدار: تمام رکوردهای جداول Transactions، Journals و JournalLines حذف می‌شوند. مطمئن هستید؟");

            if (!confirmed)
                return;

            // غیرفعال کردن ترگرها برای جلوگیری از خطا هنگام حذف
            await _db.ExecuteAsync("DISABLE TRIGGER ALL ON dbo.JournalLines");
            await _db.ExecuteAsync("DISABLE TRIGGER ALL ON dbo.Journals");

            try
            {
                // ترتیب امن پاک کردن: ابتدا خطوط ریزسند، بعد سند، بعد تراکنش
                const string sql = @"
DELETE FROM dbo.JournalLines;
DELETE FROM dbo.Journals;
DELETE FROM dbo.Transactions;";

                await _db.ExecuteAsync(sql);
            }
            finally
            {
                // فعال کردن مجدد ترگرها در هر صورت
                await _db.ExecuteAsync("ENABLE TRIGGER ALL ON dbo.JournalLines");
                await _db.ExecuteAsync("ENABLE TRIGGER ALL ON dbo.Journals");
            }

            Toast.Success("همه تراکنش‌ها و اسناد حسابداری با موفقیت حذف شدند");

            // پاک کردن وضعیت فرم در UI
            ClearForm();
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در حذف داده‌های حسابداری: {ex.Message}");
        }
    }

    private List<string> ValidateJournalLine(ManualJournalLine line, int lineNumber)
    {
        var errors = new List<string>();

        line.DescriptionError = null;

        // Check if main account is selected
        if (line.AccountId == 0)
        {
            errors.Add($"خط {lineNumber}: حساب معین باید انتخاب شود");
        }

        // Check if subsidiary account is selected (mandatory)
        if (!line.SubsidiaryId.HasValue || line.SubsidiaryId.Value == 0)
        {
            errors.Add($"خط {lineNumber}: حساب تفضیلی باید انتخاب شود");
        }

        // Check if either debit or credit is filled (but not both)
        if (line.Debit == 0 && line.Credit == 0)
        {
            errors.Add($"خط {lineNumber}: یکی از فیلدهای بدهکار یا بستانکار باید پر شود");
        }
        else if (line.Debit > 0 && line.Credit > 0)
        {
            errors.Add($"خط {lineNumber}: نمی‌توان همزمان هر دو فیلد بدهکار و بستانکار را پر کرد");
        }

        // Check if amount is positive
        if (line.Debit < 0 || line.Credit < 0)
        {
            errors.Add($"خط {lineNumber}: مقادیر بدهکار و بستانکار باید مثبت باشند");
        }

        if (string.IsNullOrWhiteSpace(line.Description))
        {
            line.DescriptionError = "شرح آرتیکل اجباری است";
            errors.Add($"خط {lineNumber}: شرح آرتیکل اجباری است");
        }

        // بررسی ترکیب ممنوع: معین 2301 یا 4101 با تفضیلی عضو
        if (line.AccountId != 0 && line.SubsidiaryId.HasValue && line.SubsidiaryId.Value != 0)
        {
            var moeen = AvailableAccounts.FirstOrDefault(a => a.AccountId == line.AccountId);
            if (moeen != null && IsRestrictedMoeenCode(moeen.Code))
            {
                var subsidiary = AvailableAccounts.FirstOrDefault(a => a.AccountId == line.SubsidiaryId.Value);
                if (IsMemberSubsidiary(subsidiary))
                {
                    errors.Add($"خط {lineNumber}: حساب معین {moeen.Code} - {moeen.Name} نمی‌تواند با حساب تفضیلی عضو ({subsidiary!.Code}) همراه باشد");
                }
            }
        }

        // بررسی: اگر کد معین با 4 شروع شود، تفضیلی فقط 444444 مجاز است
        if (line.AccountId != 0 && line.SubsidiaryId.HasValue && line.SubsidiaryId.Value != 0)
        {
            var moeen = AvailableAccounts.FirstOrDefault(a => a.AccountId == line.AccountId);
            if (moeen != null && moeen.Code.StartsWith("4"))
            {
                var subsidiary = AvailableAccounts.FirstOrDefault(a => a.AccountId == line.SubsidiaryId.Value);
                if (subsidiary != null && subsidiary.Code != "444444")
                {
                    errors.Add($"خط {lineNumber}: حساب معین {moeen.Code} - {moeen.Name} فقط با تفضیلی 444444 قابل ثبت است (انتخاب شده: {subsidiary.Code})");
                }
            }
        }

        // بررسی: اگر کد معین با 5 شروع شود، تفضیلی فقط 555555 مجاز است
        if (line.AccountId != 0 && line.SubsidiaryId.HasValue && line.SubsidiaryId.Value != 0)
        {
            var moeen = AvailableAccounts.FirstOrDefault(a => a.AccountId == line.AccountId);
            if (moeen != null && moeen.Code.StartsWith("5"))
            {
                var subsidiary = AvailableAccounts.FirstOrDefault(a => a.AccountId == line.SubsidiaryId.Value);
                if (subsidiary != null && subsidiary.Code != "555555")
                {
                    errors.Add($"خط {lineNumber}: حساب معین {moeen.Code} - {moeen.Name} فقط با تفضیلی 555555 قابل ثبت است (انتخاب شده: {subsidiary.Code})");
                }
            }
        }

        return errors;
    }

    private static bool IsRestrictedMoeenCode(string code) =>
        code is "2301" or "4101";

    private static bool IsMemberSubsidiary(Account? subsidiary) =>
        subsidiary != null &&
        (subsidiary.Code?.StartsWith("M-", StringComparison.OrdinalIgnoreCase) == true ||
         subsidiary.MemberId != null);

    private async Task<long> PostManualJournalAsync()
    {
        if (_db.State != ConnectionState.Open)
        {
            _db.Open();
        }

        var effectiveOccurredAt = GetEffectiveOccurredAt();

        // Validate fiscal year BEFORE starting transaction (FiscalYearRepo shares the same IDbConnection)
        var openYear = await FiscalYearRepo.GetOpenYearForDateAsync(effectiveOccurredAt);
        if (openYear == null)
            throw new InvalidOperationException($"برای تاریخ {effectiveOccurredAt:yyyy/MM/dd} سال مالی بازی وجود ندارد. لطفاً با مدیر سیستم تماس بگیرید.");

        using var transaction = _db.BeginTransaction();

        try
        {
            long journalId;

            if (IsEditMode && EditingJournalId.HasValue)
            {
                // بررسی: آیا سند رسید دارد؟ (TransactionId != NULL → دستی، TransactionId = NULL → سیستمی)
                var txId = await _db.QuerySingleOrDefaultAsync<long?>(
                    "SELECT TransactionId FROM dbo.Journals WHERE JournalId = @Id",
                    new { Id = EditingJournalId.Value }, transaction);

                if (txId == null) // سند سیستمی (بدون رسید)
                {
                    // حفظ متادیتای اسناد سیستمی (LoanDisburse, Run:, ...)
                    if (!string.IsNullOrEmpty(_originalJournalNotes))
                    {
                        var cat = TransactionPresentationService.PeekCategory(_originalJournalNotes);
                        if (cat != TransactionPresentationService.TransactionCategory.UserEntered &&
                            cat != TransactionPresentationService.TransactionCategory.Unknown)
                        {
                            var meta = GetSystemicMetadataSuffix(_originalJournalNotes);
                            if (!string.IsNullOrEmpty(meta))
                                Description = $"{Description.Trim()} | {meta}";
                        }
                        else
                        {
                            // بازسازی متادیتا برای اسناد سیستمی که متادیتای آن‌ها در ویرایش قبلی حذف شده
                            var hasLoanId = await _db.QuerySingleAsync<bool>(
                                "SELECT COUNT(1) FROM dbo.JournalLines WHERE JournalId = @Id AND LoanId IS NOT NULL AND LoanId > 0",
                                new { Id = EditingJournalId.Value }, transaction);

                            if (hasLoanId)
                            {
                                var lines = await _db.QueryAsync<dynamic>(
                                    @"SELECT LoanId, MemberId FROM dbo.JournalLines
                                      WHERE JournalId = @Id AND LoanId IS NOT NULL AND LoanId > 0",
                                    new { Id = EditingJournalId.Value }, transaction);
                                var loanId = lines.Select(l => (long)l.LoanId).FirstOrDefault();
                                var memberId = lines
                                    .Select(l => (long?)l.MemberId)
                                    .FirstOrDefault(m => m.HasValue && m.Value > 0);

                                var meta = $"LoanDisburse | Loan:{loanId}";
                                if (memberId.HasValue)
                                    meta += $" | Member:{memberId}";
                                Description = $"{Description.Trim()} | {meta}";
                            }
                        }
                    }
                }
                // اگر سند رسید دارد، متادیتا را دست‌کاری نکن — Description کاربر همانی است که ذخیره می‌شود

                // ویرایش سند موجود: فقط هدر را آپدیت می‌کنیم
                journalId = EditingJournalId.Value;
                var updateSql = @"UPDATE dbo.Journals SET OccurredAt = @OccurredAt, Notes = @Notes";
                if (_isTemporary)
                    updateSql += ", Status = 1";
                else
                    updateSql += ", Status = 2";
                updateSql += " WHERE JournalId = @JournalId";
                await _db.ExecuteAsync(updateSql,
                    new {
                        JournalId = journalId,
                        OccurredAt = effectiveOccurredAt,
                        Notes = Description
                    }, transaction);
            }
            else
            {
                // ایجاد سند جدید
                var journalStatus = (byte)(_isTemporary ? 1 : 2);
                journalId = await _db.QuerySingleAsync<long>(@"
                    INSERT INTO dbo.Journals (TransactionId, OccurredAt, Notes, CreatedAt, CreatedBy, ProcessId, Status)
                    VALUES (@TransactionId, @OccurredAt, @Notes, GETUTCDATE(), 'admin', @ProcessId, @Status);
                    SELECT CAST(SCOPE_IDENTITY() AS BIGINT)",
                    new { 
                        TransactionId = (object?)null, // Manual journal entries have no transaction
                        OccurredAt = effectiveOccurredAt,
                        Notes = Description,
                        ProcessId = Guid.NewGuid().ToString(),
                        Status = journalStatus
                    }, transaction);
            }

            if (!_isTemporary)
            {
                var existingDocNum = await _db.QuerySingleOrDefaultAsync<int?>(
                    "SELECT DocumentNumber FROM dbo.Journals WHERE JournalId = @journalId",
                    new { journalId }, transaction);
                if (existingDocNum == null || existingDocNum == 0)
                {
                    var fy = openYear;
                    await _db.ExecuteAsync(
                            @"IF NOT EXISTS (SELECT 1 FROM dbo.SerialCounters WHERE FiscalYearId = @id)
                              INSERT INTO dbo.SerialCounters (FiscalYearId, LastDocumentNumber)
                              SELECT @id, ISNULL(MAX(DocumentNumber), 0) FROM dbo.Journals WHERE FiscalYearId = @id",
                            new { id = fy.FiscalYearId }, transaction);
                        var docNum = await _db.QuerySingleAsync<int>(@"
                            UPDATE dbo.SerialCounters
                            SET LastDocumentNumber = LastDocumentNumber + 1
                            OUTPUT INSERTED.LastDocumentNumber
                            WHERE FiscalYearId = @fiscalYearId",
                            new { fiscalYearId = fy.FiscalYearId }, transaction);
                        await _db.ExecuteAsync(
                            "UPDATE dbo.Journals SET DocumentNumber = @docNum WHERE JournalId = @journalId",
                            new { docNum, journalId }, transaction);
                }
            }

            // Build journal lines
            var journalLines = new List<object>();
            int lineNo = 1;

            foreach (var line in JournalLines.Where(l => l.Debit > 0 || l.Credit > 0))
            {
                if (!_isTemporary)
                {
                    // Validate account selection
                    if (line.AccountId == 0)
                    {
                        throw new InvalidOperationException("برای هر خط باید یک حساب معین انتخاب شود");
                    }

                    // Validate subsidiary account selection (mandatory)
                    if (!line.SubsidiaryId.HasValue || line.SubsidiaryId.Value == 0)
                    {
                        throw new InvalidOperationException($"خط {journalLines.Count + 1}: حساب تفضیلی باید انتخاب شود");
                    }

                    // Additional validation: ensure only one of debit or credit is filled
                    if (line.Debit > 0 && line.Credit > 0)
                    {
                        throw new InvalidOperationException($"خط {journalLines.Count + 1}: نمی‌توان همزمان هر دو فیلد بدهکار و بستانکار را پر کرد");
                    }
                }

                // Determine the final account to post
                long accountToPost = line.AccountId; // Default to main account
                long? memberId = null;
                long? parentAccountId = null;

                // If subsidiary account is selected, use it directly
                if (line.SubsidiaryId.HasValue && line.SubsidiaryId.Value > 0)
                {
                    accountToPost = line.SubsidiaryId.Value;
                    parentAccountId = line.AccountId; // Store the main account as parent
                    memberId = line.MemberId; // Member is already set by OnSubsidiarySelected
                }

                journalLines.Add(new
                {
                    JournalLineId = line.JournalLineId,
                    JournalId = journalId,
                    LineNo = lineNo,
                    AccountId = accountToPost,
                    ParentAccountId = parentAccountId,
                    MemberId = memberId,
                    LoanId = line.ActiveLoanId,
                    Debit = line.Debit,
                    Credit = line.Credit,
                    Description = line.Description
                });

                lineNo++;
            }

            var affectedApprovedLoanIds = new List<long>();

            if (!_isTemporary)
            {
                // Validate balance again (double-check)
                var totalDebit = journalLines.Sum(jl => (decimal)jl.GetType().GetProperty("Debit").GetValue(jl));
                var totalCredit = journalLines.Sum(jl => (decimal)jl.GetType().GetProperty("Credit").GetValue(jl));

                if (Math.Abs(totalDebit - totalCredit) > 0.01m)
                {
                    throw new InvalidOperationException($"سند متعادل نیست: بدهکار={totalDebit:N0}, بستانکار={totalCredit:N0}");
                }

                affectedApprovedLoanIds = await ValidateAndGetApprovedLoansForDisbursementAsync(journalLines, transaction);

                await ValidateActiveLoanExistsForInstallmentPostingAsync(journalLines, transaction);
            }

            // Disable triggers temporarily
            await _db.ExecuteAsync("DISABLE TRIGGER ALL ON dbo.JournalLines", null, transaction);
            await _db.ExecuteAsync("DISABLE TRIGGER ALL ON dbo.Journals", null, transaction);

            try
            {
                if (IsEditMode && EditingJournalId.HasValue)
                {
                    // Guard: don't allow empty lines in edit mode
                    if (journalLines.Count == 0)
                        throw new InvalidOperationException("خطایی در بارگذاری خطوط سند رخ داده است");

                    await UndoLoanPaymentsForManualJournalAsync(EditingJournalId.Value, transaction);

                    // Get existing line IDs from DB for this journal
                    var existingLineIds = (await _db.QueryAsync<long>(
                        "SELECT JournalLineId FROM dbo.JournalLines WHERE JournalId = @JournalId",
                        new { JournalId = EditingJournalId.Value }, transaction)).ToHashSet();

                    // Lines to delete (in DB but not in current JournalLines)
                    var newLineIds = journalLines
                        .Select(jl => (long?)jl.GetType().GetProperty("JournalLineId")?.GetValue(jl))
                        .Where(id => id.HasValue && id.Value > 0)
                        .Select(id => id!.Value)
                        .ToHashSet();

                    var toDelete = existingLineIds.Except(newLineIds).ToList();
                    if (toDelete.Count > 0)
                    {
                        await _db.ExecuteAsync(
                            "DELETE FROM dbo.JournalLines WHERE JournalLineId IN @Ids",
                            new { Ids = toDelete }, transaction);
                    }

                    // For each journal line, UPDATE if exists or INSERT if new
                    foreach (var jl in journalLines)
                    {
                        var jlId = (long?)jl.GetType().GetProperty("JournalLineId")?.GetValue(jl);
                        var jlLineNo = (int)jl.GetType().GetProperty("LineNo")!.GetValue(jl)!;
                        var jlAccountId = (long)jl.GetType().GetProperty("AccountId")!.GetValue(jl)!;
                        var jlParentAccountId = (long?)jl.GetType().GetProperty("ParentAccountId")?.GetValue(jl);
                        var jlMemberId = (long?)jl.GetType().GetProperty("MemberId")?.GetValue(jl);
                        var jlLoanId = (long?)jl.GetType().GetProperty("LoanId")?.GetValue(jl);
                        var jlDebit = (decimal)jl.GetType().GetProperty("Debit")!.GetValue(jl)!;
                        var jlCredit = (decimal)jl.GetType().GetProperty("Credit")!.GetValue(jl)!;
                        var jlDescription = (string?)jl.GetType().GetProperty("Description")?.GetValue(jl);

                        if (jlId.HasValue && jlId.Value > 0)
                        {
                            // UPDATE existing line
                            await _db.ExecuteAsync(@"
                                UPDATE dbo.JournalLines SET
                                    [LineNo] = @LineNo,
                                    AccountId = @AccountId,
                                    ParentAccountId = @ParentAccountId,
                                    MemberId = @MemberId,
                                    LoanId = @LoanId,
                                    Debit = @Debit,
                                    Credit = @Credit,
                                    Description = @Description
                                WHERE JournalLineId = @JournalLineId",
                                new
                                {
                                    JournalLineId = jlId.Value,
                                    LineNo = jlLineNo,
                                    AccountId = jlAccountId,
                                    ParentAccountId = jlParentAccountId,
                                    MemberId = jlMemberId,
                                    LoanId = jlLoanId,
                                    Debit = jlDebit,
                                    Credit = jlCredit,
                                    Description = jlDescription
                                }, transaction);
                        }
                        else
                        {
                            // INSERT new line
                            await _db.ExecuteAsync(@"
                                INSERT INTO dbo.JournalLines (JournalId, [LineNo], AccountId, ParentAccountId, MemberId, LoanId, Debit, Credit, Description)
                                VALUES (@JournalId, @LineNo, @AccountId, @ParentAccountId, @MemberId, @LoanId, @Debit, @Credit, @Description)",
                                new
                                {
                                    JournalId = journalId,
                                    LineNo = jlLineNo,
                                    AccountId = jlAccountId,
                                    ParentAccountId = jlParentAccountId,
                                    MemberId = jlMemberId,
                                    LoanId = jlLoanId,
                                    Debit = jlDebit,
                                    Credit = jlCredit,
                                    Description = jlDescription
                                }, transaction);
                        }
                    }
                }
                else
                {
                    // New journal: insert all lines
                    foreach (var jl in journalLines)
                    {
                        await _db.ExecuteAsync(@"
                            INSERT INTO dbo.JournalLines (JournalId, [LineNo], AccountId, ParentAccountId, MemberId, LoanId, Debit, Credit, Description)
                            VALUES (@JournalId, @LineNo, @AccountId, @ParentAccountId, @MemberId, @LoanId, @Debit, @Credit, @Description)",
                            new
                            {
                                JournalId = journalId,
                                LineNo = (int)jl.GetType().GetProperty("LineNo")!.GetValue(jl)!,
                                AccountId = (long)jl.GetType().GetProperty("AccountId")!.GetValue(jl)!,
                                ParentAccountId = (long?)jl.GetType().GetProperty("ParentAccountId")?.GetValue(jl),
                                MemberId = (long?)jl.GetType().GetProperty("MemberId")?.GetValue(jl),
                                LoanId = (long?)jl.GetType().GetProperty("LoanId")?.GetValue(jl),
                                Debit = (decimal)jl.GetType().GetProperty("Debit")!.GetValue(jl)!,
                                Credit = (decimal)jl.GetType().GetProperty("Credit")!.GetValue(jl)!,
                                Description = (string?)jl.GetType().GetProperty("Description")?.GetValue(jl)
                            }, transaction);
                    }
                }
            }
            finally
            {
                // Always re-enable the triggers
                await _db.ExecuteAsync("ENABLE TRIGGER ALL ON dbo.JournalLines", null, transaction);
                await _db.ExecuteAsync("ENABLE TRIGGER ALL ON dbo.Journals", null, transaction);
            }

            if (!_isTemporary)
            {
                if (affectedApprovedLoanIds.Count > 0)
                {
                    await MarkLoansAsDisbursedAsync(affectedApprovedLoanIds, transaction);
                }

                await TryApplyLoanPaymentFromManualJournalAsync(journalId, journalLines, transaction);
            }

            // Commit transaction
            transaction.Commit();
            return journalId;
        }
        catch
        {
            transaction.Rollback();
            throw;
        }
    }

    private async Task<List<long>> ValidateAndGetApprovedLoansForDisbursementAsync(List<object> journalLines, IDbTransaction tx)
    {
        if (journalLines == null || journalLines.Count == 0)
            return new List<long>();

        // When editing an existing journal, skip disbursement validation
        // because loan status may have changed since the original posting.
        if (IsEditMode)
            return new List<long>();

        var postedLines = new List<PostedJournalLine>();
        foreach (var jl in journalLines)
        {
            postedLines.Add(new PostedJournalLine
            {
                JournalId = (long)jl.GetType().GetProperty("JournalId")!.GetValue(jl)!,
                LineNo = (int)jl.GetType().GetProperty("LineNo")!.GetValue(jl)!,
                AccountId = (long)jl.GetType().GetProperty("AccountId")!.GetValue(jl)!,
                ParentAccountId = (long?)jl.GetType().GetProperty("ParentAccountId")!.GetValue(jl),
                MemberId = (long?)jl.GetType().GetProperty("MemberId")!.GetValue(jl),
                Debit = (decimal)jl.GetType().GetProperty("Debit")!.GetValue(jl)!,
                Credit = (decimal)jl.GetType().GetProperty("Credit")!.GetValue(jl)!,
                Description = (string?)jl.GetType().GetProperty("Description")!.GetValue(jl)
            });
        }

        var candidateLines = postedLines
            .Where(x => x.ParentAccountId.HasValue && x.ParentAccountId.Value > 0 && x.Debit > 0m)
            .ToList();

        if (candidateLines.Count == 0)
            return new List<long>();

        var parentAccountIds = candidateLines
            .Select(x => x.ParentAccountId!.Value)
            .Distinct()
            .ToList();

        const string sqlAccounts = @"SELECT AccountId, Code FROM dbo.Accounts WHERE AccountId IN @ids";
        var parentCodes = (await _db.QueryAsync<(long AccountId, string Code)>(sqlAccounts, new { ids = parentAccountIds }, tx))
            .ToDictionary(x => x.AccountId, x => (x.Code ?? string.Empty).Trim(), EqualityComparer<long>.Default);

        var accountIds = candidateLines
            .Select(x => x.AccountId)
            .Where(x => x > 0)
            .Distinct()
            .ToList();

        var accountCodes = (await _db.QueryAsync<(long AccountId, string Code)>(sqlAccounts, new { ids = accountIds }, tx))
            .ToDictionary(x => x.AccountId, x => (x.Code ?? string.Empty).Trim(), EqualityComparer<long>.Default);

        bool IsLoanDisbursementLine(PostedJournalLine l)
        {
            if (l.ParentAccountId.HasValue && l.ParentAccountId.Value > 0 && parentCodes.TryGetValue(l.ParentAccountId.Value, out var parentCode))
            {
                return string.Equals(parentCode, "1301", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(parentCode, "1302", StringComparison.OrdinalIgnoreCase);
            }

            if (l.AccountId > 0 && accountCodes.TryGetValue(l.AccountId, out var accountCode))
            {
                return string.Equals(accountCode, "1301", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(accountCode, "1302", StringComparison.OrdinalIgnoreCase);
            }

            return false;
        }

        var disbursementLines = candidateLines.Where(IsLoanDisbursementLine).ToList();
        if (disbursementLines.Count == 0)
            return new List<long>();

        // Only enforce this validation for member subsidiaries (M-...)
        bool IsMemberSubsidiary(PostedJournalLine l)
        {
            if (l.AccountId <= 0) return false;
            if (!accountCodes.TryGetValue(l.AccountId, out var c)) return false;
            return !string.IsNullOrWhiteSpace(c) && c.StartsWith("M-", StringComparison.OrdinalIgnoreCase);
        }

        disbursementLines = disbursementLines.Where(IsMemberSubsidiary).ToList();
        if (disbursementLines.Count == 0)
            return new List<long>();

        var disbursementMemberIds = disbursementLines
            .Where(x => x.MemberId.HasValue && x.MemberId.Value > 0)
            .Select(x => x.MemberId!.Value)
            .Distinct()
            .ToList();

        if (disbursementMemberIds.Count == 0)
        {
            throw new InvalidOperationException("خطا در ثبت سند پرداخت وام: برای ثبت بدهکار معین 1301 یا 1302، انتخاب تفضیلیِ عضو (M-...) الزامی است");
        }

        const string sqlApprovedLoan = @"SELECT TOP 1 LoanId FROM dbo.Loans WHERE MemberId = @memberId AND Status = 2 ORDER BY LoanId DESC";
        var approvedLoanIds = new List<long>();

        foreach (var memberId in disbursementMemberIds)
        {
            var loanId = await _db.ExecuteScalarAsync<long?>(sqlApprovedLoan, new { memberId }, tx);
            if (!loanId.HasValue || loanId.Value <= 0)
            {
                throw new InvalidOperationException("خطا در ثبت سند پرداخت وام: این عضو وامِ آماده پرداخت ندارد؛ ثبت سند مجاز نیست");
            }
            approvedLoanIds.Add(loanId.Value);
        }

        return approvedLoanIds.Distinct().ToList();
    }

    private async Task ValidateActiveLoanExistsForInstallmentPostingAsync(List<object> journalLines, IDbTransaction tx)
    {
        if (journalLines == null || journalLines.Count == 0)
            return;

        // When editing an existing journal, skip re-validating active loan existence
        // because loan status may have changed (e.g., 3→4) since the original posting.
        if (IsEditMode)
            return;

        var postedLines = new List<PostedJournalLine>();
        foreach (var jl in journalLines)
        {
            postedLines.Add(new PostedJournalLine
            {
                JournalId = (long)jl.GetType().GetProperty("JournalId")!.GetValue(jl)!,
                LineNo = (int)jl.GetType().GetProperty("LineNo")!.GetValue(jl)!,
                AccountId = (long)jl.GetType().GetProperty("AccountId")!.GetValue(jl)!,
                ParentAccountId = (long?)jl.GetType().GetProperty("ParentAccountId")!.GetValue(jl),
                MemberId = (long?)jl.GetType().GetProperty("MemberId")!.GetValue(jl),
                LoanId = (long?)jl.GetType().GetProperty("LoanId")!.GetValue(jl),
                Debit = (decimal)jl.GetType().GetProperty("Debit")!.GetValue(jl)!,
                Credit = (decimal)jl.GetType().GetProperty("Credit")!.GetValue(jl)!,
                Description = (string?)jl.GetType().GetProperty("Description")!.GetValue(jl)
            });
        }

        // If journal lines have stored LoanId (new/self-healed data), skip active loan validation
        // because the link is explicit and may refer to a settled loan.
        if (postedLines.Any(x => x.LoanId.HasValue))
            return;

        var candidateLines = postedLines
            .Where(x => x.ParentAccountId.HasValue && x.ParentAccountId.Value > 0 && x.Credit > 0m)
            .ToList();

        if (candidateLines.Count == 0)
            return;

        var parentAccountIds = candidateLines
            .Select(x => x.ParentAccountId!.Value)
            .Distinct()
            .ToList();

        const string sqlAccounts = @"SELECT AccountId, Code FROM dbo.Accounts WHERE AccountId IN @ids";
        var parentCodes = (await _db.QueryAsync<(long AccountId, string Code)>(sqlAccounts, new { ids = parentAccountIds }, tx))
            .ToDictionary(x => x.AccountId, x => (x.Code ?? string.Empty).Trim(), EqualityComparer<long>.Default);

        var accountIds = candidateLines
            .Select(x => x.AccountId)
            .Where(x => x > 0)
            .Distinct()
            .ToList();

        var accountCodes = (await _db.QueryAsync<(long AccountId, string Code)>(sqlAccounts, new { ids = accountIds }, tx))
            .ToDictionary(x => x.AccountId, x => (x.Code ?? string.Empty).Trim(), EqualityComparer<long>.Default);

        bool IsLoanInstallmentPostingLine(PostedJournalLine l)
        {
            if (l.ParentAccountId.HasValue && l.ParentAccountId.Value > 0 && parentCodes.TryGetValue(l.ParentAccountId.Value, out var parentCode))
            {
                return string.Equals(parentCode, "1301", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(parentCode, "1302", StringComparison.OrdinalIgnoreCase);
            }

            if (l.AccountId > 0 && accountCodes.TryGetValue(l.AccountId, out var accountCode))
            {
                return string.Equals(accountCode, "1301", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(accountCode, "1302", StringComparison.OrdinalIgnoreCase);
            }

            return false;
        }

        var installmentLines = candidateLines.Where(IsLoanInstallmentPostingLine).ToList();
        if (installmentLines.Count == 0)
            return;

        // Only enforce this validation for member subsidiaries (M-...)
        bool IsMemberSubsidiary(PostedJournalLine l)
        {
            if (l.AccountId <= 0) return false;
            if (!accountCodes.TryGetValue(l.AccountId, out var c)) return false;
            return !string.IsNullOrWhiteSpace(c) && c.StartsWith("M-", StringComparison.OrdinalIgnoreCase);
        }

        installmentLines = installmentLines.Where(IsMemberSubsidiary).ToList();
        if (installmentLines.Count == 0)
            return;

        var memberIds = installmentLines
            .Where(x => x.MemberId.HasValue && x.MemberId.Value > 0)
            .Select(x => x.MemberId!.Value)
            .Distinct()
            .ToList();

        if (memberIds.Count == 0)
        {
            throw new InvalidOperationException("خطا در ثبت سند قسط: برای ثبت بستانکار معین 1301 یا 1302، انتخاب تفضیلیِ عضو (M-...) الزامی است");
        }

        // For installment posting (credit 1301/1302), member must have a disbursed loan.
        // Status: 3=Disbursed
        const string sqlActiveLoan = @"SELECT TOP 1 LoanId FROM dbo.Loans WHERE MemberId = @memberId AND Status = 3 ORDER BY LoanId DESC";

        foreach (var memberId in memberIds)
        {
            var loanId = await _db.ExecuteScalarAsync<long?>(sqlActiveLoan, new { memberId }, tx);
            if (!loanId.HasValue || loanId.Value <= 0)
            {
                throw new InvalidOperationException("خطا در ثبت سند قسط: این عضو وام فعال/پرداخت‌شده ندارد؛ ثبت قسط برای عضو بدون وام مجاز نیست");
            }
        }
    }

    private Task MarkLoansAsDisbursedAsync(List<long> loanIds, IDbTransaction tx)
    {
        if (loanIds == null || loanIds.Count == 0)
            return Task.CompletedTask;

        const string sql = @"UPDATE dbo.Loans SET Status = 3, UpdatedAt = GETUTCDATE() WHERE LoanId IN @loanIds AND Status = 2";
        return _db.ExecuteAsync(sql, new { loanIds }, tx);
    }

    private sealed class PostedJournalLine
    {
        public long JournalId { get; set; }
        public int LineNo { get; set; }
        public long AccountId { get; set; }
        public long? ParentAccountId { get; set; }
        public long? MemberId { get; set; }
        public long? LoanId { get; set; }
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public string? Description { get; set; }
    }

    private async Task TryApplyLoanPaymentFromManualJournalAsync(long journalId, List<object> journalLines, IDbTransaction tx)
    {
        if (journalLines == null || journalLines.Count == 0)
            return;

        var postedLines = new List<PostedJournalLine>();
        foreach (var jl in journalLines)
        {
            postedLines.Add(new PostedJournalLine
            {
                JournalId = (long)jl.GetType().GetProperty("JournalId")!.GetValue(jl)!,
                LineNo = (int)jl.GetType().GetProperty("LineNo")!.GetValue(jl)!,
                AccountId = (long)jl.GetType().GetProperty("AccountId")!.GetValue(jl)!,
                ParentAccountId = (long?)jl.GetType().GetProperty("ParentAccountId")!.GetValue(jl),
                MemberId = (long?)jl.GetType().GetProperty("MemberId")!.GetValue(jl),
                LoanId = (long?)jl.GetType().GetProperty("LoanId")!.GetValue(jl),
                Debit = (decimal)jl.GetType().GetProperty("Debit")!.GetValue(jl)!,
                Credit = (decimal)jl.GetType().GetProperty("Credit")!.GetValue(jl)!,
                Description = (string?)jl.GetType().GetProperty("Description")!.GetValue(jl)
            });
        }

        var memberIds = postedLines
            .Where(x => x.MemberId.HasValue && x.MemberId.Value > 0)
            .Select(x => x.MemberId!.Value)
            .Distinct()
            .ToList();

        if (memberIds.Count == 0)
            return;

        var parentAccountIds = postedLines
            .Where(x => x.ParentAccountId.HasValue && x.ParentAccountId.Value > 0)
            .Select(x => x.ParentAccountId!.Value)
            .Distinct()
            .ToList();

        if (parentAccountIds.Count == 0)
            return;

        const string loanPrincipalAccountCode = "1301";
        const string loanInterestAccountCode = "1302";
        const string unrealizedInterestAccountCode = "2301";
        const string interestIncomeAccountCode = "4101";
        const string penaltyIncomeAccountCode = "4102";

        const string sqlAccounts = @"SELECT AccountId, Code FROM dbo.Accounts WHERE AccountId IN @ids";
        var parentCodes = (await _db.QueryAsync<(long AccountId, string Code)>(sqlAccounts, new { ids = parentAccountIds }, tx))
            .ToDictionary(x => x.AccountId, x => (x.Code ?? string.Empty).Trim(), EqualityComparer<long>.Default);

        var accountIds = postedLines
            .Select(x => x.AccountId)
            .Where(x => x > 0)
            .Distinct()
            .ToList();

        var accountCodes = (await _db.QueryAsync<(long AccountId, string Code)>(sqlAccounts, new { ids = accountIds }, tx))
            .ToDictionary(x => x.AccountId, x => (x.Code ?? string.Empty).Trim(), EqualityComparer<long>.Default);

        bool IsMemberSubsidiaryLine(PostedJournalLine l)
        {
            if (l.AccountId <= 0) return false;
            if (!accountCodes.TryGetValue(l.AccountId, out var c)) return false;
            return !string.IsNullOrWhiteSpace(c) && c.StartsWith("M-", StringComparison.OrdinalIgnoreCase);
        }

        bool TryGetLineCode(PostedJournalLine l, out string code)
        {
            code = string.Empty;
            if (l.ParentAccountId.HasValue && l.ParentAccountId.Value > 0 && parentCodes.TryGetValue(l.ParentAccountId.Value, out var pc))
            {
                code = pc;
                return true;
            }
            if (l.AccountId > 0 && accountCodes.TryGetValue(l.AccountId, out var ac))
            {
                code = ac;
                return true;
            }
            return false;
        }

        bool IsLoanDisbursementJournal(List<PostedJournalLine> lines)
        {
            return lines.Any(x => x.Debit > 0m
                && TryGetLineCode(x, out var c)
                && (string.Equals(c, loanPrincipalAccountCode, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(c, loanInterestAccountCode, StringComparison.OrdinalIgnoreCase)));
        }

        // If this journal debits 1301/1302 (loan principal/interest), it's a disbursement — skip payment.
        if (IsLoanDisbursementJournal(postedLines))
            return;

        bool HasLoanSignalForLines(List<PostedJournalLine> lines)
        {
            return lines.Any(x => TryGetLineCode(x, out var c) && string.Equals(c, loanPrincipalAccountCode, StringComparison.OrdinalIgnoreCase))
                || lines.Any(x => TryGetLineCode(x, out var c) && string.Equals(c, loanInterestAccountCode, StringComparison.OrdinalIgnoreCase))
                || lines.Any(x => TryGetLineCode(x, out var c) && string.Equals(c, interestIncomeAccountCode, StringComparison.OrdinalIgnoreCase))
                || lines.Any(x => TryGetLineCode(x, out var c) && string.Equals(c, penaltyIncomeAccountCode, StringComparison.OrdinalIgnoreCase));
        }

        decimal SumCreditByParentCode(List<PostedJournalLine> lines, string code)
        {
            decimal sum = 0m;
            foreach (var l in lines)
            {

                if (!TryGetLineCode(l, out var c))
                    continue;
                if (!string.Equals(c, code, StringComparison.OrdinalIgnoreCase))
                    continue;
                if (l.Credit > 0m)
                    sum += l.Credit;
            }
            return sum;
        }

        decimal SumDebitByParentCode(List<PostedJournalLine> lines, string code)
        {
            decimal sum = 0m;
            foreach (var l in lines)
            {

                if (!TryGetLineCode(l, out var c))
                    continue;
                if (!string.Equals(c, code, StringComparison.OrdinalIgnoreCase))
                    continue;
                if (l.Debit > 0m)
                    sum += l.Debit;
            }
            return sum;
        }

        const string sqlLoan = @"SELECT TOP 1 * FROM dbo.Loans WHERE MemberId = @memberId AND Status IN (2,3,4) ORDER BY LoanId DESC";
        const string sqlInstallments = @"
SELECT *
FROM dbo.LoanInstallments
WHERE LoanId = @loanId
  AND Status <> 3
ORDER BY InstallmentNo ASC";

        const string sqlInsertPayment = @"
INSERT INTO dbo.LoanPayments (LoanId, MemberId, PaidAt, Amount, IsApproved, ApprovedAt, ApprovedBy, Notes, CreatedAt)
OUTPUT INSERTED.PaymentId
VALUES (@LoanId, @MemberId, @PaidAt, @Amount, @IsApproved, @ApprovedAt, @ApprovedBy, @Notes, GETUTCDATE());";

        const string sqlInsertAlloc = @"
INSERT INTO dbo.LoanPaymentAllocations (PaymentId, InstallmentId, Type, Amount, CreatedAt)
VALUES (@PaymentId, @InstallmentId, @Type, @Amount, GETUTCDATE());";

        const string sqlUpdateInstallment = @"
UPDATE dbo.LoanInstallments
SET PaidPrincipal = @PaidPrincipal,
    PaidInterest = @PaidInterest,
    PaidPenalty = @PaidPenalty,
    Status = @Status
WHERE InstallmentId = @InstallmentId";

        var loanMembers = memberIds
            .Select(mid => new { mid, lines = postedLines.Where(x => x.MemberId == mid && IsMemberSubsidiaryLine(x)).ToList() })
            .Where(x => x.lines.Count > 0 && HasLoanSignalForLines(x.lines))
            .Select(x => x.mid)
            .Distinct()
            .ToList();

        var singleLoanMemberId = loanMembers.Count == 1 ? (long?)loanMembers[0] : null;

        foreach (var memberId in memberIds)
        {
            var memberLines = postedLines.Where(x => x.MemberId == memberId && IsMemberSubsidiaryLine(x)).ToList();
            if (memberLines.Count == 0)
                continue;

            if (!HasLoanSignalForLines(memberLines))
                continue;

            // If penalty lines are posted without member dimension (e.g., cashbox subsidiary) and there is only one
            // loan member in the journal, attribute them to that member.
            if (singleLoanMemberId.HasValue && singleLoanMemberId.Value == memberId)
            {
                var penaltyNoMember = postedLines.Where(x => !x.MemberId.HasValue && x.ParentAccountId.HasValue && parentCodes.TryGetValue(x.ParentAccountId.Value, out var c) && c == penaltyIncomeAccountCode).ToList();
                if (penaltyNoMember.Count > 0)
                    memberLines.AddRange(penaltyNoMember);
            }

            // Use stored LoanId from journal lines if available (eliminates guessing)
            var lineLoanId = memberLines.Select(x => x.LoanId).FirstOrDefault(id => id.HasValue);
            MiniBank.Web.Models.Loan? loan;
            if (lineLoanId.HasValue)
            {
                loan = await _db.QueryFirstOrDefaultAsync<MiniBank.Web.Models.Loan>(
                    "SELECT * FROM dbo.Loans WHERE LoanId = @loanId", new { loanId = lineLoanId.Value }, tx);
            }
            else
            {
                loan = await _db.QueryFirstOrDefaultAsync<MiniBank.Web.Models.Loan>(sqlLoan, new { memberId }, tx);
            }
            if (loan == null || loan.LoanId <= 0)
                continue;

            var installments = (await _db.QueryAsync<MiniBank.Web.Models.LoanInstallment>(sqlInstallments, new { loanId = loan.LoanId }, tx)).ToList();
            if (installments.Count == 0)
                continue;

            // Manual journal styles may post the receivable/payable accounts either as Debit or Credit.
            // We accept both directions and use the larger side as the intended paid amount.
            var principalCredit1301 = SumCreditByParentCode(memberLines, loanPrincipalAccountCode);
            var principalDebit1301 = SumDebitByParentCode(memberLines, loanPrincipalAccountCode);
            var paidPrincipal = Math.Max(principalCredit1301, principalDebit1301);

            var interestCredit1302 = SumCreditByParentCode(memberLines, loanInterestAccountCode);
            var interestDebit1302 = SumDebitByParentCode(memberLines, loanInterestAccountCode);
            var interestCredit4101 = SumCreditByParentCode(memberLines, interestIncomeAccountCode);
            var paidInterest = Math.Max(interestCredit1302, interestDebit1302);
            if (paidInterest <= 0m)
                paidInterest = interestCredit4101;

            var penaltyCredit4102 = SumCreditByParentCode(memberLines, penaltyIncomeAccountCode);
            var penaltyDebit4102 = SumDebitByParentCode(memberLines, penaltyIncomeAccountCode);
            var paidPenalty = Math.Max(penaltyCredit4102, penaltyDebit4102);

            var totalPaid = paidPrincipal + paidInterest + paidPenalty;
            if (totalPaid <= 0m)
                continue;

            var totalRemainingPrincipal = installments.Sum(x => Math.Max(0m, x.PrincipalAmount - x.PaidPrincipal));
            var totalRemainingInterest = installments.Sum(x => Math.Max(0m, x.InterestAmount - x.PaidInterest));

            if (paidPrincipal > totalRemainingPrincipal + 0.01m)
                throw new InvalidOperationException("مبلغ اصل ثبت‌شده در سند بیشتر از مانده اصل وام است");
            if (paidInterest > totalRemainingInterest + 0.01m)
                throw new InvalidOperationException("مبلغ سود ثبت‌شده در سند بیشتر از مانده سود وام است");

            var paymentId = await _db.QuerySingleAsync<long>(sqlInsertPayment, new
            {
                LoanId = loan.LoanId,
                MemberId = memberId,
                PaidAt = GetEffectiveOccurredAt(),
                Amount = totalPaid,
                IsApproved = true,
                ApprovedAt = GetEffectiveOccurredAt(),
                ApprovedBy = "admin",
                Notes = $"ManualJournal:{journalId}"
            }, tx);

            var remainingToAllocatePrincipal = paidPrincipal;
            var remainingToAllocateInterest = paidInterest;
            var remainingToAllocatePenalty = paidPenalty;

            var journalDate = GetEffectiveOccurredAt().Date;
            var penaltyDailyRate = (loan.PenaltyAnnualRatePercent / 100m) / 365m;

            foreach (var inst in installments)
            {
                if (remainingToAllocatePrincipal <= 0m && remainingToAllocateInterest <= 0m && remainingToAllocatePenalty <= 0m)
                    break;

                var instRemainingPrincipal = Math.Max(0m, inst.PrincipalAmount - inst.PaidPrincipal);
                var instRemainingInterest = Math.Max(0m, inst.InterestAmount - inst.PaidInterest);

                var allocPrincipal = Math.Min(instRemainingPrincipal, remainingToAllocatePrincipal);
                var allocInterest = Math.Min(instRemainingInterest, remainingToAllocateInterest);

                // Compute required penalty on the installment base amount as of journal date.
                var dueDate = inst.DueDate.Date;
                var overdueDays = Math.Max(0, (journalDate - dueDate).Days);
                var baseRemainingBefore = instRemainingPrincipal + instRemainingInterest;
                var potentialPenalty = (overdueDays > 0 && baseRemainingBefore > 0m)
                    ? (baseRemainingBefore * penaltyDailyRate * overdueDays)
                    : 0m;

                var requiredPenalty = ApplyLatePenalty ? potentialPenalty : 0m;

                var requiredPenaltyRemaining = Math.Max(0m, requiredPenalty - inst.PaidPenalty);
                var allocPenalty = remainingToAllocatePenalty > 0m
                    ? Math.Min(requiredPenaltyRemaining > 0m ? requiredPenaltyRemaining : remainingToAllocatePenalty, remainingToAllocatePenalty)
                    : 0m;

                if (allocPrincipal > 0m)
                {
                    await _db.ExecuteAsync(sqlInsertAlloc, new { PaymentId = paymentId, InstallmentId = inst.InstallmentId, Type = 3, Amount = allocPrincipal }, tx);
                    remainingToAllocatePrincipal -= allocPrincipal;
                }
                if (allocInterest > 0m)
                {
                    await _db.ExecuteAsync(sqlInsertAlloc, new { PaymentId = paymentId, InstallmentId = inst.InstallmentId, Type = 2, Amount = allocInterest }, tx);
                    remainingToAllocateInterest -= allocInterest;
                }
                if (allocPenalty > 0m)
                {
                    await _db.ExecuteAsync(sqlInsertAlloc, new { PaymentId = paymentId, InstallmentId = inst.InstallmentId, Type = 1, Amount = allocPenalty }, tx);
                    remainingToAllocatePenalty -= allocPenalty;
                }

                var newPaidPrincipal = inst.PaidPrincipal + allocPrincipal;
                var newPaidInterest = inst.PaidInterest + allocInterest;
                var newPaidPenalty = inst.PaidPenalty + allocPenalty;

                var isPrincipalPaid = newPaidPrincipal >= inst.PrincipalAmount - 0.01m;
                var isInterestPaid = newPaidInterest >= inst.InterestAmount - 0.01m;
                var isPenaltySatisfied = !ApplyLatePenalty || (newPaidPenalty >= requiredPenalty - 0.01m);

                // If penalty enforcement is disabled, but the installment was overdue at journal date,
                // record the unpaid penalty amount as waived/forgiven (Type=4) for future reporting.
                if (!ApplyLatePenalty && isPrincipalPaid && isInterestPaid && potentialPenalty > 0m)
                {
                    var waived = Math.Max(0m, potentialPenalty - newPaidPenalty);
                    if (waived > 0.01m)
                    {
                        await _db.ExecuteAsync(sqlInsertAlloc, new { PaymentId = paymentId, InstallmentId = inst.InstallmentId, Type = 4, Amount = waived }, tx);
                    }
                }

                var newStatus = (byte)((isPrincipalPaid && isInterestPaid && isPenaltySatisfied)
                    ? MiniBank.Web.Models.LoanInstallmentStatus.Paid
                    : ((allocPrincipal > 0m || allocInterest > 0m || allocPenalty > 0m) ? MiniBank.Web.Models.LoanInstallmentStatus.PartiallyPaid : inst.Status));

                if (allocPrincipal > 0m || allocInterest > 0m || allocPenalty > 0m)
                {
                    await _db.ExecuteAsync(sqlUpdateInstallment, new
                    {
                        PaidPrincipal = newPaidPrincipal,
                        PaidInterest = newPaidInterest,
                        PaidPenalty = newPaidPenalty,
                        Status = newStatus,
                        InstallmentId = inst.InstallmentId
                    }, tx);
                }

                // If late penalty is enabled and this installment is now fully paid (principal+interest) but penalty isn't,
                // do not allow paying subsequent installments.
                if (ApplyLatePenalty && (isPrincipalPaid && isInterestPaid) && !isPenaltySatisfied)
                {
                    throw new InvalidOperationException($"برای پاس شدن قسط شماره {inst.InstallmentNo}، پرداخت جریمه تاخیر الزامی است");
                }
            }

            if (remainingToAllocatePrincipal > 0.01m || remainingToAllocateInterest > 0.01m)
            {
                throw new InvalidOperationException("مبلغ پرداختی بیشتر از مانده اقساط است");
            }

            await UpdateLoanStatusFromInstallmentsAsync(loan.LoanId, tx);
        }
    }

    private async Task UpdateLoanStatusFromInstallmentsAsync(long loanId, IDbTransaction tx)
    {
        if (loanId <= 0)
            return;

        const string sqlRemaining = @"SELECT COUNT(1) FROM dbo.LoanInstallments WHERE LoanId = @loanId AND Status <> 3";
        var remainingCount = await _db.ExecuteScalarAsync<int>(sqlRemaining, new { loanId }, tx);

        const string sqlHasPayments = @"SELECT CASE WHEN EXISTS (SELECT 1 FROM dbo.LoanPayments WHERE LoanId = @loanId) THEN 1 ELSE 0 END";
        var hasPayments = await _db.ExecuteScalarAsync<int>(sqlHasPayments, new { loanId }, tx);

        const string sqlHasDisbursement = @"
SELECT CASE WHEN EXISTS (
    SELECT 1
    FROM dbo.vw_ApprovedJournals j
    WHERE j.Notes LIKE '%LoanDisburse%'
      AND j.Notes LIKE CONCAT('%Loan:', @loanId, '%')
) THEN 1 ELSE 0 END";
        var hasDisbursement = await _db.ExecuteScalarAsync<int>(sqlHasDisbursement, new { loanId }, tx);

        // Status lifecycle:
        // 2 = Approved (آماده پرداخت)
        // 3 = Disbursed (پرداخت شده / دارای تراکنش)
        // 5 = Settled (تسویه شده)
        if (remainingCount <= 0)
        {
            const string sqlSetSettled = @"UPDATE dbo.Loans SET Status = 5, UpdatedAt = GETUTCDATE() WHERE LoanId = @loanId AND Status <> 5";
            await _db.ExecuteAsync(sqlSetSettled, new { loanId }, tx);
            return;
        }

        if (hasPayments == 1 || hasDisbursement == 1)
        {
            const string sqlSetDisbursed = @"UPDATE dbo.Loans SET Status = 3, UpdatedAt = GETUTCDATE() WHERE LoanId = @loanId AND Status <> 3";
            await _db.ExecuteAsync(sqlSetDisbursed, new { loanId }, tx);
            return;
        }

        const string sqlSetApproved = @"UPDATE dbo.Loans SET Status = 2, UpdatedAt = GETUTCDATE() WHERE LoanId = @loanId AND Status <> 2";
        await _db.ExecuteAsync(sqlSetApproved, new { loanId }, tx);
    }

    // متد لینک کردن رسید به سند پس از ثبت موفق
    private async Task LinkReceiptToJournalAsync(long receiptId, long journalId)
    {
        const string sql = @"
            UPDATE dbo.HouseholdReceipts 
            SET ExternalRef = @ExternalRef, 
                Status = 1 
            WHERE HouseholdReceiptId = @ReceiptId";
        
        await _db.ExecuteAsync(sql, new 
        { 
            ExternalRef = $"J:{journalId}",
            ReceiptId = receiptId
        });
    }

