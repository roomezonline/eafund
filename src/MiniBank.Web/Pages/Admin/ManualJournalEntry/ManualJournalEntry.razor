@code {
    [SupplyParameterFromQuery(Name = "receiptId")]
    public long? ReceiptId { get; set; }

    [SupplyParameterFromQuery(Name = "journalId")]
    public long? JournalId { get; set; }

    [SupplyParameterFromQuery(Name = "oldAmount")]
    public decimal? OldReceiptAmount { get; set; }

    // Receipt information for display
    private dynamic? ReceiptInfo { get; set; }

    private bool IsLoading => Loading?.IsShown == true;

    private void GoBackToStage1()
    {
        if (ReceiptId.HasValue)
        {
            if (JournalId.HasValue)
                NavigationManager.NavigateTo($"/admin/manual-journal-entry-v2?receiptId={ReceiptId.Value}&journalId={JournalId.Value}");
            else
                NavigationManager.NavigateTo($"/admin/manual-journal-entry-v2?receiptId={ReceiptId.Value}");
            return;
        }

        NavigationManager.NavigateTo("/admin/manual-journal-entry-v2");
    }

    private string OccurredAt = "";
    private string Description = "";
    private string? _originalJournalNotes;
    private List<ManualJournalLine> JournalLines = new();

    private bool hasUnsavedChanges = false;

    private bool _showLeaveConfirm = false;
    private string? _pendingLeaveTarget = null;
    private bool _allowLeaveOnce = false;

    private bool _showDepositSmsConfirm = false;
    private string _depositSmsConfirmMessage = string.Empty;
    private string _depositSmsMobile = string.Empty;
    private long _depositMemberId = 0;
    private decimal _depositAmount = 0m;
    private decimal _depositNewBalance = 0m;
    private string _depositMessageText = string.Empty;
    private bool _pendingResetAfterDepositSms = false;
    private bool _pendingNavigateAfterDepositSms = false;

    private bool _showLoanPaymentSmsConfirm = false;
    private string _loanPaymentSmsConfirmMessage = string.Empty;
    private string _loanPaymentSmsMobile = string.Empty;
    private long _loanPaymentMemberId = 0;
    private decimal _loanPaymentAmount = 0m;
    private decimal _loanPaymentNewBalance = 0m;
    private string _loanPaymentMessageText = string.Empty;
    private long? _loanPaymentHouseholdId = null;
    private string _loanPaymentMemberIdsJson = string.Empty;
    private bool _pendingResetAfterLoanPaymentSms = false;
    private bool _pendingNavigateAfterLoanPaymentSms = false;

    private bool _queueLoanSmsAfterDeposit = false;

    private CancellationTokenSource? _draftSaveCts;
    private bool _isRestoringDraft = false;
    private long? _draftReceiptIdScope = null;

    private void MarkDirty()
    {
        hasUnsavedChanges = true;
        if (!_isRestoringDraft)
        {
            _ = ScheduleDraftSaveAsync();
        }
    }

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (_allowLeaveOnce)
        {
            _allowLeaveOnce = false;
            return;
        }

        if (!hasUnsavedChanges)
            return;

        _pendingLeaveTarget = context.TargetLocation;
        context.PreventNavigation();
        _showLeaveConfirm = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task ConfirmLeaveAndNavigate()
    {
        _showLeaveConfirm = false;
        if (string.IsNullOrWhiteSpace(_pendingLeaveTarget))
            return Task.CompletedTask;

        _allowLeaveOnce = true;
        var target = _pendingLeaveTarget;
        _pendingLeaveTarget = null;
        return ConfirmLeaveAndNavigateInternalAsync(target);
    }

    private async Task ConfirmLeaveAndNavigateInternalAsync(string target)
    {
        await SaveDraftNowAsync();
        NavigationManager.NavigateTo(target);
    }

    private Task CancelLeave()
    {
        _showLeaveConfirm = false;
        _pendingLeaveTarget = null;
        return Task.CompletedTask;
    }

    // Amount tracking for live display
    private decimal ReceiptTotalAmount = 0;
    private decimal UsedAmount = 0;
    private decimal RemainingAmount => ReceiptTotalAmount - UsedAmount;

    // Separate tracking for debit and credit
    private decimal TotalDebitUsed => JournalLines.Sum(l => l.Debit);
    private decimal TotalCreditUsed => JournalLines.Sum(l => l.Credit);
    private decimal DebitRemaining => ReceiptTotalAmount - TotalDebitUsed;
    private decimal CreditRemaining => ReceiptTotalAmount - TotalCreditUsed;

    // Confirmation dialog for amount exceed
    private bool _showAmountExceedConfirm = false;
    private bool _isTemporary = false;
    private string _amountExceedTitle = "هشدار تجاوز از مبلغ";
    private string _amountExceedMessage = string.Empty;

    private string GetAmountDisplay()
    {
        if (ReceiptTotalAmount == 0) return "0/0";
        return $"{ReceiptTotalAmount:N0}/{RemainingAmount:N0}";
    }

    private string GetDebitDisplay()
    {
        if (ReceiptTotalAmount == 0) return "0/0";
        return $"{ReceiptTotalAmount:N0}/{DebitRemaining:N0}";
    }

    private string GetCreditDisplay()
    {
        if (ReceiptTotalAmount == 0) return "0/0";
        return $"{ReceiptTotalAmount:N0}/{CreditRemaining:N0}";
    }

    private string GetDebitCapsuleCssClass()
    {
        if (ReceiptTotalAmount == 0) return "";
        
        // Always use green color for debit, regardless of remaining amount
        if (DebitRemaining <= 0)
        {
            return "debit-capsule-complete"; // سبز تیره - کامل تسهیم شده
        }
        else if (DebitRemaining < ReceiptTotalAmount * 0.1m) // کمتر از 10% مانده
        {
            return "debit-capsule-warning"; // سبز روشن - نزدیک به پایان
        }
        else
        {
            return "debit-capsule-normal"; // سبز - هنوز مانده دارد
        }
    }

    private string GetCreditCapsuleCssClass()
    {
        if (ReceiptTotalAmount == 0) return "";
        
        // Always use red color for credit, regardless of remaining amount
        if (CreditRemaining <= 0)
        {
            return "credit-capsule-complete"; // قرمز تیره - کامل تسهیم شده
        }
        else if (CreditRemaining < ReceiptTotalAmount * 0.1m) // کمتر از 10% مانده
        {
            return "credit-capsule-warning"; // قرمز روشن - نزدیک به پایان
        }
        else
        {
            return "credit-capsule-normal"; // قرمز - هنوز مانده دارد
        }
    }

    private string GetCapsuleCssClass()
    {
        if (ReceiptTotalAmount == 0) return "";
        
        if (RemainingAmount <= 0)
        {
            return "capsule-complete"; // سبز - کامل تسهیم شده
        }
        else if (RemainingAmount < ReceiptTotalAmount * 0.1m) // کمتر از 10% مانده
        {
            return "capsule-warning"; // نارنجی - نزدیک به پایان
        }
        else
        {
            return "capsule-normal"; // قرمز - هنوز مانده دارد
        }
    }

    private void UpdateUsedAmount()
    {
        var totalDebit = JournalLines.Sum(l => l.Debit);
        var totalCredit = JournalLines.Sum(l => l.Credit);

        // In double-entry, for a fixed total (like receipt allocation),
        // the effective consumed amount is the larger side, not Debit+Credit.
        UsedAmount = ReceiptTotalAmount > 0 ? Math.Max(totalDebit, totalCredit) : (totalDebit + totalCredit);
        StateHasChanged(); // Trigger UI update for live display
    }
    private List<Account> AvailableAccounts = new();
    private List<Account> AvailableSubsidiaries = new();
    private List<Account> AvailableMainAccounts = new(); // حساب‌های معین (Level 3)
    private List<Member> AvailableMembers = new(); // لیست اعضا برای فیلتر کردن تفضیلی‌ها
    private HashSet<long> TargetHouseholdMemberIds = new();

    // Edit mode state
    private bool IsEditMode = false;
    private long? EditingJournalId = null;
    private bool _pendingAutoResize;

    private bool ApplyLatePenalty = false;

    private bool _isDirty;
    private DateTime _lastDraftSaveUtc;

    // Journal History Properties
    private List<JournalHistoryItem> JournalHistory = new();
    private List<JournalHistoryItem> FilteredJournalHistory = new();
    private List<long> ExpandedJournals = new();
    private bool JournalHistoryLoading = false;
    private string SearchTerm = "";
    private string FromDate = "";
    private string ToDate = "";

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

