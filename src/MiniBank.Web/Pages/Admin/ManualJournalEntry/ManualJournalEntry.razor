    // متد برای فوکوس روی اولین فیلد خالی و پر کردن مبلغ مانده
    private void FocusAndFillRemainingAmount(string? type = null)
    {
        decimal remaining = type == "debit" ? DebitRemaining : 
                           type == "credit" ? CreditRemaining : 
                           RemainingAmount;

        if (remaining <= 0)
        {
            Toast.Info("مانده‌ای برای تخصیص وجود ندارد");
            return;
        }

        // پیدا کردن اولین خط خالی یا آخرین خط
        ManualJournalLine targetLine;
        
        if (type != null)
        {
            // برای نوع خاص، اولین خط خالی از همان نوع را پیدا کن
            targetLine = JournalLines.FirstOrDefault(line => 
                (type == "debit" && line.Debit == 0 && line.Credit == 0) ||
                (type == "credit" && line.Credit == 0 && line.Debit == 0));
        }
        else
        {
            // اگر فیلدی فوکوس نشده، اولین خط خالی را پیدا کن
            targetLine = JournalLines.FirstOrDefault(line => line.Debit == 0 && line.Credit == 0);
        }
        
        if (targetLine == null)
        {
            // اگر خط خالی وجود ندارد، یک خط جدید اضافه کن
            AddLine();
            targetLine = JournalLines.Last();
        }

        // پر کردن مبلغ مانده در فیلد مناسب
        if (type == "debit")
        {
            targetLine.Debit = remaining;
        }
        else if (type == "credit")
        {
            targetLine.Credit = remaining;
        }
        else
        {
            // رفتار پیش‌فرض: بدهکار
            targetLine.Debit = remaining;
        }
        
        UpdateUsedAmount();
        
        // به‌روزرسانی UI و فوکوس روی فیلد مربوطه
        StateHasChanged();
    }

