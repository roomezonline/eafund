</style>

<div class="journal-entry-container">
    <div class="top-actions-bar">
        <button class="back-stage1-btn" @onclick="GoBackToStage1">
            <i class="fas fa-arrow-right"></i> برگشت به مرحله اول
        </button>
    </div>

    <div class="dashboard-top-center">
        <button class="dashboard-return-btn" @onclick="ReturnToDashboard">
            <i class="fas fa-home"></i> بازگشت به داشبورد
        </button>
    </div>
    @if (IsLoading)
    {
        <div style="text-align:center; padding: 20px;">
            <i class="fas fa-spinner fa-spin"></i>
            <span style="margin-right: 10px;">در حال بارگذاری...</span>
        </div>
    }
    @if (ReceiptId.HasValue && ReceiptInfo != null)
    {
        <!-- Receipt Information Card -->
        <div class="receipt-info-card">
            <div class="receipt-header">
                <h3><i class="fas fa-receipt"></i> اطلاعات رسید مرحله اول</h3>
                <div class="receipt-id">رسید @ReceiptInfo.HouseholdReceiptId</div>
            </div>
            
            <div class="receipt-content">
                <!-- Desktop Layout -->
                <div class="receipt-desktop-layout">
                    <div class="receipt-section">
                        <div class="receipt-row-horizontal">
                            <div class="receipt-item">
                                <div class="receipt-capsule amount">
                                    <div class="label">مبلغ</div>
                                    <div class="value">@Convert.ToDecimal(ReceiptInfo.Amount).ToString("N0") ریال</div>
                                </div>
                            </div>
                            <div class="receipt-item">
                                <div class="receipt-capsule">
                                    <div class="label">تاریخ</div>
                                    <div class="value">@GetJalaliDateFromGregorian((DateTime)ReceiptInfo.OccurredAt)</div>
                                </div>
                            </div>
                            <div class="receipt-item">
                                <div class="receipt-capsule">
                                    <div class="label">نوع سند</div>
                                    <div class="value">@(ReceiptInfo.DocumentTypeName)</div>
                                </div>
                            </div>
                            <div class="receipt-item">
                                <div class="receipt-capsule">
                                    <div class="label">نوع تراکنش</div>
                                    <div class="value">@(ReceiptInfo.TransactionTypeName)</div>
                                </div>
                            </div>
                            <div class="receipt-item">
                                <div class="receipt-capsule">
                                    <div class="label">خانوار</div>
                                    <div class="value">@(ReceiptInfo.HouseholdName ?? "-")</div>
                                </div>
                            </div>
                            <div class="receipt-item">
                                <div class="receipt-capsule">
                                    <div class="label">طرف مقابل</div>
                                    <div class="value">@(ReceiptInfo.CounterpartyName ?? "-")</div>
                                </div>
                            </div>
                            <div class="receipt-item">
                                <div class="receipt-capsule">
                                    <div class="label">کانال</div>
                                    <div class="value">@(ReceiptInfo.ChannelName)</div>
                                </div>
                            </div>
                            <div class="receipt-item">
                                <div class="receipt-capsule">
                                    <div class="label">شرح رسید</div>
                                    <div class="value">@(string.IsNullOrEmpty(ReceiptInfo.Notes) ? "بدون شرح" : ReceiptInfo.Notes)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Mobile Layout -->
                <div class="receipt-mobile-layout">
                    <div class="receipt-item">
                        <div class="receipt-capsule amount">
                            <div class="label">مبلغ</div>
                            <div class="value">@Convert.ToDecimal(ReceiptInfo.Amount).ToString("N0") ریال</div>
                        </div>
                    </div>
                    <div class="receipt-item">
                        <div class="receipt-capsule">
                            <div class="label">تاریخ</div>
                            <div class="value">@GetJalaliDateFromGregorian((DateTime)ReceiptInfo.OccurredAt)</div>
                        </div>
                    </div>
                    <div class="receipt-item">
                        <div class="receipt-capsule">
                            <div class="label">نوع سند</div>
                            <div class="value">@(ReceiptInfo.DocumentTypeName ?? "-")</div>
                        </div>
                    </div>
                    <div class="receipt-item">
                        <div class="receipt-capsule">
                            <div class="label">نوع تراکنش</div>
                            <div class="value">@(ReceiptInfo.TransactionTypeName ?? "-")</div>
                        </div>
                    </div>
                    <div class="receipt-item">
                        <div class="receipt-capsule">
                            <div class="label">خانوار</div>
                            <div class="value">@(ReceiptInfo.HouseholdName ?? "-")</div>
                        </div>
                    </div>
                    <div class="receipt-item">
                        <div class="receipt-capsule">
                            <div class="label">طرف مقابل</div>
                            <div class="value">@(ReceiptInfo.CounterpartyName ?? "-")</div>
                        </div>
                    </div>
                    <div class="receipt-item">
                        <div class="receipt-capsule">
                            <div class="label">کانال</div>
                            <div class="value">@(ReceiptInfo.ChannelName)</div>
                        </div>
                    </div>
                    <div class="receipt-item">
                        <div class="receipt-capsule">
                            <div class="label">شرح رسید</div>
                            <div class="value">@(string.IsNullOrEmpty(ReceiptInfo.Notes) ? "بدون شرح" : ReceiptInfo.Notes)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top: 12px; margin-bottom: 12px; display: flex; justify-content: center;">
            <button class="dashboard-return-btn" @onclick="ReturnToDashboard">
                <i class="fas fa-home"></i> بازگشت به داشبورد
            </button>
        </div>
    }
    else
    {
        <!-- Stage 1: Manual Journal Entry without Receipt -->
        <div class="manual-journal-stage1">
           
            
            <!-- Middle Dashboard Return Button -->
            <div style="margin-top: 20px; margin-bottom: 20px; display: flex; justify-content: center;">
                <button class="dashboard-return-btn" @onclick="ReturnToDashboard">
                    <i class="fas fa-home"></i> بازگشت به داشبورد
                </button>
            </div>
        </div>
    }

    <!-- Journal Lines -->
    <div class="journal-lines-card">
        <div class="lines-header">
            <h3><i class="fas fa-list"></i> خطوط سند</h3>
            <div class="lines-header-actions">
                <button class="add-line-btn" @onclick="AddLine">
                    <i class="fas fa-plus"></i> افزودن خط
                </button>
            </div>
        </div>

        <div class="journal-notes-section">
            <label class="journal-notes-label"><i class="fas fa-align-left"></i> شرح سند</label>
            <textarea class="journal-notes-input" placeholder="شرح کلی سند..."
                      @bind="Description" />
        </div>

        @if (ReceiptTotalAmount > 0 && JournalLines.Count > 0)
        {
            var diff = Math.Abs(UsedAmount - ReceiptTotalAmount);
            if (diff > 0.01m)
            {
                <div class="amount-mismatch-banner">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>
                        @if (OldReceiptAmount.HasValue && OldReceiptAmount.Value > 0 && Math.Abs(OldReceiptAmount.Value - ReceiptTotalAmount) > 0.01m)
                        {
                            <span>مغایرت مبلغ: </span>
                            <span style="color:#dc3545;font-weight:700;">قدیم @OldReceiptAmount.Value.ToString("N0")</span>
                            <span> → </span>
                            <span style="color:#10b981;font-weight:700;">جدید @ReceiptTotalAmount.ToString("N0")</span>
                            <span> | مجموع خطوط: </span>
                            <span style="color:#f57c00;font-weight:700;">@UsedAmount.ToString("N0")</span>
                        }
                        else
                        {
                            <span>مغایرت مبلغ: مجموع خطوط (<span style="color:#dc3545;font-weight:700;">@UsedAmount.ToString("N0")</span>) با مبلغ رسید (<span style="color:#10b981;font-weight:700;">@ReceiptTotalAmount.ToString("N0")</span>) همخوانی ندارد</span>
                        }
                    </span>
                </div>
            }
        }

        @if (JournalLines.Count == 0)
        {
            <div class="empty-state">
                <i class="fas fa-plus-circle"></i>
                <p>هنوز خطی به سند اضافه نشده است</p>
                <button class="add-line-btn" @onclick="AddLine">
                    <i class="fas fa-plus"></i> افزودن اولین خط
                </button>
            </div>
        }
        else
        {
            
            <!-- Desktop Table View -->
            <div class="desktop-journal-container">
                <div class="desktop-journal-scroll">
                    <table class="journal-table">
                        <thead>
                            <tr>
                                <th style="width: 250px;">حساب معین</th>
                                <th style="width: 250px;">حساب تفضیلی</th>
                                <th style="width: 150px;">
                                    @if (ReceiptId.HasValue && ReceiptTotalAmount > 0)
                                    {
                                        <div class="amount-tracking-header">
                                            <div class="amount-tracking-capsule @GetDebitCapsuleCssClass()" @onclick="FocusAndFillDebitRemaining" style="cursor: pointer; margin-bottom: 8px;">
                                                <span class="amount-tracking-text">@GetDebitDisplay()</span>
                                            </div>
                                        </div>
                                    }
                                    بدهکار
                                </th>
                                <th style="width: 150px;">
                                    @if (ReceiptId.HasValue && ReceiptTotalAmount > 0)
                                    {
                                        <div class="amount-tracking-header">
                                            <div class="amount-tracking-capsule @GetCreditCapsuleCssClass()" @onclick="FocusAndFillCreditRemaining" style="cursor: pointer; margin-bottom: 8px;">
                                                <span class="amount-tracking-text">@GetCreditDisplay()</span>
                                            </div>
                                        </div>
                                    }
                                    بستانکار
                                </th>
                                <th style="width: 200px;">شرح</th>
                                <th style="width: 80px;">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in JournalLines)
                            {
                                <tr id="journal-line-@line.LineId" class="@GetRowClass(line)">
                                    <td>
                                        <div class="table-cell-content">
                                            <DsDropdown Label="" 
                                                  Placeholder="انتخاب حساب معین..." 
