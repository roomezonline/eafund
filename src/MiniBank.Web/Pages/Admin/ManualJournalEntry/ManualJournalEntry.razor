    private decimal DetectDepositAmount()
    {
        decimal sum = 0m;
        foreach (var l in JournalLines)
        {
            if (l.Credit <= 0m) continue;
            if (l.AccountId <= 0) continue;
            var acc = AvailableAccounts.FirstOrDefault(a => a.AccountId == l.AccountId);
            var code = (acc?.Code ?? string.Empty).Trim();
            if (code == "2201" || code == "2202")
                sum += l.Credit;
        }
        return sum;
    }

    private long DetectDepositMemberId()
    {
        foreach (var l in JournalLines)
        {
            if (l.Credit <= 0m) continue;
            if (l.MemberId is null || l.MemberId.Value <= 0) continue;
            if (l.AccountId <= 0) continue;
            var acc = AvailableAccounts.FirstOrDefault(a => a.AccountId == l.AccountId);
            var code = (acc?.Code ?? string.Empty).Trim();
            if (code == "2201" || code == "2202")
                return l.MemberId.Value;
        }
        return 0;
    }

    private List<long> DetectDepositMemberIds()
    {
        var set = new HashSet<long>();
        foreach (var l in JournalLines)
        {
            if (l.Credit <= 0m) continue;
            if (l.MemberId is null || l.MemberId.Value <= 0) continue;
            if (l.AccountId <= 0) continue;
            var acc = AvailableAccounts.FirstOrDefault(a => a.AccountId == l.AccountId);
            var code = (acc?.Code ?? string.Empty).Trim();
            if (code == "2201" || code == "2202")
                set.Add(l.MemberId.Value);
        }
        return set.ToList();
    }

    private List<long> DetectLoanPaymentMemberIds()
    {
        var set = new HashSet<long>();
        foreach (var l in JournalLines)
        {
            if (l.Credit <= 0m) continue;
            if (l.MemberId is null || l.MemberId.Value <= 0) continue;
            if (l.AccountId <= 0) continue;
            var acc = AvailableAccounts.FirstOrDefault(a => a.AccountId == l.AccountId);
            var code = (acc?.Code ?? string.Empty).Trim();
            if (code == "1301" || code == "1302")
                set.Add(l.MemberId.Value);
        }
        return set.ToList();
    }

    private async Task<(string? headMobile, long headMemberId, string? headFullName, decimal totalCurrentNet, long? householdId)> ResolveSingleHouseholdHeadAndCurrentNetAsync(List<long> memberIds)
    {
        if (memberIds.Count == 0)
            return (null, 0, null, 0m, null);

        var members = new List<Member>();
        foreach (var id in memberIds)
        {
            var m = await MemberService.GetByIdAsync(id);
            if (m != null)
                members.Add(m);
        }

        if (members.Count == 0)
            return (null, 0, null, 0m, null);

        var headIds = members
            .Select(m => m.Household?.OwnerMemberId)
            .Where(x => x.HasValue && x.Value > 0)
            .Select(x => x!.Value)
            .Distinct()
            .ToList();

        if (headIds.Count != 1)
            return (null, 0, null, 0m, null);

        var headId = headIds[0];
        var head = await MemberService.GetByIdAsync(headId);
        var headMobile = head?.MobileNumber;
        if (string.IsNullOrWhiteSpace(headMobile))
            return (null, 0, null, 0m, null);

        var householdId = members.FirstOrDefault()?.Household?.HouseholdId;

        decimal totalCurrentNet = 0m;
        if (householdId.HasValue && householdId.Value > 0)
        {
            // مانده سپرده تجمیعی کل خانوار (همه اعضای خانوار)
            var householdMembers = (await MemberService.GetAsync(householdId: householdId.Value, top: 1000)).ToList();
            var memberCodes = new List<string>();
            foreach (var hm in householdMembers)
            {
                if (hm.MemberId <= 0) continue;
                var sub = await AccountsRepo.GetSubsidiaryByMemberIdAsync(hm.MemberId, includeInactive: true);
                var code = (sub?.Code ?? string.Empty).Trim();
                if (!string.IsNullOrWhiteSpace(code))
                    memberCodes.Add(code);
            }

            var snaps = await MemberFinancial.GetSnapshotsByMemberCodesAsync(memberCodes);
            totalCurrentNet = snaps.Values.Sum(x => x.TotalNet);
        }

        return (headMobile, headId, head?.FullName, totalCurrentNet, householdId);
    }

