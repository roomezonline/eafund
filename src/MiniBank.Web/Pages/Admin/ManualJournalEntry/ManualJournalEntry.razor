    private string GetJalaliDate()
    {
        var persianCalendar = new System.Globalization.PersianCalendar();
        var today = DateTime.Today;
        return $"{persianCalendar.GetYear(today)}/{persianCalendar.GetMonth(today):D2}/{persianCalendar.GetDayOfMonth(today):D2}";
    }

    private string GetJalaliDateFromGregorian(DateTime date)
    {
        var persianCalendar = new System.Globalization.PersianCalendar();
        return $"{persianCalendar.GetYear(date)}/{persianCalendar.GetMonth(date):D2}/{persianCalendar.GetDayOfMonth(date):D2}";
    }

    private DateTime ConvertJalaliToGregorian(string jalaliDate)
        => MiniBank.Web.Components.Extensions.DateTimeExtensions.FromPersianDate(jalaliDate);

    private DateTime GetEffectiveOccurredAt()
    {
        if (ReceiptId.HasValue && ReceiptInfo != null && ReceiptInfo.OccurredAt != null)
            return ((DateTime)ReceiptInfo.OccurredAt);

        return ConvertJalaliToGregorian(OccurredAt);
    }

    private decimal TotalDebit => JournalLines.Sum(l => l.Debit);
    private decimal TotalCredit => JournalLines.Sum(l => l.Credit);
    private decimal Difference => Math.Abs(TotalDebit - TotalCredit);
    private bool IsBalanced => Math.Abs(TotalDebit - TotalCredit) < 0.01m && JournalLines.Count > 0;

    private async Task OnSubmit()
    {
        if (!_isTemporary)
        {
            if (!IsBalanced)
            {
                Toast.Error("سند باید تراز باشد (مجموع بدهکار = مجموع بستانکار)");
                return;
            }

            // Validate each journal line
            var validationErrors = new List<string>();
            int lineNumber = 1;
            bool hasValidLines = false;

            foreach (var line in JournalLines)
            {
                var lineErrors = ValidateJournalLine(line, lineNumber);
                if (lineErrors.Count > 0)
                {
                    validationErrors.AddRange(lineErrors);
                }
                else if (line.AccountId > 0 && line.SubsidiaryId.HasValue && line.SubsidiaryId.Value > 0 && (line.Debit > 0 || line.Credit > 0))
                {
                    hasValidLines = true;
                }
                lineNumber++;
            }

            if (!hasValidLines)
            {
                validationErrors.Add("حداقل یک خط معتبر با حساب معین، تفضیلی و مبلغ باید وجود داشته باشد");
            }

            if (validationErrors.Count > 0)
            {
                var errorMessage = string.Join("\n", validationErrors);
                Toast.Error("خطاهای اعتبارسنجی:\n" + errorMessage);
                return;
            }

            // Check for amount mismatch confirmation
            if (ReceiptTotalAmount > 0 && Math.Abs(UsedAmount - ReceiptTotalAmount) > 0.01m)
            {
                _amountExceedTitle = UsedAmount > ReceiptTotalAmount ? "هشدار تجاوز از مبلغ" : "هشدار مغایرت مبلغ";
                _amountExceedMessage = UsedAmount > ReceiptTotalAmount
                    ? $"مبلغ ورودی ({UsedAmount:N0} ریال) از مبلغ رسید ({ReceiptTotalAmount:N0} ریال) بیشتر است. آیا با وجود این تفاوت سند را ثبت می‌کنید؟"
                    : $"مبلغ سند ({UsedAmount:N0} ریال) از مبلغ رسید ({ReceiptTotalAmount:N0} ریال) کمتر است. آیا با وجود این تفاوت سند را ثبت می‌کنید؟";
                _showAmountExceedConfirm = true;
                StateHasChanged();
                return;
            }
        }

        await PostJournalWithConfirmation();
    }

    private async Task PostJournalWithConfirmation()
    {
        try
        {
            var journalId = await PostManualJournalAsync();

            await CommitStage2HistoryAsync();
            
            // Link receipt to journal if we're in receipt mode
            if (ReceiptId.HasValue && !IsEditMode)
            {
                await LinkReceiptToJournalAsync(ReceiptId.Value, journalId);
                Toast.Success("سند حسابداری با موفقیت ثبت و به رسید لینک شد");
            }
            else if (IsEditMode)
            {
                Toast.Success("سند با موفقیت به‌روزرسانی شد");
            }
            else
            {
                Toast.Success("سند حسابداری با موفقیت ثبت شد");
            }

            // After successful post, for deposit posting (codes 2201/2202), prompt SMS confirmation
            if (!IsEditMode)
            {
                _queueLoanSmsAfterDeposit = false;
                var loanSmsPrepared = await TryPrepareLoanPaymentSmsConfirmStateAsync();

                var willShowSms = await TryOpenDepositSmsConfirmAsync();
                if (willShowSms)
                {
                    if (loanSmsPrepared)
                    {
                        _queueLoanSmsAfterDeposit = true;
                        _pendingResetAfterDepositSms = false;
                        _pendingNavigateAfterDepositSms = false;
                        _pendingResetAfterLoanPaymentSms = true;
                        _pendingNavigateAfterLoanPaymentSms = ReceiptId.HasValue;
                    }
                    else
                    {
                        _pendingResetAfterDepositSms = true;
                        _pendingNavigateAfterDepositSms = ReceiptId.HasValue;
                    }
                    StateHasChanged();
                    return;
                }

                // After successful post, for loan installment payment posting (codes 1301/1302), prompt SMS confirmation
                var willShowLoanSms = loanSmsPrepared ? await TryOpenPreparedLoanPaymentSmsConfirmAsync() : await TryOpenLoanPaymentSmsConfirmAsync();
                if (willShowLoanSms)
                {
                    _pendingResetAfterLoanPaymentSms = true;
                    _pendingNavigateAfterLoanPaymentSms = ReceiptId.HasValue;
                    StateHasChanged();
                    return;
                }
            }
            
            // خروج از حالت ویرایش و پاک کردن فرم
            IsEditMode = false;
            var wasEditingSystemJournal = EditingJournalId.HasValue && !ReceiptId.HasValue;
            EditingJournalId = null;
            
            // پاک کردن ReceiptId و برگرد به مرحله ۱ تا تاریخچه به‌روز شود.
            if (ReceiptId.HasValue)
            {
                await RemoveDraftAsync();
                ReceiptId = null; // پاک کردن ReceiptId برای جلوگیری از لود مجدد رسید پرداخت‌شده
                hasUnsavedChanges = false;
                NavigationManager.NavigateTo("/admin/manual-journal-entry-v2");
                return;
            }
            
            if (wasEditingSystemJournal)
            {
                hasUnsavedChanges = false;
                NavigationManager.NavigateTo("/admin/manual-journal-entry-v2");
                return;
            }
            
            // Clear form for new entry
            ClearForm();
            hasUnsavedChanges = false;
            await RemoveDraftAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error details: {ex}");
            if (ex.InnerException != null)
            {
                Console.WriteLine($"Inner Exception: {ex.InnerException.Message}");
            }
            Toast.Error($"خطا در ثبت سند: {ex.Message}");
        }
    }

    private async Task CommitStage2HistoryAsync()
    {
        try
        {
            foreach (var line in JournalLines)
