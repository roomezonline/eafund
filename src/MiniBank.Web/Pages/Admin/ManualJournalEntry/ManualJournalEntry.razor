    private long? _pendingDeleteJournalId;
    private bool _showDeleteConfirm;
    private string _deleteTitle = "تأیید حذف";
    private string _deleteMessage = string.Empty;

    private async Task ConfirmDeleteJournal()
    {
        var journalId = _pendingDeleteJournalId;
        _showDeleteConfirm = false; 
        StateHasChanged();
        
        if (journalId == null) return;
        
        try
        {
            Loading.Show("صندوق امام علی (ع)", "در حال حذف سند...", "fa-solid fa-trash");

            if (_db.State != ConnectionState.Open)
                _db.Open();

            using var tx = _db.BeginTransaction();

            try
            {
                await UndoLoanPaymentsForManualJournalAsync(journalId.Value, tx);

                await _db.ExecuteAsync("UPDATE dbo.Journals SET IsDeleted = 1 WHERE JournalId = @Id",
                    new { Id = journalId }, tx);

                tx.Commit();
            }
            catch
            {
                try { tx.Rollback(); } catch { }
                throw;
            }
            
            // Reload journal history
            await LoadJournalHistory();
            
            Toast.Success("سند با موفقیت حذف شد (حذف نرم)");
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در حذف سند: {ex.Message}");
        }
        finally
        {
            Loading.Hide();
            _pendingDeleteJournalId = null;
        }
    }

    private async Task UndoLoanPaymentsForManualJournalAsync(long journalId, IDbTransaction tx)
    {
        // Step 1: Try to find LoanId directly from JournalLines (new data with stored LoanId)
        var storedLoanIds = (await _db.QueryAsync<long?>(@"
            SELECT DISTINCT jl.LoanId
            FROM dbo.JournalLines jl
            WHERE jl.JournalId = @journalId AND jl.LoanId IS NOT NULL",
            new { journalId }, tx))
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .Distinct()
            .ToList();

        // Step 2: If no stored LoanId (old data), find from LoanPayments.Notes and save back
        if (storedLoanIds.Count == 0)
        {
            var paymentLoanPairs = (await _db.QueryAsync<(long LoanId, long? MemberId)>(@"
                SELECT DISTINCT lp.LoanId, lp.MemberId
                FROM dbo.LoanPayments lp
                WHERE lp.Notes LIKE @notes AND lp.LoanId IS NOT NULL",
                new { notes = $"ManualJournal:{journalId}%" }, tx)).ToList();

            if (paymentLoanPairs.Count > 0)
            {
                storedLoanIds = paymentLoanPairs.Select(x => x.LoanId).Distinct().ToList();
                // Self-heal: save LoanId back to JournalLines per MemberId for future edits
                foreach (var pair in paymentLoanPairs)
                {
                    await _db.ExecuteAsync(@"
                        UPDATE dbo.JournalLines SET LoanId = @loanId
                        WHERE JournalId = @journalId AND LoanId IS NULL
                          AND (MemberId = @memberId OR (MemberId IS NULL AND @memberId IS NULL))",
                        new { loanId = pair.LoanId, memberId = pair.MemberId, journalId }, tx);
                }
            }
        }

        // Step 3: Determine affected loans from stored LoanIds or fall back to guessing
        List<long> affectedLoanIds;
        if (storedLoanIds.Count > 0)
        {
            affectedLoanIds = storedLoanIds;
        }
        else
        {
            // Fall back to the guessing approach (backward compat for truly orphaned data)
            const string sqlAffectedLoansByJournal = @"
SELECT DISTINCT x.LoanId
FROM (
    SELECT DISTINCT jl.MemberId
    FROM dbo.JournalLines jl
    INNER JOIN dbo.Accounts a ON a.AccountId = COALESCE(jl.ParentAccountId, jl.AccountId)
    WHERE jl.JournalId = @journalId
      AND jl.MemberId IS NOT NULL
      AND a.Code IN ('1301','1302','4101','4102')
) m
CROSS APPLY (
    SELECT TOP 1 l.LoanId
    FROM dbo.Loans l
    WHERE l.MemberId = m.MemberId
      AND l.Status IN (2,3,4,5)
    ORDER BY l.LoanId DESC
) x;";
            affectedLoanIds = (await _db.QueryAsync<long>(sqlAffectedLoansByJournal, new { journalId }, tx)).Distinct().ToList();
        }

        const string sqlPayments = @"
SELECT PaymentId, LoanId
FROM dbo.LoanPayments
WHERE Notes LIKE @notes";

        var notes = $"ManualJournal:{journalId}%";
        var payments = (await _db.QueryAsync<(long PaymentId, long LoanId)>(sqlPayments, new { notes }, tx)).ToList();

        if (payments.Count > 0)
        {
            var paymentIds = payments.Select(x => x.PaymentId).Distinct().ToList();
            await _db.ExecuteAsync("DELETE FROM dbo.LoanPaymentAllocations WHERE PaymentId IN @ids", new { ids = paymentIds }, tx);
            await _db.ExecuteAsync("DELETE FROM dbo.LoanPayments WHERE PaymentId IN @ids", new { ids = paymentIds }, tx);
        }

        var loanIds = payments.Select(x => x.LoanId).Concat(affectedLoanIds).Distinct().ToList();
        if (loanIds.Count == 0)
            return;

        const string sqlDeleteOrphanManualJournalPayments = @"
DECLARE @OrphanPayments TABLE (PaymentId BIGINT PRIMARY KEY);

INSERT INTO @OrphanPayments (PaymentId)
SELECT p.PaymentId
FROM dbo.LoanPayments p
OUTER APPLY (
  SELECT TRY_CONVERT(BIGINT,
    CASE
      WHEN p.Notes LIKE 'ManualJournal:%' THEN
        SUBSTRING(
          SUBSTRING(p.Notes, LEN('ManualJournal:') + 1, 50),
          1,
          PATINDEX('%[^0-9]%', SUBSTRING(p.Notes, LEN('ManualJournal:') + 1, 50) + 'X') - 1
        )
      ELSE NULL
    END
  ) AS JournalId
) j
WHERE p.LoanId = @loanId
  AND p.Notes LIKE 'ManualJournal:%'
  AND (j.JournalId IS NULL OR NOT EXISTS (SELECT 1 FROM dbo.Journals jj WHERE jj.JournalId = j.JournalId));

DELETE FROM dbo.LoanPaymentAllocations WHERE PaymentId IN (SELECT PaymentId FROM @OrphanPayments);
DELETE FROM dbo.LoanPayments WHERE PaymentId IN (SELECT PaymentId FROM @OrphanPayments);";

        const string sqlRecompute = @"
UPDATE li
SET
  PaidPrincipal = ISNULL(x.PaidPrincipal, 0),
  PaidInterest  = ISNULL(x.PaidInterest, 0),
  PaidPenalty   = ISNULL(x.PaidPenalty, 0),
  Status = CASE
    WHEN (ISNULL(x.PaidPrincipal,0) + ISNULL(x.PaidInterest,0)) >= (li.PrincipalAmount + li.InterestAmount) - 0.01 THEN 3
    WHEN (ISNULL(x.PaidPrincipal,0) + ISNULL(x.PaidInterest,0) + ISNULL(x.PaidPenalty,0)) > 0 THEN 2
    ELSE 1
  END
FROM dbo.LoanInstallments li
OUTER APPLY (
  SELECT
    SUM(CASE WHEN a.Type = 3 THEN a.Amount ELSE 0 END) AS PaidPrincipal,
    SUM(CASE WHEN a.Type = 2 THEN a.Amount ELSE 0 END) AS PaidInterest,
    SUM(CASE WHEN a.Type = 1 THEN a.Amount ELSE 0 END) AS PaidPenalty
  FROM dbo.LoanPaymentAllocations a
  JOIN dbo.LoanPayments p ON p.PaymentId = a.PaymentId
  WHERE p.LoanId = li.LoanId
    AND a.InstallmentId = li.InstallmentId
) x
WHERE li.LoanId = @loanId";

        foreach (var loanId in loanIds)
        {
            await _db.ExecuteAsync(sqlDeleteOrphanManualJournalPayments, new { loanId }, tx);
            await _db.ExecuteAsync(sqlRecompute, new { loanId }, tx);
            await UpdateLoanStatusFromInstallmentsAsync(loanId, tx);
        }
    }

    private Task CancelDeleteJournal()
    {
        _showDeleteConfirm = false; 
        _pendingDeleteJournalId = null; 
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ExportToExcel()
    {
        try
        {
            // Simple CSV export for now - you can enhance this with proper Excel library
            var csv = new System.Text.StringBuilder();
            csv.AppendLine("شماره سند,تاریخ,شرح,بدهکار,بستانکار,متعادل");
            
            foreach (var journal in FilteredJournalHistory)
            {
                csv.AppendLine($"{journal.JournalId},{journal.OccurredAt},\"{journal.Notes}\",{journal.TotalDebit},{journal.TotalCredit},{(journal.IsBalanced ? "بله" : "خیر")}");
            }

            var fileName = $"journals_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
            
            await JS.InvokeVoidAsync("downloadFile", fileName, "text/csv;charset=utf-8", Convert.ToBase64String(bytes));
            
            Toast.Success("فایل با موفقیت دانلود شد");
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در خروجی گرفتن: {ex.Message}");
        }
    }

