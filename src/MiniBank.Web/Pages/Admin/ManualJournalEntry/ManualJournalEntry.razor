    private async Task MoveLineUp(ManualJournalLine line)
    {
        var idx = JournalLines.IndexOf(line);
        if (idx > 0)
        {
            JournalLines.RemoveAt(idx);
            JournalLines.Insert(idx - 1, line);
            MarkDirty();
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("eval", $"document.getElementById('journal-line-{line.LineId}')?.scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
        }
    }

    private async Task MoveLineDown(ManualJournalLine line)
    {
        var idx = JournalLines.IndexOf(line);
        if (idx < JournalLines.Count - 1)
        {
            JournalLines.RemoveAt(idx);
            JournalLines.Insert(idx + 1, line);
            MarkDirty();
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("eval", $"document.getElementById('journal-line-{line.LineId}')?.scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
        }
    }

    // بارگذاری تفضیلی‌های یک حساب معین خاص
    private void LoadSubsidiariesForMainAccount(ManualJournalLine line)
    {
        if (line.AccountId > 0)
        {
            // بارگذاری تفضیلی‌های این حساب معین + تفضیلی‌های مستقل (بدون والد معین)
            var subsidiaries = AvailableAccounts
                .Where(a => a.Level == 4 && (a.ParentAccountId == line.AccountId || a.ParentAccountId == null));
            
            // فیلتر اعضای خانوار انتخابی در مرحله اول (برای کدهای تفضیلی که با M شروع میشن)
            // فقط برای تراکنش‌های اعضایی (DocumentType == 1)
            if (line.UseHouseholdMemberFilter && ReceiptInfo?.TargetHouseholdId != null && ReceiptInfo.DocumentType == 1)
            {
                subsidiaries = subsidiaries.Where(a => 
                    // اگر کد تفضیلی با M شروع میشه، فقط اعضای همین خانوار رو نمایش بده
                    !(a.Code?.StartsWith("M-", StringComparison.OrdinalIgnoreCase) == true) || 
                    a.MemberId == null ||
                    // فقط اعضایی که در مرحله اول (خانوار انتخابی) هستند
                    TargetHouseholdMemberIds.Contains(a.MemberId.Value)
                );
            }
            
            line.AvailableSubsidiaries = subsidiaries.OrderBy(a => a.Code).ToList();
            
            // پاک کردن انتخاب تفضیلی اگر دیگر معتبر نباشد
            if (line.SubsidiaryId.HasValue && !line.AvailableSubsidiaries.Any(s => s.AccountId == line.SubsidiaryId.Value))
            {
                line.SubsidiaryId = null;
                line.MemberId = null;
            }
        }
        else
        {
            // اگر معین انتخاب نشده:
            // - حالت پیش‌فرض: فقط تفضیلی‌های مستقل
            // - اگر فیلتر خانوار غیرفعال شد: همه تفضیلی‌های اعضا (M-) + تفضیلی‌های مستقل
            var subsidiaries = AvailableAccounts
                .Where(a => a.Level == 4 && (a.ParentAccountId == null || (!line.UseHouseholdMemberFilter && a.Code != null && a.Code.StartsWith("M-", StringComparison.OrdinalIgnoreCase))));
            
            // فیلتر اعضای خانوار انتخابی در مرحله اول (برای کدهای تفضیلی که با M شروع میشن)
            // فقط برای تراکنش‌های اعضایی (DocumentType == 1)
            if (line.UseHouseholdMemberFilter && ReceiptInfo?.TargetHouseholdId != null && ReceiptInfo.DocumentType == 1)
            {
                subsidiaries = subsidiaries.Where(a => 
                    // اگر کد تفضیلی با M شروع میشه، فقط اعضای همین خانوار رو نمایش بده
                    !(a.Code?.StartsWith("M-", StringComparison.OrdinalIgnoreCase) == true) || 
                    a.MemberId == null ||
                    // فقط اعضایی که در مرحله اول (خانوار انتخابی) هستند
                    TargetHouseholdMemberIds.Contains(a.MemberId.Value)
                );
            }
            
            line.AvailableSubsidiaries = subsidiaries.OrderBy(a => a.Code).ToList();
            
            line.SubsidiaryId = null;
            line.MemberId = null;
        }
    }

    // وقتی تفضیلی انتخاب شد، عضو مربوطه را هم تنظیم کن
    private async Task OnSubsidiarySelected(ManualJournalLine line, bool markDirty = true)
    {
        if (line.SubsidiaryId.HasValue)
        {
            var subsidiary = line.AvailableSubsidiaries.FirstOrDefault(s => s.AccountId == line.SubsidiaryId.Value);
            if (subsidiary != null)
            {
                line.MemberId = subsidiary.MemberId;
                await LoadMemberDepositSummaryAsync(line);
                ApplyApprovedLoanDisbursementAutoFill(line);
                ApplyLoanInstallmentAutoFill(line);
                if (markDirty)
                    MarkDirty();
            }
        }
        else
        {
            line.MemberId = null;
            line.TotalDepositPrincipal = 0;
            line.TotalDepositInterest = 0;
            line.TotalDepositWithdrawal = 0;
            line.TotalDepositNet = 0;

            line.FinancialSnapshot = null;

            line.ActiveLoanId = null;
            line.ActiveLoanPrincipal = 0;
            line.ActiveLoanInterest = 0;
            line.ActiveLoanTotal = 0;
            line.ActiveLoanRemaining = 0;
            line.ActiveLoanTermMonths = 0;
            line.ActiveLoanEmiAmount = 0;
            line.ActiveLoanPenaltyAmount = 0;
            line.ActiveLoanOverdueDays = 0;
            line.ActiveLoanCurrentInstallmentNo = null;
            line.ActiveLoanCurrentInstallmentDueDate = null;
            line.ActiveLoanCurrentInstallmentPrincipal = 0;
            line.ActiveLoanCurrentInstallmentInterest = 0;
            line.ActiveLoanCurrentInstallmentTotal = 0;
            line.ActiveLoanCurrentInstallmentAchievedPrincipal = 0;
            line.ActiveLoanCurrentInstallmentAchievedInterest = 0;
            line.ActiveLoanCurrentInstallmentAchievedTotal = 0;
            line.ActiveLoanLastPaidInstallmentDueDate = null;

            line.ApprovedLoanId = null;
            line.ApprovedLoanPrincipal = 0;
            line.ApprovedLoanInterest = 0;

            if (markDirty)
                MarkDirty();
        }
    }

    private void ApplyApprovedLoanDisbursementAutoFill(ManualJournalLine line)
    {
        if (line == null)
            return;

        if (!line.MemberId.HasValue || line.MemberId.Value <= 0)
            return;

        if (!line.ApprovedLoanId.HasValue || line.ApprovedLoanId.Value <= 0)
            return;

        if (line.Debit > 0m || line.Credit > 0m)
            return;

        var acc = AvailableAccounts.FirstOrDefault(a => a.AccountId == line.AccountId);
        var code = (acc?.Code ?? string.Empty).Trim();

        var principal = Math.Max(0m, line.ApprovedLoanPrincipal);
        var interest = Math.Max(0m, line.ApprovedLoanInterest);

        if (string.Equals(code, "1301", StringComparison.OrdinalIgnoreCase))
        {
            if (principal <= 0m) return;
            line.Debit = principal;
            line.Credit = 0m;
            line.DebitError = null;
            line.CreditError = null;
            return;
        }

        if (string.Equals(code, "1302", StringComparison.OrdinalIgnoreCase))
        {
            if (interest <= 0m) return;
            line.Debit = interest;
            line.Credit = 0m;
            line.DebitError = null;
            line.CreditError = null;
            return;
        }

        if (string.Equals(code, "2301", StringComparison.OrdinalIgnoreCase))
        {
            if (interest <= 0m) return;
            line.Credit = interest;
            line.Debit = 0m;
            line.DebitError = null;
            line.CreditError = null;
            return;
        }
    }

    private void ApplyLoanInstallmentAutoFill(ManualJournalLine line)
    {
        if (line == null)
            return;

        if (!line.MemberId.HasValue || line.MemberId.Value <= 0)
            return;

        if (!line.ActiveLoanId.HasValue || line.ActiveLoanId.Value <= 0)
            return;

        if (line.Debit > 0m || line.Credit > 0m)
            return;

        var acc = AvailableAccounts.FirstOrDefault(a => a.AccountId == line.AccountId);
        var code = (acc?.Code ?? string.Empty).Trim();

        var principal = Math.Max(0m, line.ActiveLoanCurrentInstallmentPrincipal);
        var interest = Math.Max(0m, line.ActiveLoanCurrentInstallmentInterest);

        if (string.Equals(code, "2301", StringComparison.OrdinalIgnoreCase))
        {
            if (interest <= 0m) return;
            line.Debit = interest;
            line.Credit = 0m;
            line.DebitError = null;
            line.CreditError = null;
            return;
        }

        if (string.Equals(code, "1301", StringComparison.OrdinalIgnoreCase))
        {
            if (principal <= 0m) return;
            line.Credit = principal;
            line.Debit = 0m;
            line.DebitError = null;
            line.CreditError = null;
            return;
        }

        if (string.Equals(code, "1302", StringComparison.OrdinalIgnoreCase)
            || string.Equals(code, "4101", StringComparison.OrdinalIgnoreCase))
        {
            if (interest <= 0m) return;
            line.Credit = interest;
            line.Debit = 0m;
            line.DebitError = null;
            line.CreditError = null;
            return;
        }
    }

    private async Task LoadMemberDepositSummaryAsync(ManualJournalLine line)
    {
        var code = line.AvailableSubsidiaries
            ?.FirstOrDefault(s => s.AccountId == line.SubsidiaryId)
            ?.Code;

        if (string.IsNullOrWhiteSpace(code) || !code.StartsWith("M", StringComparison.OrdinalIgnoreCase))
        {
            line.TotalDepositPrincipal = 0;
            line.TotalDepositInterest = 0;
            line.TotalDepositWithdrawal = 0;
            line.TotalDepositNet = 0;

            line.FinancialSnapshot = null;

            line.ActiveLoanId = null;
            line.ActiveLoanPrincipal = 0;
            line.ActiveLoanInterest = 0;
            line.ActiveLoanTotal = 0;
            line.ActiveLoanRemaining = 0;
            line.ActiveLoanTermMonths = 0;
            line.ActiveLoanEmiAmount = 0;
            line.ActiveLoanPenaltyAmount = 0;
            line.ActiveLoanOverdueDays = 0;
            line.ActiveLoanCurrentInstallmentNo = null;
            line.ActiveLoanCurrentInstallmentDueDate = null;
            line.ActiveLoanCurrentInstallmentPrincipal = 0;
            line.ActiveLoanCurrentInstallmentInterest = 0;
            line.ActiveLoanCurrentInstallmentTotal = 0;
            line.ActiveLoanCurrentInstallmentAchievedPrincipal = 0;
            line.ActiveLoanCurrentInstallmentAchievedInterest = 0;
            line.ActiveLoanCurrentInstallmentAchievedTotal = 0;
            line.ActiveLoanLastPaidInstallmentDueDate = null;

            line.ApprovedLoanId = null;
            line.ApprovedLoanPrincipal = 0;
            line.ApprovedLoanInterest = 0;

            await InvokeAsync(StateHasChanged);
            return;
        }

        var snap = await MemberFinancial.GetSnapshotByMemberCodeAsync(code);

        line.FinancialSnapshot = snap;

        // Display net values directly (withdrawals are shown separately)
        line.TotalDepositPrincipal = snap.NetPrincipal;
        line.TotalDepositInterest = snap.NetInterest;
        line.TotalDepositWithdrawal = snap.PrincipalWithdrawals + snap.InterestWithdrawals;
        line.TotalDepositNet = snap.TotalNet;

        line.ActiveLoanId = snap.ActiveLoan?.LoanId;
        line.ActiveLoanPrincipal = snap.ActiveLoan?.Principal ?? 0m;
        line.ActiveLoanInterest = snap.ActiveLoan?.TotalInterest ?? 0m;
        line.ActiveLoanTotal = snap.ActiveLoan?.TotalPayable ?? 0m;
        line.ActiveLoanRemaining = snap.ActiveLoan?.RemainingTotal ?? 0m;
        line.ActiveLoanTermMonths = snap.ActiveLoan?.TermMonths ?? 0;
        line.ActiveLoanEmiAmount = snap.ActiveLoan?.EmiAmount ?? 0m;
        line.ActiveLoanPenaltyAmount = snap.ActiveLoan?.CurrentInstallmentPenaltyAmount ?? 0m;
        line.ActiveLoanOverdueDays = snap.ActiveLoan?.CurrentInstallmentOverdueDays ?? 0;
        line.ActiveLoanCurrentInstallmentNo = snap.ActiveLoan?.CurrentInstallmentNo;
        line.ActiveLoanCurrentInstallmentDueDate = snap.ActiveLoan?.CurrentInstallmentDueDate;
        line.ActiveLoanCurrentInstallmentPrincipal = snap.ActiveLoan?.CurrentInstallmentPrincipal ?? 0m;
        line.ActiveLoanCurrentInstallmentInterest = snap.ActiveLoan?.CurrentInstallmentInterest ?? 0m;
        line.ActiveLoanCurrentInstallmentTotal = snap.ActiveLoan?.CurrentInstallmentTotal ?? 0m;
        line.ActiveLoanCurrentInstallmentAchievedPrincipal = snap.ActiveLoan?.CurrentInstallmentAchievedPrincipal ?? 0m;
        line.ActiveLoanCurrentInstallmentAchievedInterest = snap.ActiveLoan?.CurrentInstallmentAchievedInterest ?? 0m;
        line.ActiveLoanCurrentInstallmentAchievedTotal = snap.ActiveLoan?.CurrentInstallmentAchievedTotal ?? 0m;
        line.ActiveLoanLastPaidInstallmentDueDate = snap.ActiveLoan?.LastPaidInstallmentDueDate;

        line.ApprovedLoanId = null;
        line.ApprovedLoanPrincipal = 0;
        line.ApprovedLoanInterest = 0;

        if (line.MemberId.HasValue && line.MemberId.Value > 0)
        {
            if (_db.State != ConnectionState.Open)
                _db.Open();

            const string sqlApprovedLoan = @"SELECT TOP 1 * FROM dbo.Loans WHERE MemberId = @memberId AND Status = 2 ORDER BY LoanId DESC";
            var approvedLoan = await _db.QueryFirstOrDefaultAsync<MiniBank.Web.Models.Loan>(sqlApprovedLoan, new { memberId = line.MemberId.Value });

            if (approvedLoan != null && approvedLoan.LoanId > 0)
            {
                const string sqlSumInterest = @"SELECT ISNULL(SUM(InterestAmount),0) FROM dbo.LoanInstallments WHERE LoanId = @loanId";
                var sumInterest = await _db.QuerySingleAsync<decimal>(sqlSumInterest, new { loanId = approvedLoan.LoanId });

                line.ApprovedLoanId = approvedLoan.LoanId;
                line.ApprovedLoanPrincipal = approvedLoan.Principal;
                line.ApprovedLoanInterest = sumInterest;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

