    // Journal History Methods
    private async Task LoadJournalHistory()
    {
        try
        {
            JournalHistoryLoading = true;
            StateHasChanged();

            Console.WriteLine("Loading journal history...");

            const string sql = @"
                SELECT 
                    j.JournalId,
                    CAST(j.OccurredAt AS DATE) as OccurredAt,
                    ISNULL(j.Notes,'') as Notes,
                    hr.DocumentType as DocumentType,
                    hr.TransactionType as TransactionType,
                    hr.PayChannel as PayChannel,
                    hr.CounterpartyName as CounterpartyName,
                    ISNULL(t.AmountTotal, 0) as TransactionAmount,
                    0 as TotalDebit,
                    0 as TotalCredit,
                    1 as IsBalanced
                FROM dbo.Journals j
                LEFT JOIN dbo.Transactions t ON t.TransactionId = j.TransactionId
                LEFT JOIN dbo.HouseholdReceipts hr ON hr.HouseholdReceiptId = t.ParentReceiptId
                ORDER BY j.JournalId DESC";

            var journals = await _db.QueryAsync<JournalHistoryItem>(sql);
            JournalHistory = journals.ToList();
            
            Console.WriteLine($"Found {JournalHistory.Count} journals");

            // Load lines for each journal
            foreach (var journal in JournalHistory)
            {
                const string linesSql = @"
                    SELECT 
                        jl.JournalLineId,
                        COALESCE(a.Name, 'Unknown') as AccountName,
                        jl.Description,
                        jl.Debit,
                        jl.Credit
                    FROM dbo.JournalLines jl
                    LEFT JOIN dbo.Accounts a ON jl.AccountId = a.AccountId
                    WHERE jl.JournalId = @JournalId
                    ORDER BY jl.[LineNo]";

                var lines = await _db.QueryAsync<JournalLineHistoryItem>(linesSql, new { journal.JournalId });
                journal.Lines = lines.ToList();
                
                // Calculate totals
                journal.TotalDebit = journal.Lines.Sum(l => l.Debit);
                journal.TotalCredit = journal.Lines.Sum(l => l.Credit);
                journal.IsBalanced = Math.Abs(journal.TotalDebit - journal.TotalCredit) < 0.01m;

                // Fallback transaction amount for manual journals
                if (journal.TransactionAmount <= 0)
                {
                    journal.TransactionAmount = Math.Max(journal.TotalDebit, journal.TotalCredit);
                }

                journal.DocumentTypeName = journal.DocumentType.HasValue
                    ? ReceiptDataService.GetDocumentTypeName(journal.DocumentType.Value)
                    : "-";
                journal.TransactionTypeName = !string.IsNullOrWhiteSpace(journal.TransactionType)
                    ? ReceiptDataService.GetTransactionTypeName(journal.TransactionType)
                    : "-";
                journal.ChannelName = journal.PayChannel.HasValue
                    ? ReceiptDataService.GetChannelName(journal.PayChannel.Value)
                    : "-";
                
                Console.WriteLine($"Journal {journal.JournalId}: {journal.Lines.Count} lines, Debit={journal.TotalDebit}, Credit={journal.TotalCredit}");
            }

            FilteredJournalHistory = JournalHistory;
            Console.WriteLine($"Filtered to {FilteredJournalHistory.Count} journals");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading journal history: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            Toast.Error($"خطا در بارگذاری تاریخچه اسناد: {ex.Message}");
        }
        finally
        {
            JournalHistoryLoading = false;
            StateHasChanged();
        }
    }

    private void PerformSearch()
    {
        FilteredJournalHistory = JournalHistory.Where(j =>
        {
            bool matchesSearch = string.IsNullOrEmpty(SearchTerm) ||
                j.JournalId.ToString().Contains(SearchTerm) ||
                j.OccurredAt.ToString("yyyy/MM/dd").Contains(SearchTerm) ||
                (j.Notes?.Contains(SearchTerm) ?? false);

            bool matchesDateRange = true;
            if (!string.IsNullOrEmpty(FromDate))
            {
                // Convert Jalali to DateTime for comparison
                try
                {
                    var fromDateTime = ConvertJalaliToGregorian(FromDate);
                    matchesDateRange = matchesDateRange && j.OccurredAt.Date >= fromDateTime.Date;
                }
                catch
                {
                    // Invalid date format, skip filter
                }
            }
            if (!string.IsNullOrEmpty(ToDate))
            {
                try
                {
                    var toDateTime = ConvertJalaliToGregorian(ToDate);
                    matchesDateRange = matchesDateRange && j.OccurredAt.Date <= toDateTime.Date;
                }
                catch
                {
                    // Invalid date format, skip filter
                }
            }

            return matchesSearch && matchesDateRange;
        }).ToList();
    }

