    private void AddLine()
    {
        var newLine = new ManualJournalLine();
        
        // مقداردهی اولیه لیست تفضیلی‌ها برای این خط جدید
        newLine.AvailableSubsidiaries = AvailableAccounts
            .Where(a => a.Level == 4 && a.ParentAccountId == null)
            .OrderBy(a => a.Code)
            .ToList();
        
        JournalLines.Add(newLine);
        UpdateUsedAmount();
        MarkDirty();
    }

    private void AddLineAfter(ManualJournalLine currentLine)
    {
        var currentIndex = JournalLines.IndexOf(currentLine);
        var newLine = new ManualJournalLine();
        
        // مقداردهی اولیه لیست تفضیلی‌ها برای این خط جدید
        newLine.AvailableSubsidiaries = AvailableAccounts
            .Where(a => a.Level == 4 && a.ParentAccountId == null)
            .OrderBy(a => a.Code)
            .ToList();
        
        // اضافه کردن خط جدید بعد از خط فعلی
        JournalLines.Insert(currentIndex + 1, newLine);
        UpdateUsedAmount();
        MarkDirty();
    }

