    private static string StripSystemicMetadata(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes)) return string.Empty;

        var cat = TransactionPresentationService.PeekCategory(notes);
        if (cat == TransactionPresentationService.TransactionCategory.UserEntered ||
            cat == TransactionPresentationService.TransactionCategory.Unknown)
            return notes;

        var parts = notes.Split('|', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .Where(x => !x.StartsWith("LoanDisburse", StringComparison.OrdinalIgnoreCase))
            .Where(x => !x.StartsWith("LoanPrepay", StringComparison.OrdinalIgnoreCase))
            .Where(x => !x.StartsWith("Loan:", StringComparison.OrdinalIgnoreCase))
            .Where(x => !x.StartsWith("Member:", StringComparison.OrdinalIgnoreCase))
            .Where(x => !x.StartsWith("Run:", StringComparison.OrdinalIgnoreCase))
            .Where(x => !x.StartsWith("Method:", StringComparison.OrdinalIgnoreCase))
            .ToList();
        return parts.Count == 0 ? notes.Trim() : string.Join(" | ", parts);
    }

    private static string GetSystemicMetadataSuffix(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes)) return string.Empty;

        var knownPrefixes = new[] { "LoanDisburse", "LoanPrepay", "Run:", "Member:", "Loan:", "Method:" };
        var parts = notes.Split('|', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .Where(x => knownPrefixes.Any(p => x.StartsWith(p, StringComparison.OrdinalIgnoreCase)))
            .ToList();

        return parts.Count == 0 ? string.Empty : string.Join(" | ", parts);
    }

