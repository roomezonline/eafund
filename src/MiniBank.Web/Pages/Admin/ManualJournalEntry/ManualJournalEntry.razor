    private static string BuildCommonSmsText(string NAME, string PRICE, string BABAT, string MANBAB, string MANPRICE)
    {
        static string CleanName(string? name)
        {
            var x = (name ?? string.Empty).Trim();
            if (string.IsNullOrWhiteSpace(x))
                return string.Empty;

            var stars = new[] { '☆', '★', '*', '✶', '✷', '✸', '✹', '✺', '✻', '✼' };
            var cut = x.IndexOfAny(stars);
            if (cut >= 0)
                x = x.Substring(0, cut);

            x = x.Replace("\u200c", string.Empty).Replace("\u200d", string.Empty).Replace("\ufeff", string.Empty);
            return x.Trim();
        }

        var safeName = CleanName(NAME);
        return $"عضومحترم {safeName}\n" +
               $"مبلغ {PRICE} ریال بابت {BABAT} شما ثبت سامانه گردید.\n" +
               $"مانده {MANBAB} شماتاکنون:\n" +
               $"{MANPRICE} ریال می باشد.\n\n" +
               $"صندوق امام علی(ع)";
    }

