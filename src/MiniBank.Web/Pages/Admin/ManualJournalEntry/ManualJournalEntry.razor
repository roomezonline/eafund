    private async Task PrefillFromReceiptAsync(long receiptId)
    {
        const string sql = @"
            SELECT TOP 1 
                hr.HouseholdReceiptId,
                hr.TargetHouseholdId,
                hr.OccurredAt,
                hr.Notes,
                hr.AmountTotal as Amount,
                hr.DocumentType,
                hr.TransactionType,
                hr.PayChannel as Channel,
                h.Name as HouseholdName,
                hr.CounterpartyName
            FROM dbo.HouseholdReceipts hr
            LEFT JOIN dbo.Households h ON hr.TargetHouseholdId = h.HouseholdId
            WHERE hr.HouseholdReceiptId = @Id";
        
        var receipt = await _db.QueryFirstOrDefaultAsync<dynamic>(sql, new { Id = receiptId });
        if (receipt == null)
            return;

        // Create enhanced receipt info with proper names
        ReceiptInfo = new
        {
            receipt.HouseholdReceiptId,
            receipt.TargetHouseholdId,
            receipt.OccurredAt,
            receipt.Notes,
            receipt.Amount,
            receipt.DocumentType,
            receipt.TransactionType,
            receipt.Channel,
            receipt.HouseholdName,
            receipt.CounterpartyName,
            // Add proper display names
            DocumentTypeName = ReceiptDataService.GetDocumentTypeName((byte)receipt.DocumentType),
            TransactionTypeName = ReceiptDataService.GetTransactionTypeName(receipt.TransactionType),
            ChannelName = ReceiptDataService.GetChannelName((byte)receipt.Channel)
        };

        // Load members for selected household (DocumentType == 1)
        TargetHouseholdMemberIds.Clear();
        if (ReceiptInfo?.TargetHouseholdId != null && ReceiptInfo.DocumentType == 1)
        {
            var householdMembers = await MemberService.GetAsync(isActive: true, householdId: (long)ReceiptInfo.TargetHouseholdId);
            TargetHouseholdMemberIds = householdMembers.Select(m => m.MemberId).ToHashSet();
        }
        
        // Set total amount for tracking
        ReceiptTotalAmount = (decimal)receipt.Amount;
        UsedAmount = 0; // Reset used amount when loading new receipt
        UpdateUsedAmount();
        
        OccurredAt = GetJalaliDateFromGregorian(((DateTime)receipt.OccurredAt).ToLocalTime());
        Description = (string?)receipt.Notes ?? "";
    }

