    private decimal SumCreditByAccountCode(long? memberId, string code)
    {
        if (memberId == null || memberId.Value <= 0)
            return 0m;

        decimal sum = 0m;
        foreach (var l in JournalLines)
        {
            if (l.MemberId != memberId.Value)
                continue;
            if (l.AccountId <= 0)
                continue;

            var acc = AvailableAccounts.FirstOrDefault(a => a.AccountId == l.AccountId);
            var c = (acc?.Code ?? string.Empty).Trim();
            if (!string.Equals(c, code, StringComparison.OrdinalIgnoreCase))
                continue;

            if (l.Credit > 0m)
                sum += l.Credit;
        }
        return sum;
    }

    private decimal DetectLoanPaymentAmount()
    {
        decimal sum = 0m;
        foreach (var l in JournalLines)
        {
            if (l.Credit <= 0m) continue;
            if (l.AccountId <= 0) continue;
            var acc = AvailableAccounts.FirstOrDefault(a => a.AccountId == l.AccountId);
            var code = (acc?.Code ?? string.Empty).Trim();
            if (code == "1301" || code == "1302")
                sum += l.Credit;
        }
        return sum;
    }

    private decimal SumDebitByAccountCode(long? memberId, string code)
    {
        if (memberId == null || memberId.Value <= 0)
            return 0m;

        decimal sum = 0m;
        foreach (var l in JournalLines)
        {
            if (l.MemberId != memberId.Value)
                continue;
            if (l.AccountId <= 0)
                continue;

            var acc = AvailableAccounts.FirstOrDefault(a => a.AccountId == l.AccountId);
            var c = (acc?.Code ?? string.Empty).Trim();
            if (!string.Equals(c, code, StringComparison.OrdinalIgnoreCase))
                continue;

            if (l.Debit > 0m)
                sum += l.Debit;
        }
        return sum;
    }

    private static decimal ParseMoney(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return 0m;
        var cleaned = (s ?? string.Empty).Replace(",", "").Replace(" ", "").Trim();
        if (decimal.TryParse(cleaned, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var v))
            return v;
        if (decimal.TryParse(cleaned, out v))
            return v;
        return 0m;
    }

    private void UpdateLoanSplitTotal(ManualJournalLine line, string? raw)
    {
        if (line == null)
            return;

        var parsed = ParseMoney(raw);
        line.LoanSplitTotal = parsed;
        line.LoanSplitTotalText = parsed > 0m ? parsed.ToString("N0") : string.Empty;
        MarkDirty();
    }

    private async Task RecomputeLoanSplitSuggestionAsync(ManualJournalLine line)
    {
        if (line == null)
            return;

        line.LoanSplitLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            line.LoanSplitSuggestedPrincipal = 0m;
            line.LoanSplitSuggestedInterest = 0m;
            line.LoanSplitSuggestedPenalty = 0m;
            line.LoanSplitRows = new();

            var loanId = line.ActiveLoanId ?? 0;
            if (loanId <= 0)
                return;

            var total = Math.Max(0m, line.LoanSplitTotal);
            if (total <= 0m)
                return;

            const string sqlLoan = "SELECT TOP 1 * FROM dbo.Loans WHERE LoanId = @loanId";
            var loan = await _db.QueryFirstOrDefaultAsync<MiniBank.Web.Models.Loan>(sqlLoan, new { loanId });
            if (loan == null || loan.LoanId <= 0)
                return;

            const string sqlInstallments = @"
SELECT *
FROM dbo.LoanInstallments
WHERE LoanId = @loanId
  AND Status <> 3
ORDER BY InstallmentNo ASC";

            var installments = (await _db.QueryAsync<MiniBank.Web.Models.LoanInstallment>(sqlInstallments, new { loanId })).ToList();
            if (installments.Count == 0)
                return;

            var journalDate = GetEffectiveOccurredAt().Date;
            var penaltyDailyRate = (loan.PenaltyAnnualRatePercent / 100m) / 365m;

            var remainingTotal = total;

            foreach (var inst in installments)
            {
                if (remainingTotal <= 0m)
                    break;

                var remP = Math.Max(0m, inst.PrincipalAmount - inst.PaidPrincipal);
                var remI = Math.Max(0m, inst.InterestAmount - inst.PaidInterest);
                if (remP <= 0m && remI <= 0m)
                    continue;

                var dueDate = inst.DueDate.Date;
                var overdueDays = Math.Max(0, (journalDate - dueDate).Days);
                var baseRemainingBefore = remP + remI;
                var penaltyComputed = (overdueDays > 0 && baseRemainingBefore > 0m)
                    ? (baseRemainingBefore * penaltyDailyRate * overdueDays)
                    : 0m;

                var penaltyForDisplay = ApplyLatePenalty ? penaltyComputed : 0m;

                // IMPORTANT: Penalty is only displayed and must NOT be consumed from the payment total.
                // Allocation and "full settlement" are based only on principal+interest.
                var requiredTotal = baseRemainingBefore;
                var isFull = remainingTotal >= requiredTotal - 0.01m;

                if (isFull)
                {
                    line.LoanSplitSuggestedInterest += remI;
                    line.LoanSplitSuggestedPrincipal += remP;
                    line.LoanSplitSuggestedPenalty += penaltyForDisplay;

                    line.LoanSplitRows.Add(new ManualJournalLine.LoanSplitRow
                    {
                        InstallmentNo = inst.InstallmentNo,
                        DueDate = inst.DueDate,
                        AllocInterest = remI,
                        AllocPrincipal = remP,
                        AllocPenalty = penaltyForDisplay,
                        IsFullySettled = true
                    });

                    remainingTotal -= requiredTotal;
                    continue;
                }

                var allocI = Math.Min(remI, remainingTotal);
                remainingTotal -= allocI;

                var allocP = Math.Min(remP, remainingTotal);
                remainingTotal -= allocP;

                line.LoanSplitSuggestedInterest += allocI;
                line.LoanSplitSuggestedPrincipal += allocP;
                line.LoanSplitSuggestedPenalty += penaltyForDisplay;

                line.LoanSplitRows.Add(new ManualJournalLine.LoanSplitRow
                {
                    InstallmentNo = inst.InstallmentNo,
                    DueDate = inst.DueDate,
                    AllocInterest = allocI,
                    AllocPrincipal = allocP,
                    AllocPenalty = penaltyForDisplay,
                    IsFullySettled = false
                });

                break;
            }
        }
        finally
        {
            line.LoanSplitLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RecomputeSuggestedPenaltyAsync(ManualJournalLine line)
    {
        if (line == null)
            return;

        line.SuggestedPenaltyLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            line.SuggestedPenaltyTotal = 0m;
            line.SuggestedPenaltyRows = new();

            var loanId = line.ActiveLoanId ?? 0;
            var memberId = line.MemberId;
            if (loanId <= 0 || memberId == null || memberId.Value <= 0)
                return;

            const string loanPrincipalAccountCode = "1301";
            const string loanInterestAccountCode = "1302";
            const string interestIncomeAccountCode = "4101";

            var principalCredit1301 = SumCreditByAccountCode(memberId, loanPrincipalAccountCode);
            var principalDebit1301 = SumDebitByAccountCode(memberId, loanPrincipalAccountCode);
            var paidPrincipal = Math.Max(principalCredit1301, principalDebit1301);

            var interestCredit1302 = SumCreditByAccountCode(memberId, loanInterestAccountCode);
            var interestDebit1302 = SumDebitByAccountCode(memberId, loanInterestAccountCode);
            var paidInterest = Math.Max(interestCredit1302, interestDebit1302);
            if (paidInterest <= 0m)
            {
                var interestCredit4101 = SumCreditByAccountCode(memberId, interestIncomeAccountCode);
                paidInterest = interestCredit4101;
            }

            if (paidPrincipal <= 0m && paidInterest <= 0m)
                return;

            const string sqlLoan = "SELECT TOP 1 * FROM dbo.Loans WHERE LoanId = @loanId";
            var loan = await _db.QueryFirstOrDefaultAsync<MiniBank.Web.Models.Loan>(sqlLoan, new { loanId });
            if (loan == null || loan.LoanId <= 0)
                return;

            const string sqlInstallments = @"
SELECT *
FROM dbo.LoanInstallments
WHERE LoanId = @loanId
  AND Status <> 3
ORDER BY InstallmentNo ASC";

            var installments = (await _db.QueryAsync<MiniBank.Web.Models.LoanInstallment>(sqlInstallments, new { loanId })).ToList();
            if (installments.Count == 0)
                return;

            var journalDate = GetEffectiveOccurredAt().Date;
            var penaltyDailyRate = (loan.PenaltyAnnualRatePercent / 100m) / 365m;

            var remainingP = paidPrincipal;
            var remainingI = paidInterest;

            foreach (var inst in installments)
            {
                if (remainingP <= 0m && remainingI <= 0m)
                    break;

                var instRemainingPrincipal = Math.Max(0m, inst.PrincipalAmount - inst.PaidPrincipal);
                var instRemainingInterest = Math.Max(0m, inst.InterestAmount - inst.PaidInterest);

                var allocP = Math.Min(instRemainingPrincipal, remainingP);
                var allocI = Math.Min(instRemainingInterest, remainingI);

                var newPaidP = inst.PaidPrincipal + allocP;
                var newPaidI = inst.PaidInterest + allocI;

                remainingP -= allocP;
                remainingI -= allocI;

                var isPrincipalPaid = newPaidP >= inst.PrincipalAmount - 0.01m;
                var isInterestPaid = newPaidI >= inst.InterestAmount - 0.01m;

                if (!isPrincipalPaid || !isInterestPaid)
                    continue;

                var dueDate = inst.DueDate.Date;
                var overdueDays = Math.Max(0, (journalDate - dueDate).Days);
                var baseRemainingBefore = instRemainingPrincipal + instRemainingInterest;
                var penalty = (overdueDays > 0 && baseRemainingBefore > 0m)
                    ? (baseRemainingBefore * penaltyDailyRate * overdueDays)
                    : 0m;

                if (penalty > 0.01m)
                {
                    line.SuggestedPenaltyRows.Add(new ManualJournalLine.SuggestedPenaltyRow
                    {
                        InstallmentNo = inst.InstallmentNo,
                        DueDate = inst.DueDate,
                        Penalty = penalty
                    });
                    line.SuggestedPenaltyTotal += penalty;
                }
            }
        }
        finally
        {
            line.SuggestedPenaltyLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

