    private async Task<bool> TryOpenDepositSmsConfirmAsync()
    {
        try
        {
            var smsSettings = await SmsPanelRepo.GetSettingsAsync();
            if (!smsSettings.IsEnabled)
                return false;

            var features = await SmsPanelRepo.GetFeaturesAsync();
            var depositFeature = features.FirstOrDefault(f => string.Equals(f.FeatureKey, "deposit_credit", StringComparison.OrdinalIgnoreCase));
            if (depositFeature == null || !depositFeature.IsEnabled)
                return false;

            var amount = DetectDepositAmount();

            var memberIds = DetectDepositMemberIds();
            if (memberIds.Count == 0 || amount <= 0m)
                return false;

            var (headMobile, headMemberId, headFullName, totalCurrentNet, householdId) = await ResolveSingleHouseholdHeadAndCurrentNetAsync(memberIds);
            if (string.IsNullOrWhiteSpace(headMobile) || headMemberId <= 0)
            {
                Toasts.Warning("برای اعضای انتخاب‌شده، سرخانوار واحد یا شماره موبایل سرخانوار یافت نشد.");
                return false;
            }

            // سند قبل از ارسال پیامک ثبت می‌شود؛ بنابراین مانده تجمیعی فعلی خانوار شامل این واریز است.
            // مبلغ رسید نباید دوباره به مانده اضافه شود.
            var newNet = totalCurrentNet;

            var PRICE = amount.ToString("N0");
            var BABAT = "واریز سپرده";
            var MANBAB = "سپرده";
            var MANPRICE = newNet.ToString("N0");

            var NAME = headFullName ?? string.Empty;

            var text = BuildDepositSmsText(NAME, PRICE, BABAT, MANBAB, MANPRICE);

            _depositSmsMobile = headMobile;
            _depositMemberId = headMemberId;
            _depositAmount = amount;
            _depositNewBalance = newNet;
            _depositMessageText = text;
            _depositHouseholdId = householdId;
            _depositMemberIdsJson = JsonSerializer.Serialize(memberIds);

            _depositSmsConfirmMessage = BuildDepositSmsConfirmMarkup(headMobile, PRICE, MANPRICE, text);
            _showDepositSmsConfirm = true;
            return true;
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در آماده‌سازی پیامک واریز سپرده: {ex.Message}");
            return false;
        }
    }

