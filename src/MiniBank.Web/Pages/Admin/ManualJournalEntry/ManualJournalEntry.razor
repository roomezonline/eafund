    private async Task ConfirmDepositSmsAsync()
    {
        _showDepositSmsConfirm = false;
        StateHasChanged();

        var navigateAfter = false;
        var openLoanAfter = _queueLoanSmsAfterDeposit;

        try
        {
            var smsSettings = await SmsPanelRepo.GetSettingsAsync();
            var templateId = ParseInt(smsSettings.VerifyTemplateId);
            if (templateId <= 0)
                templateId = 828043;

            var parts = EstimateParts(_depositMessageText);

            var PRICE = _depositAmount.ToString("N0");
            var BABAT = "واریز سپرده";
            var MANBAB = "سپرده";
            var MANPRICE = _depositNewBalance.ToString("N0");

            var head = await MemberService.GetByIdAsync(_depositMemberId);
            var NAME = head?.FullName ?? string.Empty;

            var paramsJson = JsonSerializer.Serialize(new { NAME, PRICE, BABAT, MANBAB, MANPRICE });
            var logId = await SmsLogRepo.CreateAsync(
                featureKey: "deposit_credit",
                householdId: _depositHouseholdId,
                headMemberId: _depositMemberId,
                memberIdsJson: _depositMemberIdsJson,
                recipientMobile: _depositSmsMobile,
                templateId: templateId,
                paramsJson: paramsJson,
                messageText: _depositMessageText);

            string? rawResponse = null;
            long? providerMessageId = null;
            int? apiStatus = null;
            string? apiMessage = null;
            try
            {
                rawResponse = await SmsSender.SendVerifyForFeatureAsync("deposit_credit", _depositSmsMobile, templateId, PRICE, BABAT, MANBAB, MANPRICE, NAME);

                // Try parse messageId/status/message from json response (best-effort)
                try
                {
                    using var doc = JsonDocument.Parse(rawResponse);
                    if (doc.RootElement.TryGetProperty("status", out var s) && s.TryGetInt32(out var st))
                        apiStatus = st;
                    if (doc.RootElement.TryGetProperty("message", out var m))
                        apiMessage = m.GetString();

                    if (doc.RootElement.TryGetProperty("data", out var data) && data.ValueKind == JsonValueKind.Object)
                    {
                        if (data.TryGetProperty("messageId", out var mid) && mid.TryGetInt64(out var midVal))
                            providerMessageId = midVal;
                    }
                }
                catch
                {
                    // ignore parse errors
                }

                var isSuccess = apiStatus.HasValue ? apiStatus.Value == 1 : true;
                await SmsLogRepo.MarkResultAsync(logId, isSuccess, rawResponse, providerMessageId, apiStatus, apiMessage, errorMessage: null);
            }
            catch (Exception exSend)
            {
                await SmsLogRepo.MarkResultAsync(logId, isSuccess: false, rawResponse, providerMessageId, apiStatus, apiMessage, errorMessage: exSend.Message);
                throw;
            }

            var creditResult = await SmsSendService.ConsumeCreditAfterSuccessfulSendAsync(parts);
            if (creditResult.lowCredit)
                Toasts.Warning($"هشدار: اعتبار پیامک کمتر از {creditResult.thresholdRial:N0} ریال است.");

            Toasts.Success("پیامک واریز سپرده ارسال شد.");
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در ارسال پیامک واریز سپرده: {ex.Message}");
        }
        finally
        {
            if (_pendingResetAfterDepositSms)
            {
                _pendingResetAfterDepositSms = false;
                ClearForm();
                hasUnsavedChanges = false;
                await RemoveDraftAsync();
                if (_pendingNavigateAfterDepositSms)
                {
                    _pendingNavigateAfterDepositSms = false;
                    ReceiptId = null;
                    navigateAfter = true;
                }
                StateHasChanged();
            }
        }

        if (openLoanAfter)
        {
            _queueLoanSmsAfterDeposit = false;
            var opened = await TryOpenPreparedLoanPaymentSmsConfirmAsync();
            if (opened)
            {
                StateHasChanged();
                return;
            }
        }

        if (navigateAfter)
        {
            NavigationManager.NavigateTo("/admin/manual-journal-entry-v2");
        }
    }

