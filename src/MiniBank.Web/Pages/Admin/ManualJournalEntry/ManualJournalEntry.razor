        public string LoanSplitTotalText { get; set; } = string.Empty;
        public decimal LoanSplitTotal { get; set; }
        public bool LoanSplitLoading { get; set; }
        public decimal LoanSplitSuggestedPrincipal { get; set; }
        public decimal LoanSplitSuggestedInterest { get; set; }
        public decimal LoanSplitSuggestedPenalty { get; set; }
        public List<LoanSplitRow> LoanSplitRows { get; set; } = new();

        public long? ActiveLoanId { get; set; }
        public decimal ActiveLoanPrincipal { get; set; }
        public decimal ActiveLoanInterest { get; set; }
        public decimal ActiveLoanTotal { get; set; }
        public decimal ActiveLoanRemaining { get; set; }
        public int ActiveLoanTermMonths { get; set; }
