    private static bool IsDepositInterestNotes(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
            return false;
        var n = notes.Trim();
        return n.Contains("Run:", StringComparison.OrdinalIgnoreCase)
               && n.Contains("Member:", StringComparison.OrdinalIgnoreCase)
               && n.Contains("واریز سود", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsLoanDisbursementNotes(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
            return false;
        var n = notes.Trim();
        return n.Contains("LoanDisburse", StringComparison.OrdinalIgnoreCase)
               && n.Contains("Member:", StringComparison.OrdinalIgnoreCase);
    }

    private static long? TryExtractMemberIdFromNotes(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
            return null;

        var idx = notes.IndexOf("Member:", StringComparison.OrdinalIgnoreCase);
        if (idx < 0)
            return null;

        idx += "Member:".Length;
        while (idx < notes.Length && char.IsWhiteSpace(notes[idx]))
            idx++;

        var start = idx;
        while (idx < notes.Length && char.IsDigit(notes[idx]))
            idx++;

        if (idx <= start)
            return null;

        var s = notes.Substring(start, idx - start);
        return long.TryParse(s, out var id) ? id : null;
    }
