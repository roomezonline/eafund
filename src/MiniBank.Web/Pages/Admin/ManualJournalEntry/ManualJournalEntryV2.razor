                                            @if (!_historyOnly && !journal.IsDeleted)
                                            {
                                                @if (journal.Status == 1)
                                                {
                                                    <button class="history-edit-btn btn-confirm-permanent" @onclick="() => RequestPermanentJournal(journal.JournalId)" @onclick:stopPropagation="true" title="تبدیل به دائمی">تایید نهایی</button>
                                                    <button class="history-edit-btn" @onclick="() => EditJournal(journal.JournalId)" @onclick:stopPropagation="true">ویرایش</button>
                                                    <button class="history-delete-btn" @onclick="() => RequestDeleteJournal(journal.JournalId)" @onclick:stopPropagation="true">حذف</button>
                                                }
                                                else if (journal.Status == 2)
                                                {
                                                    <button class="history-edit-btn" @onclick="() => RequestRevertToTemporary(journal.JournalId)" @onclick:stopPropagation="true" title="برگشت به موقت">برگشت به موقت</button>
                                                    <button class="history-delete-btn" @onclick="() => RequestDeleteJournal(journal.JournalId)" @onclick:stopPropagation="true">حذف</button>
                                                }
                                            }
                                            @if (!_historyOnly && journal.IsDeleted)
                                            {
                                                <button class="history-restore-btn" @onclick="() => RestoreJournal(journal.JournalId)" @onclick:stopPropagation="true" title="بازگردانی سند">بازگردانی</button>
                                                <button class="history-permanent-delete-btn" @onclick="() => RequestPermanentDelete(journal.JournalId)" @onclick:stopPropagation="true" title="حذف برای همیشه">حذف دائمی</button>
                                            }
                                            <button class="history-details-btn" @onclick="() => ToggleJournalDetailsAsync(journal.JournalId)" @onclick:stopPropagation="true">جزئیات</button>
                                        </span>
                                    </td>
                                </tr>

                                @if (ExpandedJournals.Contains(journal.JournalId))
                                {
                                    <tr class="journal-details-row">
                                        <td colspan="11">
                                            <div class="journal-details-inline">
                                                @if (_journalHistoryLineLoading.Contains(journal.JournalId))
                                                {
                                                    <div class="loading-container" style="padding:10px 0">
                                                        <i class="fas fa-spinner fa-spin"></i>
                                                        <span>در حال بارگذاری...</span>
                                                    </div>
                                                }
                                                <div class="journal-lines-table">
                                                    <table>
                                                        <thead>
                                                            <tr>
                                                                <th>ردیف</th>
                                                                <th>شناسه</th>
                                                                <th>کد معین</th>
                                                                <th>معین</th>
                                                                <th>کد تفضیلی</th>
                                                                <th>تفضیلی</th>
                                                                <th class="debit-header">بدهکار</th>
                                                                <th class="credit-header">بستانکار</th>
                                                                <th>شرح سند</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @{
                                                                var lineIdx = 0;
                                                            }
                                                            @foreach (var line in journal.Lines)
                                                            {
                                                                lineIdx++;
                                                                <tr>
                                                                    <td>@lineIdx</td>
                                                                    <td>@line.LineNumber</td>
                                                                    <td style="text-align:center; white-space: nowrap; min-width: 90px;">@(string.IsNullOrWhiteSpace(line.MoeenCode) ? "-" : line.MoeenCode)</td>
                                                                    <td style="text-align:right; white-space: normal; min-width: 200px;">@line.MoeenName</td>
                                                                    <td style="text-align:center; white-space: nowrap; min-width: 90px;">@(string.IsNullOrWhiteSpace(line.SubsidiaryCode) ? "-" : line.SubsidiaryCode)</td>
                                                                    <td style="text-align:right; white-space: normal; min-width: 200px;">@line.SubsidiaryName</td>
                                                                    <td class="amount-td debit-amount">@(line.Debit > 0 ? line.Debit.ToString("N0") : "-")</td>
                                                                    <td class="amount-td credit-amount">@(line.Credit > 0 ? line.Credit.ToString("N0") : "-")</td>
                                                                    <td style="text-align:right; white-space: normal; min-width: 260px;">@(string.IsNullOrWhiteSpace(line.Description) ? "-" : line.Description)</td>
                                                                </tr>
                                                            }

                                                            @{
                                                                var totalDebit = journal.Lines.Sum(x => x.Debit);
                                                                var totalCredit = journal.Lines.Sum(x => x.Credit);
                                                                var diff = totalDebit - journal.TransactionAmount;
                                                                var diffAbs = Math.Abs(diff);
                                                                var diffSign = diff >= 0 ? "+" : "-";
                                                                var diffClass = diff >= 0 ? "diff-positive" : "diff-negative";
                                                            }

                                                            <tr style="background: #e0f2fe; font-weight: 900;">
                                                                <td colspan="6" style="text-align:center;">جمع و موازنه</td>
                                                                <td class="amount-td debit-amount totals-debit-bg">@totalDebit.ToString("N0")</td>
                                                                <td class="amount-td credit-amount totals-credit-bg">@totalCredit.ToString("N0")</td>
                                                                <td style="text-align:center; white-space: nowrap;" class="@diffClass">اختلاف رسید و موازنه: @diffSign@diffAbs.ToString("N0") ریال</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (_journalHistoryHasMore)
                {
                    <div style="display:flex; justify-content:center; margin-top:10px">
                        <button class="refresh-btn" disabled="@_journalHistoryLoadingMore" @onclick="LoadMoreJournalHistoryAsync">
                            @if (_journalHistoryLoadingMore)
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>در حال بارگذاری...</span>
                            }
                            else
                            {
                                <span>نمایش بیشتر</span>
                            }
                        </button>
                    </div>
                }
            }
        </div>
    </div>

