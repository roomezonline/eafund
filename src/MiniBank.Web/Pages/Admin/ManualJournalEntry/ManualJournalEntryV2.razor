    private async Task LoadJournalHistoryPageAsync(IDbConnection connection, bool reset)
    {
        DateTime? fromDateTime = null;
        DateTime? toDateTime = null;
        if (!string.IsNullOrWhiteSpace(FromDate))
        {
            try { fromDateTime = ConvertJalaliToGregorian(FromDate).Date; } catch { }
        }
        if (!string.IsNullOrWhiteSpace(ToDate))
        {
            try { toDateTime = ConvertJalaliToGregorian(ToDate).Date; } catch { }
        }

        var term = (SearchTerm ?? string.Empty).Trim();
        var termNormalized = NormalizeDigits(term);
        var termLower = termNormalized.ToLowerInvariant();
        long? termJournalId = null;
        if (long.TryParse(termLower, out var jid) && jid > 0) termJournalId = jid;

        var sortKey = (SortColumn ?? string.Empty).Trim();
        var sortDir = SortAscending ? "ASC" : "DESC";
        var orderBy = sortKey switch
        {
            "OccurredAt" => $"j.OccurredAt {sortDir}, j.JournalId {sortDir}",
            "TransactionAmount" => $"TransactionAmount {sortDir}, j.JournalId {sortDir}",
            _ => $"j.JournalId {sortDir}, j.OccurredAt {sortDir}"
        };

        var searchCondition = string.IsNullOrWhiteSpace(_activeSearchColumn)
            ? "(j.Notes LIKE '%' + @term + '%' OR j.DocumentNumber = ISNULL(@termJournalId, -1) OR CAST(j.DocumentNumber AS NVARCHAR(30)) LIKE '%' + @term + '%')"
            : _activeSearchColumn switch
            {
                "DocumentNumber" => "(j.DocumentNumber = ISNULL(@termJournalId, -1) OR CAST(j.DocumentNumber AS NVARCHAR(30)) LIKE '%' + @term + '%')",
                "Notes" => "(j.Notes LIKE '%' + @term + '%')",
                _ => "(j.Notes LIKE '%' + @term + '%')"
            };

        var sql = $@"
SELECT
    j.JournalId,
    CAST(j.OccurredAt AS DATE) as OccurredAt,
    ISNULL(j.Notes,'') as Notes,
    j.Status,
    j.IsDeleted,
    j.SerialNumber,
    j.DocumentNumber,
    COALESCE(hr1.DocumentType, hr2.DocumentType) as DocumentType,
    COALESCE(hr1.TransactionType, hr2.TransactionType) as TransactionType,
    COALESCE(hr1.PayChannel, hr2.PayChannel) as PayChannel,
    COALESCE(hr1.CounterpartyName, hr2.CounterpartyName) as CounterpartyName,
    CASE
        WHEN COALESCE(hr1.DocumentType, hr2.DocumentType) = 1 THEN
            COALESCE(h.Name, hr1.CounterpartyName, hr2.CounterpartyName, '-')
        ELSE
            COALESCE(hr1.CounterpartyName, hr2.CounterpartyName, '-')
    END as DisplayName,
    ISNULL(COALESCE(t.AmountTotal, hr1.AmountTotal, hr2.AmountTotal, jl.AmountFromLines), 0) as TransactionAmount,
    0 as TotalDebit,
    0 as TotalCredit,
    1 as IsBalanced
FROM dbo.Journals j
LEFT JOIN dbo.Transactions t ON t.TransactionId = j.TransactionId
LEFT JOIN dbo.HouseholdReceipts hr1 ON hr1.HouseholdReceiptId = t.ParentReceiptId
LEFT JOIN dbo.HouseholdReceipts hr2 ON hr2.ExternalRef = CONCAT('J:', j.JournalId)
LEFT JOIN dbo.Households h ON (h.HouseholdId = hr1.TargetHouseholdId OR h.HouseholdId = hr2.TargetHouseholdId)
OUTER APPLY (
    SELECT
        CASE
            WHEN SUM(ISNULL(jl.Debit, 0)) >= SUM(ISNULL(jl.Credit, 0)) THEN SUM(ISNULL(jl.Debit, 0))
            ELSE SUM(ISNULL(jl.Credit, 0))
        END AS AmountFromLines
    FROM dbo.JournalLines jl
    WHERE jl.JournalId = j.JournalId
) jl
WHERE (@term = '' OR {searchCondition})
  AND (@termJournalId IS NOT NULL OR @fromDate IS NULL OR j.OccurredAt >= @fromDate)
  AND (@termJournalId IS NOT NULL OR @toDate IS NULL OR j.OccurredAt < DATEADD(DAY, 1, @toDate))
  AND j.IsDeleted = @showDeleted
  AND (@statusFilter IS NULL OR j.Status = @statusFilter)
ORDER BY {orderBy}
OFFSET @offset ROWS FETCH NEXT @pageSize ROWS ONLY;";

        var page = (await connection.QueryAsync<JournalHistoryItem>(sql, new
        {
            term = termLower,
            termJournalId,
            fromDate = fromDateTime,
            toDate = toDateTime,
            offset = _journalHistoryOffset,
            pageSize = _journalHistoryPageSize,
            showDeleted = _showDeleted ? 1 : 0,
            statusFilter = _statusFilter
        })).ToList();

        if (reset)
        {
            JournalHistory = new();
            FilteredJournalHistory = new();
            ExpandedJournals = new();
        }

        if (page.Count > 0)
        {
            var memberIds = page
                .Select(j => TryExtractMemberIdFromNotes(j.Notes))
                .Where(x => x.HasValue && x.Value > 0)
                .Select(x => x!.Value)
                .Distinct()
                .ToList();

            var memberNameById = new Dictionary<long, string>();
            if (memberIds.Count > 0)
            {
                const string memberSql = @"SELECT MemberId, LTRIM(RTRIM(CONCAT(ISNULL(FirstName,N''), N' ', ISNULL(LastName,N'')))) AS FullName FROM dbo.Members WHERE MemberId IN @ids";
                var rows = await connection.QueryAsync<(long MemberId, string FullName)>(memberSql, new { ids = memberIds });
                foreach (var r in rows)
                    memberNameById[r.MemberId] = r.FullName;
            }

            foreach (var journal in page)
            {
                var p = TransactionPresentationService.Build(
                    new TransactionPresentationService.PresentationInput
                    {
                        JournalId = journal.JournalId,
                        Notes = journal.Notes,
                        DocumentType = journal.DocumentType,
                        TransactionType = journal.TransactionType,
                        PayChannel = journal.PayChannel,
                        CounterpartyName = journal.CounterpartyName,
                        DisplayName = journal.DisplayName,
                        Status = journal.Status,
                        IsDeleted = journal.IsDeleted,
                        SerialNumber = journal.SerialNumber
                    },
                    memberNameById);

                journal.DocumentTypeName = p.DocumentTypeName;
                journal.TransactionTypeName = p.TransactionTypeName;
                journal.ChannelName = p.ChannelName;
                journal.DisplayName = p.DisplayName;
                journal.BadgeText = p.BadgeText;
                journal.BadgeCssClass = p.BadgeCssClass;
                journal.StatusBadgeText = p.StatusBadgeText;
                journal.StatusBadgeCssClass = p.StatusBadgeCssClass;

                journal.Lines = new();
                journal.TotalDebit = 0;
                journal.TotalCredit = 0;
                journal.IsBalanced = true;
            }

            JournalHistory.AddRange(page);
        }

        _journalHistoryOffset += page.Count;
        _journalHistoryHasMore = page.Count >= _journalHistoryPageSize;
        FilteredJournalHistory = JournalHistory.ToList();
        ApplyJournalSort();
    }

