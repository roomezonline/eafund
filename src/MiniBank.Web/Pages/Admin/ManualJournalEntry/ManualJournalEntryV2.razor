    private async Task ConfirmPermanentJournalAsync(long journalId)
    {
        try
        {
            using var connection = await DbConnectionFactory.CreateConnectionAsync();

            // Check balance
            var balance = await connection.QuerySingleAsync<(decimal Debit, decimal Credit)>(
                "SELECT ISNULL(SUM(Debit),0), ISNULL(SUM(Credit),0) FROM dbo.JournalLines WHERE JournalId = @id",
                new { id = journalId });
            if (Math.Abs(balance.Debit - balance.Credit) > 0.01m)
            {
                Toast.Error("سند موازنه نیست. مجموع بدهکار و بستانکار برابر نیست.");
                return;
            }

            using var tx = connection.BeginTransaction();

            // Assign DocumentNumber if not already assigned
            var existingDocNum = await connection.QuerySingleOrDefaultAsync<int?>(
                "SELECT DocumentNumber FROM dbo.Journals WHERE JournalId = @id", new { id = journalId }, tx);
            if (existingDocNum == null || existingDocNum == 0)
            {
                var fyId = await connection.QuerySingleOrDefaultAsync<int?>(
                    @"SELECT FiscalYearId FROM dbo.Journals WHERE JournalId = @id", new { id = journalId }, tx);
                if (fyId.HasValue && fyId.Value > 0)
                {
                    await connection.ExecuteAsync(
                        @"IF NOT EXISTS (SELECT 1 FROM dbo.SerialCounters WHERE FiscalYearId = @id)
                          INSERT INTO dbo.SerialCounters (FiscalYearId, LastDocumentNumber)
                          SELECT @id, ISNULL(MAX(DocumentNumber), 0) FROM dbo.Journals WHERE FiscalYearId = @id",
                        new { id = fyId.Value }, tx);
                    var docNum = await connection.QuerySingleAsync<int>(@"
                        UPDATE dbo.SerialCounters
                        SET LastDocumentNumber = LastDocumentNumber + 1
                        OUTPUT INSERTED.LastDocumentNumber
                        WHERE FiscalYearId = @fiscalYearId",
                        new { fiscalYearId = fyId.Value }, tx);
                    await connection.ExecuteAsync(
                        "UPDATE dbo.Journals SET DocumentNumber = @docNum WHERE JournalId = @id",
                        new { docNum, id = journalId }, tx);
                }
            }

            // Re-apply loan payments (in case they were undone by a previous revert)
            await ApplyLoanPaymentsForJournalAsync(connection, journalId, tx);

            await connection.ExecuteAsync("UPDATE dbo.Journals SET Status = 2 WHERE JournalId = @id", new { id = journalId }, tx);
            tx.Commit();
            Toast.Success("سند با موفقیت به حالت دائمی تبدیل شد.");
            await LoadJournalHistory();
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا: {ex.Message}");
        }
    }

    private static async Task ApplyLoanPaymentsForJournalAsync(IDbConnection connection, long journalId, IDbTransaction tx)
    {
        // Load journal lines with account codes
        const string sqlLines = @"
SELECT jl.MemberId, jl.Debit, jl.Credit, a.Code AS AccountCode
FROM dbo.JournalLines jl
INNER JOIN dbo.Accounts a ON a.AccountId = COALESCE(jl.ParentAccountId, jl.AccountId)
WHERE jl.JournalId = @journalId AND jl.MemberId IS NOT NULL";
        var lines = (await connection.QueryAsync<(long MemberId, decimal Debit, decimal Credit, string AccountCode)>(
            sqlLines, new { journalId }, tx)).ToList();

        var loanMembers = lines
            .Where(l => l.AccountCode is "1301" or "1302" or "4101" or "4102")
            .Select(l => l.MemberId)
            .Distinct()
            .ToList();

        if (loanMembers.Count == 0) return;

        // Check if this is a disbursement (Debit 1301 = principal disbursed) — skip if so
        var hasDebit1301 = lines.Any(l => l.AccountCode == "1301" && l.Debit > 0);
        if (hasDebit1301) return;

        var pc = new System.Globalization.PersianCalendar();

        foreach (var memberId in loanMembers)
        {
            // Get loan
            var loan = await connection.QuerySingleOrDefaultAsync<dynamic>(
                "SELECT TOP 1 LoanId, MemberId, Principal AS LoanAmount FROM dbo.Loans WHERE MemberId = @mid AND Status IN (2,3,4,5) ORDER BY LoanId DESC",
                new { mid = memberId }, tx);
            if (loan == null) continue;

            // Get unpaid installments
            var installments = (await connection.QueryAsync<dynamic>(
                "SELECT InstallmentId, PrincipalAmount, InterestAmount, PaidPrincipal, PaidInterest, PaidPenalty, Status " +
                "FROM dbo.LoanInstallments WHERE LoanId = @lid ORDER BY InstallmentId",
                new { lid = loan.LoanId }, tx)).ToList();

            var totalPaid = lines
                .Where(l => l.MemberId == memberId && l.AccountCode is "1301" or "1302")
                .Sum(l => Math.Max(l.Debit, l.Credit));

            if (totalPaid <= 0) continue;

            // Get occurredAt from journal
            var occurredAt = await connection.QuerySingleAsync<DateTime>(
                "SELECT OccurredAt FROM dbo.Journals WHERE JournalId = @id", new { id = journalId }, tx);

            // Insert payment
            const string sqlInsPayment = @"
INSERT INTO dbo.LoanPayments (LoanId, MemberId, PaidAt, Amount, IsApproved, ApprovedAt, ApprovedBy, Notes, CreatedAt)
OUTPUT INSERTED.PaymentId
VALUES (@LoanId, @MemberId, @PaidAt, @Amount, 1, @ApprovedAt, @ApprovedBy, @Notes, GETUTCDATE())";
            var paymentId = await connection.QuerySingleAsync<long>(sqlInsPayment, new
            {
                LoanId = loan.LoanId,
                MemberId = memberId,
                PaidAt = occurredAt,
                Amount = totalPaid,
                ApprovedAt = occurredAt,
                ApprovedBy = "admin",
                Notes = $"ManualJournal:{journalId}"
            }, tx);

            // Check for waived interest: lines with 4101/4102 where member matches
            var waivedAmount = lines
                .Where(l => l.MemberId == memberId && l.AccountCode is "4101" or "4102" && l.Debit > 0)
                .Sum(l => l.Debit);

            // Allocate across installments
            var remainingPaid = totalPaid;
            foreach (var inst in installments)
            {
                if (remainingPaid <= 0) break;
                var needPrincipal = Math.Max(0, (decimal)inst.PrincipalAmount - (decimal)inst.PaidPrincipal);
                var needInterest = Math.Max(0, (decimal)inst.InterestAmount - (decimal)inst.PaidInterest);
                var needPenalty = 0m;

                var allocPrincipal = Math.Min(needPrincipal, remainingPaid);
                remainingPaid -= allocPrincipal;
                var allocInterest = Math.Min(needInterest, remainingPaid);
                remainingPaid -= allocInterest;
                var allocPenalty = Math.Min(needPenalty, remainingPaid);
                remainingPaid -= allocPenalty;

                var allocWaived = 0m;
                if (waivedAmount > 0)
                {
                    allocWaived = Math.Min(waivedAmount, needInterest - allocInterest);
                    waivedAmount -= allocWaived;
                }

                if (allocPrincipal > 0)
                {
                    const string sqlAlloc = @"
INSERT INTO dbo.LoanPaymentAllocations (PaymentId, InstallmentId, Amount, Type)
VALUES (@PaymentId, @InstallmentId, @Amount, @Type)";
                    await connection.ExecuteAsync(sqlAlloc, new { PaymentId = paymentId, InstallmentId = inst.InstallmentId, Amount = allocPrincipal, Type = 3 }, tx);
                }
                if (allocInterest > 0)
                    await connection.ExecuteAsync("INSERT INTO dbo.LoanPaymentAllocations (PaymentId, InstallmentId, Amount, Type) VALUES (@p, @i, @a, 2)",
                        new { p = paymentId, i = inst.InstallmentId, a = allocInterest }, tx);
                if (allocPenalty > 0)
                    await connection.ExecuteAsync("INSERT INTO dbo.LoanPaymentAllocations (PaymentId, InstallmentId, Amount, Type) VALUES (@p, @i, @a, 1)",
                        new { p = paymentId, i = inst.InstallmentId, a = allocPenalty }, tx);
                if (allocWaived > 0)
                    await connection.ExecuteAsync("INSERT INTO dbo.LoanPaymentAllocations (PaymentId, InstallmentId, Amount, Type) VALUES (@p, @i, @a, 4)",
                        new { p = paymentId, i = inst.InstallmentId, a = allocWaived }, tx);
            }

            // Recompute installment statuses using the Undo method's logic
            const string sqlRecompute = @"
UPDATE li
SET
  PaidPrincipal = ISNULL(x.PaidPrincipal, 0),
  PaidInterest  = ISNULL(x.PaidInterest, 0),
  PaidPenalty   = ISNULL(x.PaidPenalty, 0),
  Status = CASE
    WHEN (ISNULL(x.PaidPrincipal,0) + ISNULL(x.PaidInterest,0)) >= (li.PrincipalAmount + li.InterestAmount) - 0.01 THEN 3
    WHEN (ISNULL(x.PaidPrincipal,0) + ISNULL(x.PaidInterest,0) + ISNULL(x.PaidPenalty,0)) > 0 THEN 2
    ELSE 1
  END
FROM dbo.LoanInstallments li
OUTER APPLY (
  SELECT
    SUM(CASE WHEN a.Type = 3 THEN a.Amount ELSE 0 END) AS PaidPrincipal,
    SUM(CASE WHEN a.Type = 2 THEN a.Amount ELSE 0 END) AS PaidInterest,
    SUM(CASE WHEN a.Type = 1 THEN a.Amount ELSE 0 END) AS PaidPenalty
  FROM dbo.LoanPaymentAllocations a
  JOIN dbo.LoanPayments p ON p.PaymentId = a.PaymentId
  WHERE p.LoanId = li.LoanId
    AND a.InstallmentId = li.InstallmentId
) x
WHERE li.LoanId = @loanId";

            await connection.ExecuteAsync(sqlRecompute, new { loanId = loan.LoanId }, tx);

            // Update loan status
            const string sqlUpdateLoanStatus = @"
UPDATE l
SET
  Status = CASE
    WHEN r.RemainingCount <= 0 THEN 5
    WHEN p.HasPayments = 1 THEN 3
    WHEN d.HasDisbursement = 1 THEN 3
    ELSE 2
  END,
  UpdatedAt = GETUTCDATE()
FROM dbo.Loans l
CROSS APPLY (SELECT COUNT(1) AS RemainingCount FROM dbo.LoanInstallments WHERE LoanId = l.LoanId AND Status <> 3) r
CROSS APPLY (SELECT CASE WHEN EXISTS (SELECT 1 FROM dbo.LoanPayments WHERE LoanId = l.LoanId) THEN 1 ELSE 0 END AS HasPayments) p
CROSS APPLY (
  SELECT CASE WHEN EXISTS (
    SELECT 1 FROM dbo.vw_ApprovedJournals j
    WHERE j.Notes LIKE '%LoanDisburse%'
      AND j.Notes LIKE CONCAT('%Loan:', l.LoanId, '%')
  ) THEN 1 ELSE 0 END AS HasDisbursement
) d
WHERE l.LoanId = @loanId";
            await connection.ExecuteAsync(sqlUpdateLoanStatus, new { loanId = loan.LoanId }, tx);
        }
    }

    private async Task RevertToTemporaryAsync(long journalId)
    {
        try
        {
            using var connection = await DbConnectionFactory.CreateConnectionAsync();
            using var tx = connection.BeginTransaction();

            // Check if it has a serial number (if finalized, can't revert)
            var hasSerial = await connection.QuerySingleAsync<int?>(
                "SELECT SerialNumber FROM dbo.Journals WHERE JournalId = @id", new { id = journalId }, tx);
            if (hasSerial.HasValue)
            {
                Toast.Error("این سند دارای شماره سریال است و قابلیت برگشت به موقت را ندارد.");
                return;
            }

            // Undo loan payments created by this journal
            await UndoLoanPaymentsForManualJournalAsync(connection, journalId, tx);

            await connection.ExecuteAsync("UPDATE dbo.Journals SET Status = 1 WHERE JournalId = @id", new { id = journalId }, tx);
            tx.Commit();
            Toast.Success("سند به حالت موقت برگردانده شد.");
            await LoadJournalHistory();
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا: {ex.Message}");
        }
    }

    private static async Task UndoLoanPaymentsForManualJournalAsync(IDbConnection connection, long journalId, IDbTransaction tx)
    {
        // Determine potentially affected loans directly from the journal lines.
        // This makes rollback robust even if payment Notes are missing/incorrect.
        const string sqlAffectedLoansByJournal = @"
SELECT DISTINCT x.LoanId
FROM (
    SELECT DISTINCT jl.MemberId
    FROM dbo.JournalLines jl
    INNER JOIN dbo.Accounts a ON a.AccountId = COALESCE(jl.ParentAccountId, jl.AccountId)
    WHERE jl.JournalId = @journalId
      AND jl.MemberId IS NOT NULL
      AND a.Code IN ('1301','1302','4101','4102')
) m
CROSS APPLY (
    SELECT TOP 1 l.LoanId
    FROM dbo.Loans l
    WHERE l.MemberId = m.MemberId
      AND l.Status IN (2,3,4,5)
    ORDER BY l.LoanId DESC
) x;";

        var affectedLoanIds = (await connection.QueryAsync<long>(sqlAffectedLoansByJournal, new { journalId }, tx)).Distinct().ToList();

        const string sqlPayments = @"
SELECT PaymentId, LoanId
FROM dbo.LoanPayments
WHERE Notes LIKE @notes";

        var notes = $"ManualJournal:{journalId}%";
        var payments = (await connection.QueryAsync<(long PaymentId, long LoanId)>(sqlPayments, new { notes }, tx)).ToList();

        if (payments.Count > 0)
        {
            var paymentIds = payments.Select(x => x.PaymentId).Distinct().ToList();
            await connection.ExecuteAsync("DELETE FROM dbo.LoanPaymentAllocations WHERE PaymentId IN @ids", new { ids = paymentIds }, tx);
            await connection.ExecuteAsync("DELETE FROM dbo.LoanPayments WHERE PaymentId IN @ids", new { ids = paymentIds }, tx);
        }

        var loanIds = payments.Select(x => x.LoanId).Concat(affectedLoanIds).Distinct().ToList();
        if (loanIds.Count == 0)
            return;

        const string sqlDeleteOrphanManualJournalPayments = @"
DECLARE @OrphanPayments TABLE (PaymentId BIGINT PRIMARY KEY);

INSERT INTO @OrphanPayments (PaymentId)
SELECT p.PaymentId
FROM dbo.LoanPayments p
OUTER APPLY (
  SELECT TRY_CONVERT(BIGINT,
    CASE
      WHEN p.Notes LIKE 'ManualJournal:%' THEN
        SUBSTRING(
          SUBSTRING(p.Notes, LEN('ManualJournal:') + 1, 50),
          1,
          PATINDEX('%[^0-9]%', SUBSTRING(p.Notes, LEN('ManualJournal:') + 1, 50) + 'X') - 1
        )
      ELSE NULL
    END
  ) AS JournalId
) j
WHERE p.LoanId = @loanId
  AND p.Notes LIKE 'ManualJournal:%'
  AND (j.JournalId IS NULL OR NOT EXISTS (SELECT 1 FROM dbo.Journals jj WHERE jj.JournalId = j.JournalId));

DELETE FROM dbo.LoanPaymentAllocations WHERE PaymentId IN (SELECT PaymentId FROM @OrphanPayments);
DELETE FROM dbo.LoanPayments WHERE PaymentId IN (SELECT PaymentId FROM @OrphanPayments);";

        const string sqlRecompute = @"
UPDATE li
SET
  PaidPrincipal = ISNULL(x.PaidPrincipal, 0),
  PaidInterest  = ISNULL(x.PaidInterest, 0),
  PaidPenalty   = ISNULL(x.PaidPenalty, 0),
  Status = CASE
    WHEN (ISNULL(x.PaidPrincipal,0) + ISNULL(x.PaidInterest,0)) >= (li.PrincipalAmount + li.InterestAmount) - 0.01 THEN 3
    WHEN (ISNULL(x.PaidPrincipal,0) + ISNULL(x.PaidInterest,0) + ISNULL(x.PaidPenalty,0)) > 0 THEN 2
    ELSE 1
  END
FROM dbo.LoanInstallments li
OUTER APPLY (
  SELECT
    SUM(CASE WHEN a.Type = 3 THEN a.Amount ELSE 0 END) AS PaidPrincipal,
    SUM(CASE WHEN a.Type = 2 THEN a.Amount ELSE 0 END) AS PaidInterest,
    SUM(CASE WHEN a.Type = 1 THEN a.Amount ELSE 0 END) AS PaidPenalty
  FROM dbo.LoanPaymentAllocations a
  JOIN dbo.LoanPayments p ON p.PaymentId = a.PaymentId
  WHERE p.LoanId = li.LoanId
    AND a.InstallmentId = li.InstallmentId
) x
WHERE li.LoanId = @loanId";

        const string sqlUpdateLoanStatus = @"
UPDATE l
SET
  Status = CASE
    WHEN r.RemainingCount <= 0 THEN 5
    WHEN p.HasPayments = 1 THEN 3
    WHEN d.HasDisbursement = 1 THEN 3
    ELSE 2
  END,
  UpdatedAt = GETUTCDATE()
FROM dbo.Loans l
CROSS APPLY (SELECT COUNT(1) AS RemainingCount FROM dbo.LoanInstallments WHERE LoanId = l.LoanId AND Status <> 3) r
CROSS APPLY (SELECT CASE WHEN EXISTS (SELECT 1 FROM dbo.LoanPayments WHERE LoanId = l.LoanId) THEN 1 ELSE 0 END AS HasPayments) p
CROSS APPLY (
  SELECT CASE WHEN EXISTS (
    SELECT 1
    FROM dbo.vw_ApprovedJournals j
    WHERE j.Notes LIKE '%LoanDisburse%'
      AND j.Notes LIKE CONCAT('%Loan:', l.LoanId, '%')
  ) THEN 1 ELSE 0 END AS HasDisbursement
) d
WHERE l.LoanId = @loanId";

        foreach (var loanId in loanIds)
        {
            await connection.ExecuteAsync(sqlDeleteOrphanManualJournalPayments, new { loanId }, tx);
            await connection.ExecuteAsync(sqlRecompute, new { loanId }, tx);
            await connection.ExecuteAsync(sqlUpdateLoanStatus, new { loanId }, tx);
        }
    }

