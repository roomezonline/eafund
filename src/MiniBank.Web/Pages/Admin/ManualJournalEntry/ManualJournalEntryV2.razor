<PageTitle>صدور سند حسابداری چند مرحله‌ای</PageTitle>

<style>
    .tx-badge { display:inline-flex; align-items:center; justify-content:center; padding:2px 8px; border-radius:999px; font-weight:900; font-size:12px; line-height:1.2; border:1px solid rgba(0,0,0,.08); }
    .tx-badge-loan { background:#ede9fe; color:#5b21b6; border-color:#ddd6fe; }
    .tx-badge-interest { background:#ecfccb; color:#365314; border-color:#d9f99d; }
    .tx-badge-prepay { background:#cffafe; color:#155e75; border-color:#a5f3fc; }
    .tx-badge-temp { background:#f3f4f6; color:#374151; border-color:#d1d5db; }
    .tx-badge-perm { background:#dbeafe; color:#1e40af; border-color:#bfdbfe; }
    .tx-badge-final { background:#dcfce7; color:#166534; border-color:#bbf7d0; }
    .tx-badge-deleted { background:#fee2e2; color:#991b1b; border-color:#fecaca; }

    .multi-step-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 5px;
        direction: rtl;
    }

    /* Header Styles - Matching the Image Design */
    .header-blue-bar {
        background: #0056b3;
        color: white;
        padding: 15px 20px;
        text-align: center;
        font-size: 18px;
        font-weight: bold;
        border-radius: 8px 8px 0 0;
        margin-bottom: 0;
    }

    .header-yellow-bar-1 {
        background: #f3f4f6;
        color: #111827;
        padding: 12px 20px;
        text-align: center;
        font-size: 16px;
        font-weight: bold;
        border-bottom: 2px solid #0056b3;
    }

    .header-blue-yellow-bar {
        background: #0056b3;
        color: white;
        padding: 15px 20px;
        text-align: center;
        font-size: 17px;
        font-weight: bold;
    }

    .header-blue-yellow-bar .blue-text {
        color: white;
    }

    .header-blue-yellow-bar .yellow-text {
        color: #212529;
    }

    .header-yellow-bar-2 {
        background: #f3f4f6;
        color: #111827;
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #0056b3;
    }

    .step-item {
        padding: 8px 16px;
        font-weight: bold;
        font-size: 14px;
    }

    .step-item.active {
        background: rgba(0, 86, 179, 0.2);
        border-radius: 4px;
        color: #0056b3;
    }

    /* Form Section Styles */
    .form-section {
        background: white;
        border: 2px solid #0056b3;
        border-top: none;
        border-radius: 0 0 8px 8px;
        padding: 15px;
    }

    .form-table {
        width: 100%;
        direction: rtl;
        border-collapse: collapse;
        border: 2px solid #000;
    }

    .form-row td {
        padding: 8px 15px;
        border-bottom: 2px solid #000;
        vertical-align: middle;
    }

    .form-row td:first-child {
        border-left: 2px solid #000;
        width: 150px;
        font-weight: bold;
        color: #01080fff;
        text-align: right;
    }

    .form-row td:last-child {
        width: auto;
    }

    .form-row:last-child td {
        border-bottom: none;
    }

    .form-row:nth-child(odd) td {
        background-color: #fff !important;
    }

    .form-row:nth-child(even) td {
        background-color: #f8fafc !important;
    }

    /* Override existing nth-child styles when JavaScript classes are applied */
    .form-row.row-white td {
        background-color: #ffffff !important;
    }

    .form-row.row-yellow td {
        background-color: #f8fafc !important;
    }

    /* Force override for all table rows */
    table tr.row-white td {
        background-color: #ffffff !important;
    }

    table tr.row-yellow td {
        background-color: #f8fafc !important;
    }

    /* DsSelect transparent styling */
    ::deep .ds-select {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
    }

    ::deep .ds-select .ds-select-trigger {
        background: transparent !important;
        border: none !important;
        color: inherit !important;
        font-weight: bold !important;
    }

    ::deep .ds-select .ds-select-trigger:hover {
        background: rgba(255, 255, 255, 0.3) !important;
    }

    ::deep .ds-select .ds-select-trigger:focus {
        background: rgba(255, 255, 255, 0.5) !important;
        outline: none !important;
        box-shadow: none !important;
    }

    ::deep .ds-select .ds-select-dropdown {
        background: white !important;
        border: 1px solid #ccc !important;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1) !important;
    }

    ::deep .ds-select .ds-select-option {
        background: white !important;
        color: #333 !important;
        padding: 8px 12px !important;
        border-bottom: 1px solid #eee !important;
    }

    ::deep .ds-select .ds-select-option:hover {
        background: #f0f0f0 !important;
    }

    ::deep .ds-select .ds-select-option.selected {
        background: #007bff !important;
        color: white !important;
    }

    .form-row:last-child td {
        background-color: #90ee90;
    }

    .form-input {
        width: 100%;
        padding: 10px 15px;
        border-radius: 0;
        font-size: 16px;
        font-weight: bold;
        background: transparent !important;
        transition: all 0.3s ease;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
    }

    .date-field-large {
        width: 100%;
    }

    .date-field-large .ds-jalali-datepicker {
        width: 100%;
    }

    .date-field-large .ds-datepicker-input {
        font-size: 1.4em;
        font-weight: bold;
        text-align: center;
        background: transparent !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        width: 100%;
        padding: 10px 15px;
    }

    .date-field-large .ds-datepicker-input:focus {
        background: transparent !important;
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
    }

    .form-select {
        width: 100%;
        padding: 10px 15px;
        border: none;
        border-radius: 4px;
        font-size: 16px;
        font-weight: bold;
        background: transparent;
        transition: all 0.3s ease;
    }

    .form-select:focus {
        border: none;
        background: rgba(255, 255, 255, 0.8);
        outline: none;
        box-shadow: 0 0 0 2px rgba(0, 86, 179, 0.2);
    }

    /* Action Buttons Styles */
    .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 20px;
    }

    .action-buttons-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    .btn-delete,
    .btn-edit,
    .btn-cancel,
    .btn-next,
    .dashboard-return-btn {
        min-height: 44px;
        border-radius: 14px;
        font-size: 13px;
        font-weight: 800;
        box-shadow: 0 8px 18px rgba(17, 24, 39, 0.10);
    }

    .btn-delete {
        background: #dc3545;
        color: white;
        border: none;
        padding: 10px 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        flex: 1;
    }

    .btn-delete:hover {
        background: #c82333;
        transform: translateY(-1px);
    }

    .btn-edit {
        background: #28a745;
        color: white;
        border: none;
        padding: 10px 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        flex: 1;
    }

    .btn-edit:hover {
        background: #218838;
        transform: translateY(-1px);
    }

    .btn-cancel {
        background: #6b7280;
        color: white;
        border: none;
        padding: 10px 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        flex: 1;
    }

    .btn-cancel:hover {
        background: #4b5563;
        transform: translateY(-1px);
    }

    .btn-next {
        background: #007bff;
        color: white;
        border: none;
        padding: 10px 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-next:hover {
        background: #0056b3;
    }

    .dashboard-return-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 10px 14px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        justify-content: center;
        white-space: nowrap;
    }

    .dashboard-return-btn:hover {
        transform: translateY(-1px);
        filter: brightness(0.98);
    }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        .multi-step-container {
            padding: 2px;
        }

        .header-yellow-bar-2 {
            flex-direction: column;
            gap: 8px;
        }

        .step-item {
            width: 100%;
            text-align: center;
        }

        .form-section {
            padding: 5px;
        }

        .form-row td {
            padding: 6px 8px;
        }

        .form-row td:first-child {
            width: 35%;
            min-width: 100px;
            font-size: 0.8em;
        }

        .form-row td:last-child {
            font-size: 0.8em;
        }

        .form-input, .form-select {
            font-size: 0.8em;
            padding: 6px 8px;
        }

        .action-buttons {
            flex-direction: column;
            gap: 10px;
        }

        .btn-delete, .btn-edit, .btn-cancel, .btn-next, .dashboard-return-btn {
            width: 100%;
        }
    }

    /* Hide bottom navigation bar only on this page */
    ::deep .app-footer {
        display: none !important;
    }

    /* Make DsDropdown backgrounds transparent to match row colors */
    ::deep .ds-dropdown {
        --input-bg: transparent;
        background-color: transparent !important;
        border: 1px solid rgba(0, 0, 0, 0.1) !important;
        font-size: small !important;
    }

    ::deep .ds-dropdown .ds-dropdown-button {
        background: transparent !important;
        border: none !important;
        font-size: small !important;
    }

    ::deep .ds-dropdown .ds-dropdown-value {
        font-size: small !important;
    }

    ::deep .ds-dropdown .ds-dropdown-menu {
        background-color: white !important;
        border: 1px solid #ddd !important;
        font-size: small !important;
    }

    ::deep .ds-dropdown .ds-dropdown-item {
        background-color: white !important;
        color: #333 !important;
        font-size: small !important;
        padding: 8px 12px !important;
    }

    ::deep .ds-dropdown .ds-dropdown-item:hover {
        background-color: #f5f5f5 !important;
    }

    /* Final dropdown override (single source of truth)
       - Closed state: dropdown + trigger transparent
       - Open state: menu + items white background
       - Font size: small everywhere
       - Avoid forcing menu background to transparent
    */
    ::deep .ds-dropdown,
    ::deep .ds-dropdown .ds-dropdown-button,
    ::deep .ds-dropdown .ds-dropdown-value {
        background: transparent !important;
        background-color: transparent !important;
        font-size: small !important;
    }

    ::deep .ds-dropdown .ds-dropdown-menu,
    ::deep .ds-dropdown .ds-dropdown-item {
        background: white !important;
        background-color: white !important;
        font-size: small !important;
    }

    ::deep .ds-dropdown .ds-dropdown-item:hover {
        background-color: #f5f5f5 !important;
    }

    /* Only override inline styles for trigger/container (not menu/items) */
    ::deep .ds-dropdown[style],
    ::deep .ds-dropdown .ds-dropdown-button[style],
    ::deep .ds-dropdown .ds-dropdown-button [style] {
        background: transparent !important;
        background-color: transparent !important;
        font-size: small !important;
    }

    /* IMPORTANT: this page uses an inline style block.
       In inline styles, ::deep is NOT processed and will be ignored by the browser.
       So we duplicate the critical dropdown overrides WITHOUT ::deep.
    */
    .ds-dropdown {
        --input-bg: transparent !important;
        background: transparent !important;
        background-color: transparent !important;
        font-size: small !important;
    }

    .ds-dropdown .ds-dropdown-button,
    .ds-dropdown .ds-dropdown-value {
        background: transparent !important;
        background-color: transparent !important;
        font-size: small !important;
    }

    .ds-dropdown .ds-dropdown-menu {
        background: white !important;
        background-color: white !important;
        font-size: small !important;
    }

    .ds-dropdown .ds-dropdown-item {
        font-size: small !important;
    }

    /* Document description row - pistachio green background */
    .form-table .document-description-row td,
    .document-description-row td {
        background-color: #C0FF99 !important; /* Light green */
    }

    /* Amount input formatting */
    .amount-input {
        direction: ltr !important;
    }

    .pending-history {
        border: 2px solid #0b2a7a;
        background: #dbeafe;
        margin-bottom: 10px;
    }

    .pending-history-table {
        width: 100%;
        border-collapse: collapse;
    }

    .pending-history-table tr.form-row,
    .pending-history-table tr.form-row > td,
    .pending-history-table tr.form-row > th,
    .pending-history-table .form-label,
    .pending-history-table .form-value {
        border: 2px solid #0b2a7a !important;
        background: #dbeafe !important;
        background-color: #dbeafe !important;
    }

    .pending-history-table tr.form-row:nth-child(odd) > td,
    .pending-history-table tr.form-row:nth-child(even) > td {
        background: #dbeafe !important;
        background-color: #dbeafe !important;
    }

    /* Remove vertical divider between Continue button cell and Amount cell */
    .pending-history-table tr.form-row > td:nth-child(3) {
        border-left: none !important;
    }

    .pending-history-table tr.form-row > td:nth-child(2) {
        border-right: none !important;
    }

    /* Journal History Styles */
    .journal-history-container {
        margin-top: 20px;
        padding: 12px;
        background: #f8fafc;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .journal-history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid #e2e8f0;
    }

    .journal-history-header h2 {
        color: #1e293b;
        margin: 0;
        font-size: 18px;
        font-weight: 700;
    }

    .journal-history-header h2 i {
        margin-left: 8px;
        color: #3b82f6;
    }

    .history-actions {
        display: flex;
        gap: 10px;
    }

    .refresh-btn, .history-finalize-link {
        padding: 8px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        background: white;
        color: #374151;
        cursor: pointer;
        font-size: 12px;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .refresh-btn:hover, .history-finalize-link:hover {
        background: #f3f4f6;
        border-color: #9ca3af;
    }

    .refresh-btn i {
        margin-left: 6px;
    }

    .history-finalize-link {
        display: inline-block;
        text-decoration: none;
        background: #16a34a;
        color: #fff !important;
        border-color: #15803d;
    }

    .history-finalize-link:hover {
        background: #15803d;
        border-color: #166534;
    }

    .history-filters {
        background: white;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        margin-bottom: 12px;
    }

    .filter-row {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 12px;
        align-items: end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-group label {
        font-size: 12px;
        font-weight: 700;
        color: #374151;
    }

    .search-input {
        padding: 8px 10px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 12px;
        flex: 1;
        min-width: 0;
    }

    .search-input-context {
        border-color: #2563eb !important;
        box-shadow: 0 0 0 1px rgba(37,99,235,0.2);
    }

    .search-context-wrapper {
        display: flex;
        align-items: center;
        gap: 4px;
        width: 100%;
    }

    .search-context-badge {
        background: #dbeafe;
        color: #1e40af;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 4px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .search-context-reset {
        background: none;
        border: none;
        color: #6b7280;
        cursor: pointer;
        font-size: 14px;
        padding: 2px 4px;
        flex-shrink: 0;
        line-height: 1;
    }

    .search-context-reset:hover {
        color: #ef4444;
    }

    .journals-table-container {
        background: white;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        overflow: hidden;
    }

    .journals-table-scroll {
        overflow-x: auto;
        overflow-y: hidden;
    }

    .journals-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        min-width: 1600px;
    }

    .journals-table thead th {
        background: #fde047;
        color: #111827;
        padding: 4px 8px;
        border: 1px solid #111827;
        font-weight: bold;
        text-align: center;
    }

    .journals-table .sortable-header {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.2s ease;
    }

    .journals-table .sortable-header:hover {
        background: #facc15;
    }

    /* Stage 1 receipt-card style (no yellow) */
    .stage1-receipt {
        margin-top: 10px;
        padding: 6px;
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
    }

    .pending-history {
        margin: 8px 0;
        padding: 6px;
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
    }

    .pending-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .pending-item {
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 8px;
        background: #f1f5f9;
        border: 1px solid #0a0233ff;
        border-radius: 14px;
        padding: 8px;
    }

    .pending-item-title {
        font-weight: 800;
        color: #0a1935ff;
        text-align: right;
        font-size: 12px;
        line-height: 1.2;
    }

    .pending-item-amount {
        font-weight: 900;
        color: #111827;
        text-align: center;
        white-space: nowrap;
        font-size: 12px;
    }

    .pending-item-actions {
        display: inline-flex;
        justify-content: center;
    }

    .pending-item-actions .btn-edit {
        padding: 8px 12px;
    }

    .stage1-receipt-pill {
        display: flex;
        justify-content: center;
        margin-bottom: 8px;
    }

    .stage1-receipt-pill span {
        background: rgba(255, 255, 255, 0.25);
        color: #111827;
        border: 1px solid rgba(17, 24, 39, 0.15);
        padding: 4px 12px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 12px;
    }

    .stage1-amount-card {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        border-radius: 16px;
        padding: 8px;
        color: #111827;
        text-align: center;
        margin-bottom: 8px;
    }

    .stage1-amount-card .label {
        display: none;
    }

    .stage1-amount-card .value {
        font-size: 20px;
        font-weight: 900;
        letter-spacing: 0.2px;
        color: #111827;
    }

    .stage1-date-card {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border-radius: 16px;
        padding: 12px 10px;
        color: white;
        text-align: center;
        margin-bottom: 8px;
        box-shadow: 0 10px 24px rgba(16, 185, 129, 0.25);
        border: 1px solid #059669 !important;
    }

    .stage1-date-card .field-label {
        color: rgba(255, 255, 255, 0.95);
        font-size: 12px;
        margin-bottom: 4px;
    }

    .stage1-date-card .ds-datepicker-input {
        color: white !important;
        font-weight: 900;
        font-size: 18px;
    }

    .stage1-date-card ::deep .ds-datepicker-input {
        color: white !important;
        font-weight: 900;
        font-size: 18px;
        text-align: center;
    }

    .stage1-date-card ::deep .ds-jalali-datepicker {
        --input-bg: transparent;
    }

    .stage1-date-card ::deep .ds-datepicker-input {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
    }

    .stage1-fields {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .stage1-field-card {
        background: #f1f5f9;
        border: 1px solid #0a0233ff;
        border-radius: 16px;
        padding: 8px;
    }

    .stage1-field-card.stage1-date-card {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        border: 1px solid #059669 !important;
        color: white !important;
        padding: 12px 10px !important;
    }

    .stage1-field-card.stage1-date-card .field-label {
        color: rgba(255, 255, 255, 0.95) !important;
        font-size: 12px !important;
        margin-bottom: 4px !important;
    }

    .stage1-field-card .field-label {
        text-align: center;
        font-size: 11px;
        font-weight: 800;
        color: #0a1935ff;
        margin-bottom: 4px;
    }

    .stage1-field-card .field-control {
        display: flex;
