    private async Task ConfirmPermanentDelete()
    {
        showPermanentDeleteDialog = false;
        StateHasChanged();

        if (_permanentDeleteJournalId == 0) return;

        try
        {
            using var connection = await DbConnectionFactory.CreateConnectionAsync();

            // Disable triggers temporarily
            await connection.ExecuteAsync("DISABLE TRIGGER ALL ON dbo.JournalLines");
            await connection.ExecuteAsync("DISABLE TRIGGER ALL ON dbo.Journals");

            using var transaction = connection.BeginTransaction();

            try
            {
                await UndoLoanPaymentsForManualJournalAsync(connection, _permanentDeleteJournalId, transaction);

                // Delete journal lines first
                await connection.ExecuteAsync("DELETE FROM dbo.JournalLines WHERE JournalId = @id",
                    new { id = _permanentDeleteJournalId }, transaction);

                // Delete the journal
                var affected = await connection.ExecuteAsync("DELETE FROM dbo.Journals WHERE JournalId = @id",
                    new { id = _permanentDeleteJournalId }, transaction);

                if (affected > 0)
                {
                    transaction.Commit();
                    Toast.Success("سند برای همیشه حذف شد");
                    await LoadJournalHistory();
                }
                else
                {
                    transaction.Rollback();
                    Toast.Warning("حذف انجام نشد");
                }
            }
            catch
            {
                transaction.Rollback();
                throw;
            }
            finally
            {
                await connection.ExecuteAsync("ENABLE TRIGGER ALL ON dbo.JournalLines");
                await connection.ExecuteAsync("ENABLE TRIGGER ALL ON dbo.Journals");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در حذف دائمی سند: {ex.Message}");
        }

        _permanentDeleteJournalId = 0;
        await InvokeAsync(StateHasChanged);
    }

