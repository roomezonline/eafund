@implements IDisposable

@code {
    private bool _historyOnly;
    private bool _showDeleted;
    private byte? _statusFilter;
    [SupplyParameterFromQuery(Name = "receiptId")]
    public long? ReceiptId { get; set; }

    private void ReturnToDashboard()
    {
        NavigationManager.NavigateTo("/admin/dashboard2");
    }

    [SupplyParameterFromQuery(Name = "journalId")]
    public long? JournalId { get; set; }

    private string selectedDateString = "";
    private List<object> householdDropdownItems = new();
    private string selectedDocumentType = "";
    private string selectedTransactionType = "";
    private string selectedFamily = "";
    private string selectedChannel = "";
    private bool isFamilyDisabled = false;

    // Journal History Properties
    private List<JournalHistoryItem> JournalHistory = new();
    private List<JournalHistoryItem> FilteredJournalHistory = new();
    private List<long> ExpandedJournals = new();
    private bool JournalHistoryLoading = false;
    private string SearchTerm = "";
    private string FromDate = "";
    private string ToDate = "";
    private string SortColumn = "JournalId";
    private bool SortAscending = false;
    private const int _journalHistoryPageSize = 40;
    private int _journalHistoryOffset = 0;
    private bool _journalHistoryHasMore = false;
    private bool _journalHistoryLoadingMore = false;
    private readonly HashSet<long> _journalHistoryLineLoading = new();
    private CancellationTokenSource? _searchDebounceCts;

    // Active search column context (null = general search)
    private string? _activeSearchColumn = null;

    // Delete confirmation dialog state
    private bool showDeleteConfirmDialog = false;
    private long receiptIdToDelete = 0;

    // Journal edit/delete confirmation dialog state
    private bool showDeleteJournalConfirmDialog = false;
    private long journalIdToDelete = 0;
    private long journalIdToEdit = 0;
    private string deleteJournalConfirmMessage = "";
    private bool showConfirmPermanentDialog;
    private long _permanentConfirmJournalId;
    private bool showConfirmRevertDialog;
    private long _revertConfirmJournalId;

    // Permanent delete dialog state
    private bool showPermanentDeleteDialog;
    private long _permanentDeleteJournalId;

    // Amount change confirmation dialog state
    private bool showAmountChangeConfirm = false;
    private decimal amountChangeOldValue = 0;
    private decimal amountChangeNewValue = 0;
    private bool _confirmedAmountChange = false;

    // Two-step edit state (edit from history)
    private long? editingReceiptId = null;
    private long? editingJournalId = null;

    private int familyDropdownKey = 0;

    private string counterpartyName = "";
    private string amountTotalInput = "";
    private string documentNotes = "";

    private List<PendingReceiptSummary> pendingReceipts = new();
    private bool pendingReceiptsLoading = false;
    private long? currentPendingReceiptId = null;
    
    // DsDropdown items - using centralized service
    private List<DsDropdown.DsDropdownItem> householdItems = new();

    private void OnDocumentTypeChanged(string? value)
    {
        selectedDocumentType = value ?? "";
        selectedTransactionType = "";
        selectedFamily = "";
        currentPendingReceiptId = null;
        
        // Update family disabled state
        isFamilyDisabled = selectedDocumentType != "1";

        if (isFamilyDisabled)
        {
            selectedFamily = "";
        }

        familyDropdownKey++;
    }

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        try
        {
            var rel = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            rel = rel.StartsWith("/") ? rel : "/" + rel;
            _historyOnly = rel.Equals("/admin/manual-journal-entry-v2/history", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _historyOnly = false;
        }

        // Set current Jalali date as default
        var persianCalendar = new System.Globalization.PersianCalendar();
        var today = DateTime.Today;
        selectedDateString = $"{persianCalendar.GetYear(today)}/{persianCalendar.GetMonth(today):D2}/{persianCalendar.GetDayOfMonth(today):D2}";

        // Default history date filter: from fiscal year start to end
        try
        {
            var fy = await FiscalYearRepo.GetOpenYearForDateAsync(DateTime.Today);
            if (fy != null)
            {
                FromDate = fy.StartDate.ToPersianDate();
                ToDate = fy.EndDate.ToPersianDate();
            }
        }
        catch { }
        if (string.IsNullOrWhiteSpace(FromDate) || string.IsNullOrWhiteSpace(ToDate))
        {
            var r = MiniBank.Web.Components.Extensions.DateTimeExtensions.CurrentJalaliYearRange();
            FromDate = r.From;
            ToDate = r.To;
        }

                
        // Initialize empty household items
        householdItems = new List<DsDropdown.DsDropdownItem>
        {
            new DsDropdown.DsDropdownItem { Value = "", Text = "لطفاً خانوار را انتخاب کنید" }
        };
    }

    private async Task LoadHouseholds()
    {
        try
        {
            Console.WriteLine("Loading households from database...");
            var households = await HouseholdRepo.GetAllAsync();
            Console.WriteLine($"Loaded {households.Count()} households from database");
            
            householdDropdownItems = households.Select(h => new { Value = h.HouseholdId.ToString(), Text = $"{h.HouseholdCode} - {h.Name}" }).ToList<object>();
            Console.WriteLine($"Created {householdDropdownItems.Count()} dropdown items");
            
            // Populate household items for DsDropdown
            householdItems = households.Select(h => new DsDropdown.DsDropdownItem 
            { 
                Value = h.HouseholdId.ToString(), 
                Text = $"{h.HouseholdCode} - {h.Name}" 
            }).ToList();
            householdItems.Insert(0, new DsDropdown.DsDropdownItem { Value = "", Text = "لطفاً خانوار را انتخاب کنید" });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in LoadHouseholds: {ex.Message}");
            Toast.Error($"خطا در بارگذاری خانوارها: {ex.Message}");
        }
    }

    private async Task LoadPendingReceipts()
    {
        try
        {
            pendingReceiptsLoading = true;
            await InvokeAsync(StateHasChanged);

            using var connection = await DbConnectionFactory.CreateConnectionAsync();

            const string sql = @"
SELECT TOP (@limit)
    r.HouseholdReceiptId,
    r.TargetHouseholdId,
    r.DocumentType,
    r.TransactionType,
    r.AmountTotal,
    CAST(0 AS DECIMAL(18,2)) AS AllocatedAmount,
    r.CreatedAt,
    r.Notes
FROM dbo.HouseholdReceipts r
WHERE r.Status = 0
ORDER BY r.CreatedAt DESC;";

            var rows = await connection.QueryAsync<PendingReceiptSummary>(sql, new { limit = 50 });
            pendingReceipts = rows.ToList();
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در بارگذاری رسیدهای در انتظار: {ex.Message}");
            pendingReceipts = new();
        }
        finally
        {
            pendingReceiptsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetHouseholdNameById(long? householdId)
    {
        if (!householdId.HasValue || householdId.Value <= 0)
            return "—";
        var item = householdItems.FirstOrDefault(x => x.Value == householdId.ToString());
        if (item?.Text == null) 
            return householdId.Value.ToString();
        
        // Extract only the name part (remove code prefix)
        var text = item.Text;
        var dashIndex = text.IndexOf(" - ");
        return dashIndex > 0 ? text.Substring(dashIndex + 3).Trim() : text;
    }

    private string GetPendingReceiptTitle(PendingReceiptSummary pr)
    {
        // Member receipt -> show household
        if (pr.DocumentType == 1)
            return GetHouseholdNameById(pr.TargetHouseholdId);

        // Non-member receipt -> show transaction type title
        return GetTransactionTypeText(pr.TransactionType);
    }

    private string GetTransactionTypeText(string? code)
    {
        return ReceiptDataService.GetTransactionTypeName(code);
    }

    private async Task ContinuePending(long receiptId)
    {
        try
        {
            using var connection = await DbConnectionFactory.CreateConnectionAsync();
            const string sql = @"SELECT TOP 1 * FROM dbo.HouseholdReceipts WHERE HouseholdReceiptId=@id";
            var receipt = await connection.QueryFirstOrDefaultAsync<HouseholdReceipt>(sql, new { id = receiptId });
            if (receipt == null)
            {
                Toast.Error("رسید پیدا نشد");
                return;
            }

            currentPendingReceiptId = receipt.HouseholdReceiptId;
            selectedDocumentType = receipt.DocumentType.ToString();
            selectedChannel = receipt.PayChannel.ToString();

            selectedTransactionType = (receipt.TransactionType ?? string.Empty).Trim();
            selectedFamily = receipt.DocumentType == 1
                ? (receipt.TargetHouseholdId?.ToString() ?? "")
                : "";

            if (receipt.DocumentType != 1)
            {
                // Ensure household dropdown is visually reset for non-member receipts
                selectedFamily = "";
            }

            counterpartyName = receipt.CounterpartyName ?? "";
            amountTotalInput = receipt.AmountTotal.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
            documentNotes = receipt.Notes ?? "";

            var pc = new System.Globalization.PersianCalendar();
            selectedDateString = $"{pc.GetYear(receipt.OccurredAt)}/{pc.GetMonth(receipt.OccurredAt):D2}/{pc.GetDayOfMonth(receipt.OccurredAt):D2}";

            isFamilyDisabled = selectedDocumentType != "1";

            if (isFamilyDisabled)
            {
                selectedFamily = "";
            }

            familyDropdownKey++;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در بارگذاری رسید: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var rel = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                rel = rel.StartsWith("/") ? rel : "/" + rel;
                _historyOnly = rel.Equals("/admin/manual-journal-entry-v2/history", StringComparison.OrdinalIgnoreCase);
            }
            catch
            {
                _historyOnly = false;
            }

            if (_historyOnly)
            {
                await LoadJournalHistory();
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Load households during initialization
            await LoadHouseholds();
            await LoadPendingReceipts();

            // If navigated back from stage 2, auto-load the receipt/journal into stage 1.
            // Prefer journalId if present (loads receipt + marks edit-from-history), otherwise load receipt directly.
            try
            {
                if (JournalId.HasValue && JournalId.Value > 0)
                {
                    await LoadEditFromHistoryAsync(JournalId.Value);
                }
                else if (ReceiptId.HasValue && ReceiptId.Value > 0)
                {
                    await ContinuePending(ReceiptId.Value);
                }
            }
            catch (Exception ex)
            {
                Toast.Error($"خطا در بارگذاری رسید از آدرس: {ex.Message}");
            }

