<script>
    // Simple click outside to close - lightweight version
    document.addEventListener('click', function(event) {
        const dropdowns = document.querySelectorAll('.ds-dropdown');
        dropdowns.forEach(function(dropdown) {
            const menu = dropdown.querySelector('.ds-dropdown-menu');
            if (menu && menu.style.display !== 'none' && !dropdown.contains(event.target)) {
                menu.style.display = 'none';
                dropdown.classList.remove('open', 'active', 'show');
            }
        });
    });

    // Format amount inputs with 3-digit grouping (while typing) + keep numeric keyboard on mobile.
    // Uses event delegation so it survives Blazor re-renders.
    (function initAmountGrouping() {
        if (window.__amountGroupingInitialized) return;
        window.__amountGroupingInitialized = true;

        function formatWithGroupingKeepingCursor(input) {
            if (!input || !input.classList || !input.classList.contains('amount-input')) return;

            const selectionStart = input.selectionStart ?? 0;
            const raw = input.value ?? '';

            const digitsBeforeCursor = raw.slice(0, selectionStart).replace(/\D/g, '').length;

            const digitsOnly = raw.replace(/\D/g, '');
            if (!digitsOnly) {
                input.value = '';
                return;
            }

            const formatted = digitsOnly.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            input.value = formatted;

            let pos = 0;
            let seenDigits = 0;
            while (pos < formatted.length && seenDigits < digitsBeforeCursor) {
                if (/\d/.test(formatted[pos])) seenDigits++;
                pos++;
            }
            try {
                input.setSelectionRange(pos, pos);
            } catch {
                // some mobile browsers may throw; ignore
            }
        }

        document.addEventListener('input', function (e) {
            const target = e.target;
            if (target && target.classList && target.classList.contains('amount-input')) {
                formatWithGroupingKeepingCursor(target);
            }
        }, true);

        document.addEventListener('paste', function (e) {
            const target = e.target;
            if (target && target.classList && target.classList.contains('amount-input')) {
                setTimeout(function () {
                    formatWithGroupingKeepingCursor(target);
                }, 1);
            }
        }, true);
    })();
</script>

