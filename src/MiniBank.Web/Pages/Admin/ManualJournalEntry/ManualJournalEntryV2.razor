    private async Task LoadEditFromHistoryAsync(long journalId)
    {
        try
        {
            using var connection = await DbConnectionFactory.CreateConnectionAsync();
            
            // Resolve related ReceiptId (if any) and load receipt data into stage1
            const string sql = @"
                SELECT 
                    j.JournalId,
                    COALESCE(t.ParentReceiptId, hr2.HouseholdReceiptId, NULL) AS ReceiptId,
                    j.OccurredAt,
                    j.Notes,
                    COALESCE(hr1.DocumentType, hr2.DocumentType) as DocumentType,
                    COALESCE(hr1.TransactionType, hr2.TransactionType) as TransactionType,
                    COALESCE(hr1.PayChannel, hr2.PayChannel) as PayChannel,
                    COALESCE(hr1.CounterpartyName, hr2.CounterpartyName) as CounterpartyName,
                    
                    -- Get household name for member receipts
                    CASE 
                        WHEN COALESCE(hr1.DocumentType, hr2.DocumentType) = 1 THEN 
                            COALESCE(h.Name, hr1.CounterpartyName, hr2.CounterpartyName, '')
                        ELSE 
                            COALESCE(hr1.CounterpartyName, hr2.CounterpartyName, '')
                    END as DisplayName,
                    
                    ISNULL(COALESCE(t.AmountTotal, hr1.AmountTotal, hr2.AmountTotal), 0) as TransactionAmount,
                    COALESCE(hr1.TargetHouseholdId, hr2.TargetHouseholdId, NULL) as TargetHouseholdId
                FROM dbo.Journals j
                LEFT JOIN dbo.Transactions t ON t.TransactionId = j.TransactionId
                LEFT JOIN dbo.HouseholdReceipts hr1 ON hr1.HouseholdReceiptId = t.ParentReceiptId
                LEFT JOIN dbo.HouseholdReceipts hr2 ON hr2.ExternalRef = CONCAT('J:', j.JournalId)
                LEFT JOIN dbo.Households h ON (h.HouseholdId = hr1.TargetHouseholdId OR h.HouseholdId = hr2.TargetHouseholdId)
                WHERE j.JournalId = @JournalId";

            var journal = await connection.QueryFirstOrDefaultAsync<dynamic>(sql, new { JournalId = journalId });
            
            if (journal != null)
            {
                long? receiptId = journal.ReceiptId == null ? (long?)null : (long)journal.ReceiptId;
                if (!receiptId.HasValue || receiptId.Value <= 0)
                {
                    NavigationManager.NavigateTo($"/admin/manual-journal-entry?journalId={journalId}");
                    return;
                }

                editingReceiptId = receiptId.Value;
                editingJournalId = journalId;

                // Load households first (dropdown items)
                await LoadHouseholds();

                // Load the receipt itself into the form (stage1)
                await ContinuePending(receiptId.Value);

                // Mark stage1 as editing-from-history (receipt might be processed)
                currentPendingReceiptId = receiptId.Value;
                
                Toast.Success("اطلاعات سند برای ویرایش بارگذاری شد. لطفاً تغییرات مورد نظر را اعمال کنید.");
                await InvokeAsync(StateHasChanged);

                await JS.InvokeVoidAsync("eval", "window.scrollTo({top: 0, behavior: 'smooth'});");
            }
            else
            {
                Toast.Error("سند مورد نظر یافت نشد");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در بارگذاری اطلاعات سند: {ex.Message}");
        }
    }

