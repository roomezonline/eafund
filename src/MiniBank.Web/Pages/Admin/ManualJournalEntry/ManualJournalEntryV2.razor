    private async Task SaveAndGoToNext()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(selectedDocumentType) || !byte.TryParse(selectedDocumentType, out var documentType) || (documentType != 1 && documentType != 2))
            {
                Toast.Error("لطفاً نوع سند را انتخاب کنید");
                return;
            }

            long? targetHouseholdId = null;
            if (documentType == 1)
            {
                if (string.IsNullOrWhiteSpace(selectedFamily) || !long.TryParse(selectedFamily, out var hid) || hid <= 0)
                {
                    Toast.Error("لطفاً خانوار مقصد را انتخاب کنید");
                    return;
                }
                targetHouseholdId = hid;
            }

            if (string.IsNullOrWhiteSpace(selectedChannel) || !byte.TryParse(selectedChannel, out var payChannel) || (payChannel != 1 && payChannel != 2 && payChannel != 3))
            {
                Toast.Error("لطفاً کانال را انتخاب کنید");
                return;
            }

            if (string.IsNullOrWhiteSpace(selectedTransactionType))
            {
                Toast.Error("لطفاً نوع تراکنش را انتخاب کنید");
                return;
            }

            var amountDigits = (amountTotalInput ?? string.Empty).Replace(",", "").Trim();
            if (!decimal.TryParse(amountDigits, out var amountTotal) || amountTotal <= 0)
            {
                Toast.Error("لطفاً مبلغ معتبر وارد کنید");
                return;
            }

            documentNotes = (documentNotes ?? string.Empty).Trim();

            if (string.IsNullOrWhiteSpace(documentNotes))
            {
                Toast.Error("لطفاً بابت (شرح سند) را وارد کنید");
                return;
            }

            // Autocomplete history should only learn from successful/validated entries.
            await CommitHistoryAsync("mje.stage1.counterpartyName", counterpartyName);
            await CommitHistoryAsync("mje.stage1.documentNotes", documentNotes);

            var occurredAt = ParseJalaliDateOrNow(selectedDateString);

            long receiptId;

            if (editingReceiptId.HasValue)
            {
                // UPDATE receipt (edit mode) - allow regardless of Status (processed or pending)
                using var connection = await DbConnectionFactory.CreateConnectionAsync();

                var oldAmountTotal = await connection.QueryFirstOrDefaultAsync<decimal?>(
                    "SELECT AmountTotal FROM dbo.HouseholdReceipts WHERE HouseholdReceiptId = @Id",
                    new { Id = editingReceiptId.Value });

                var amountChanged = oldAmountTotal.HasValue && oldAmountTotal.Value != amountTotal;

                if (amountChanged && !_confirmedAmountChange)
                {
                    amountChangeOldValue = oldAmountTotal.Value;
                    amountChangeNewValue = amountTotal;
                    showAmountChangeConfirm = true;
                    await InvokeAsync(StateHasChanged);
                    return;
                }
                _confirmedAmountChange = false;

                const string sql = @"
UPDATE dbo.HouseholdReceipts
SET
    TargetHouseholdId = @TargetHouseholdId,
    DocumentType = @DocumentType,
    TransactionType = @TransactionType,
    CounterpartyName = @CounterpartyName,
    AmountTotal = @AmountTotal,
    PayChannel = @PayChannel,
    OccurredAt = @OccurredAt,
    Notes = @Notes
WHERE HouseholdReceiptId = @Id;";

                var affected = await connection.ExecuteAsync(sql, new
                {
                    Id = editingReceiptId.Value,
                    TargetHouseholdId = targetHouseholdId,
                    DocumentType = documentType,
                    TransactionType = selectedTransactionType.Trim(),
                    CounterpartyName = string.IsNullOrWhiteSpace(counterpartyName) ? null : counterpartyName,
                    AmountTotal = amountTotal,
                    PayChannel = payChannel,
                    OccurredAt = occurredAt,
                    Notes = string.IsNullOrWhiteSpace(documentNotes) ? null : documentNotes
                });

                if (affected > 0)
                {
                    receiptId = editingReceiptId.Value;
                    Toast.Success(amountChanged
                        ? "مبلغ رسید تغییر کرد. لطفاً در مرحله دوم مبلغ خطوط را اصلاح کنید."
                        : "ویرایش مرحله اول انجام شد. انتقال به مرحله دوم...");
                    var jid = editingJournalId;
                    if (jid.HasValue)
                    {
                        var url = amountChanged
                            ? $"/admin/manual-journal-entry?receiptId={receiptId}&journalId={jid.Value}&oldAmount={amountChangeOldValue.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}"
                            : $"/admin/manual-journal-entry?receiptId={receiptId}&journalId={jid.Value}";
                        NavigationManager.NavigateTo(url);
                    }
                    else
                        NavigationManager.NavigateTo($"/admin/manual-journal-entry?receiptId={receiptId}");
                }
                else
                {
                    Toast.Warning("ویرایش انجام نشد");
                    return;
                }
            }
            else if (currentPendingReceiptId.HasValue)
            {
                // UPDATE existing pending receipt (Status = 0)
                using var connection = await DbConnectionFactory.CreateConnectionAsync();
                const string sql = @"
UPDATE dbo.HouseholdReceipts
SET
    TargetHouseholdId = @TargetHouseholdId,
    DocumentType = @DocumentType,
    TransactionType = @TransactionType,
    CounterpartyName = @CounterpartyName,
    AmountTotal = @AmountTotal,
    PayChannel = @PayChannel,
    OccurredAt = @OccurredAt,
    Notes = @Notes
WHERE HouseholdReceiptId = @Id AND Status = 0;";

                var affected = await connection.ExecuteAsync(sql, new
                {
                    Id = currentPendingReceiptId.Value,
                    TargetHouseholdId = targetHouseholdId,
                    DocumentType = documentType,
                    TransactionType = selectedTransactionType.Trim(),
                    CounterpartyName = string.IsNullOrWhiteSpace(counterpartyName) ? null : counterpartyName,
                    AmountTotal = amountTotal,
                    PayChannel = payChannel,
                    OccurredAt = occurredAt,
                    Notes = string.IsNullOrWhiteSpace(documentNotes) ? null : documentNotes
                });

                if (affected > 0)
                {
                    receiptId = currentPendingReceiptId.Value;
                    Toast.Success("رسید با موفقیت ویرایش شد. انتقال به مرحله دوم...");
                    NavigationManager.NavigateTo($"/admin/manual-journal-entry?receiptId={receiptId}");
                }
                else
                {
                    Toast.Warning("ویرایش انجام نشد (ممکن است رسید قبلاً پردازش شده باشد)");
                    return;
                }
            }
            else
            {
                // INSERT new receipt
                using var connection = await DbConnectionFactory.CreateConnectionAsync();

                const string sql = @"
INSERT INTO dbo.HouseholdReceipts (
    TargetHouseholdId,
    DocumentType,
    TransactionType,
    CounterpartyName,
    AmountTotal,
    PayChannel,
    OccurredAt,
    CreatedAt,
    CreatedBy,
    Status,
    Notes,
    ExternalRef
)
VALUES (
    @TargetHouseholdId,
    @DocumentType,
    @TransactionType,
    @CounterpartyName,
    @AmountTotal,
    @PayChannel,
    @OccurredAt,
    GETUTCDATE(),
    @CreatedBy,
    @Status,
    @Notes,
    NULL
);
SELECT CAST(SCOPE_IDENTITY() AS BIGINT);";

                receiptId = await connection.QuerySingleAsync<long>(sql, new
                {
                    TargetHouseholdId = targetHouseholdId,
                    DocumentType = documentType,
                    TransactionType = selectedTransactionType,
                    CounterpartyName = string.IsNullOrWhiteSpace(counterpartyName) ? null : counterpartyName,
                    AmountTotal = amountTotal,
                    PayChannel = payChannel,
                    OccurredAt = occurredAt,
                    CreatedBy = "system",
                    Status = (byte)0,
                    Notes = string.IsNullOrWhiteSpace(documentNotes) ? null : documentNotes
                });

                Toast.Success($"رسید ثبت شد (کد: {receiptId}). انتقال به مرحله دوم...");
                NavigationManager.NavigateTo($"/admin/manual-journal-entry?receiptId={receiptId}");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در ثبت رسید: {ex.Message}");
        }
    }

    private async Task CommitHistoryAsync(string key, string? value)
    {
        try
        {
            var k = System.Text.Json.JsonSerializer.Serialize(key);
            var v = System.Text.Json.JsonSerializer.Serialize(value ?? string.Empty);
            await JS.InvokeVoidAsync("eval", $"window.mbHistorySuggest && window.mbHistorySuggest.commit({k}, {v});");
        }
        catch
        {
            // ignore
        }
    }

    private static DateTime ParseJalaliDateOrNow(string? jalali)
    {
        if (string.IsNullOrWhiteSpace(jalali))
            return DateTime.Now;

        try
        {
            var parts = jalali.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (parts.Length != 3)
                return DateTime.Now;

            if (!int.TryParse(parts[0], out var y)) return DateTime.Now;
            if (!int.TryParse(parts[1], out var m)) return DateTime.Now;
            if (!int.TryParse(parts[2], out var d)) return DateTime.Now;

            var pc = new System.Globalization.PersianCalendar();
            var dtLocal = pc.ToDateTime(y, m, d, 0, 0, 0, 0);
            return DateTime.SpecifyKind(dtLocal, DateTimeKind.Local);
        }
        catch
        {
            return DateTime.Now;
        }
    }

