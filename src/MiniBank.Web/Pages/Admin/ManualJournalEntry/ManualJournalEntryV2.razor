    private async Task ToggleJournalDetailsAsync(long journalId)
    {
        if (ExpandedJournals.Contains(journalId))
        {
            ExpandedJournals.Remove(journalId);
            await InvokeAsync(StateHasChanged);
            return;
        }

        ExpandedJournals.Clear();
        ExpandedJournals.Add(journalId);
        await InvokeAsync(StateHasChanged);

        var item = JournalHistory.FirstOrDefault(x => x.JournalId == journalId);
        if (item == null) return;
        if (item.Lines != null && item.Lines.Count > 0) return;
        if (_journalHistoryLineLoading.Contains(journalId)) return;

        _journalHistoryLineLoading.Add(journalId);
        await InvokeAsync(StateHasChanged);
        try
        {
            using var connection = await DbConnectionFactory.CreateConnectionAsync();
            const string linesSql = @"
SELECT 
    jl.JournalLineId,
    jl.JournalLineId AS LineNumber,
    CASE 
        WHEN ma.AccountId IS NOT NULL THEN COALESCE(ma.Code, '-')
        WHEN a.Level = 3 THEN COALESCE(a.Code, '-')
        ELSE '-'
    END AS MoeenCode,
    CASE 
        WHEN ma.AccountId IS NOT NULL THEN COALESCE(ma.Name, 'Unknown')
        WHEN a.Level = 3 THEN COALESCE(a.Name, 'Unknown')
        ELSE N'تفصیلی مستقل'
    END AS MoeenName,
    CASE 
        WHEN a.Level = 4 THEN COALESCE(a.Code, '-')
        ELSE '-'
    END AS SubsidiaryCode,
    CASE 
        WHEN a.Level = 4 THEN COALESCE(a.Name, '-')
        ELSE '-'
    END AS SubsidiaryName,
    jl.Description,
    jl.Debit,
    jl.Credit
FROM dbo.JournalLines jl
LEFT JOIN dbo.Accounts a ON jl.AccountId = a.AccountId
LEFT JOIN dbo.Accounts ma ON ma.AccountId = jl.ParentAccountId
WHERE jl.JournalId = @JournalId
ORDER BY jl.JournalLineId";

            var lines = (await connection.QueryAsync<JournalLineHistoryItem>(linesSql, new { JournalId = journalId })).ToList();
            item.Lines = lines;
            item.TotalDebit = item.Lines.Sum(l => l.Debit);
            item.TotalCredit = item.Lines.Sum(l => l.Credit);
            item.IsBalanced = Math.Abs(item.TotalDebit - item.TotalCredit) < 0.01m;
            if (item.TransactionAmount <= 0)
                item.TransactionAmount = Math.Max(item.TotalDebit, item.TotalCredit);
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در بارگذاری جزئیات سند: {ex.Message}");
        }
        finally
        {
            _journalHistoryLineLoading.Remove(journalId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private DateTime ConvertJalaliToGregorian(string jalaliDate)
        => DateTime.SpecifyKind(Components.Extensions.DateTimeExtensions.FromPersianDate(jalaliDate), DateTimeKind.Local);

    private static string NormalizeDigits(string input)
    {
        if (string.IsNullOrEmpty(input)) return string.Empty;

        return input
            .Replace('۰', '0').Replace('۱', '1').Replace('۲', '2').Replace('۳', '3').Replace('۴', '4')
            .Replace('۵', '5').Replace('۶', '6').Replace('۷', '7').Replace('۸', '8').Replace('۹', '9')
            .Replace('٠', '0').Replace('١', '1').Replace('٢', '2').Replace('٣', '3').Replace('٤', '4')
            .Replace('٥', '5').Replace('٦', '6').Replace('٧', '7').Replace('٨', '8').Replace('٩', '9');
    }

    private async Task ExportToExcel()
    {
        try
        {
            var csv = new System.Text.StringBuilder();
            csv.AppendLine("شماره سند,تاریخ سند,نوع سند,نوع تراکنش,مبلغ تراکنش,کانال پرداخت,طرف مقابل,شرح سند");

            foreach (var journal in FilteredJournalHistory)
            {
                csv.AppendLine($"{(journal.DocumentNumber?.ToString() ?? $"P-{journal.JournalId}")},{journal.OccurredAt:yyyy/MM/dd},\"{journal.DocumentTypeName}\",\"{journal.TransactionTypeName}\",{journal.TransactionAmount},\"{journal.ChannelName}\",\"{journal.CounterpartyName}\",\"{journal.Notes}\"");
            }

            var fileName = $"journals_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
            await JS.InvokeVoidAsync("downloadFile", fileName, "text/csv;charset=utf-8", Convert.ToBase64String(bytes));
            Toast.Success("فایل با موفقیت دانلود شد");
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در خروجی گرفتن: {ex.Message}");
        }
    }

