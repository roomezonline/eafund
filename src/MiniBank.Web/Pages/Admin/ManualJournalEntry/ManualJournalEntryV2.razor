@page "/admin/manual-journal-entry-v2"
@page "/admin/manual-journal-entry-v2/history"
@using MiniBank.Web.Components.Extensions
@using MiniBank.Web.Components
@using MiniBank.Web.Components.DesignSystem
@using MiniBank.Web.Services
@inject IDbConnection _db
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
