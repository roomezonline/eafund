    private async Task SortByColumn(string columnName)
    {
        // Set active search column context
        _activeSearchColumn = columnName;

        if (SortColumn == columnName)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = columnName;
            SortAscending = true;
        }
        await ReloadJournalHistoryAsync();
    }

    private void ApplyJournalSort()
    {
        if (FilteredJournalHistory == null || FilteredJournalHistory.Count == 0)
            return;

        var asc = SortAscending;
        var key = (SortColumn ?? string.Empty).Trim();

        IEnumerable<JournalHistoryItem> q = key switch
        {
            "DocumentNumber" => asc ? FilteredJournalHistory.OrderBy(x => x.DocumentNumber ?? 0) : FilteredJournalHistory.OrderByDescending(x => x.DocumentNumber ?? 0),
            "OccurredAt" => asc ? FilteredJournalHistory.OrderBy(x => x.OccurredAt).ThenBy(x => x.JournalId) : FilteredJournalHistory.OrderByDescending(x => x.OccurredAt).ThenByDescending(x => x.JournalId),
            "TransactionAmount" => asc ? FilteredJournalHistory.OrderBy(x => x.TransactionAmount).ThenBy(x => x.JournalId) : FilteredJournalHistory.OrderByDescending(x => x.TransactionAmount).ThenByDescending(x => x.JournalId),
            "DocumentTypeName" => asc ? FilteredJournalHistory.OrderBy(x => x.DocumentTypeName) : FilteredJournalHistory.OrderByDescending(x => x.DocumentTypeName),
            "TransactionTypeName" => asc ? FilteredJournalHistory.OrderBy(x => x.TransactionTypeName) : FilteredJournalHistory.OrderByDescending(x => x.TransactionTypeName),
            "ChannelName" => asc ? FilteredJournalHistory.OrderBy(x => x.ChannelName) : FilteredJournalHistory.OrderByDescending(x => x.ChannelName),
            "DisplayName" => asc ? FilteredJournalHistory.OrderBy(x => x.DisplayName) : FilteredJournalHistory.OrderByDescending(x => x.DisplayName),
            "Notes" => asc ? FilteredJournalHistory.OrderBy(x => x.Notes) : FilteredJournalHistory.OrderByDescending(x => x.Notes),
            "SerialNumber" => asc ? FilteredJournalHistory.OrderBy(x => x.SerialNumber ?? 9999999) : FilteredJournalHistory.OrderByDescending(x => x.SerialNumber ?? 9999999),
            _ => asc ? FilteredJournalHistory.OrderByDescending(x => x.JournalId) : FilteredJournalHistory.OrderByDescending(x => x.JournalId)
        };

        FilteredJournalHistory = q.ToList();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;

        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(180, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested) return;
        await ReloadJournalHistoryAsync();
        await InvokeAsync(StateHasChanged);
    }

