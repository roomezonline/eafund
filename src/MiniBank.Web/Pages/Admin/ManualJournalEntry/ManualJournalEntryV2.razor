    private static string GetDisplayNotes(JournalHistoryItem journal)
    {
        var isDepositInterest = IsDepositInterestNotes(journal.Notes);
        var isLoanDisburse = IsLoanDisbursementNotes(journal.Notes);
        if (!isDepositInterest && !isLoanDisburse)
            return journal.Notes;

        var parts = journal.Notes.Split('|', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => x.Length > 0)
            .Where(x => !x.StartsWith("Run:", StringComparison.OrdinalIgnoreCase))
            .Where(x => !x.StartsWith("Member:", StringComparison.OrdinalIgnoreCase))
            .Where(x => !x.StartsWith("Loan:", StringComparison.OrdinalIgnoreCase))
            .Where(x => !x.Equals("LoanDisburse", StringComparison.OrdinalIgnoreCase))
            .ToList();

        return parts.Count == 0 ? journal.Notes : string.Join(" | ", parts);
    }

    private string GetSortIconClass(string columnName)
    {
