    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Avoid PWA service worker registration and version checks in Development to prevent caching issues
                if (!Env.IsDevelopment())
                {
                    await JS.InvokeVoidAsync("SWUpdate.register", DotNetObjectReference.Create(this));
                    _ = LoadVersionAsync();
                    _ = LoadLocalVersionAsync();
                }
            }
            catch { }

            try
            {
                await JS.InvokeVoidAsync("baamBudgetDeltaInit");
            }
            catch { }
        }

        try
        {
            await JS.InvokeVoidAsync("baamBudgetDeltaFitAll");
        }
        catch { }
    }

    [JSInvokable("OnUpdateAvailable")]
    public void OnUpdateAvailable()
    {
        updateAvailable = true;
        _ = LoadVersionAsync();
        StateHasChanged();
    }

    private async Task ApplyUpdate()
    {
        try
        {
            await JS.InvokeVoidAsync("SWUpdate.apply");
            Toasts.Info("در حال اعمال بروزرسانی...");
        }
        catch (Exception ex)
        {
            Toasts.Error($"اعمال بروزرسانی با خطا مواجه شد: {ex.Message}");
        }
    }

    private async Task LoadVersionAsync()
    {
        try
        {
            // Cache-busting to ensure we fetch the latest version.json when SW indicates update
            var url = $"/version.json?t={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";
            using var resp = await Http.GetAsync(url);
            resp.EnsureSuccessStatusCode();
            var json = await resp.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(json);
            serverVersion = doc.RootElement.TryGetProperty("version", out var v) ? v.GetString() : null;
            serverVersionDate = doc.RootElement.TryGetProperty("date", out var d) ? d.GetString() : null;
            if (doc.RootElement.TryGetProperty("notes", out var notesElement) && notesElement.ValueKind == JsonValueKind.Array)
            {
                serverNotes = notesElement.EnumerateArray().Select(x => x.GetString() ?? string.Empty).Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
            }
            StateHasChanged();
        }
        catch { /* ignore */ }
    }
    private async Task LoadLocalVersionAsync()
    {
        try
        {
            var local = await JS.InvokeAsync<LocalVersion>("SWUpdate.getLocalVersion");
            currentVersion = local?.version;
            currentVersionDate = local?.date;
            currentNotes = local?.notes ?? new List<string>();
            StateHasChanged();
        }
        catch { /* ignore */ }
    }

    private class LocalVersion
    {
        public string? version { get; set; }
        public string? date { get; set; }
        public List<string> notes { get; set; } = new();
    }
    private async Task RebuildDb()
    {
