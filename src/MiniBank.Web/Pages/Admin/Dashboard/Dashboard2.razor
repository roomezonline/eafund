    private decimal Bourse1Balance;
    private decimal Bourse2Balance;
    private decimal BourseTotalBalance;

    private string Bourse1AccountTitle = "-";
    private string Bourse2AccountTitle = "-";

    private List<BudgetItemVm> _budgetItems = new();
    private decimal BudgetTotal;

    private decimal AnnualYield;
    private decimal TotalYield;
    private string AnnualYieldText = "بازده سالانه (یکسال اخیر)";
    private string TotalYieldText = "بازده کل";


    // If true => budget is over loan principal (negative delta)
    private bool IsBudgetLoanOver8PercentOfLoanPrincipal;
    private string BudgetLoanDeltaText = string.Empty;

    private string Equity310101Title = "تفضیلی ۳۱۰۱۰۱";
    private string Equity310102Title = "-";
    private decimal Equity310101Balance;
    private decimal Equity310102Balance;
