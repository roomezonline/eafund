@code {
    private bool updateAvailable = false;
    private string? serverVersion;
    private string? serverVersionDate;
    private List<string> serverNotes = new();
    private string? currentVersion;
    private string? currentVersionDate;
    private List<string> currentNotes = new();

    private bool _balanceLoading;
    private bool _showDepositAmounts = true;
    private bool _showLoanAmounts = true;
    private bool _showBourseAmounts = true;
    private bool _showBudgetAmounts = true;
    private bool _showEquityAmounts = true;
