@page "/admin/dashboard2"
@inject NavigationManager NavigationManager
@inject MiniBank.Web.Services.DatabaseMigrationService Migrator
@inject MiniBank.Web.Services.LoadingService Loading
@inject MiniBank.Web.Components.DesignSystem.DsToastService Toasts
@inject IJSRuntime JS
@inject HttpClient Http
@inject IWebHostEnvironment Env
@inject MiniBank.Web.Infrastructure.Repositories.TrialBalanceRepository TrialBalanceRepo
@inject MiniBank.Web.Infrastructure.Repositories.LoanInstallmentReminderRepository LoanReminderRepo
@inject MiniBank.Web.Infrastructure.Repositories.FiscalYearRepository FiscalYearRepo
@inject MiniBank.Web.Services.FiscalYearContext FyContext
@inject MiniBank.Web.Infrastructure.Repositories.CashFlowBudgetRepository BudgetRepo
@using MiniBank.Web.Models
@using System.Text.Json

<section class="baam-dashboard">
    @if (updateAvailable)
    {
        <div class="baam-update-banner">
            <div class="update-content">
                <div class="update-icon">
                    <i class="fa-solid fa-download"></i>
                </div>
                <div class="update-text">
                    <div class="update-title">بروزرسانی در دسترس است</div>
                    <div class="update-desc">نسخه جدید اپلیکیشن آماده است</div>
                </div>
                <button class="update-btn" @onclick="ApplyUpdate">
                    <i class="fa-solid fa-arrow-down"></i>
                </button>
            </div>
        </div>
    }

    <div class="overdue-chip-wrap">
        <a href="/admin/loan-installment-reminders" class="overdue-chip-card @(_balanceLoading ? "is-loading" : "")" title="ورود به صفحه یادآوری اقساط">
            <div class="overdue-chip-icon">
                <i class="fa-solid fa-bell"></i>
            </div>
            <div class="overdue-chip-text">
                @if (_balanceLoading)
                {
                    <span class="overdue-chip-title">یادآوری:</span>
                    <span class="overdue-chip-desc">در حال بارگذاری...</span>
                }
                else if (_overdueBorrowersCount > 0)
                {
                    <span class="overdue-chip-title">یادآوری:</span>
                    <span class="overdue-chip-desc"><b>@_overdueBorrowersCount</b> نفر قسطِ معوق دارند.</span>
                }
                else
                {
                    <span class="overdue-chip-title">یادآوری:</span>
                    <span class="overdue-chip-desc">مورد معوقی ثبت نشده است.</span>
                }
            </div>
            <div class="overdue-chip-action">
                <span>مشاهده</span>
                <i class="fa-solid fa-chevron-left"></i>
            </div>
        </a>
    </div>

    <div class="balance-cards-row">
        <div class="balance-card-new balance-card-snap">
            <div class="card-header">
                <div class="header-right">
                    <div class="card-icon">
                        <i class="fa-solid fa-piggy-bank"></i>
                    </div>
                    <div class="card-title">موجودی سپرده اعضا</div>
                </div>
                <div class="header-left">
                    <button class="details-btn" @onclick="ToggleDepositAmounts">
                        <i class="fa-solid @(_showDepositAmounts ? "fa-eye" : "fa-eye-slash")"></i>
                    </button>
                </div>
            </div>

            <div class="card-body">
                <div class="balance-row">
                    <span class="balance-label">+خالص اصل سپرده</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showDepositAmounts, PrincipalBalance))</span>
                </div>
                <div class="balance-row">
                    <span class="balance-label">+خالص سودسپرده</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showDepositAmounts, InterestBalance))</span>
                </div>
                <div class="balance-row">
                    <span class="balance-label">=جمع خالص کل سپرده</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showDepositAmounts, TotalBalance))</span>
                </div>

                <div class="balance-row">
                    <span class="balance-label">@AnnualYieldText</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : (AnnualYield.ToString("N2") + "%"))</span>
                </div>
                <div class="balance-row">
                    <span class="balance-label">@TotalYieldText</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : (TotalYield.ToString("N2") + "%"))</span>
                </div>
            </div>
        </div>

        <div class="balance-card-new balance-card-snap">
            <div class="card-header">
                <div class="header-right">
                    <div class="card-icon">
                        <i class="fa-solid fa-money-check-dollar"></i>
                    </div>
                    <div class="card-title">وام پرداختی به اعضا</div>
                </div>
                <div class="header-left">
                    <button class="details-btn" @onclick="ToggleLoanAmounts">
                        <i class="fa-solid @(_showLoanAmounts ? "fa-eye" : "fa-eye-slash")"></i>
                    </button>
                </div>
            </div>

            <div class="card-body">
                <div class="balance-row">
                    <span class="balance-label">مانده اصل وام</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showLoanAmounts, LoanPrincipalBalance))</span>
                </div>
                <div class="balance-row">
                    <span class="balance-label">مانده سود وام</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showLoanAmounts, LoanInterestBalance))</span>
                </div>
                <div class="balance-row">
                    <span class="balance-label">مانده کل وام</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showLoanAmounts, LoanTotalBalance))</span>
                </div>

                <div class="balance-row">
                    <span class="balance-label">1301 = @LoanPrincipalAccountTitle</span>
                    <span class="balance-value"></span>
                </div>
                <div class="balance-row">
                    <span class="balance-label">1302 = @LoanInterestAccountTitle</span>
                    <span class="balance-value"></span>
                </div>
            </div>
        </div>

        <div class="balance-card-new balance-card-snap">
            <div class="card-header">
                <div class="header-right">
                    <div class="card-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div class="card-title">موجودی سرمایه گذاری بورس</div>
                </div>
                <div class="header-left">
                    <button class="details-btn" @onclick="ToggleBourseAmounts">
                        <i class="fa-solid @(_showBourseAmounts ? "fa-eye" : "fa-eye-slash")"></i>
                    </button>
                </div>
            </div>

            <div class="card-body">
                <div class="balance-row">
                    <span class="balance-label">مانده بورس ۱</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showBourseAmounts, Bourse1Balance))</span>
                </div>
                <div class="balance-row">
                    <span class="balance-label">مانده بورس ۲</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showBourseAmounts, Bourse2Balance))</span>
                </div>
                <div class="balance-row">
                    <span class="balance-label">جمع کل سرمایه گذاری بورس</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showBourseAmounts, BourseTotalBalance))</span>
                </div>

                <div class="balance-row">
                    <span class="balance-label">120101 = @Bourse1AccountTitle</span>
                    <span class="balance-value"></span>
                </div>
                <div class="balance-row">
                    <span class="balance-label">120201 = @Bourse2AccountTitle</span>
                    <span class="balance-value"></span>
                </div>
            </div>
        </div>

        <div class="balance-card-new balance-card-snap">
            <div class="card-header">
                <div class="header-right">
                    <div class="card-icon">
                        <i class="fa-solid fa-coins"></i>
                    </div>
                    <div class="card-title">بودجه بندی نقدینگی</div>
                </div>
                <div class="header-left" style="gap:5px">
                    <a href="/admin/cashflow-budget" class="details-btn" title="تنظیم بودجه">
                        <i class="fa-solid fa-sliders"></i>
                    </a>
                    <button class="details-btn" @onclick="ToggleBudgetAmounts">
                        <i class="fa-solid @(_showBudgetAmounts ? "fa-eye" : "fa-eye-slash")"></i>
                    </button>
                </div>
            </div>

            <div class="card-body">
                @foreach (var b in _budgetItems)
                {
                    var isFirst = b == _budgetItems.FirstOrDefault();
                    <div class="balance-row @(isFirst && IsBudgetLoanOver8PercentOfLoanPrincipal ? "budget-bad" : "budget-ok")">
                        <span class="balance-label">@b.Title (@b.PercentText)</span>
                        <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showBudgetAmounts, b.Amount))</span>
                    </div>
                }
                <div class="balance-row">
                    <span class="balance-label">جمع کل (۱۰۰٪)</span>
                    <span class="balance-value">@(_balanceLoading ? "..." : DisplayAmount(_showBudgetAmounts, BudgetTotal))</span>
                </div>

                <div class="balance-row @(IsBudgetLoanOver8PercentOfLoanPrincipal ? "budget-bad" : "budget-ok")">
                    <span class="balance-value budget-delta-text budget-delta-autofit @(IsBudgetLoanOver8PercentOfLoanPrincipal ? "budget-bad-text" : "budget-ok-text")">@BudgetLoanDeltaText</span>
                </div>
            </div>
        </div>

