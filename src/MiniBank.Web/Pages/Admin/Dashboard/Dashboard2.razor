        {
            Loading?.Show("بانک اطلاعاتی", "در حال اجرای اسکریپت و بازسازی جداول...", "fa-solid fa-database");
            // اجرای سیستم متمرکز مهاجرت: کلیه فایل‌های پوشه database به ترتیب نام اعمال می‌شوند
            await Migrator.ApplyMigrationsAsync();
            Toasts.Success("مهاجرت/بازسازی بانک با موفقیت انجام شد.");
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در بازسازی بانک: {ex.Message}");
        }
        finally
        {
            Loading?.Hide();
        }
    }

