    protected override async Task OnInitializedAsync()
    {
        _balanceLoading = true;
        await InvokeAsync(StateHasChanged);

        await Task.WhenAll(
            LoadBalanceCardAsync(),
            LoadOverdueBorrowersChipAsync(),
            LoadFyStatusAsync());

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadFyStatusAsync()
    {
        // فقط برچسب/نمایش: سالِ انتخاب‌شده توسط کاربر، وگرنه سالِ بازِ امروز.
        try { _fyStatus = await FyContext.GetActiveAsync(); } catch { }
        if (_fyStatus == null)
        {
            try { _fyStatus = await FiscalYearRepo.GetOpenYearForDateAsync(DateTime.Today); } catch { }
        }
    }

    private int _overdueBorrowersCount;

    private async Task LoadOverdueBorrowersChipAsync()
    {
        try
        {
            _overdueBorrowersCount = await LoanReminderRepo.CountOverdueBorrowersAsync();
        }
        catch
        {
            _overdueBorrowersCount = 0;
        }
    }

    private async Task LoadBalanceCardAsync()
    {
        try
        {
            // loading flag is managed by caller to avoid multiple renders

            // 2201: اصل سپرده (معین)
            // 2202: سود سپرده (معین)
            var principal = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("2201");
            var interest = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("2202");

            // 1301: اصل وام (معین)
            // 1302: سود وام (معین)
            var loanPrincipal = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("1301");
            var loanInterest = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("1302");

            // 1201: سرمایه گذاری بورس (معین)
            // 120101: بورس 1 (تفضیلی)
            // 120201: بورس 2 (تفضیلی)
            var bourse1 = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("120101");
            var bourse2 = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("120201");

            var equity310101 = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("310101");
            var equity310102 = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("310102");
            var equityCapital = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("3101");
            var equityRE1 = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("3102");
            var equityRE2 = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("3302");
            decimal resVal = 0;
            var level1Accounts = (await TrialBalanceRepo.GetByLevelAsync(1, null, false, null, null, null)).ToList();
            var equityRoot = level1Accounts.FirstOrDefault(x => x.AccountType == 3);
            if (equityRoot != null)
            {
                var equityLevel2 = (await TrialBalanceRepo.GetChildrenAsync(equityRoot.AccountId, null, null, null))
                    .Where(x => x.AccountType == 3 && x.Level == 2)
                    .OrderBy(x => x.Code)
                    .ToList();
                var reservesNode = equityLevel2.FirstOrDefault(c =>
                    c.Code.StartsWith("3304") || c.Name.Contains("اندوخته"));
                if (reservesNode != null)
                    resVal = ToPositive(ComputeDisplayNet(reservesNode.AccountType, reservesNode.DebitBalance, reservesNode.CreditBalance));
            }

            PrincipalBalance = principal is null ? 0 : ComputeDisplayNet(principal.AccountType, principal.DebitBalance, principal.CreditBalance);
            InterestBalance = interest is null ? 0 : ComputeDisplayNet(interest.AccountType, interest.DebitBalance, interest.CreditBalance);
            TotalBalance = PrincipalBalance + InterestBalance;

            var dbBudget = await BudgetRepo.GetAllAsync();
            _budgetItems = dbBudget.Select(x => new BudgetItemVm
            {
                Title = x.Title,
                Percentage = x.Percentage,
                PercentText = $"{x.Percentage:0.#}%",
                Amount = 0
            }).ToList();

            DepositPrincipalAccountTitle = await GetAccountTitleByAccountIdAsync(principal?.AccountId) ?? "-";
            DepositInterestAccountTitle = await GetAccountTitleByAccountIdAsync(interest?.AccountId) ?? "-";

            LoanPrincipalBalance = loanPrincipal is null ? 0 : ComputeDisplayNet(loanPrincipal.AccountType, loanPrincipal.DebitBalance, loanPrincipal.CreditBalance);
            LoanInterestBalance = loanInterest is null ? 0 : ComputeDisplayNet(loanInterest.AccountType, loanInterest.DebitBalance, loanInterest.CreditBalance);
            LoanTotalBalance = LoanPrincipalBalance + LoanInterestBalance;

            LoanPrincipalAccountTitle = await GetAccountTitleByAccountIdAsync(loanPrincipal?.AccountId) ?? "-";
            LoanInterestAccountTitle = await GetAccountTitleByAccountIdAsync(loanInterest?.AccountId) ?? "-";

            Bourse1Balance = bourse1 is null ? 0 : ComputeDisplayNet(bourse1.AccountType, bourse1.DebitBalance, bourse1.CreditBalance);
            Bourse2Balance = bourse2 is null ? 0 : ComputeDisplayNet(bourse2.AccountType, bourse2.DebitBalance, bourse2.CreditBalance);
            BourseTotalBalance = Bourse1Balance + Bourse2Balance;

            Bourse1AccountTitle = await GetAccountTitleByAccountIdAsync(bourse1?.AccountId) ?? "-";
            Bourse2AccountTitle = await GetAccountTitleByAccountIdAsync(bourse2?.AccountId) ?? "-";

            BudgetTotal = 0;
            foreach (var b in _budgetItems)
            {
                b.Amount = decimal.Round(TotalBalance * b.Percentage / 100m, 0, MidpointRounding.AwayFromZero);
                BudgetTotal += b.Amount;
            }

            var firstBudget = _budgetItems.FirstOrDefault();
            var budgetDelta = (firstBudget?.Amount ?? 0) - LoanPrincipalBalance;
            IsBudgetLoanOver8PercentOfLoanPrincipal = budgetDelta < 0;
            var budgetDeltaAbs = ToPositive(budgetDelta);
            if (IsBudgetLoanOver8PercentOfLoanPrincipal)
                BudgetLoanDeltaText = $"بودجه وام {budgetDeltaAbs.ToString("N0")} ریال منفی است";
            else
                BudgetLoanDeltaText = $"بودجه وام {budgetDeltaAbs.ToString("N0")} ریال مثبت است";

            Equity310101Balance = equity310101 is null ? 0 : ToPositive(ComputeDisplayNet(equity310101.AccountType, equity310101.DebitBalance, equity310101.CreditBalance));
            Equity310102Balance = equity310102 is null ? 0 : ToPositive(ComputeDisplayNet(equity310102.AccountType, equity310102.DebitBalance, equity310102.CreditBalance));

            var capitalVal = equityCapital is null ? 0 : ToPositive(ComputeDisplayNet(equityCapital.AccountType, equityCapital.DebitBalance, equityCapital.CreditBalance));
            var re1Val = equityRE1 is null ? 0 : ToPositive(ComputeDisplayNet(equityRE1.AccountType, equityRE1.DebitBalance, equityRE1.CreditBalance));
            var re2Val = equityRE2 is null ? 0 : ToPositive(ComputeDisplayNet(equityRE2.AccountType, equityRE2.DebitBalance, equityRE2.CreditBalance));

            EquityCapitalBalance = capitalVal;
            EquityRetainedEarningsBalance = re1Val + re2Val;
            EquityReservesBalance = resVal;

            Equity310102Title = await GetAccountTitleByAccountIdAsync(equity310102?.AccountId) ?? "-";
            Equity310101Title = await GetAccountTitleByAccountIdAsync(equity310101?.AccountId) ?? "تفضیلی ۳۱۰۱۰۱";

            // محاسبه بازده‌ها
            var oneYearAgo = DateTime.Today.AddYears(-1);
            var lastYearInterest = await TrialBalanceRepo.GetAccountBalanceByCodeAsync("2202", from: oneYearAgo);
            var lastYearInterestVal = lastYearInterest is null ? 0 : ComputeDisplayNet(lastYearInterest.AccountType, lastYearInterest.DebitBalance, lastYearInterest.CreditBalance);
            
            AnnualYield = PrincipalBalance > 0 ? (lastYearInterestVal / PrincipalBalance) * 100 : 0;
            TotalYield = PrincipalBalance > 0 ? (InterestBalance / PrincipalBalance) * 100 : 0;
        }
        catch (Exception ex)
        {
            PrincipalBalance = 0;
            InterestBalance = 0;
            TotalBalance = 0;

            DepositPrincipalAccountTitle = "-";
            DepositInterestAccountTitle = "-";

            LoanPrincipalBalance = 0;
            LoanInterestBalance = 0;
            LoanTotalBalance = 0;

            LoanPrincipalAccountTitle = "-";
            LoanInterestAccountTitle = "-";

            Bourse1Balance = 0;
            Bourse2Balance = 0;
            BourseTotalBalance = 0;

            Bourse1AccountTitle = "-";
            Bourse2AccountTitle = "-";

            _budgetItems.Clear();
            BudgetTotal = 0;

            IsBudgetLoanOver8PercentOfLoanPrincipal = false;
            BudgetLoanDeltaText = string.Empty;

            Equity310101Title = "تفضیلی ۳۱۰۱۰۱";
            Equity310102Title = "-";
            Equity310101Balance = 0;
            Equity310102Balance = 0;
            EquityCapitalBalance = 0;
            EquityRetainedEarningsBalance = 0;
            EquityReservesBalance = 0;
            Toasts.Error($"خطا در محاسبه موجودی صندوق: {ex.Message}");
        }
        finally
        {
            _balanceLoading = false;
        }
    }

    private decimal ComputeDisplayNet(byte accountType, decimal debit, decimal credit)
    {
        var net = debit - credit;
        if (accountType == 2 || accountType == 3 || accountType == 4)
            net = -net;
        return net;
    }

    private static string DisplayAmount(bool show, decimal value)
    {
        return show ? value.ToString("N0") : "•••";
    }

    private void ToggleDepositAmounts() { _showDepositAmounts = !_showDepositAmounts; }
    private void ToggleLoanAmounts() { _showLoanAmounts = !_showLoanAmounts; }
