    private void ToggleBudgetAmounts() { _showBudgetAmounts = !_showBudgetAmounts; }
    private void ToggleEquityAmounts() { _showEquityAmounts = !_showEquityAmounts; }

    private static decimal ToPositive(decimal v)
    {
        return v < 0 ? -v : v;
    }

    private async Task<string?> GetAccountTitleByAccountIdAsync(long? accountId)
    {
        if (!accountId.HasValue || accountId.Value <= 0) return null;
        try
        {
            var d = await TrialBalanceRepo.GetAccountDisplayByIdAsync(accountId.Value);
            if (!d.HasValue) return null;
            return string.IsNullOrWhiteSpace(d.Value.Name) ? null : d.Value.Name;
        }
        catch
        {
            return null;
        }
    }

