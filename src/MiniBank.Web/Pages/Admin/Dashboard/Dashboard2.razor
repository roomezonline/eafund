<script>
    (function () {
        function fitOne(el, minPx, maxPx) {
            if (!el) return;
            var parent = el.parentElement;
            if (!parent) return;

            el.style.whiteSpace = 'nowrap';

            var max = maxPx || 16;
            var min = minPx || 10;
            var size = max;
            var parentRect = parent.getBoundingClientRect();
            var parentStyle = window.getComputedStyle(parent);
            var padL = parseFloat(parentStyle.paddingLeft) || 0;
            var padR = parseFloat(parentStyle.paddingRight) || 0;
            var available = Math.max(0, parentRect.width - padL - padR - 10);

            el.style.setProperty('font-size', size + 'px', 'important');

            var guard = 0;
            while (guard++ < 40 && el.scrollWidth > available && size > min) {
                size -= 1;
                el.style.setProperty('font-size', size + 'px', 'important');
            }

            guard = 0;
            while (guard++ < 40 && el.scrollWidth <= available - 6 && size < max) {
                size += 1;
                el.style.setProperty('font-size', size + 'px', 'important');
                if (el.scrollWidth > available) {
                    size -= 1;
                    el.style.setProperty('font-size', size + 'px', 'important');
                    break;
                }
            }
        }

        window.baamBudgetDeltaFitAll = function () {
            var els = document.querySelectorAll('.budget-delta-autofit');
            els.forEach(function (el) {
                fitOne(el, 8, 13);
            });
        };

        var _initDone = false;
        var _resizeTimer = 0;
        window.baamBudgetDeltaInit = function () {
            if (_initDone) return;
            _initDone = true;

            window.addEventListener('resize', function () {
                clearTimeout(_resizeTimer);
                _resizeTimer = setTimeout(function () {
                    window.baamBudgetDeltaFitAll();
                }, 150);
            });
        };
    })();
</script>

