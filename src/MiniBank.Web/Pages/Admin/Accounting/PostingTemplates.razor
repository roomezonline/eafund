  private async Task SaveEditLine()
  {
    if (editingLine.AccountId == 0) return;

    // اعتبارسنجی شماره خط (فقط اگر تغییر کرده باشد)
    var originalLine = lines.First(x => x.PostingTemplateLineId == editingLineId);
    if (editingLine.LineNo != originalLine.LineNo && IsLineNumberDuplicate(editingLine.LineNo))
    {
      Toast.Error($"شماره خط {editingLine.LineNo} قبلاً استفاده شده است");
      return;
    }

    try
    {
      await PTRepo.UpdateLineAsync(editingLine);
      editingLineId = null;
      editingLine = new MiniBank.Web.Models.PostingTemplateLine();
      await LoadLines();
      Toast.Success("خط الگو به‌روزرسانی شد");
