  // Load subsidiaries for operational account selection
  private IEnumerable<MiniBank.Web.Models.Account> GetSubsidiariesForAccount(long accountId)
  {
    return GetSubsidiariesForAccount((long?)accountId);
  }

  private IEnumerable<MiniBank.Web.Models.Account> GetSubsidiariesForAccount(long? accountId)
  {
    // Ensure we have accounts loaded
    if (allAccountsWithHierarchy is null || allAccountsWithHierarchy.Count == 0)
      return Enumerable.Empty<MiniBank.Web.Models.Account>();

    // Only level 4 accounts (subsidiary), active only
    var subsAll = allAccountsWithHierarchy
      .Where(a => (a.Level ?? 0) == 4 && a.IsActive)
      .ToList();

    var generalSubs = subsAll.Where(a => !a.ParentAccountId.HasValue);
    if (accountId.HasValue)
    {
      var childSubs = subsAll.Where(a => a.ParentAccountId == accountId.Value);
      return childSubs.Concat(generalSubs)
                      .GroupBy(a => a.AccountId)
                      .Select(g => g.First())
                      .OrderBy(a => a.ParentAccountId.HasValue ? 0 : 1) // prioritize linked, then general
                      .ThenBy(a => a.Code);
    }
    else
    {
      // If no GL account selected yet, show only general subsidiaries
      return generalSubs.OrderBy(a => a.Code);
    }
  }

  private string GetSubsidiaryDisplayName(MiniBank.Web.Models.Account acc)
  {
    // Show code-name and parent context or "عمومی" if no parent
    var parentText = acc.ParentAccountId.HasValue
      ? allAccountsWithHierarchy.FirstOrDefault(p => p.AccountId == acc.ParentAccountId.Value)?.DisplayTitle
      : "عمومی";
    return acc.ParentAccountId.HasValue
      ? $"{acc.Code} - {acc.Name} ({parentText})"
      : $"{acc.Code} - {acc.Name} (عمومی)";
  }

  // Build dropdown items for DsDropdown from subsidiaries
  private IEnumerable<MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem> BuildSubsidiaryDropdownItems(long? accountId)
