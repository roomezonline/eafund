    };
  }
  
  private string? GetAmountSourceWarning(byte amountSource)
  {
    // Get context of existing lines
    var existingSources = lines.Select(l => l.AmountSource).ToList();
    var hasTotal = existingSources.Contains((byte)1);
    var hasSpecific = existingSources.Any(s => s >= 2 && s <= 7);
    
    return amountSource switch
    {
      1 => hasSpecific ? 
        "⚠️ جمع کل: شما قبلاً منابع تفکیکی (اصل/سود/کارمزد) دارید. ترکیب آن‌ها ممکن است مشکل ایجاد کند. بهتر است همه خطوط از 'جمع کل' استفاده کنند." :
        "✅ جمع کل: بهترین انتخاب - همیشه مقدار دارد و مطمئن است. برای اکثر الگوها توصیه می‌شود.",
        
      2 => hasTotal ?
        "❌ اصل: شما قبلاً 'جمع کل' دارید. این ترکیب خطرناک است چون ممکن است مبلغ دوبار محاسبه شود." :
        "⚠️ اصل: فقط در تراکنش‌هایی که مبلغ اصل جداگانه محاسبه شده (مثل پرداخت قسط وام) استفاده کنید. در واریزهای عادی صفر خواهد بود.",
        
      3 => hasTotal ?
        "❌ سود: شما قبلاً 'جمع کل' دارید. این ترکیب باعث دوبار محاسبه مبلغ می‌شود." :
        "⚠️ سود: فقط در تراکنش‌هایی که سود جداگانه محاسبه شده (مثل پرداخت سود به عضو) استفاده کنید. در واریزهای عادی صفر است.",
        
      4 => hasTotal ?
        "❌ کارمزد: شما قبلاً 'جمع کل' دارید. این باعث عدم تعادل ژورنال می‌شود." :
        "⚠️ کارمزد: فقط در تراکنش‌هایی که کارمزد محاسبه و از کاربر کسر می‌شود استفاده کنید. در غیر این صورت صفر است.",
        
      5 => hasTotal ?
        "❌ مالیات: ترکیب با 'جمع کل' مجاز نیست." :
        "⚠️ مالیات: فقط برای تراکنش‌هایی که مالیات کسر می‌شود (مثل پرداخت سود با کسر مالیات) استفاده کنید.",
        
      6 => hasTotal ?
        "❌ جریمه: ترکیب با 'جمع کل' باعث خطا می‌شود." :
        "⚠️ جریمه: فقط برای تراکنش‌هایی که جریمه دیرکرد محاسبه شده استفاده کنید. در تراکنش‌های عادی صفر است.",
        
      7 => hasTotal ?
        "❌ کمیسیون: ترکیب با 'جمع کل' مجاز نیست." :
        "⚠️ کمیسیون: فقط برای تراکنش‌هایی که کمیسیون محاسبه شده استفاده کنید.",
        
      8 => "💰 مبلغ ثابت: این مبلغ در همه تراکنش‌ها ثابت خواهد بود. مثال: هزینه ماهانه ۲۰ هزار تومان نگهداری حساب. حتماً مقدار را وارد کنید.",
      
      _ => null
    };
  }

