  .line-details {
    padding: 0 16px 12px 16px;
    background: #f8fafc;
    border-top: 1px solid #e5e7eb;
  }

  .detail-row {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    padding: 8px 0;
  }

  .detail-pair {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .detail-label {
    font-size: 13px;
    color: #6b7280;
    font-weight: 500;
  }

  .detail-value {
    font-size: 14px;
    font-weight: 600;
    color: #374151;
    background: #f3f4f6;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .empty-state {
    text-align: center;
    padding: 40px 20px;
    color: #6b7280;
  }

  .empty-icon {
    font-size: 48px;
    color: #d1d5db;
    margin-bottom: 16px;
  }

  .empty-title {
    font-size: 18px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 8px;
  }

  .empty-description {
    font-size: 14px;
    color: #6b7280;
    margin: 0;
    line-height: 1.5;
  }

  @@media (max-width: 768px) {
    .line-summary {
      padding: 10px 12px;
    }
    
    .line-main-info {
      gap: 6px;
    }
    
    .account-title {
      font-size: 14px;
    }
    
    .detail-row {
      flex-direction: column;
      gap: 12px;
    }
    
    .line-details {
      padding: 0 12px 8px 12px;
    }
  }

  /* دیالوگ استایل */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1050;
    backdrop-filter: blur(2px);
  }

  .modal-dialog {
    background: white;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    max-width: 500px;
    width: 90%;
    max-height: 90vh;
    overflow: hidden;
    animation: modalSlideIn 0.3s ease-out;
  }

  @@keyframes modalSlideIn {
    from {
      opacity: 0;
      transform: translateY(-20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .modal-header {
    padding: 20px 24px 16px;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    display: flex;
    align-items: center;
  }

  .btn-close {
    background: none;
    border: none;
    padding: 8px;
    border-radius: 6px;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-close:hover {
    background: #f3f4f6;
    color: #374151;
  }

  .modal-body {
    padding: 24px;
  }

  .modal-footer {
    padding: 16px 24px 24px;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
  }

  @@media (max-width: 768px) {
    .modal-overlay {
      align-items: flex-end;
    }
    
    .modal-dialog {
      width: 100%;
      margin: 0;
      border-radius: 16px 16px 0 0;
      max-height: 80vh;
      animation: bottomSheetIn 0.28s ease-out;
      will-change: transform, opacity;
    }
    
    .modal-footer {
      flex-direction: column-reverse;
    }
    
    .modal-footer .ds-button {
      width: 100%;
    }
  }

  /* Bottom sheet slide-in animation for mobile */
  @@keyframes bottomSheetIn {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .alert {
    padding: 12px 16px;
    border-radius: 8px;
    border: 1px solid;
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .alert-warning {
    background-color: #fef3c7;
    border-color: #f59e0b;
    color: #92400e;
  }

  .text-danger {
    color: #dc2626 !important;
  }

  .text-muted {
    color: #6b7280 !important;
  }

  .small {
    font-size: 0.875rem;
  }
</style>

<!-- دیالوگ افزودن الگوی جدید -->
@if (showNewTemplateDialog)
{
  <div class="modal-overlay" @onclick="@(() => showNewTemplateDialog = false)">
    <div class="modal-dialog" @onclick:stopPropagation="true">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-plus me-2"></i>
          ایجاد الگوی جدید
        </h5>
        <button type="button" class="btn-close" @onclick="@(() => showNewTemplateDialog = false)">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <DsInput Label="نام الگو" 
                 Value="@newTemplateName" 
                 ValueChanged="@((value) => newTemplateName = value)"
                 Placeholder="نام الگوی حسابداری را وارد کنید"
                 HelperText="نام منحصربه‌فرد برای الگوی حسابداری انتخاب کنید" />
        <div class="mt-3">
          <DsDropdown Label="دسته الگو"
                      Placeholder="انتخاب دسته"
                      Items="@templateCategoryItems"
                      Value="@(newTemplateCategoryCode?.ToString())"
                      ValueChanged="@HandleNewTemplateCategoryChange" />
        </div>
      </div>
      <div class="modal-footer">
        <DsButton Variant="secondary" 
                  OnClick="@(() => { showNewTemplateDialog = false; newTemplateName = string.Empty; })">
          انصراف
        </DsButton>
        <DsButton Variant="primary" 
                  Disabled="@(string.IsNullOrWhiteSpace(newTemplateName))"
                  OnClick="@CreateTemplateFromDialog">
          <i class="fas fa-check me-2"></i>
          ایجاد الگو
        </DsButton>
      </div>
    </div>
  </div>
}

<!-- دیالوگ تأیید حذف الگو -->
@if (showDeleteTemplateDialog)
{
  <div class="modal-overlay" @onclick="@(() => showDeleteTemplateDialog = false)">
    <div class="modal-dialog" @onclick:stopPropagation="true">
      <div class="modal-header">
        <h5 class="modal-title text-danger">
          <i class="fas fa-exclamation-triangle me-2"></i>
          تأیید حذف الگو
        </h5>
        <button type="button" class="btn-close" @onclick="@(() => showDeleteTemplateDialog = false)">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning mb-3">
          <i class="fas fa-exclamation-triangle me-2"></i>
          <strong>هشدار:</strong> این عمل غیرقابل بازگشت است!
        </div>
        <p class="mb-3">
          آیا مطمئن هستید که می‌خواهید الگو 
          <strong>"@selectedTemplateName"</strong> 
          را به همراه تمام خطوط آن حذف کنید؟
        </p>
        <div class="text-muted small">
          <i class="fas fa-info-circle me-1"></i>
          تمام خطوط مرتبط با این الگو نیز حذف خواهند شد.
        </div>
      </div>
      <div class="modal-footer">
        <DsButton Variant="secondary" 
                  OnClick="@(() => showDeleteTemplateDialog = false)">
          انصراف
        </DsButton>
        <DsButton Variant="danger" 
                  OnClick="@DeleteTemplate">
          <i class="fas fa-trash me-2"></i>
          حذف قطعی
        </DsButton>
      </div>
    </div>
  </div>
}
</div>

<!-- FAB Navigation -->
<DsFabNavigation @bind-IsOpen="fabMenuOpen" />
