  private bool IsValidLineConfiguration()
  {
    ValidateNewLine();
    return string.IsNullOrEmpty(lineValidationError);
  }
  
  private bool IsValidEditLineConfiguration()
  {
    ValidateEditLine();
    return string.IsNullOrEmpty(editLineValidationError);
  }
  
  private void ValidateNewLine()
  {
    lineValidationError = ValidateLineConfiguration(newLine.AmountSource, newLine.FixedAmount, newLine.Side);
  }
  
  private void ValidateEditLine()
  {
    editLineValidationError = ValidateLineConfiguration(editingLine.AmountSource, editingLine.FixedAmount, editingLine.Side);
  }
  
  private string? ValidateLineConfiguration(byte amountSource, decimal? fixedAmount, byte side)
  {
    // Only validate fixed amount requirement - everything else should be warnings, not blocking errors
    if (amountSource == 8 && (!fixedAmount.HasValue || fixedAmount.Value <= 0))
    {
      return "مبلغ ثابت: حتماً مقدار مثبت وارد کنید. این مبلغ در همه تراکنش‌ها ثابت خواهد بود.";
    }
    
    // All other validations are now warnings only - don't block saving
    // Balance validation, amount source conflicts, etc. are handled in GetAmountSourceWarning
    
    return null;
  }
  
