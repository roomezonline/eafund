@page "/admin/posting-templates"
@using MiniBank.Web.Models
@using MiniBank.Web.Components.DesignSystem
@inject MiniBank.Web.Infrastructure.Repositories.PostingTemplateRepository PTRepo
@inject MiniBank.Web.Infrastructure.Repositories.AccountsRepository AccountsRepo
@inject MiniBank.Web.Services.BankAccountService BankAccountService
@inject MiniBank.Web.Components.DesignSystem.DsToastService Toast
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation

<div class="posting-templates-duo">
  <!-- Header -->
  <DsPageHeader Icon="fa-solid fa-file-invoice" 
                Title="الگوهای حسابداری" 
                Subtitle="مدیریت الگوهای ثبت خودکار"
                ShowBackButton="true"
                ShowRefreshButton="true"
                ShowAddButton="true"
                AddButtonTitle="الگوی جدید"
                OnRefreshClick="LoadPostingTemplates"
                OnAddClick="AddNewTemplate">
    <ChildContent>
    </ChildContent>
  </DsPageHeader>

  <div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">الگوهای حسابداری</h4>
  <div class="d-flex gap-2">
    <DsButton Variant="primary" 
              OnClick="@(() => showNewTemplateDialog = true)">
      <i class="fas fa-plus me-2"></i>
      الگوی جدید
    </DsButton>
    @if (selectedTemplateId.HasValue)
    {
      <DsButton Variant="secondary" 
                OnClick="@(() => OpenEditTemplateDialog())">
        <i class="fas fa-pen me-2"></i>
        ویرایش الگو
      </DsButton>
    }

    @if (selectedTemplateId.HasValue)
    {
      <DsButton Variant="danger" 
                OnClick="@(() => showDeleteTemplateDialog = true)">
        <i class="fas fa-trash me-2"></i>
        حذف الگو
      </DsButton>
    }
  </div>
</div>

  <!-- دیالوگ ویرایش الگو -->
@if (showEditTemplateDialog)
{
  <div class="modal-overlay" @onclick="@(() => showEditTemplateDialog = false)">
    <div class="modal-dialog" @onclick:stopPropagation="true">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-pen me-2"></i>
          ویرایش الگو
        </h5>
        <button type="button" class="btn-close" @onclick="@(() => showEditTemplateDialog = false)">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <DsInput Label="نام الگو" 
                 Value="@editTemplateName" 
                 ValueChanged="@((value) => editTemplateName = value)"
                 Placeholder="نام الگوی حسابداری را وارد کنید" />
        <div class="mt-3">
          <DsDropdown Label="دسته الگو"
                      Placeholder="انتخاب دسته"
                      Items="@templateCategoryItems"
                      Value="@(editTemplateCategoryCode?.ToString())"
                      ValueChanged="@HandleEditTemplateCategoryChange" />
        </div>
      </div>
      <div class="modal-footer">
        <DsButton Variant="secondary" 
                  OnClick="@(() => { showEditTemplateDialog = false; })">
          انصراف
        </DsButton>
        <DsButton Variant="primary" 
                  Disabled="@(string.IsNullOrWhiteSpace(editTemplateName))"
                  OnClick="@SaveEditTemplateAsync">
          <i class="fas fa-check me-2"></i>
          ذخیره تغییرات
        </DsButton>
      </div>
    </div>
  </div>
}

<DsCard Title="انتخاب الگو" Class="mb-4">
  <DsDropdown Label="الگوهای موجود"
              Placeholder="الگو را انتخاب کنید"
              Items="@templateDropdownItems"
              Value="@selectedTemplateId?.ToString()"
              ValueChanged="@HandleTemplateDropdownChange" />
</DsCard>

@if (selectedTemplateId.HasValue)
{
  <DsCard Title="@($"خطوط الگو: {DisplayTemplateName(selectedTemplateName)}")"
          Subtitle="@($"{lines.Count} خط تعریف شده")"
          Class="mb-4">
    @if (lines.Any())
    {
      <div class="lines-list">
        @foreach (var ln in lines.OrderBy(x => x.LineNo))
        {
          @if (editingLineId == ln.PostingTemplateLineId)
          {
            <!-- حالت ویرایش -->
            <div class="line-item editing">
              <div class="line-edit-form">
                <div class="edit-row">
                  <div class="edit-field">
                    <label>شماره خط</label>
                    <input type="number" @bind="editingLine.LineNo" min="1" />
                  </div>
                  <div class="edit-field">
                    <label>حساب حسابداری</label>
                    <DsHierarchicalAccountSelector 
                      Placeholder="انتخاب حساب حسابداری..."
                      SelectedAccount="@GetSelectedAccount(editingLine.AccountId)"
                      SelectedAccountChanged="@((account) => OnAccountSelected(account))" />
                  </div>
                  <div class="edit-field">
                    <label>سمت</label>
                    <select @bind="editingLine.Side">
                      <option value="1">بدهکار</option>
                      <option value="2">بستانکار</option>
                    </select>
                  </div>
                </div>
                <div class="edit-row">
                  <div class="edit-field">
                    <label>منبع مبلغ</label>
                    <select @bind="editingLine.AmountSource">
                      <option value="1">جمع کل</option>
                      <option value="2">اصل</option>
                      <option value="3">سود</option>
                      <option value="4">کارمزد</option>
                      <option value="5">مالیات</option>
                      <option value="6">جریمه</option>
                      <option value="7">کمیسیون</option>
                      <option value="8">مبلغ ثابت</option>
                    </select>
                  </div>
                  <div class="edit-field">
                    <DsDropdown Label="حساب عملیاتی"
                                Placeholder="انتخاب کنید (اختیاری)"
                                Items="@BuildSubsidiaryDropdownItems(editingLine.AccountId)"
                                Value="@(editingLine.OperationalAccountId?.ToString())"
                                ValueChanged="HandleEditOperationalAccountChange"
                                Searchable="true" />
                  </div>
                  @if (editingLine.AmountSource == 8)
                  {
                    <div class="edit-field">
                      <label>مبلغ ثابت</label>
                      <input type="number" @bind="editingLine.FixedAmount" />
                    </div>
                  }
                </div>
                <div class="edit-row">
                  <div class="edit-field">
                    <label>تخصیص به عضو خاص</label>
                    <select @bind="editingMemberDimensionValue" @bind:after="OnEditingMemberDimensionChanged">
                      <option value="false">خیر</option>
                      <option value="true">بله</option>
                    </select>
                  </div>
                </div>
                <div class="edit-actions">
                  <button class="btn btn-success" @onclick="SaveEditLine" disabled="@(!IsValidEditLineConfiguration())">
                    <i class="fas fa-check"></i> ذخیره
                  </button>
                  <button class="btn btn-secondary" @onclick="CancelEditLine">
                    <i class="fas fa-times"></i> انصراف
                  </button>
                  @if (!string.IsNullOrEmpty(editLineValidationError))
                  {
                    <div class="validation-error mt-2">
                      <i class="fa-solid fa-times-circle"></i>
                      @editLineValidationError
                    </div>
                  }
                </div>
              </div>
            </div>
          }
          else
          {
            <!-- حالت نمایش عادی -->
            <div class="line-item @(expandedLineId == ln.PostingTemplateLineId ? "expanded" : "")">
              <!-- هدر خط -->
              <div class="line-header" @onclick="() => ToggleLineExpansion(ln.PostingTemplateLineId)">
                <!-- ردیف اول: شماره خط در گوشه چپ، نام حساب در وسط، بج سمت در گوشه راست -->
                <div class="header-row-first">
                  <div class="line-number-badge">@ln.LineNo</div>
                  <div class="account-name-full">@GetAccountDisplayName(ln.AccountId)</div>
                  <div class="side-badge @(ln.Side == 1 ? "debit" : "credit")">
                    @(ln.Side == 1 ? "بدهکار" : "بستانکار")
                  </div>
                </div>
                <!-- ردیف دوم: 3 دکمه دایره‌ای در وسط -->
                <div class="header-row-second">
                  <div class="line-header-actions">
                    <button class="btn-action-circle edit" @onclick:stopPropagation="true" @onclick="() => StartEditLine(ln)" title="ویرایش">
                      <i class="fas fa-edit"></i>
                    </button>
                    <button class="btn-action-circle delete" @onclick:stopPropagation="true" @onclick="() => ConfirmDeleteLine(ln)" title="حذف">
                      <i class="fas fa-trash"></i>
                    </button>
                    <button class="btn-action-circle expand" title="@(expandedLineId == ln.PostingTemplateLineId ? "بستن جزئیات" : "نمایش جزئیات")">
                      <i class="fas fa-@(expandedLineId == ln.PostingTemplateLineId ? "chevron-up" : "chevron-down")"></i>
                    </button>
                  </div>
                </div>
              </div>
              
              <!-- جزئیات کامل -->
              @if (expandedLineId == ln.PostingTemplateLineId)
              {
                <div class="line-details">
                  <div class="details-table">
                    <div class="details-row">
                      <div class="detail-label">شماره خط:</div>
                      <div class="detail-value">@ln.LineNo</div>
                    </div>
                    <div class="details-row">
                      <div class="detail-label">حساب حسابداری:</div>
                      <div class="detail-value">@GetAccountDisplayName(ln.AccountId)</div>
                    </div>
                    <div class="details-row">
                      <div class="detail-label">سمت:</div>
                      <div class="detail-value">
                        <span class="side-badge @(ln.Side == 1 ? "debit" : "credit")">
                          @(ln.Side == 1 ? "بدهکار" : "بستانکار")
                        </span>
                      </div>
                    </div>
                    <div class="details-row">
                      <div class="detail-label">منبع مبلغ:</div>
                      <div class="detail-value">@GetAmountSourceText(ln.AmountSource)</div>
                    </div>
                    <div class="details-row">
                      <div class="detail-label">حساب عملیاتی:</div>
                      <div class="detail-value">
                        @if (ln.OperationalAccountId.HasValue)
                        {
                          <span class="operational-account-badge">
                            <i class="fa-solid fa-link"></i>
                            @GetOperationalAccountDisplayName(ln.OperationalAccountId.Value)
                          </span>
                        }
                        else
                        {
                          <span class="text-muted">تعریف نشده</span>
                        }
                      </div>
                    </div>
                    <div class="details-row">
                      <div class="detail-label">تخصیص به عضو:</div>
                      <div class="detail-value">
                        <span class="@(ln.AllowMemberDimension ? "text-success" : "text-muted")">
                          @(ln.AllowMemberDimension ? "بله" : "خیر")
                        </span>
                      </div>
                    </div>
                    @if (ln.FixedAmount.HasValue)
                    {
                      <div class="details-row">
                        <div class="detail-label">مبلغ ثابت:</div>
                        <div class="detail-value">
                          <span class="amount-value">@ln.FixedAmount.Value.ToString("N0") ریال</span>
                        </div>
                      </div>
                    }
                  </div>
                </div>
              }
            </div>
          }
        }
      </div>
    }
    else
    {
      <div class="empty-state">
        <i class="fa-solid fa-list-ul"></i>
        <h5>هیچ خطی تعریف نشده</h5>
        <p>برای این الگو هنوز خطی تعریف نشده است. از بخش زیر خط جدید اضافه کنید.</p>
      </div>
    }
  </DsCard>

  <DsCard Title="افزودن خط جدید" Class="mb-4">
    <div class="add-line-section">
      <div class="edit-row">
        <div class="edit-field">
          <label>شماره خط</label>
          <input type="number" @bind="newLine.LineNo" min="1" />
        </div>
        <div class="edit-field">
          <label>حساب حسابداری</label>
          <DsHierarchicalAccountSelector 
            Placeholder="انتخاب حساب حسابداری..."
            SelectedAccount="@GetSelectedAccount(newLineAccountId)"
            SelectedAccountChanged="@((account) => OnNewLineAccountSelected(account))" />
        </div>
      </div>
      <div class="edit-row">
        <div class="edit-field">
          <DsDropdown Label="حساب عملیاتی"
                      Placeholder="انتخاب کنید (اختیاری)"
                      Items="@BuildSubsidiaryDropdownItems(newLineAccountId)"
                      Value="@(newLineOperationalAccountId?.ToString())"
                      ValueChanged="HandleNewOperationalAccountChange"
                      Searchable="true" />
        </div>
        <div class="edit-field">
          <label>سمت</label>
          <select @bind="newLine.Side">
            <option value="1">بدهکار</option>
            <option value="2">بستانکار</option>
          </select>
        </div>
      </div>
      <div class="edit-row">
        <div class="edit-field">
          <label>منبع مبلغ</label>
          <select @bind="newLine.AmountSource" @bind:after="OnAmountSourceChanged">
            <option value="1">جمع کل</option>
            <option value="2">اصل</option>
            <option value="3">سود</option>
            <option value="4">کارمزد</option>
            <option value="5">مالیات</option>
            <option value="6">جریمه</option>
            <option value="7">کمیسیون</option>
            <option value="8">مبلغ ثابت</option>
          </select>
          @if (!string.IsNullOrEmpty(amountSourceWarning))
          {
            <div class="validation-warning mt-2 @(amountSourceWarning.StartsWith("❌") ? "error" : amountSourceWarning.StartsWith("✅") ? "success" : "")">
              <i class="fa-solid fa-@(amountSourceWarning.StartsWith("❌") ? "times-circle" : amountSourceWarning.StartsWith("✅") ? "check-circle" : "exclamation-triangle")"></i>
              @amountSourceWarning
            </div>
          }
        </div>
        <div class="edit-field">
          <label>مبلغ ثابت</label>
          <input type="number" @bind="newLine.FixedAmount" />
        </div>
      </div>
      <div class="edit-row">
        <div class="edit-field">
          <label>تخصیص به عضو خاص</label>
          <select @bind="newMemberDimensionValue" @bind:after="OnNewMemberDimensionChanged">
            <option value="false">خیر</option>
            <option value="true">بله</option>
          </select>
        </div>
      </div>
      <div class="edit-actions">
        <button class="btn-add-line" @onclick="AddLine" disabled="@(newLine.LineNo <= 0 || !newLineAccountId.HasValue || !IsValidLineConfiguration())">
          <i class="fas fa-plus"></i> افزودن خط
        </button>
        @if (!string.IsNullOrEmpty(editAmountSourceWarning))
        {
          <div class="validation-warning mt-2 @(editAmountSourceWarning.StartsWith("❌") ? "error" : editAmountSourceWarning.StartsWith("✅") ? "success" : "")">
            <i class="fa-solid fa-@(editAmountSourceWarning.StartsWith("❌") ? "times-circle" : editAmountSourceWarning.StartsWith("✅") ? "check-circle" : "exclamation-triangle")"></i>
            @editAmountSourceWarning
          </div>
        }
      </div>
    </div>
  </DsCard>
}

<!-- Confirm delete line -->
<DsConfirm 
    Show="@showDeleteLineConfirm"
    Variant="danger"
    Title="حذف خط الگو"
    Message="@($"آیا از حذف خط {pendingDeleteLineNo} مطمئن هستید؟")"
    OnConfirm="DeleteLineConfirmed"
    OnCancel="() => showDeleteLineConfirm = false" />

<!-- Confirm delete template -->
<DsConfirm 
    Show="@showDeleteTemplateDialog"
    Variant="danger"
    Title="حذف الگو"
    Message="آیا از حذف کامل این الگو و تمام خطوط آن مطمئن هستید؟"
    OnConfirm="DeleteTemplateWithCheck"
    OnCancel="() => showDeleteTemplateDialog = false" />

@code {
  private List<MiniBank.Web.Models.PostingTemplate> templates = new();
  private List<MiniBank.Web.Models.PostingTemplateLine> lines = new();
  private List<(long AccountId, string Code, string Name, byte AccountType)> accounts = new();
  private List<MiniBank.Web.Models.Account> allAccountsWithHierarchy = new();
  private List<MiniBank.Web.Models.BankAccount> bankAccounts = new();

  private int? selectedTemplateId;
  private string? selectedTemplateName;
  private string newTemplateName = string.Empty;
  private byte? newTemplateCategoryCode = null;

  private MiniBank.Web.Models.PostingTemplateLine newLine = new MiniBank.Web.Models.PostingTemplateLine { Side = 2, AmountSource = 1, AllowMemberDimension = false };
  private long? newLineAccountId;
  private long? newLineOperationalAccountId;
  private int? expandedLineId = null;
  private string? lineNoError;
  private int? editingLineId = null;
  private MiniBank.Web.Models.PostingTemplateLine editingLine = new();
  private bool showNewTemplateDialog = false;
  private bool showDeleteTemplateDialog = false;
  private bool showDeleteLineConfirm = false;
  private int? pendingDeleteLineId = null;
  private int? pendingDeleteLineNo = null;
  private bool showEditTemplateDialog = false;
  private string editTemplateName = string.Empty;
  private byte? editTemplateCategoryCode = null;

  // String values for dropdown binding
  private string editingMemberDimensionValue = "false";
  private string newMemberDimensionValue = "false";
  
  // Validation warnings
  private string? amountSourceWarning;
  private string? editAmountSourceWarning;
  private string? lineValidationError;
  private string? editLineValidationError;

  // Dropdown items
  private List<MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem> templateDropdownItems = new();
  private List<MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem> templateCategoryItems = new();
  private List<MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem> accountDropdownItems = new();
  private List<MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem> bankAccountDropdownItems = new();
  private List<MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem> sideDropdownItems = new()
  {
    new() { Value = "1", Text = "بدهکار" },
    new() { Value = "2", Text = "بستانکار" }
  };
  private List<MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem> amountSourceDropdownItems = new()
  {
    new() { Value = "1", Text = "جمع کل" },
    new() { Value = "2", Text = "اصل" },
    new() { Value = "3", Text = "سود" },
    new() { Value = "4", Text = "جریمه" },
    new() { Value = "5", Text = "مالیات" },
    new() { Value = "6", Text = "کارمزد" },
    new() { Value = "7", Text = "کمیسیون" },
    new() { Value = "8", Text = "مبلغ ثابت" }
  };
  private List<MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem> memberDimensionDropdownItems = new()
  {
    new() { Value = "false", Text = "خیر" },
    new() { Value = "true", Text = "بله" }
  };

  protected override async Task OnInitializedAsync()
  {
    BuildCategoryItems();
    await LoadPostingTemplates();
  }

  private async Task LoadPostingTemplates()
  {
    templates = (await PTRepo.GetAllAsync(onlyActive: false)).ToList();
    accounts = (await AccountsRepo.GetAllAsync()).ToList();
    allAccountsWithHierarchy = (await AccountsRepo.GetAllWithHierarchyAsync()).ToList();
    
    // Load bank accounts
    var bankAccountsList = await BankAccountService.GetAsync(null, null, 1000);
    bankAccounts = bankAccountsList.ToList();
    
    // Populate dropdown items
    templateDropdownItems = templates.Select(t => new MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem
    {
      Value = t.PostingTemplateId.ToString(),
      Text = DisplayTemplateName(t.TemplateName)
    }).ToList();
    
    accountDropdownItems = accounts.Select(a => new MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem
    {
      Value = a.AccountId.ToString(),
      Text = $"{a.Code} - {a.Name}"
    }).ToList();
    
    bankAccountDropdownItems = bankAccounts.Where(ba => ba.IsActive).Select(ba => new MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem
    {
      Value = ba.AccountId.ToString(),
      Text = ba.DisplayTitle
    }).ToList();
  }

  private MiniBank.Web.Models.Account? GetSelectedAccount(long? accountId)
  {
    if (accountId == null) return null;
    return allAccountsWithHierarchy.FirstOrDefault(a => a.AccountId == accountId);
  }

  private void OnAccountSelected(MiniBank.Web.Models.Account? account)
  {
    editingLine.AccountId = account?.AccountId ?? 0;
  }

  private void OnNewLineAccountSelected(MiniBank.Web.Models.Account? account)
  {
    newLineAccountId = account?.AccountId;
  }

  private void AddNewTemplate()
  {
    showNewTemplateDialog = true;
  }

  private async Task CreateTemplate()
  {
    try
    {
      var id = await PTRepo.CreateAsync(newTemplateName.Trim(), newTemplateCategoryCode);
      templates = (await PTRepo.GetAllAsync(onlyActive: false)).ToList();
      selectedTemplateId = id;
      newTemplateName = string.Empty;
      newTemplateCategoryCode = null;
      // بارگذاری مجدد dropdown ها
      templateDropdownItems = templates.Select(t => new MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem 
      { 
        Value = t.PostingTemplateId.ToString(), 
        Text = t.TemplateName 
      }).ToList();
      Toast.Success("الگو ایجاد شد");
    }
    catch (Exception ex)
    {
      Toast.Error($"خطا در ایجاد الگو: {ex.Message}");
    }
  }

  private void HandleNewTemplateCategoryChange(string? value)
  {
    if (byte.TryParse(value, out var b)) newTemplateCategoryCode = b; else newTemplateCategoryCode = null;
  }

  private void HandleEditTemplateCategoryChange(string? value)
  {
    if (byte.TryParse(value, out var b)) editTemplateCategoryCode = b; else editTemplateCategoryCode = null;
  }

  private async Task CreateTemplateFromDialog()
  {
    if (string.IsNullOrWhiteSpace(newTemplateName)) return;
    try
    {
      var id = await PTRepo.CreateAsync(newTemplateName, newTemplateCategoryCode);
      templates = (await PTRepo.GetAllAsync(onlyActive: false)).ToList();
      showNewTemplateDialog = false;
      newTemplateName = string.Empty;
      newTemplateCategoryCode = null;
      // بارگذاری مجدد dropdown ها
      templateDropdownItems = templates.Select(t => new MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem 
      { 
        Value = t.PostingTemplateId.ToString(), 
        Text = t.TemplateName 
      }).ToList();
      Toast.Success("الگو ایجاد شد");
    }
    catch (Exception ex)
    {
      Toast.Error($"خطا در ایجاد الگو: {ex.Message}");
    }
  }

  private async Task DeleteTemplate()
  {
    if (!selectedTemplateId.HasValue) return;
    try
    {
      var success = await PTRepo.DeleteTemplateAsync(selectedTemplateId.Value);
      if (success)
      {
        templates = (await PTRepo.GetAllAsync(onlyActive: false)).ToList();
        templateDropdownItems = templates.Select(t => new MiniBank.Web.Components.DesignSystem.DsDropdown.DsDropdownItem 
        { 
          Value = t.PostingTemplateId.ToString(), 
          Text = t.TemplateName 
        }).ToList();
        
        selectedTemplateId = null;
        selectedTemplateName = null;
        lines.Clear();
        showDeleteTemplateDialog = false;
        Toast.Success("الگو و تمام خطوط آن حذف شد");
      }
      else
      {
        Toast.Error("حذف الگو ناموفق بود");
      }
    }
    catch (Exception ex)
    {
      Toast.Error($"خطا در حذف الگو: {ex.Message}");
    }
  }

  private async Task DeleteTemplateWithCheck()
  {
    if (!selectedTemplateId.HasValue)
    {
      showDeleteTemplateDialog = false;
      return;
    }
    try
    {
      var inUse = await PTRepo.IsTemplateUsedAsync(selectedTemplateId.Value);
      if (inUse)
      {
        showDeleteTemplateDialog = false;
        Toast.Error("این الگو در نوع(های) تراکنش استفاده شده و قابل حذف نیست.");
        return;
      }
      await DeleteTemplate();
    }
    catch (Exception ex)
    {
      showDeleteTemplateDialog = false;
      Toast.Error($"خطا در بررسی استفاده الگو: {ex.Message}");
    }
  }

