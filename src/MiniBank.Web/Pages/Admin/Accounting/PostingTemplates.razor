  private async Task LoadLines()
  {
    try
    {
      lines.Clear();
      if (selectedTemplateId.HasValue)
      {
        lines = (await PTRepo.GetLinesAsync(selectedTemplateId.Value)).ToList();
      }
      // تنظیم شماره خط پیشنهادی
      newLine.LineNo = GetNextLineNumber();
      lineNoError = null;
      StateHasChanged();
    }
    catch (Exception ex)
    {
      Toast.Error($"خطا در بارگذاری خطوط الگو: {ex.Message}");
    }
  }

  private async Task AddLine()
  {
    if (!selectedTemplateId.HasValue || !newLineAccountId.HasValue) return;
    
    // اعتبارسنجی شماره خط
    if (IsLineNumberDuplicate(newLine.LineNo))
    {
      lineNoError = $"شماره خط {newLine.LineNo} قبلاً استفاده شده است";
      return;
    }
    
    lineNoError = null;
    
    try
    {
      newLine.PostingTemplateId = selectedTemplateId.Value;
      newLine.AccountId = newLineAccountId.Value;
      newLine.OperationalAccountId = newLineOperationalAccountId;
      var id = await PTRepo.AddLineAsync(newLine);
      
      // reset quick-add state with next suggested line number
      newLine = new MiniBank.Web.Models.PostingTemplateLine { LineNo = GetNextLineNumber() + 1, Side = 2, AmountSource = 1, AllowMemberDimension = false };
      newLineAccountId = null;
      newLineOperationalAccountId = null;
      await LoadLines();
      Toast.Success("خط الگو اضافه شد");
    }
    catch (Exception ex)
    {
      Toast.Error($"خطا در افزودن خط: {ex.Message}");
    }
  }

  private async Task DeleteLine(int postingTemplateLineId)
  {
    try
    {
      var ok = await PTRepo.DeleteLineAsync(postingTemplateLineId);
      if (ok)
      {
        await LoadLines();
        Toast.Success("خط حذف شد");
      }
      else
      {
        Toast.Error("حذف خط ناموفق بود");
      }
    }
    catch (Exception ex)
    {
      Toast.Error($"خطا در حذف خط: {ex.Message}");
    }
  }

  private async Task DeleteLineConfirmed()
  {
    try
    {
      if (pendingDeleteLineId.HasValue)
      {
        var success = await PTRepo.DeleteLineAsync(pendingDeleteLineId.Value);
        if (success)
        {
          Toast.Success($"خط شماره {pendingDeleteLineNo} با موفقیت حذف شد.");
          await LoadLines();
        }
        else
        {
          Toast.Error("خطا در حذف خط الگو.");
        }
      }
    }
    catch (Exception ex)
    {
      Toast.Error($"خطا در حذف خط: {ex.Message}");
    }
    finally
    {
      showDeleteLineConfirm = false;
      pendingDeleteLineId = null;
      pendingDeleteLineNo = null;
    }
  }

  private async Task ConfirmDeleteLine(MiniBank.Web.Models.PostingTemplateLine line)
  {
    try
    {
      pendingDeleteLineId = line.PostingTemplateLineId;
      pendingDeleteLineNo = line.LineNo;
      showDeleteLineConfirm = true;
    }
    catch (Exception ex)
    {
      Toast.Error($"خطا در بررسی امکان حذف: {ex.Message}");
    }
  }

