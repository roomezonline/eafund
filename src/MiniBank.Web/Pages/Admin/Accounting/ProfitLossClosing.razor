@code {
    private string _fromDateString = "";
    private string _toDateString = "";
    private bool _isTemporary = true;
    private bool _initialized;

    protected override void OnInitialized()
    {
        if (!_initialized)
        {
            var pc = new System.Globalization.PersianCalendar();
            var today = DateTime.Today;
            var year = pc.GetYear(today);
            var month = pc.GetMonth(today);
            var daysInMonth = pc.GetDaysInMonth(year, month);
            _fromDateString = $"{year}/{month:D2}/01";
            _toDateString = $"{year}/{month:D2}/{daysInMonth:D2}";
            _initialized = true;
        }
    }

    private bool _loading;
    private bool _posting;
    private string? _error;
    private ProfitLossService.ProfitLossPreview? _preview;
    private bool _showPreviewModal;
    private bool _showPostConfirm;
    private string _postConfirmMessage = "";

    private DateTime? ToGeorgian(string jalali)
    {
        if (string.IsNullOrWhiteSpace(jalali)) return null;
        var parts = jalali.Split('/');
        if (parts.Length == 3 &&
            int.TryParse(parts[0], out var y) &&
            int.TryParse(parts[1], out var m) &&
            int.TryParse(parts[2], out var d))
        {
            var pc = new System.Globalization.PersianCalendar();
            return pc.ToDateTime(y, m, d, 0, 0, 0, 0);
        }
        return null;
    }

    private async Task BuildPreview()
    {
        var from = ToGeorgian(_fromDateString);
        var to = ToGeorgian(_toDateString);
        if (from == null || to == null)
        {
            Toasts.Warning("لطفاً بازه زمانی را وارد کنید");
            return;
        }
        if (from > to)
        {
            Toasts.Warning("تاریخ شروع نباید بعد از تاریخ پایان باشد");
            return;
        }

        _loading = true;
        _error = null;
        _preview = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            _preview = await ProfitLossService.BuildPreviewAsync(from.Value, to.Value);
            if (_preview.IncomeLines.Count == 0 && _preview.ExpenseLines.Count == 0)
                _error = "در بازه انتخابی هیچ درآمد یا هزینه‌ای ثبت نشده است";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenPreviewModal()
    {
        if (_preview == null) return;
        _showPreviewModal = true;
    }

    private void ClosePreviewModal()
    {
        _showPreviewModal = false;
    }

    private void ConfirmPost()
    {
        if (_preview == null) return;
        _showPreviewModal = false;
        var typeText = _isTemporary ? "موقت" : "دائمی";
        var dbFmt = _preview.TotalDebit.ToString("N0");
        var crFmt = _preview.TotalCredit.ToString("N0");
        _postConfirmMessage = $@"
<div style='line-height:1.9'>
  <div style='margin-bottom:8px'>آیا از ثبت سند سود و زیان مطمئن هستید؟</div>
  <div style='background:rgba(220,38,38,.06);border:1px solid rgba(220,38,38,.25);border-radius:10px;padding:10px 12px'>
    <div><strong>بازه:</strong> {_fromDateString} تا {_toDateString}</div>
    <div><strong>نوع:</strong> {typeText}</div>
    <div><strong>بدهکار:</strong> {dbFmt} ریال</div>
    <div><strong>بستانکار:</strong> {crFmt} ریال</div>
  </div>
</div>";
        _showPostConfirm = true;
    }

    private async Task OnConfirmPostAsync()
    {
        _showPostConfirm = false;
        _showPreviewModal = false;
        await PostJournal();
    }

    private void OnCancelPost()
    {
        _showPostConfirm = false;
    }

    private async Task PostJournal()
    {
        var from = ToGeorgian(_fromDateString);
        var to = ToGeorgian(_toDateString);
        if (from == null || to == null || _preview == null) return;

        _posting = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var (success, message, docNum) = await ProfitLossService.PostClosingJournalAsync(
                from.Value, to.Value, "admin", _isTemporary, null);

            if (success)
            {
                Toasts.Success(message);
                _preview = null;
            }
            else
            {
                Toasts.Error(message);
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در ثبت سند: {ex.Message}");
        }
        finally
        {
            _posting = false;
        }
    }
}
