@page "/admin/reports/member-banking"
@using MiniBank.Web.Infrastructure.Repositories
@using MiniBank.Web.Models.Reports
@using MiniBank.Web.Components.DesignSystem
@inject TransactionReportRepository ReportRepo
@inject IJSRuntime JSRuntime

<PageTitle>گزارش موجودی بانکی اعضا</PageTitle>

<DsPageHeader Title="گزارش موجودی بانکی اعضا" 
             Icon="fa-solid fa-university"
             Subtitle="مدیریت و نمایش موجودی حساب‌های بانکی اعضا"
             ShowBackButton="true" />

<div class="banking-reports-container">
    <!-- فیلترها -->
    <DsCard Title="فیلترهای گزارش" Elevated="true" Class="filters-card mb-4">
        <HeaderActions>
            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">
                <i class="fas fa-eraser me-1"></i>
                پاک کردن
            </button>
        </HeaderActions>
        <ChildContent>
            <div class="row g-3">
                <div class="col-md-3">
                    <DsInput Label="عضو" @bind-Value="selectedMemberName" Placeholder="نام عضو را وارد کنید" />
                </div>
                <div class="col-md-3">
                    <DsInput Label="خانوار" @bind-Value="selectedHouseholdName" Placeholder="نام خانوار را وارد کنید" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">حداقل موجودی</label>
                    <input type="number" class="form-control" @bind="minBalance" placeholder="0" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="LoadReports" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="fas fa-search me-1"></i>
                        جستجو
                    </button>
                </div>
            </div>
        </ChildContent>
    </DsCard>

    <!-- تب‌های گزارش -->
    <DsCard Elevated="true" Class="reports-card">
        <HeaderContent>
            <div class="d-flex justify-content-between align-items-center w-100">
                <div class="btn-group" role="group">
                    <button type="button" class="btn @(activeTab == "summary" ? "btn-primary" : "btn-outline-primary")" 
                            @onclick="@(() => SetActiveTab("summary"))">
                        <i class="fas fa-chart-pie me-1"></i>
                        خلاصه موجودی
                    </button>
                    <button type="button" class="btn @(activeTab == "details" ? "btn-primary" : "btn-outline-primary")" 
                            @onclick="@(() => SetActiveTab("details"))">
                        <i class="fas fa-list-alt me-1"></i>
                        جزئیات حساب‌ها
                    </button>
                    <button type="button" class="btn @(activeTab == "fund-summary" ? "btn-primary" : "btn-outline-primary")" 
                            @onclick="@(() => SetActiveTab("fund-summary"))">
                        <i class="fas fa-building me-1"></i>
                        خلاصه صندوق
                    </button>
                </div>
                <button class="btn btn-success btn-sm" @onclick="ExportToExcel">
                    <i class="fas fa-file-excel me-1"></i>
                    اکسپورت
                </button>
            </div>
        </HeaderContent>

        <ChildContent>
            <!-- محتوای تب‌ها -->
            @if (activeTab == "summary")
            {
                <div class="tab-content">
                    @if (isLoading)
                    {
                        <div class="loading-state">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">در حال بارگیری...</span>
                            </div>
                            <p class="mt-3 text-muted">در حال بارگیری گزارش موجودی...</p>
                        </div>
                    }
                    else if (balanceSummaryData?.Any() == true)
                    {
                        <div class="bootstrap-grid-container">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover table-bordered">
                                    <thead class="table-dark">
                                        <tr>
                                            <th scope="col">
                                                <i class="fas fa-user me-2"></i>نام عضو
                                            </th>
                                            <th scope="col">
                                                <i class="fas fa-id-card me-2"></i>کد ملی
                                            </th>
                                            <th scope="col">
                                                <i class="fas fa-home me-2"></i>خانوار
                                            </th>
                                            <th scope="col" class="text-end">
                                                <i class="fas fa-coins me-2"></i>اصل سپرده (ریال)
                                            </th>
                                            <th scope="col" class="text-end">
                                                <i class="fas fa-percentage me-2"></i>سود (ریال)
                                            </th>
                                            <th scope="col" class="text-end">
                                                <i class="fas fa-calculator me-2"></i>مجموع (ریال)
                                            </th>
                                            <th scope="col" class="text-center">
                                                <i class="fas fa-check me-2"></i>وضعیت
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in balanceSummaryData)
                                        {
                                            <tr>
                                                <td class="fw-bold text-primary">@item.MemberName</td>
                                                <td class="font-monospace text-muted">@item.NationalCode</td>
                                                <td>
                                                    <span class="badge bg-primary">@item.HouseholdName</span>
                                                </td>
                                                <td class="text-end font-monospace text-success fw-bold">
                                                    @item.PrincipalBalance.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
                                                </td>
                                                <td class="text-end font-monospace text-warning fw-bold">
                                                    @item.InterestBalance.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
                                                </td>
                                                <td class="text-end font-monospace text-primary fw-bold fs-5">
                                                    @item.TotalBalance.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
                                                </td>
                                                <td class="text-center">
                                                    <i class="fas fa-check-circle text-success fs-5" title="تایید شده"></i>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-secondary">
                                        <tr>
                                            <th colspan="3" class="text-center fw-bold">
                                                <i class="fas fa-calculator me-2"></i>مجموع کل
                                            </th>
                                            <th class="text-end font-monospace text-success fw-bold">
                                                @balanceSummaryData.Sum(x => x.PrincipalBalance).ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
                                            </th>
                                            <th class="text-end font-monospace text-warning fw-bold">
                                                @balanceSummaryData.Sum(x => x.InterestBalance).ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
                                            </th>
                                            <th class="text-end font-monospace text-primary fw-bold fs-5">
                                                @balanceSummaryData.Sum(x => x.TotalBalance).ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
                                            </th>
                                            <th class="text-center">
                                                <span class="badge bg-success">@balanceSummaryData.Count() عضو</span>
                                            </th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            
                            <!-- Pagination -->
                            <nav aria-label="صفحه‌بندی گزارش">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item disabled">
                                        <span class="page-link">قبلی</span>
                                    </li>
                                    <li class="page-item active">
                                        <span class="page-link">1</span>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="#">2</a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="#">3</a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="#">بعدی</a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-search-dollar"></i>
                            <h4>داده‌ای یافت نشد</h4>
                            <p>هیچ موجودی بانکی برای نمایش یافت نشد. لطفاً فیلترها را بررسی کنید.</p>
                        </div>
                    }
                </div>
            }

            @if (activeTab == "details")
            {
                <!-- جزئیات حساب‌ها - مشابه summary با جزئیات بیشتر -->
                <div class="tab-content">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        جزئیات حساب‌های اعضا به زودی اضافه خواهد شد.
                    </div>
                </div>
            }

            @if (activeTab == "fund-summary")
            {
                <!-- خلاصه صندوق -->
                <div class="tab-content">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        خلاصه وضعیت صندوق به زودی اضافه خواهد شد.
                    </div>
                </div>
            }
        </ChildContent>
    </DsCard>
</div>

@code {
    private string activeTab = "summary";
    private bool isLoading = false;

    private string selectedMemberName = string.Empty;
    private string selectedHouseholdName = string.Empty;
    private decimal? minBalance = null;

    private IEnumerable<MemberBankingBalanceRow>? balanceSummaryData;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            if (activeTab == "summary")
            {
                balanceSummaryData = await ReportRepo.GetMemberBankingBalancesAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"خطا در بارگذاری گزارش: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SetActiveTab(string tab)
    {
        activeTab = tab;
        await LoadReports();
    }

    private void ViewMemberDetails(long memberId)
    {
        // پیاده‌سازی مشاهده جزئیات عضو
    }

    private async Task ExportToExcel()
    {
        await JSRuntime.InvokeVoidAsync("alert", "قابلیت اکسپورت به اکسل به زودی اضافه خواهد شد.");
    }

    private void ClearFilters()
    {
        selectedMemberName = string.Empty;
        selectedHouseholdName = string.Empty;
        minBalance = null;
        StateHasChanged();
    }
}
