        {
            CurrentLevel = currentLevel,
            PreviousLevel = previousLevel,
            ShowOnlyWithBalance = showOnlyWithBalance,
            IsFourColumn = isFourColumn,
            IsTurnoverTwoColumn = isTurnoverTwoColumn,
