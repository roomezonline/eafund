<script>
    window.mbtb = window.mbtb || {
        attach: function (tableId) {
            if (!tableId) return;
            const recalc = () => window.mbtb.recalcAccountNameWidth(tableId);
            window.addEventListener('resize', recalc);

            // Observe DOM changes to re-measure after expand/collapse renders
            const table = document.getElementById(tableId);
            if (table && !table._mbtbObserved) {
                const mo = new MutationObserver(() => window.mbtb.deferRecalc(tableId));
                mo.observe(table.tBodies[0] || table, { childList: true, subtree: true, attributes: true });
                table._mbtbObserved = true;
            }
        },
        deferRecalc: function (tableId) {
            // wait for layout to settle
            requestAnimationFrame(() => requestAnimationFrame(() => window.mbtb.recalcAccountNameWidth(tableId)));
        },
        recalcAccountNameWidth: function (tableId) {
            try {
                if (window.innerWidth > 768) return; // فقط موبایل
                const table = document.getElementById(tableId);
                if (!table) return;
                const header = table.querySelector('th.account-name');
                const allCells = Array.from(table.querySelectorAll('td.account-name'));
                const visibleCells = Array.from(table.querySelectorAll('tbody tr'))
                    .filter(tr => tr.offsetParent !== null)
                    .map(tr => tr.querySelector('td.account-name'))
                    .filter(Boolean);

                // ریست کامل همه سلول‌ها (visible و غیر قابل مشاهده)
                [header, ...allCells].forEach(el => {
                    if (!el) return;
                    el.style.width = 'auto';
                    el.style.minWidth = '0px';
                    el.style.maxWidth = '';
                });

                // اگر هیچ ردیفی قابل مشاهده نبود، خروج
                if (!visibleCells.length) return;

                // محاسبه بیشینه عرض محتوای قابل مشاهده (فقط سلول‌های قابل مشاهده؛ هدر لحاظ نمی‌شود)
                let max = 0;
                visibleCells.forEach(td => { max = Math.max(max, td.scrollWidth); });

                // محاسبه عرض در دسترس با کسر سایر ستون‌ها در اولین ردیف قابل مشاهده
                const firstVisibleRow = Array.from(table.tBodies[0]?.rows || []).find(tr => tr.offsetParent !== null);
                let otherWidth = 0;
                if (firstVisibleRow) {
                    const tds = Array.from(firstVisibleRow.cells);
                    tds.forEach(td => {
                        if (!td.classList.contains('account-name')) {
                            const styles = getComputedStyle(td);
                            const w = td.getBoundingClientRect().width
                                + parseFloat(styles.marginLeft) + parseFloat(styles.marginRight);
                            otherWidth += w;
                        }
                    });
                }
                // حداقل را پایین می‌آوریم تا ستون کوچک شود وقتی متن کوتاه است
                // در عین حال اجازه می‌دهیم جدول با اسکرول افقی بزرگ شود (بدون سقف به اندازه container)
                const minPx = 60;
                const target = Math.max(max + 4, minPx);

                if (header) header.style.width = target + 'px';
                allCells.forEach(td => td.style.width = target + 'px');
            } catch (e) {
                // ignore
            }
        },
        // removed mediateVerticalScroll: rely on native scrolling
        stateSet: function (key, json) {
            try {
                if (!key) return;
                sessionStorage.setItem(key, json || '');
            } catch (e) { }
        },
        stateGet: function (key) {
            try {
                if (!key) return null;
                return sessionStorage.getItem(key);
            } catch (e) { return null; }
        },
        stateRemove: function (key) {
            try {
                if (!key) return;
                sessionStorage.removeItem(key);
            } catch (e) { }
        },
    };
</script>

@code {
    private const string TrialBalanceStateKey = "mb.tb.state.v1";

    private static string BuildTransactionNodeTitle(JournalLineDetail t)
    {
        var p = TransactionPresentationService.Build(
            new TransactionPresentationService.PresentationInput
            {
                JournalId = t.JournalId,
                Notes = t.Notes ?? string.Empty,
                DocumentType = t.DocumentType,
                TransactionType = t.TransactionTypeCode,
                PayChannel = t.PayChannel,
                CounterpartyName = t.CounterpartyName,
                DisplayName = t.DisplayName
            },
            null);

        var title = !string.IsNullOrWhiteSpace(p.TransactionTypeName) && p.TransactionTypeName != "-" ? p.TransactionTypeName : t.TransactionType;
        var counterparty = !string.IsNullOrWhiteSpace(p.DisplayName) ? p.DisplayName : t.DisplayMember;
        var amount = t.Amount;
        return $"{title} - {counterparty} - {amount:N0}";
    }

    private class TrialBalanceViewState
    {
        public byte Level { get; set; }
        public byte CurrentLevel { get; set; }
        public byte PreviousLevel { get; set; }
        public bool ShowOnlyWithBalance { get; set; }
        public bool IsFourColumn { get; set; }
        public bool IsTurnoverTwoColumn { get; set; }
        public bool IsBalanceTwoColumn { get; set; }
        public string FromDate { get; set; } = string.Empty;
        public string ToDate { get; set; } = string.Empty;
        public long? MoeenId { get; set; }
    }

    private List<TrialBalanceNode> nodes = new();
    private List<TrialBalanceNode> filteredNodes => FilterNodes(nodes);
    private TrialBalanceSummary summary = new();
    private byte currentLevel = 1;
    private byte previousLevel = 1; // ذخیره آخرین سطح قبل از جستجو
    private bool isLoading = false;
    private string searchTerm = string.Empty;
    private bool showOnlyWithBalance = true;
    private long? _currentMoeenId;

    private bool isFourColumn = false;
    private bool isTurnoverTwoColumn = false;
    private bool isBalanceTwoColumn = true;
    
    // محاسبه مجاميع
    private decimal totalDebit => filteredNodes.Sum(n => n.DebitBalance);
    private decimal totalCredit => filteredNodes.Sum(n => n.CreditBalance);
    
    // مدال تراکنش
    private bool showTransactionModal = false;
    private JournalLineDetail? selectedTransaction = null;
    private string fromDate = "";
    private string toDate = "";
    private DateTime? fromDateG;
    private DateTime? toDateG;
    private string dateValidationError = "";
    private ElementReference reportTableRef;
    private readonly string tableDomId = "trial-balance-table";

    private CancellationTokenSource? _liveSearchCts;
    private CancellationTokenSource? _filtersCts;

    protected override async Task OnInitializedAsync()
    {
        var restored = await TryRestoreStateAsync();
        if (!restored)
        {
            // تنظیم تاریخ پیش‌فرض به ابتدا و انتهای سال مالی جاری
            await InitializeDefaultDatesAsync();

            // بعد از تنظیم تاریخ‌ها، داده‌ها را بر اساس بازه پیش‌فرض لود کن
            await LoadLevel(3);
        }
        await LoadSummary();
    }

    private async Task<bool> TryRestoreStateAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("mbtb.stateGet", TrialBalanceStateKey);
            if (string.IsNullOrWhiteSpace(json)) return false;

            var state = JsonSerializer.Deserialize<TrialBalanceViewState>(json);
            if (state == null) return false;

            currentLevel = state.CurrentLevel;
            previousLevel = state.PreviousLevel;
            showOnlyWithBalance = state.ShowOnlyWithBalance;

            isFourColumn = state.IsFourColumn;
            isTurnoverTwoColumn = state.IsTurnoverTwoColumn;
            isBalanceTwoColumn = state.IsBalanceTwoColumn;

            fromDate = state.FromDate ?? string.Empty;
            toDate = state.ToDate ?? string.Empty;
            fromDateG = ParseJalaliToGregorian(fromDate);
            var toG = ParseJalaliToGregorian(toDate);
            toDateG = toG?.Date;

            _currentMoeenId = state.MoeenId;

            await JSRuntime.InvokeVoidAsync("mbtb.stateRemove", TrialBalanceStateKey);

            if (_currentMoeenId.HasValue)
                await LoadMoeenDrillDown(_currentMoeenId.Value);
            else
                await LoadLevel(currentLevel);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private void OnLiveSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        _ = DebouncedLiveSearchAsync();
    }

    private Task OnFromDateChanged(string? v)
    {
        fromDate = v ?? string.Empty;
        _ = DebouncedApplyDateFilterAsync();
        return Task.CompletedTask;
    }

    private Task OnToDateChanged(string? v)
    {
        toDate = v ?? string.Empty;
        _ = DebouncedApplyDateFilterAsync();
        return Task.CompletedTask;
    }

    private async Task DebouncedApplyDateFilterAsync(int delayMs = 250)
    {
        _filtersCts?.Cancel();
        _filtersCts = new CancellationTokenSource();
        var token = _filtersCts.Token;

        try
        {
            await Task.Delay(delayMs, token);
            if (!token.IsCancellationRequested)
                await ApplyDateFilter();
        }
        catch (TaskCanceledException) { }
    }

    private async Task DebouncedLiveSearchAsync(int delayMs = 120)
    {
        _liveSearchCts?.Cancel();
        _liveSearchCts = new CancellationTokenSource();
        var token = _liveSearchCts.Token;

        try
        {
            await Task.Delay(delayMs, token);
            if (!token.IsCancellationRequested)
                StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private List<TrialBalanceNode> FilterNodes(List<TrialBalanceNode> source)
    {
        var q = (searchTerm ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(q))
            return source;

        var kw = q.ToLowerInvariant();
        return source
            .Where(n =>
                (!string.IsNullOrWhiteSpace(n.Code) && n.Code.ToLowerInvariant().Contains(kw))
                || (!string.IsNullOrWhiteSpace(n.Name) && n.Name.ToLowerInvariant().Contains(kw)))
            .ToList();
    }

    private async Task InitializeDefaultDatesAsync()
    {
        try
        {
            var range = await FiscalRange.GetRangeAsync();
            fromDate = range.From;
            toDate = range.To;
        }
        catch
        {
            var r = DateTimeExtensions.CurrentJalaliYearRange();
            fromDate = r.From;
            toDate = r.To;
        }
        fromDateG = ParseJalaliToGregorian(fromDate);
        var toG = ParseJalaliToGregorian(toDate);
        toDateG = toG?.Date;
    }

    private DateTime? ParseJalaliToGregorian(string? jalali)
        => Components.Extensions.DateTimeExtensions.TryParseJalaliDate(jalali, out var dt) ? dt : null;

    private async Task LoadLevel(byte level)
    {
        isLoading = true;
        _currentMoeenId = null;
        // ذخیره سطح قبلی فقط اگر در حالت عادی باشیم
        previousLevel = currentLevel;
        currentLevel = level;
        StateHasChanged();

        try
        {
            nodes = (await TrialBalanceRepo.GetByLevelAsync(level, null, showOnlyWithBalance, fromDateG, toDateG, null)).ToList();
        }
        catch (Exception ex)
        {
            // Log error
            nodes = new List<TrialBalanceNode>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await RecalcAccountNameWidthAsync();
        }
    }

    private async Task LoadMoeenDrillDown(long moeenId)
    {
        isLoading = true;
        _currentMoeenId = moeenId;
        previousLevel = currentLevel;
        currentLevel = 4;
        StateHasChanged();

        try
        {
            nodes = (await TrialBalanceRepo.GetMoeenTafsiliListAsync(moeenId, showOnlyWithBalance, fromDateG, toDateG)).ToList();
        }
        catch (Exception ex)
        {
            nodes = new List<TrialBalanceNode>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await RecalcAccountNameWidthAsync();
        }
    }

    private async Task LoadDrillDown(byte parentLevel, long parentId)
    {
        var targetLevel = (byte)(parentLevel + 1);
        isLoading = true;
        _currentMoeenId = null;
        previousLevel = currentLevel;
        currentLevel = targetLevel;
        StateHasChanged();

        try
        {
            nodes = (await TrialBalanceRepo.GetByLevelAsync(targetLevel, parentId, showOnlyWithBalance, fromDateG, toDateG, null)).ToList();
        }
        catch (Exception ex)
        {
            nodes = new List<TrialBalanceNode>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await RecalcAccountNameWidthAsync();
        }
    }

    private async Task LoadSummary()
    {
        try
        {
            summary = await TrialBalanceRepo.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            // Log error
            summary = null;
        }
        StateHasChanged();
        await RecalcAccountNameWidthAsync();
    }

    private async Task DebugTransactions()
    {
        try
        {
            var analysis = await TrialBalanceRepo.GetTransactionAnalysisAsync();
            var debugInfo = string.Join("\n", analysis.Select(a => 
                $"ID: {a.AccountId}, Code: {a.Code}, Name: {a.Name}, Level: {a.Level}, " +
                $"Parent: {a.ParentAccountId}, Transactions: {a.TransactionCount}, " +
                $"Debit: {a.TotalDebit}, Credit: {a.TotalCredit}, Net: {a.NetBalance}"));
            
            await JSRuntime.InvokeVoidAsync("alert", $"تحلیل تراکنش‌ها:\n{debugInfo}");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در تحلیل: {ex.Message}");
        }
    }

    private async Task ToggleExpand(TrialBalanceNode node)
    {
        if (node.IsExpanded)
        {
            node.IsExpanded = false;
            node.Children.Clear();
        }
        else
        {
            try
            {
                // ابتدا سعی کن فرزندان حساب را پیدا کنی
                IEnumerable<TrialBalanceNode> children;
                
                children = await TrialBalanceRepo.GetChildrenAsync(node.AccountId, fromDateG, toDateG, null);
                
                if (children.Any())
                {
                    // اگر فرزند داشت، آن‌ها را به عنوان children اضافه کن
                    node.Children = children.ToList();
                    node.IsExpanded = true;
                }
                else
                {
                    // اگر فرزند نداشت، تراکنش‌ها را بارگیری کن
                    IEnumerable<JournalLineDetail> transactions;
                    
                    transactions = await TrialBalanceRepo.GetAccountTransactionsAsync(node.AccountId, fromDateG, toDateG);
                    
                    if (transactions.Any())
                    {
                        // تبدیل تراکنش‌ها به نودهای فرزند
                        var transactionNodes = transactions.Select(t => new TrialBalanceNode
                        {
                            AccountId = t.JournalLineId, // استفاده از JournalLineId به عنوان شناسه منحصر به فرد
                            Code = $"T{t.JournalLineId}",
                            Name = BuildTransactionNodeTitle(t),
                            Level = 5, // سطح تراکنش
                            DebitBalance = t.Debit,
                            CreditBalance = t.Credit,
                            HasChildren = false,
                            IsExpanded = false,
                            Children = new List<TrialBalanceNode>(),
                            ParentAccountId = node.AccountId
                        }).ToList();
                        
                        node.Children = transactionNodes;
                        node.IsExpanded = true;
                    }
                    else
                    {
                        // اگر تراکنشی هم نداشت، یک پیام نمایش بده
                        node.Children = new List<TrialBalanceNode>
                        {
                            new TrialBalanceNode
                            {
                                AccountId = -1,
                                Code = "---",
                                Name = "هیچ تراکنش یا فرزندی یافت نشد",
                                Level = 5,
                                AccountType = node.AccountType,
                                ParentAccountId = node.AccountId,
                                DebitBalance = 0,
                                CreditBalance = 0,
                                HasChildren = false
                            }
                        };
                        node.IsExpanded = true;
                    }
                }
            }
            catch (Exception ex)
            {
                // Log error silently
            }
        }
        StateHasChanged();
        await RecalcAccountNameWidthAsync();
    }

    private async Task RefreshData()
    {
        await LoadLevel(currentLevel);
        await LoadSummary();
    }

    private enum ReportMode
    {
        TwoColumnBalance = 1,
        TwoColumnTurnover = 2,
        FourColumnTurnoverBalance = 3
    }

    private void SelectReportMode(ReportMode mode)
    {
        isBalanceTwoColumn = mode == ReportMode.TwoColumnBalance;
        isTurnoverTwoColumn = mode == ReportMode.TwoColumnTurnover;
        isFourColumn = mode == ReportMode.FourColumnTurnoverBalance;
        StateHasChanged();
    }

    private decimal ComputeDebtorBalance(TrialBalanceNode node)
    {
        var net = node.DebitBalance - node.CreditBalance;
        return net > 0 ? net : 0m;
    }

    private decimal ComputeCreditorBalance(TrialBalanceNode node)
    {
        var net = node.DebitBalance - node.CreditBalance;
        return net < 0 ? Math.Abs(net) : 0m;
    }

    private decimal ComputeTotalDebtorBalance(IEnumerable<TrialBalanceNode> list)
        => list.Sum(n => ComputeDebtorBalance(n));

    private decimal ComputeTotalCreditorBalance(IEnumerable<TrialBalanceNode> list)
        => list.Sum(n => ComputeCreditorBalance(n));

