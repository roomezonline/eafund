@page "/admin/reports/trial-balance"
@using MiniBank.Web.Models
@using MiniBank.Web.Infrastructure.Repositories
@using MiniBank.Web.Components.DesignSystem
@using MiniBank.Web.Components.Extensions
@using MiniBank.Web.Services
@using Dapper
@using System.Text.Json
@inject TrialBalanceRepository TrialBalanceRepo
@inject IJSRuntime JSRuntime
@inject DsToastService Toast
@inject NavigationManager Nav
@inject IConfiguration Configuration
@inject FiscalYearRepository FiscalYearRepo
@inject MiniBank.Web.Services.FiscalYearRangeProvider FiscalRange

<PageTitle>مرور حسابها</PageTitle>

<style>
    .report-container { max-width: 1200px; margin: 0 auto; background: white; padding-bottom: 110px; }
    .report-header { 
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
        padding: 25px; 
        text-align: center; 
        border-radius: 12px 12px 0 0; 
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        position: relative;
        overflow: hidden;
    }
    .report-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.1"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.1"/><circle cx="50" cy="10" r="0.5" fill="white" opacity="0.15"/><circle cx="20" cy="80" r="0.5" fill="white" opacity="0.15"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        pointer-events: none;
    }
    .report-title { 
        font-size: 24px; 
        font-weight: 700; 
        margin: 0 0 8px 0; 
        color: #ffffff; 
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        position: relative;
        z-index: 1;
    }
    .report-subtitle { 
        font-size: 16px; 
        margin: 0 0 12px 0; 
        color: #f0f4f8; 
        font-weight: 500;
        position: relative;
        z-index: 1;
    }
    .date-range { 
        font-size: 13px; 
        margin: 0; 
        color: #e2e8f0; 
        background: rgba(255,255,255,0.15);
        padding: 8px 16px;
        border-radius: 20px;
        display: inline-block;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
        position: relative;
        z-index: 1;
    }
    .level-nav-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        width: 100%;
        margin: 10px 0;
    }
    .level-nav-item {
        flex: 1;
        min-width: 0;
        padding: 10px 16px;
        background: #f0f0f0;
        border: 1px solid #ccc;
        border-radius: 10px;
        text-decoration: none;
        color: #000;
        cursor: pointer;
        text-align: center;
        font-weight: 700;
        font-size: 13px;
        white-space: nowrap;
        transition: all 0.15s ease;
    }
    .level-nav-item.active { background: #FFD700; border-color: #DAA520; }
    .level-nav-item:hover { background: #ddd; }
    .nav-sidebar { float: right; width: 150px; margin: 10px; }
    .nav-sidebar .nav-item { display: block; padding: 8px 12px; margin: 2px 0; background: #f0f0f0; border: 1px solid #ccc; text-decoration: none; color: #000; cursor: pointer; }
    .nav-sidebar .nav-item.active { background: #FFD700; }
    .nav-sidebar .nav-item:hover { background: #ddd; }
    .filter-section { margin: 10px 0; }
    .filter-checkbox { margin-right: 5px; }
    .col-mode-section { margin: 10px 0; }
    .col-mode-section label { display: block; margin: 6px 0; }

    .filter-section label,
    .col-mode-section label {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 4px 14px rgba(17, 24, 39, 0.06);
        font-size: 13px;
        font-weight: 700;
        color: #111827;
        line-height: 1.25;
    }
    .filter-section label { margin: 8px 0; }
    .col-mode-section label { margin: 8px 0; }

    .filter-section input[type="checkbox"],
    .col-mode-section input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin: 0;
        accent-color: #2563eb;
        flex: 0 0 auto;
    }

    .col-mode-section label:has(input[type="checkbox"]:checked),
    .filter-section label:has(input[type="checkbox"]:checked) {
        border-color: #93c5fd;
        background: #eff6ff;
    }
    .date-filter-section { margin: 15px 0; padding: 10px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 5px; }
    .date-inputs { display: flex; flex-direction: column; gap: 10px; align-items: stretch; justify-content: flex-start; }
    .date-input-group { display: flex; flex-direction: column; align-items: stretch; width: 100%; }
    .date-input-group > * { width: 100% !important; max-width: none !important; }
    .date-input-group label { font-size: 12px; margin-bottom: 5px; font-weight: bold; }
    .date-input-group input { padding: 5px; border: 1px solid #ccc; border-radius: 3px; text-align: center; font-family: 'Vazir'; }
    /* Force DsJalaliDatePicker to fill the card width */
    .date-filter-section .ds-jalali-datepicker { display: block; width: 100%; }
    .date-filter-section .ds-jalali-datepicker .ds-datepicker-input {
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;
        box-sizing: border-box;
        display: block;
        margin: 0;
    }
    .apply-filter-btn { padding: 8px 15px; background: #007bff; color: white; border: none; border-radius: 8px; cursor: pointer; margin: 12px auto 0; display: block; min-width: 140px; }
    .apply-filter-btn:hover { background: #0056b3; }
    
    /* Error Message Styling */
    .date-error-message {
        background: #f8d7da;
        border: 2px solid #dc3545;
        border-radius: 8px;
        padding: 12px 16px;
        margin: 10px 0;
        color: #721c24;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2);
        animation: errorPulse 0.5s ease-in-out;
    }
    
    .date-error-message i {
        color: #dc3545;
        font-size: 16px;
        animation: shake 0.5s ease-in-out;
    }
    
    @@keyframes errorPulse {
        0% { transform: scale(0.95); opacity: 0.8; }
        50% { transform: scale(1.02); }
        100% { transform: scale(1); opacity: 1; }
    }
    
    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-2px); }
        75% { transform: translateX(2px); }
    }
    /* Desktop: keep Jalali datepicker popup inside the sidebar box */
    @@media (min-width: 769px) {
        .nav-sidebar { position: relative; overflow: visible; }
        .date-filter-section { position: relative; overflow: visible; }
        .date-filter-section jdp-container { position: absolute !important; inset-inline-start: 0; top: 100%; z-index: 4000 !important; }
        .date-filter-section jdp-overlay { display: none !important; }
    }
    .main-content { margin-right: 170px; }
    
    /* Mobile Responsive Styles */
    @@media (max-width: 768px) {
        .nav-sidebar { float: none; width: 100%; margin: 0; padding: 10px; background: #f8f9fa; border: 1px solid #ddd; }
        .nav-sidebar .nav-items-container { display: block; }
        .nav-sidebar .nav-item { display: block; width: 100%; margin: 6px 0; padding: 10px 12px; font-size: 13px; text-align: center; }
        .filter-section { text-align: right; margin: 10px 0; }
        .date-filter-section { margin: 10px 0; }
        .date-inputs { flex-direction: row; gap: 10px; }
        .date-input-group { width: 100%; flex: 1 1 0; }
        .date-input-group input { width: 100%; max-width: none; }
        .date-input-group label { text-align: right; }
        .apply-filter-btn { width: 100%; max-width: none; }

        .filter-section label,
        .col-mode-section label {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 10px;
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #d1d5db;
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 4px 14px rgba(17, 24, 39, 0.06);
            font-size: 13px;
            font-weight: 700;
            color: #111827;
            line-height: 1.25;
        }
        .filter-section label { margin: 8px 0; }
        .col-mode-section { margin: 10px 0; }
        .col-mode-section label { margin: 8px 0; }

        .filter-section input[type="checkbox"],
        .col-mode-section input[type="checkbox"] {
            width: 18px;
            height: 18px;
            margin: 0;
            accent-color: #2563eb;
            flex: 0 0 auto;
        }

        .col-mode-section label:has(input[type="checkbox"]:checked),
        .filter-section label:has(input[type="checkbox"]:checked) {
            border-color: #93c5fd;
            background: #eff6ff;
        }
        /* اعداد لاتین و خواناتر در موبایل */
        .amount-debit, .amount-credit { 
            font-family: 'Segoe UI', Roboto, Arial, sans-serif; 
            font-variant-numeric: tabular-nums lining-nums; 
            font-feature-settings: 'tnum' 1, 'lnum' 1; 
            direction: ltr; 
            font-size: 15px; 
            letter-spacing: .2px; 
        }
        .account-name { font-size: 15px; font-weight: 700; }
        /* روی موبایل، خود محتوای صفحه اسکرول‌پذیر عمودی و افقی باشد تا لمس روی جدول نیز اسکرول کند */
        .main-content { 
            margin-right: 0; 
            padding-bottom: 120px; 
            overflow: visible; /* اسکرول را به ظرف داخلی می‌سپاریم */
            height: calc(100vh - 300px); /* ارتفاع ثابت برای محتوا (با درنظر گرفتن ناو پایین) */
        }
        .table-scroll {
            /* فقط افقی اسکرول کند؛ عمودی به والد واگذار شود */
            overflow-x: auto;
            overflow-y: visible;
            -webkit-overflow-scrolling: touch;
            height: 100%; /* پر کردن کامل فضای والد */
            width: 100%;
            position: relative;
            touch-action: pan-x pan-y; /* اجازه ژست‌های طبیعی هر دو محور بدون مداخله JS */
        }
        .report-container { padding-bottom: 120px; }
        .report-table { font-size: 13px; width: -moz-max-content; width: max-content; table-layout: auto; }
        .report-table th, .report-table td { padding: 6px 4px; font-size: 12px; }

        /* Grid-based table (mobile replacement) */
        .grid-scroll { overflow: auto; -webkit-overflow-scrolling: touch; max-height: calc(100vh - 190px); }
        .grid-table { display: block; width: max-content; font-size: 13px; }
        .grid-header, .grid-row {
            display: grid;
            grid-template-columns: 60px 110px auto 150px 150px;
            align-items: center;
            column-gap: 0;
        }
        .grid-header { background: #87CEEB; font-weight: 800; text-align: center; border: 1px solid #000; }
        .grid-header .cell { padding: 10px 12px; border-left: 1px solid #000; white-space: nowrap; }
        .grid-header .cell:first-child { border-inline-start: none; }
        .grid-body { display: block; border-inline: 1px solid #000; }
        .grid-row { border-bottom: 1px solid #000; }
        .grid-row .cell { padding: 8px 12px; border-left: 1px solid #000; white-space: nowrap; }
        .grid-row .cell:first-child { border-inline-start: none; text-align: center; }
        .cell.account-code { text-align: center; width: 110px; }
        .cell.account-name { white-space: nowrap; font-size: 14px; }
        .cell.amount { text-align: right; width: 150px; font-family: monospace; direction: ltr; font-weight: 800; font-size: 13px; }
        .grid-row.total { background: #FFD700; font-weight: 800; }
        .row-number { width: auto; min-width: 30px; }
        .account-code { width: auto; min-width: 50px; }
        .account-name { width: auto; min-width: 0 !important; max-width: none; white-space: nowrap; font-size: 14px; }
        .account-name, .account-name * { white-space: nowrap !important; overflow-wrap: normal; word-break: keep-all; hyphens: none; }
        .account-name > span { display: inline-flex; align-items: center; gap: 6px; }
        .transaction-btn { white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; padding: 3px 8px; }
        .amount-debit, .amount-credit { width: auto; min-width: 70px; font-size: 13px; font-weight: 800; text-align: left; }
        .report-container { margin: 0; padding: 5px; }
        .report-header { padding: 10px; }
        .report-title { font-size: 16px; }
        .report-subtitle { font-size: 12px; }
        .total-row { background: #FFD700 !important; }
    }
    
    @@media (min-width: 769px) {
        .nav-items-container { display: block; }
    }
    .report-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 15px; }
    .report-table th { background: #FFD700; border: 1px solid #DAA520; padding: 10px 12px; text-align: center; font-weight: 800; font-size: 16px; white-space: nowrap; color: #8B4513; }
    .report-table td { border: 1px solid #000; padding: 8px 12px; white-space: nowrap; font-size: 15px; }
    .report-table td.account-name { white-space: normal; }
    .row-number { text-align: center; width: 50px; }
    .account-code { text-align: center; width: 100px; }
    .account-name { text-align: right; min-width: 300px; font-size: 16px; font-weight: 700; }
    .account-name > span { display: inline-flex; align-items: center; gap: 6px; line-height: 1.45; }
    .account-name .fa-plus-circle, .account-name .fa-minus-circle { 
        font-size: 18px; 
        line-height: 1; 
        position: relative !important; 
        z-index: 100 !important; 
        display: inline-block !important;
        visibility: visible !important;
    }
    .amount-debit, .amount-credit { 
        text-align: right; width: 150px; 
        font-family: 'Segoe UI', Roboto, Arial, sans-serif; 
        font-variant-numeric: tabular-nums lining-nums; 
        font-feature-settings: 'tnum' 1, 'lnum' 1; 
        direction: ltr; font-weight: 800; font-size: 18px; 
        letter-spacing: .2px;
    }
    .total-row { font-weight: bold; }
    .expand-btn { background: none; border: none; cursor: pointer; padding: 2px; }
    .transaction-btn { background: #e3f2fd; border: 1px solid #90caf9; padding: 2px 6px; cursor: pointer; font-size: 11px; }

    .th-yellow { background: #fff200 !important; color: #111827 !important; border: 1px solid #000 !important; }
    .th-blue { background: #7dd3fc !important; color: #111827 !important; border: 1px solid #000 !important; }
    .th-green { background: #b7f7b7 !important; color: #111827 !important; border: 1px solid #000 !important; }

    .td-blue { background: #7dd3fc !important; color: #111827 !important; border: 1px solid #000 !important; }
    .td-green { background: #b7f7b7 !important; color: #111827 !important; border: 1px solid #000 !important; }
    .td-white { background: #ffffff !important; color: #111827 !important; border: 1px solid #000 !important; }

    .tafsili-moeen-btn {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        border-radius: 10px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        white-space: nowrap;
    }
    .tafsili-moeen-btn:hover { background: #f1f5f9; }

    .turnover-eye-btn {
        border: none;
        background: rgba(102, 126, 234, 0.10);
        border-radius: 10px;
        width: 34px;
        height: 34px;
        padding: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #4f46e5;
        transition: background 120ms ease, transform 120ms ease;
    }
    .turnover-eye-btn:hover { background: rgba(102, 126, 234, 0.18); transform: translateY(-1px); }
    .turnover-eye-btn i { font-size: 15px; }
</style>

<div class="report-container">
    <!-- هدر گزارش -->
    <div class="report-header">
        <div class="report-title">صندوق همیاری امام علی (ع)</div>
        <div class="report-subtitle">مرور حسابها</div>
        <div class="date-range">گزارش تهیه شده از تاریخ @fromDate تا تاریخ @toDate</div>
    </div>

    <!-- ردیف دکمه‌های سطح -->
    <div class="level-nav-row">
        <div class="level-nav-item @(currentLevel == 1 ? "active" : "")" @onclick="() => LoadLevel(1)">گروه</div>
        <div class="level-nav-item @(currentLevel == 2 ? "active" : "")" @onclick="() => LoadLevel(2)">کل</div>
        <div class="level-nav-item @(currentLevel == 3 ? "active" : "")" @onclick="() => LoadLevel(3)">معین</div>
        <div class="level-nav-item @(currentLevel == 4 ? "active" : "")" @onclick="() => LoadLevel(4)">تفصیلی</div>
    </div>

    <!-- ناوبری و فیلترها -->
    <div class="nav-sidebar">
        
        <div class="date-filter-section">
            <div class="date-inputs">
                <div class="date-input-group">
                    <DsJalaliDatePicker Label="از تاریخ:" Value="@fromDate" ValueChanged="OnFromDateChanged" />
                </div>
                <div class="date-input-group">
                    <DsJalaliDatePicker Label="تا تاریخ:" Value="@toDate" ValueChanged="OnToDateChanged" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(dateValidationError))
            {
                <div class="date-error-message">
                    <i class="fas fa-exclamation-triangle"></i>
                    @dateValidationError
                </div>
            }
        </div>
        
        <div class="col-mode-section">
            <label>
                <input type="checkbox" class="filter-checkbox" checked="@isBalanceTwoColumn" @onchange="() => SelectReportMode(ReportMode.TwoColumnBalance)" />
                ۲ ستونی (مانده)
            </label>
            <label style="display:none">
                <input type="checkbox" class="filter-checkbox" checked="@isTurnoverTwoColumn" @onchange="() => SelectReportMode(ReportMode.TwoColumnTurnover)" />
                ۲ ستونی (گردش)
            </label>
            <label>
                <input type="checkbox" class="filter-checkbox" checked="@isFourColumn" @onchange="() => SelectReportMode(ReportMode.FourColumnTurnoverBalance)" />
                ۴ ستونی (گردش + مانده)
            </label>
        </div>

        <div class="filter-section">
            <label>
                <input type="checkbox" class="filter-checkbox" @bind="showOnlyWithBalance" @bind:after="OnBalanceFilterChanged" />
                حساب‌های با مانده
            </label>
        </div>
    </div>

    <!-- محتوای اصلی -->
    <div class="main-content">
        <div class="date-inputs" style="margin-bottom: 10px;">
            <div class="date-input-group">
                <label>جستجو (کد/نام/تفصیلی):</label>
                <input type="text" value="@searchTerm" @oninput="OnLiveSearchInput" placeholder="مثال: 11012 یا علی یا 60101001" style="padding: 12px 16px; border: 1px solid #e5e5ea; border-radius: 8px; text-align: center; width: 100%; box-sizing: border-box;" />
            </div>
        </div>

        @if (isLoading)
        {
            <div style="text-align: center; padding: 50px;">در حال بارگیری...</div>
        }
        else if (nodes?.Any() == true)
        {
            <div class="table-scroll">
            <table class="report-table" id="trial-balance-table" @ref="reportTableRef">
                <thead>
                        @if (isFourColumn)
                        {
                            <tr>
                                <th class="row-number th-yellow" rowspan="2">ردیف</th>
                                <th class="account-code th-yellow" rowspan="2">کدینگ</th>
                                @if (currentLevel >= 1 && currentLevel <= 4)
                                {
                                    <th class="th-yellow" rowspan="2">گردش</th>
                                }
                                <th class="account-name th-yellow" rowspan="2">شرح حساب</th>
                                <th class="th-blue" colspan="2">گردش حساب</th>
                                <th class="th-green" colspan="2">مانده حساب</th>
                            </tr>
                            <tr>
                                <th class="amount-debit th-blue" style="font-family: 'Vazir', 'Segoe UI', Tahoma, Arial, sans-serif;">گردش بدهکار</th>
                                <th class="amount-credit th-blue" style="font-family: 'Vazir', 'Segoe UI', Tahoma, Arial, sans-serif;">گردش بستانکار</th>
                                <th class="amount-debit th-green" style="font-family: 'Vazir', 'Segoe UI', Tahoma, Arial, sans-serif;">مانده بدهکار</th>
                                <th class="amount-credit th-green" style="font-family: 'Vazir', 'Segoe UI', Tahoma, Arial, sans-serif;">مانده بستانکار</th>
                            </tr>
                        }
                        else if (isBalanceTwoColumn)
                        {
                            <tr>
                                <th class="row-number th-yellow">ردیف</th>
                                <th class="account-code th-yellow">کدینگ</th>
                                @if (currentLevel >= 1 && currentLevel <= 4)
                                {
                                    <th class="th-yellow">گردش</th>
                                }
                                <th class="account-name th-yellow">شرح حساب</th>
                                <th class="amount-debit th-green" style="font-family: 'Vazir', 'Segoe UI', Tahoma, Arial, sans-serif;">مانده بدهکار</th>
                                <th class="amount-credit th-green" style="font-family: 'Vazir', 'Segoe UI', Tahoma, Arial, sans-serif;">مانده بستانکار</th>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <th class="row-number th-yellow">ردیف</th>
                                <th class="account-code th-yellow">کدینگ</th>
                                @if (currentLevel >= 1 && currentLevel <= 4)
                                {
                                    <th class="th-yellow">گردش</th>
                                }
                                <th class="account-name th-yellow">شرح حساب</th>
                                <th class="amount-debit th-blue" style="font-family: 'Vazir', 'Segoe UI', Tahoma, Arial, sans-serif;">گردش بدهکار</th>
                                <th class="amount-credit th-blue" style="font-family: 'Vazir', 'Segoe UI', Tahoma, Arial, sans-serif;">گردش بستانکار</th>
                            </tr>
                        }
                    </thead>
                    <tbody>
                        @{int rowNumber = 1;}
                        @foreach (var node in filteredNodes)
                        {
                            @RenderTableRow(node, rowNumber++)
                        }
                        <!-- ردیف جمع -->
                        <tr class="total-row">
                            <td class="account-name td-white" colspan="@(3 + (currentLevel >= 1 && currentLevel <= 4 ? 1 : 0))" style="text-align: center; font-weight: 800;">
                                جمع و موازنه
                            </td>
