    private async Task TestRollupLogic()
    {
        try
        {
            // تست منطق تجمیعی برای تمام سطوح
            var level1 = await TrialBalanceRepo.GetByLevelAsync(1);
            var level2 = await TrialBalanceRepo.GetByLevelAsync(2);
            var level3 = await TrialBalanceRepo.GetByLevelAsync(3);
            var level4 = await TrialBalanceRepo.GetByLevelAsync(4);

            var message = "تست منطق Roll-up:\n" +
                $"سطح 1: {level1.Count()} حساب - مجموع بدهکار: {level1.Sum(x => x.DebitBalance):N0} - مجموع بستانکار: {level1.Sum(x => x.CreditBalance):N0}\n" +
                $"سطح 2: {level2.Count()} حساب - مجموع بدهکار: {level2.Sum(x => x.DebitBalance):N0} - مجموع بستانکار: {level2.Sum(x => x.CreditBalance):N0}\n" +
                $"سطح 3: {level3.Count()} حساب - مجموع بدهکار: {level3.Sum(x => x.DebitBalance):N0} - مجموع بستانکار: {level3.Sum(x => x.CreditBalance):N0}\n" +
                $"سطح 4: {level4.Count()} حساب - مجموع بدهکار: {level4.Sum(x => x.DebitBalance):N0} - مجموع بستانکار: {level4.Sum(x => x.CreditBalance):N0}\n\n" +
                "نمونه حساب‌های سطح 1:\n" +
                string.Join("\n", level1.Take(3).Select(x => $"- {x.Code}: {x.Name} | بدهکار: {x.DebitBalance:N0} | بستانکار: {x.CreditBalance:N0}"));

            await JSRuntime.InvokeVoidAsync("alert", message);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در تست Roll-up: {ex.Message}");
        }
    }

    private async Task DebugChildren()
    {
        try
        {
            // تست GetChildrenAsync برای حساب‌های سطح 3 و 4
            var level3Accounts = await TrialBalanceRepo.GetByLevelAsync(3);
            var level4Accounts = await TrialBalanceRepo.GetByLevelAsync(4);

            var debugInfo = "Debug فرزندان:\n\n";
            
            // تست یک حساب سطح 3
            var sampleLevel3 = level3Accounts.FirstOrDefault();
            if (sampleLevel3 != null)
            {
                var children3 = await TrialBalanceRepo.GetChildrenAsync(sampleLevel3.AccountId);
                debugInfo += "حساب سطح 3: " + sampleLevel3.Code + " - " + sampleLevel3.Name + "\n";
                debugInfo += "تعداد فرزندان: " + children3.Count() + "\n";
                debugInfo += "فرزندان: " + string.Join(", ", children3.Take(3).Select(x => x.Code)) + "\n\n";
            }

            // تست یک حساب سطح 4
            var sampleLevel4 = level4Accounts.FirstOrDefault();
            if (sampleLevel4 != null)
            {
                var children4 = await TrialBalanceRepo.GetChildrenAsync(sampleLevel4.AccountId);
                debugInfo += "حساب سطح 4: " + sampleLevel4.Code + " - " + sampleLevel4.Name + "\n";
                debugInfo += "تعداد فرزندان: " + children4.Count() + "\n";
                debugInfo += "HasChildren: " + sampleLevel4.HasChildren + "\n";
                if (children4.Any())
                {
                    debugInfo += "فرزندان: " + string.Join(", ", children4.Take(3).Select(x => x.Code)) + "\n";
                }
                else
                {
                    // اگر فرزند نداشت، تراکنش‌ها را بررسی کن
                    var transactions = await TrialBalanceRepo.GetAccountTransactionsAsync(sampleLevel4.AccountId);
                    debugInfo += "تعداد تراکنش‌ها: " + transactions.Count() + "\n";
                }
            }

            await JSRuntime.InvokeVoidAsync("alert", debugInfo);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در Debug: {ex.Message}");
        }
    }

    private RenderFragment RenderTableRow(TrialBalanceNode node, int rowNumber) => __builder =>
    {
        var debitDisplay = isBalanceTwoColumn ? ComputeDebtorBalance(node) : node.DebitBalance;
        var creditDisplay = isBalanceTwoColumn ? ComputeCreditorBalance(node) : node.CreditBalance;

        <tr>
            <td class="row-number">@rowNumber</td>
            <td class="account-code">
                @if (node.Level == 3 && currentLevel == 3)
                {
                    <a href="javascript:void(0)" style="font-weight:900; text-decoration: underline;" @onclick="() => LoadMoeenDrillDown(node.AccountId)">@node.Code</a>
                }
                else if (node.Level == 4 && currentLevel == 4)
                {
                    <a href="javascript:void(0)" style="font-weight:900; text-decoration: underline;" @onclick="() => GoToTafsiliMoeenAsync(node)">@node.Code</a>
                }
                else if (node.Level <= 2 && currentLevel == node.Level)
                {
                    <a href="javascript:void(0)" style="font-weight:900; text-decoration: underline;" @onclick="() => LoadDrillDown(node.Level, node.AccountId)">@node.Code</a>
                }
                else
                {
                    <span>@node.Code</span>
                }
            </td>
            @if (currentLevel >= 1 && currentLevel <= 4)
            {
                <td style="text-align: center;">
                    <button type="button" class="turnover-eye-btn" @onclick="() => OnTurnoverClick(node)">
                        <i class="fas fa-receipt"></i>
                    </button>
                </td>
            }
            <td class="account-name">
                <span>@OneLine(node.Name)</span>
            </td>
            <td class="amount-debit">
                <span>@debitDisplay.ToString("N0")</span>
            </td>
            <td class="amount-credit">
                <span>@creditDisplay.ToString("N0")</span>
            </td>
            @if (isFourColumn)
            {
                <td class="amount-debit">
                    <span>@(ComputeDebtorBalance(node) > 0 ? ComputeDebtorBalance(node).ToString("N0") : "-")</span>
                </td>
                <td class="amount-credit">
                    <span>@(ComputeCreditorBalance(node) > 0 ? ComputeCreditorBalance(node).ToString("N0") : "-")</span>
                </td>
            }
        </tr>
    };

    private async Task GoToTurnoverAsync(TrialBalanceNode node)
    {
        await SaveStateAsync();
        var fromQ = Uri.EscapeDataString(fromDate ?? string.Empty);
        var toQ = Uri.EscapeDataString(toDate ?? string.Empty);
        var includeChildrenQ = currentLevel == 4 ? "" : "&includeChildren=true";
        Nav.NavigateTo($"/admin/reports/subsidiary-transactions/{node.AccountId}?fromDate={fromQ}&toDate={toQ}&level={node.Level}{includeChildrenQ}");
    }

    private void OnTurnoverClick(TrialBalanceNode node)
    {
        _ = GoToTurnoverAsync(node);
    }

    private async Task SaveStateAsync()
    {
