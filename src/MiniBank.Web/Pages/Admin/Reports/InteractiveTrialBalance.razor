    private string GetRowBackgroundColor(byte level)
    {
        return level switch
        {
            1 => "rgba(13, 110, 253, 0.05)",  // آبی خیلی روشن
            2 => "rgba(25, 135, 84, 0.05)",   // سبز خیلی روشن  
            3 => "rgba(255, 193, 7, 0.05)",   // زرد خیلی روشن
            4 => "rgba(220, 53, 69, 0.05)",   // قرمز خیلی روشن
            5 => "rgba(108, 117, 125, 0.03)", // خاکستری خیلی روشن برای تراکنش‌ها
            _ => "transparent"
        };
    }

    private string OneLine(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var s = input.Replace("\r", " ").Replace("\n", " ");
        // فشرده‌سازی فاصله‌های پشت‌سرهم
        while (s.Contains("  ")) s = s.Replace("  ", " ");
        return s.Trim();
    }

    private async Task ShowTransactionDetails(long journalLineId)
    {
        try
        {
            // پیدا کردن تراکنش از تراکنش‌های بارگیری شده
            selectedTransaction = null;
            
            // جستجو در تمام نودهای باز شده برای پیدا کردن تراکنش
            foreach (var node in nodes)
            {
                selectedTransaction = await FindTransactionInNode(node, journalLineId);
                if (selectedTransaction != null) break;
            }
            
            if (selectedTransaction != null)
            {
                showTransactionModal = true;
                StateHasChanged();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "تراکنش یافت نشد");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در بارگیری جزئیات تراکنش: {ex.Message}");
        }
    }

    private async Task<JournalLineDetail?> FindTransactionInNode(TrialBalanceNode node, long journalLineId)
    {
        if (node.Level == 4 && node.IsExpanded && node.Children.Any())
        {
            // بارگیری تراکنش‌های این حساب
            IEnumerable<JournalLineDetail> transactions;
            
            // در حالت عادی، تمام تراکنش‌ها
            transactions = await TrialBalanceRepo.GetAccountTransactionsAsync(node.AccountId, fromDateG, toDateG);
            
            return transactions.FirstOrDefault(t => t.JournalLineId == journalLineId);
        }
        
        // جستجو در فرزندان
        foreach (var child in node.Children)
        {
            var result = await FindTransactionInNode(child, journalLineId);
            if (result != null) return result;
        }
        
        return null;
    }

