    private async Task ApplyDateFilter()
    {
        try
        {
            // پاک کردن خطای قبلی
            dateValidationError = "";
            
            // اعتبارسنجی تاریخ‌ها
            if (string.IsNullOrWhiteSpace(fromDate) || string.IsNullOrWhiteSpace(toDate))
            {
                dateValidationError = "لطفاً هر دو تاریخ شروع و پایان را وارد کنید";
                StateHasChanged();
                return;
            }

            // پارس تاریخ‌های انتخاب شده کاربر
            var fromG = ParseJalaliToGregorian(fromDate);
            var toG = ParseJalaliToGregorian(toDate);
            
            if (fromG == null || toG == null)
            {
                dateValidationError = "فرمت تاریخ نامعتبر است. لطفاً از فرمت yyyy/mm/dd استفاده کنید";
                StateHasChanged();
                return;
            }

            // بررسی اینکه تاریخ پایان از تاریخ شروع کمتر نباشد
            if (toG < fromG)
            {
                dateValidationError = "تاریخ پایان نمی‌تواند از تاریخ شروع کمتر باشد";
                StateHasChanged();
                return;
            }

            // اعمال به بازه فیلتر
            fromDateG = fromG;
            toDateG = toG?.Date;

            // بازخوانی داده‌ها بر اساس بازه جدید
            if (_currentMoeenId.HasValue)
                await LoadMoeenDrillDown(_currentMoeenId.Value);
            else
                await LoadLevel(currentLevel);
        }
        catch (Exception ex)
        {
            dateValidationError = $"خطا در اعمال فیلتر تاریخی: {ex.Message}";
            StateHasChanged();
        }
    }

