@page "/admin/reports/transactions"
@using MiniBank.Web.Infrastructure.Repositories
@using MiniBank.Web.Models.Reports
@using MiniBank.Web.Components.DesignSystem
@using MiniBank.Web.Components.Extensions
@using MiniBank.Web.Services
@inject TransactionReportRepository ReportRepo
@inject IJSRuntime JSRuntime
@inject MiniBank.Web.Infrastructure.Repositories.FiscalYearRepository FiscalYearRepo
@inject MiniBank.Web.Services.FiscalYearRangeProvider FiscalRange

<PageTitle>گزارش‌های تراکنش‌ها</PageTitle>

<DsPageHeader Title="گزارش‌های تراکنش‌ها" 
             Icon="fa-solid fa-chart-line"
             ShowBackButton="true" />

<style>
    .tx-badge { display:inline-flex; align-items:center; justify-content:center; padding:2px 8px; border-radius:999px; font-weight:900; font-size:12px; line-height:1.2; border:1px solid rgba(0,0,0,.08); }
    .tx-badge-loan { background:#ede9fe; color:#5b21b6; border-color:#ddd6fe; }
    .tx-badge-interest { background:#ecfccb; color:#365314; border-color:#d9f99d; }
    .tx-badge-prepay { background:#cffafe; color:#155e75; border-color:#a5f3fc; }
</style>

<div class="reports-container">
    <!-- فیلترها -->
    <div class="filters-section">
        <div class="filters-card">
            <div class="filters-header">
                <h3 class="filters-title">
                    <i class="fa-solid fa-filter"></i>
                    فیلترهای گزارش
                </h3>
            </div>
            <div class="filters-body">
                    <div class="filters-grid">
                        <div class="filter-group">
                            <DsJalaliDatePicker Label="از تاریخ" 
                                              @bind-Value="fromDateString" 
                                              Placeholder="مثال: 1403/01/01" />
                        </div>
                        <div class="filter-group">
                            <DsJalaliDatePicker Label="تا تاریخ" 
                                              @bind-Value="toDateString" 
                                              Placeholder="مثال: 1403/12/29" />
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">شناسه عضو</label>
                            <input type="number" class="filter-input" @bind="memberId" placeholder="اختیاری" />
                        </div>
                        <div class="filter-group">
                            <label class="filter-label">شناسه خانوار</label>
                            <input type="number" class="filter-input" @bind="householdId" placeholder="اختیاری" />
                        </div>
                    </div>
            </div>
        </div>
    </div>

    <!-- تب‌های گزارش -->
    <div class="reports-section">
            <ul class="nav nav-tabs" id="reportTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "balance-summary" ? "active" : "")" 
                            @onclick='() => SetActiveTab("balance-summary")' type="button">
                        <i class="fa-solid fa-users me-2"></i>
                        خلاصه موجودی اعضا
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "balance-details" ? "active" : "")" 
                            @onclick='() => SetActiveTab("balance-details")' type="button">
                        <i class="fa-solid fa-list-ul me-2"></i>
                        جزئیات موجودی اعضا
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "transaction-impact" ? "active" : "")" 
                            @onclick='() => SetActiveTab("transaction-impact")' type="button">
                        <i class="fa-solid fa-chart-bar me-2"></i>
                        تأثیر بر حساب‌ها
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "transaction-trail" ? "active" : "")" 
                            @onclick='() => SetActiveTab("transaction-trail")' type="button">
                        <i class="fa-solid fa-route me-2"></i>
                        ردیابی تراکنش
                    </button>
                </li>
            </ul>

            <div class="tab-content mt-3">
                <!-- خلاصه موجودی اعضا -->
                @if (activeTab == "balance-summary")
                {
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">خلاصه موجودی حساب‌های اعضا</h5>
                            <button class="btn btn-primary btn-sm" @onclick="LoadBalanceSummary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fa-solid fa-refresh me-2"></i>
                                بارگیری
                            </button>
                        </div>
                        <div class="card-body">
                            @if (balanceSummaryData?.Any() == true)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>عضو</th>
                                                <th>کد ملی</th>
                                                <th>خانوار</th>
                                                <th>حساب</th>
                                                <th>بدهکار</th>
                                                <th>بستانکار</th>
                                                <th>موجودی</th>
                                                <th>تعداد تراکنش</th>
                                                <th>آخرین تراکنش</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in balanceSummaryData)
                                            {
                                                <tr>
                                                    <td>@item.MemberName</td>
                                                    <td>@item.NationalCode</td>
                                                    <td>@item.HouseholdName</td>
                                                    <td>
                                                        <span class="badge bg-secondary me-1">@item.AccountCode</span>
                                                        @item.AccountName
                                                    </td>
                                                    <td class="text-end">@item.TotalDebit.ToString("N0")</td>
                                                    <td class="text-end">@item.TotalCredit.ToString("N0")</td>
                                                    <td class="text-end">
                                                        <span class="@(item.Balance >= 0 ? "text-success" : "text-danger")">
                                                            @item.Balance.ToString("N0")
                                                        </span>
                                                    </td>
                                                    <td class="text-center">@item.TransactionCount</td>
                                                    <td>@item.LastTransactionDate?.ToString("yyyy/MM/dd")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else if (isLoading)
                            {
                                <div class="text-center py-4">
                                    <div class="spinner-border" role="status">
                                        <span class="visually-hidden">در حال بارگیری...</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="fa-solid fa-info-circle me-2"></i>
                                    برای مشاهده گزارش، دکمه بارگیری را کلیک کنید.
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- جزئیات موجودی اعضا -->
                @if (activeTab == "balance-details")
                {
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">جزئیات موجودی حساب‌های اعضا</h5>
                            <button class="btn btn-primary btn-sm" @onclick="LoadBalanceDetails" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fa-solid fa-refresh me-2"></i>
                                بارگیری
                            </button>
                        </div>
                        <div class="card-body">
                            @if (balanceDetailsData?.Any() == true)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover table-sm">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>عضو</th>
                                                <th>حساب</th>
                                                <th>تاریخ</th>
                                                <th>نوع تراکنش</th>
                                                <th>بدهکار</th>
                                                <th>بستانکار</th>
                                                <th>موجودی تجمعی</th>
                                                <th>توضیحات</th>
                                                <th>عملیات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in balanceDetailsData)
                                            {
                                                <tr>
                                                    <td>
                                                        <small>@item.MemberName</small><br>
                                                        <span class="text-muted small">@item.NationalCode</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary">@item.AccountCode</span><br>
                                                        <small>@item.AccountName</small>
                                                    </td>
                                                    <td class="small">@item.TransactionDate.ToString("yyyy/MM/dd")</td>
                                                    <td>
                                                        <span class="badge bg-info">@item.TransactionType</span>
                                                    </td>
                                                    <td class="text-end">@item.Debit.ToString("N0")</td>
                                                    <td class="text-end">@item.Credit.ToString("N0")</td>
                                                    <td class="text-end">
                                                        <span class="@(item.RunningBalance >= 0 ? "text-success" : "text-danger") fw-bold">
                                                            @item.RunningBalance.ToString("N0")
                                                        </span>
                                                    </td>
                                                    <td class="small">@item.TransactionNotes</td>
                                                    <td>
                                                        <button class="btn btn-outline-primary btn-sm" 
                                                                @onclick="() => ShowTransactionTrail(item.TransactionId)">
                                                            <i class="fa-solid fa-search"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else if (isLoading)
                            {
                                <div class="text-center py-4">
                                    <div class="spinner-border" role="status">
                                        <span class="visually-hidden">در حال بارگیری...</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="fa-solid fa-info-circle me-2"></i>
                                    برای مشاهده گزارش، دکمه بارگیری را کلیک کنید.
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- تأثیر بر حساب‌ها -->
                @if (activeTab == "transaction-impact")
                {
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">تأثیر تراکنش‌ها بر حساب‌های مختلف</h5>
                            <button class="btn btn-primary btn-sm" @onclick="LoadTransactionImpact" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fa-solid fa-refresh me-2"></i>
                                بارگیری
                            </button>
                        </div>
                        <div class="card-body">
                            @if (transactionImpactData?.Any() == true)
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>حساب</th>
                                                <th>تعداد تراکنش</th>
                                                <th>تعداد اعضا</th>
                                                <th>کل بدهکار</th>
                                                <th>کل بستانکار</th>
                                                <th>تأثیر خالص</th>
                                                <th>سپرده</th>
                                                <th>قسط وام</th>
                                                <th>سود</th>
                                                <th>جریمه</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in transactionImpactData)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="badge bg-secondary me-1">@item.AccountCode</span>
                                                        @item.AccountName
                                                    </td>
                                                    <td class="text-center">@item.TransactionCount</td>
                                                    <td class="text-center">@item.AffectedMemberCount</td>
                                                    <td class="text-end">@item.TotalDebit.ToString("N0")</td>
                                                    <td class="text-end">@item.TotalCredit.ToString("N0")</td>
                                                    <td class="text-end">
                                                        <span class="@(item.NetImpact >= 0 ? "text-success" : "text-danger") fw-bold">
                                                            @item.NetImpact.ToString("N0")
                                                        </span>
                                                    </td>
                                                    <td class="text-end small">@item.DepositImpact.ToString("N0")</td>
                                                    <td class="text-end small">@item.LoanPaymentImpact.ToString("N0")</td>
                                                    <td class="text-end small">@item.InterestImpact.ToString("N0")</td>
                                                    <td class="text-end small">@item.PenaltyImpact.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else if (isLoading)
                            {
                                <div class="text-center py-4">
                                    <div class="spinner-border" role="status">
                                        <span class="visually-hidden">در حال بارگیری...</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="fa-solid fa-info-circle me-2"></i>
                                    برای مشاهده گزارش، دکمه بارگیری را کلیک کنید.
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- ردیابی تراکنش -->
                @if (activeTab == "transaction-trail")
                {
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">ردیابی مسیر تراکنش</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">شناسه تراکنش</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" @bind="trailTransactionId" placeholder="شناسه تراکنش را وارد کنید" />
                                        <button class="btn btn-primary" @onclick="LoadTransactionTrail" disabled="@isLoading">
                                            @if (isLoading)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                            }
                                            <i class="fa-solid fa-search me-2"></i>
                                            جستجو
                                        </button>
                                    </div>
                                </div>
                            </div>

                            @if (transactionTrailData != null)
                            {
                                @if (transactionTrailData.Transaction != null)
                                {
                                    <!-- اطلاعات اصلی تراکنش -->
                                    <div class="row mb-4">
                                        <div class="col-12">
                                            <div class="card border-primary">
                                                <div class="card-header bg-primary text-white">
                                                    <h6 class="mb-0">
                                                        <i class="fa-solid fa-info-circle me-2"></i>
                                                        اطلاعات تراکنش #@transactionTrailData.TransactionId
                                                    </h6>
                                                </div>
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-md-3">
                                                            <strong>نوع:</strong>
                                                            @if (!string.IsNullOrWhiteSpace(_trailBadgeText) && !string.IsNullOrWhiteSpace(_trailBadgeCss))
                                                            {
                                                                <span class="@_trailBadgeCss">@_trailBadgeText</span>
                                                            }
                                                            <span style="margin-inline-start:6px">@_trailTypeText</span>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <strong>مبلغ:</strong> @transactionTrailData.Transaction.AmountTotal.ToString("N0") ریال
                                                        </div>
                                                        <div class="col-md-3">
                                                            <strong>تاریخ:</strong> @transactionTrailData.Transaction.OccurredAt.ToString("yyyy/MM/dd HH:mm")
                                                        </div>
                                                        <div class="col-md-3">
                                                            <strong>وضعیت:</strong> 
                                                            <span class="badge bg-success">تکمیل شده</span>
                                                        </div>
                                                    </div>
                                                    <div class="row mt-2">
                                                        <div class="col-md-4">
                                                            <strong>عضو:</strong> @transactionTrailData.Transaction.MemberName
                                                        </div>
                                                        <div class="col-md-4">
                                                            <strong>خانوار:</strong> @transactionTrailData.Transaction.HouseholdName
                                                        </div>
                                                        <div class="col-md-4">
                                                            <strong>الگو:</strong> @transactionTrailData.Transaction.PostingTemplateName
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(transactionTrailData.Transaction.Notes))
                                                    {
                                                        <div class="row mt-2">
                                                            <div class="col-12">
                                                                <strong>توضیحات:</strong> @transactionTrailData.Transaction.Notes
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ثبت‌های حسابداری -->
                                    @if (transactionTrailData.JournalLines?.Any() == true)
                                    {
                                        <div class="row mb-4">
                                            <div class="col-12">
                                                <div class="card border-success">
                                                    <div class="card-header bg-success text-white">
                                                        <h6 class="mb-0">
                                                            <i class="fa-solid fa-book me-2"></i>
                                                            ثبت‌های حسابداری
                                                        </h6>
                                                    </div>
                                                    <div class="card-body p-0">
                                                        <div class="table-responsive">
                                                            <table class="table table-sm mb-0">
                                                                <thead class="table-light">
                                                                    <tr>
                                                                        <th>ردیف</th>
                                                                        <th>حساب</th>
                                                                        <th>عضو</th>
                                                                        <th>بدهکار</th>
                                                                        <th>بستانکار</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var line in transactionTrailData.JournalLines)
                                                                    {
                                                                        <tr>
                                                                            <td>@line.LineNo</td>
                                                                            <td>
                                                                                <span class="badge bg-secondary me-1">@line.AccountCode</span>
                                                                                @line.AccountName
                                                                            </td>
                                                                            <td>
                                                                                @if (!string.IsNullOrEmpty(line.MemberName))
                                                                                {
                                                                                    <small>@line.MemberName</small>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">-</span>
                                                                                }
                                                                            </td>
                                                                            <td class="text-end">
                                                                                @if (line.Debit > 0)
                                                                                {
                                                                                    <span class="text-danger">@line.Debit.ToString("N0")</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">-</span>
                                                                                }
                                                                            </td>
                                                                            <td class="text-end">
                                                                                @if (line.Credit > 0)
                                                                                {
                                                                                    <span class="text-success">@line.Credit.ToString("N0")</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">-</span>
                                                                                }
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                                <tfoot class="table-light">
                                                                    <tr>
                                                                        <th colspan="3">جمع کل:</th>
                                                                        <th class="text-end">@transactionTrailData.JournalLines.Sum(x => x.Debit).ToString("N0")</th>
                                                                        <th class="text-end">@transactionTrailData.JournalLines.Sum(x => x.Credit).ToString("N0")</th>
                                                                    </tr>
                                                                </tfoot>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- تاریخچه پردازش -->
                                    @if (transactionTrailData.ProcessLogs?.Any() == true)
                                    {
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="card border-info">
                                                    <div class="card-header bg-info text-white">
                                                        <h6 class="mb-0">
                                                            <i class="fa-solid fa-history me-2"></i>
                                                            تاریخچه پردازش
                                                        </h6>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="timeline">
                                                            @foreach (var log in transactionTrailData.ProcessLogs.OrderBy(x => x.CreatedAt))
                                                            {
                                                                <div class="timeline-item">
                                                                    <div class="timeline-marker bg-@(log.Status == "Completed" ? "success" : log.Status == "Failed" ? "danger" : "primary")"></div>
                                                                    <div class="timeline-content">
                                                                        <h6 class="mb-1">@log.Step</h6>
                                                                        <p class="mb-1">@log.Message</p>
                                                                        <small class="text-muted">
                                                                            @log.CreatedAt.ToString("yyyy/MM/dd HH:mm:ss") - @log.CreatedBy
                                                                        </small>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        <i class="fa-solid fa-exclamation-triangle me-2"></i>
                                        تراکنش با شناسه @transactionTrailData.TransactionId یافت نشد.
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
        </div>
    </div>
</div>

@code {
    private string activeTab = "balance-summary";
    private bool isLoading = false;

    // فیلترها
    private string? fromDateString;
    private string? toDateString;
    private DateTime? fromDate => ParseJalaliDate(fromDateString);
    private DateTime? toDate => ParseJalaliDate(toDateString);
    private long? memberId;
    private long? householdId;
    private long? trailTransactionId;

    private string _trailTypeText = "-";
    private string _trailBadgeText = string.Empty;
    private string _trailBadgeCss = string.Empty;

    // داده‌های گزارش‌ها
    private IEnumerable<MemberBalanceSummaryRow>? balanceSummaryData;
    private IEnumerable<MemberBalanceDetailRow>? balanceDetailsData;
    private IEnumerable<TransactionImpactRow>? transactionImpactData;
    private TransactionTrailReport? transactionTrailData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var range = await FiscalRange.GetRangeAsync();
            fromDateString = range.From;
            toDateString = range.To;
        }
        catch { }
        if (string.IsNullOrWhiteSpace(fromDateString) || string.IsNullOrWhiteSpace(toDateString))
        {
            var r = DateTimeExtensions.CurrentJalaliYearRange();
            fromDateString ??= r.From;
            toDateString ??= r.To;
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    private async Task LoadBalanceSummary()
    {
        isLoading = true;
        try
        {
            balanceSummaryData = await ReportRepo.GetMemberBalanceSummaryAsync(memberId, householdId, toDate);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در بارگیری گزارش: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadBalanceDetails()
    {
        isLoading = true;
        try
        {
            balanceDetailsData = await ReportRepo.GetMemberBalanceDetailsAsync(memberId, householdId, fromDate, toDate);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در بارگیری گزارش: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadTransactionImpact()
    {
        isLoading = true;
        try
        {
            transactionImpactData = await ReportRepo.GetTransactionImpactAsync(fromDate, toDate);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در بارگیری گزارش: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadTransactionTrail()
    {
        if (!trailTransactionId.HasValue)
        {
            await JSRuntime.InvokeVoidAsync("alert", "لطفاً شناسه تراکنش را وارد کنید.");
            return;
        }

        isLoading = true;
        try
        {
            transactionTrailData = await ReportRepo.GetTransactionTrailAsync(trailTransactionId.Value);

            _trailTypeText = transactionTrailData?.Transaction?.TransactionTypeName ?? "-";
            _trailBadgeText = string.Empty;
            _trailBadgeCss = string.Empty;

            if (transactionTrailData?.Transaction != null)
            {
                var p = TransactionPresentationService.Build(
                    new TransactionPresentationService.PresentationInput
                    {
                        JournalId = 0,
                        Notes = transactionTrailData.Transaction.Notes,
                        DocumentType = null,
                        TransactionType = null,
                        PayChannel = null,
                        CounterpartyName = null,
                        DisplayName = string.Empty
                    },
                    null);

                if (!string.IsNullOrWhiteSpace(p.BadgeText) && !string.IsNullOrWhiteSpace(p.BadgeCssClass))
                {
                    _trailTypeText = p.TransactionTypeName;
                    _trailBadgeText = p.BadgeText;
                    _trailBadgeCss = p.BadgeCssClass;
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطا در بارگیری ردیابی تراکنش: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowTransactionTrail(long transactionId)
    {
        trailTransactionId = transactionId;
        activeTab = "transaction-trail";
        await LoadTransactionTrail();
    }

    private DateTime? ParseJalaliDate(string? jalaliDate)
    {
        if (string.IsNullOrWhiteSpace(jalaliDate))
            return null;

        try
        {
            // Parse Jalali date in format YYYY/MM/DD
            var parts = jalaliDate.Split('/');
            if (parts.Length == 3 && 
                int.TryParse(parts[0], out var year) && 
                int.TryParse(parts[1], out var month) && 
                int.TryParse(parts[2], out var day))
            {
                var persianCalendar = new System.Globalization.PersianCalendar();
                return persianCalendar.ToDateTime(year, month, day, 0, 0, 0, 0);
            }
        }
        catch
        {
            // Ignore parsing errors
        }
        
        return null;
    }
}
