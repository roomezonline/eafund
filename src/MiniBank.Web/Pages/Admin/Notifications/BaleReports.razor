@code {
    private bool _loading;
    private List<BaleMessageLogReportRow> _items = new();
    private BaleMessageLogReportStats _stats = new();

    private string _fromJalali = string.Empty;
    private string _toJalali = string.Empty;
    private string _query = string.Empty;
    private string _statusFilter = string.Empty;

    private CancellationTokenSource? _filterCts;
    private readonly HashSet<long> _openDetails = new();

    protected override async Task OnInitializedAsync()
    {
        await SetDefaultJalaliYearRangeIfEmptyAsync();
        await LoadAsync();
    }

    private async Task SetDefaultJalaliYearRangeIfEmptyAsync()
    {
        if (!string.IsNullOrWhiteSpace(_fromJalali) || !string.IsNullOrWhiteSpace(_toJalali))
            return;

        try
        {
            var range = await FiscalRange.GetRangeAsync();
            _fromJalali = range.From;
            _toJalali = range.To;
            return;
        }
        catch { }

        var today = DateTime.Today;
        var pc = new PersianCalendar();
        var y = pc.GetYear(today);
        var lastDay = pc.GetDaysInMonth(y, 12);
        _fromJalali = $"{y:0000}/01/01";
        _toJalali = $"{y:0000}/12/{lastDay:00}";
    }

    private async Task OnQueryInput(ChangeEventArgs e)
    {
        _query = e?.Value?.ToString() ?? string.Empty;
        await ScheduleFilterLoadAsync(350);
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        _statusFilter = e?.Value?.ToString() ?? string.Empty;
        await ScheduleFilterLoadAsync(0);
    }

    private async Task ScheduleFilterLoadAsync(int delayMs)
    {
        _filterCts?.Cancel();
        _filterCts = new CancellationTokenSource();
        var ct = _filterCts.Token;

        try
        {
            if (delayMs > 0)
                await Task.Delay(delayMs, ct);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (ct.IsCancellationRequested)
            return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            var (fromUtc, toUtc) = ParseJalaliRangeUtc(_fromJalali, _toJalali);
            var (isSuccess, successIsNull) = ParseStatusFilter(_statusFilter);

            _items = (await Repo.SearchMessageLogsAsync(
                fromUtc: fromUtc,
                toUtc: toUtc,
                query: _query,
                isSuccess: isSuccess,
                successIsNull: successIsNull,
                take: 300)).ToList();

            _stats = await Repo.GetMessageLogReportStatsAsync(
                fromUtc: fromUtc,
                toUtc: toUtc,
                query: _query,
                isSuccess: isSuccess,
                successIsNull: successIsNull);
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در بارگذاری گزارش بله: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ClearFilters()
    {
        _fromJalali = string.Empty;
        _toJalali = string.Empty;
        _query = string.Empty;
        _statusFilter = string.Empty;
        _openDetails.Clear();
        await SetDefaultJalaliYearRangeIfEmptyAsync();
        await ScheduleFilterLoadAsync(0);
    }

    private void ToggleDetails(long logId)
    {
        if (_openDetails.Contains(logId))
        {
            _openDetails.Clear();
            return;
        }

        _openDetails.Clear();
        _openDetails.Add(logId);
    }

    private bool IsDetailsOpen(long logId) => _openDetails.Contains(logId);

    private static string FeatureLabel(string? key) => key switch
    {
        "deposit_credit" => "واریز به حساب",
        "deposit_interest_run" => "واریز سود سپرده",
        "loan_payment" => "پرداخت تسهیلات",
        "loan_installment_reminder" => "یادآوری قسط",
        "member_updated" => "به‌روزرسانی اطلاعات عضو",
        null or "" => "اطلاع‌رسانی عمومی",
        _ => key
    };

    private static (string Text, string Class, string Icon) GetStatus(bool? isSuccess) => isSuccess switch
    {
        true => ("تحویل به بله", "ok", "fa-circle-check"),
        false => ("ناموفق", "fail", "fa-circle-xmark"),
        _ => ("در انتظار نتیجه", "pending", "fa-hourglass-half")
    };

    private static (DateTime? fromUtc, DateTime? toUtc) ParseJalaliRangeUtc(string from, string to)
    {
        DateTime? fromUtc = null;
        DateTime? toUtc = null;

        if (TryParseJalali(from, out var f))
            fromUtc = f.ToUniversalTime();

        if (TryParseJalali(to, out var t))
            toUtc = t.Date.ToUniversalTime();

        return (fromUtc, toUtc);
    }

    private static bool TryParseJalali(string raw, out DateTime dt)
    {
        var ok = MiniBank.Web.Components.Extensions.DateTimeExtensions.TryParseJalaliDate(raw, out dt);
        if (ok) dt = DateTime.SpecifyKind(dt, DateTimeKind.Local);
        return ok;
    }

    private static string FormatJalaliDateTime(DateTime dt)
    {
        var local = dt.ToLocalTime();
        var pc = new PersianCalendar();
        var y = pc.GetYear(local);
        var m = pc.GetMonth(local);
        var d = pc.GetDayOfMonth(local);
        return $"{y:0000}/{m:00}/{d:00} {local:HH:mm}";
    }

    private static (bool? isSuccess, bool? successIsNull) ParseStatusFilter(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return (null, null);
        if (string.Equals(raw, "null", StringComparison.OrdinalIgnoreCase)) return (null, true);
        return raw switch
        {
            "1" => (true, null),
            "0" => (false, null),
            _ => (null, null)
        };
    }
}
