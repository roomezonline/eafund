@page "/admin/bale-reports"
@using MiniBank.Web.Components.DesignSystem
@using MiniBank.Web.Infrastructure.Repositories
@using MiniBank.Web.Models.Notifications
@using MiniBank.Web.Services
@using System.Globalization
@inject DsToastService Toasts
@inject BaleBotRepository Repo
@inject FiscalYearRangeProvider FiscalRange

<PageTitle>گزارش پیام‌های بله</PageTitle>

<DsPageHeader Title="گزارش پیام‌های بله"
             Icon="fa-brands fa-telegram"
             Subtitle="پیگیری ارسال اطلاع‌رسانی‌ها از طریق ربات بله"
             ShowBackButton="true"
             ShowRefreshButton="true"
             OnRefreshClick="LoadAsync" />

<section class="br-page" dir="rtl">
    <div class="br-hero">
        <div class="br-hero-text">
            <div class="br-hero-title">وضعیت ارسال پیام‌های بله</div>
            <div class="br-hero-sub">هر پیام پس از ثبت در صف اطلاع‌رسانی، از طریق ربات بله ارسال می‌شود و نتیجهٔ پاسخ سرور بله در همین صفحه ثبت می‌گردد.</div>
        </div>
        <div class="br-hero-icon">
            <i class="fa-brands fa-telegram"></i>
        </div>
    </div>

    <div class="br-note">
        <i class="fa-solid fa-circle-info"></i>
        <div>
            <b>راهنمای وضعیت‌ها:</b>
            «تحویل به بله» یعنی سرور بله پیام را پذیرفته است. رابط برنامه‌نویسی بله گزارش «خوانده شد» یا تحویل نهایی به گوشی را در اختیار ربات قرار نمی‌دهد؛ بنابراین «آخرین فعالیت» عضو در ربات (مثلاً ارسال دستور یا پیام) به‌عنوان نشانهٔ نزدیک به مشاهده نمایش داده می‌شود.
        </div>
    </div>

    <div class="br-stats">
        <div class="br-stat total">
            <div class="br-stat-icon"><i class="fa-solid fa-paper-plane"></i></div>
            <div>
                <div class="br-stat-value">@_stats.Total</div>
                <div class="br-stat-label">کل ارسال‌ها</div>
            </div>
        </div>
        <div class="br-stat ok">
            <div class="br-stat-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div>
                <div class="br-stat-value">@_stats.Success</div>
                <div class="br-stat-label">تحویل به بله</div>
            </div>
        </div>
        <div class="br-stat fail">
            <div class="br-stat-icon"><i class="fa-solid fa-circle-xmark"></i></div>
            <div>
                <div class="br-stat-value">@_stats.Failed</div>
                <div class="br-stat-label">ناموفق</div>
            </div>
        </div>
        <div class="br-stat pending">
            <div class="br-stat-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div>
                <div class="br-stat-value">@_stats.Pending</div>
                <div class="br-stat-label">در انتظار نتیجه</div>
            </div>
        </div>
        <div class="br-stat members">
            <div class="br-stat-icon"><i class="fa-solid fa-users"></i></div>
            <div>
                <div class="br-stat-value">@_stats.UniqueMembers</div>
                <div class="br-stat-label">اعضای یکتا</div>
            </div>
        </div>
        <div class="br-stat activity">
            <div class="br-stat-icon"><i class="fa-solid fa-eye"></i></div>
            <div>
                <div class="br-stat-value">@_stats.ActivityAfterSend</div>
                <div class="br-stat-label">فعالیت بعد از ارسال</div>
            </div>
        </div>
    </div>

    <div class="br-card">
        <div class="br-card-title"><i class="fa-solid fa-filter"></i> فیلترها</div>

        <div class="br-filters">
            <div class="br-field">
                <label>از تاریخ</label>
                <DsJalaliDatePicker Value="@_fromJalali" ValueChanged="async (v) => { _fromJalali = v ?? string.Empty; await ScheduleFilterLoadAsync(0); }" Placeholder="مثال: 1404/06/01" />
            </div>
            <div class="br-field">
                <label>تا تاریخ</label>
                <DsJalaliDatePicker Value="@_toJalali" ValueChanged="async (v) => { _toJalali = v ?? string.Empty; await ScheduleFilterLoadAsync(0); }" Placeholder="مثال: 1404/06/30" />
            </div>
            <div class="br-field wide">
                <label>جستجو (نام / موبایل / کد عضویت / ChatId / متن پیام)</label>
                <input class="br-input" value="@_query" @oninput="OnQueryInput" placeholder="مثلاً 0912... یا 11008 یا نام عضو" />
            </div>
            <div class="br-field">
                <label>وضعیت ارسال</label>
                <select class="br-input" value="@_statusFilter" @onchange="OnStatusChanged">
                    <option value="">همه</option>
                    <option value="1">تحویل به بله</option>
                    <option value="0">ناموفق</option>
                    <option value="null">در انتظار نتیجه</option>
                </select>
            </div>
        </div>

        <div class="br-actions">
            <button class="br-btn ghost" @onclick="ClearFilters" disabled="@_loading">پاک کردن فیلترها</button>
            <span class="br-hint">حداکثر ۳۰۰ مورد آخر نمایش داده می‌شود.</span>
        </div>
    </div>

    <div class="br-card">
        <div class="br-card-head">
            <div class="br-card-title"><i class="fa-solid fa-list-ul"></i> نتایج</div>
            <div class="br-count">@_items.Count مورد</div>
        </div>

        @if (_loading)
        {
            <div class="br-empty">در حال بارگذاری...</div>
        }
        else if (_items.Count == 0)
        {
            <div class="br-empty">
                <i class="fa-regular fa-face-smile"></i>
                <div>در بازهٔ انتخابی پیامی یافت نشد.</div>
            </div>
        }
        else
        {
            <div class="br-list">
                @foreach (var x in _items)
                {
                    var isOpen = IsDetailsOpen(x.LogId);
                    var (statusText, statusClass, statusIcon) = GetStatus(x.IsSuccess);

                    <div class="br-row @statusClass">
                        <div class="br-row-summary" @onclick="(() => ToggleDetails(x.LogId))">
                            <div class="br-row-main">
                                <div class="br-row-top">
                                    <span class="br-chip @statusClass"><i class="fa-solid @statusIcon"></i> @statusText</span>
                                    @if (x.ActivityAfterSend)
                                    {
                                        <span class="br-chip activity"><i class="fa-solid fa-eye"></i> فعالیت بعد از ارسال</span>
                                    }
                                    <span class="br-feature">@FeatureLabel(x.FeatureKey)</span>
                                </div>

                                <div class="br-row-name">
                                    @(string.IsNullOrWhiteSpace(x.MemberFullName) ? "-" : x.MemberFullName)
                                    <span class="br-muted">#@(x.MemberId?.ToString() ?? "-")</span>
                                </div>

                                <div class="br-row-meta">
                                    <span class="br-mobile" dir="ltr">@(string.IsNullOrWhiteSpace(x.MemberMobileNumber) ? "-" : x.MemberMobileNumber)</span>
                                    <span class="br-sep">|</span>
                                    <span dir="ltr">ChatId: @(x.ChatId?.ToString() ?? "-")</span>
                                    @if (!string.IsNullOrWhiteSpace(x.BaleUsername))
                                    {
                                        <span class="br-sep">|</span>
                                        <span dir="ltr">@@@x.BaleUsername</span>
                                    }
                                </div>
                            </div>

                            <div class="br-row-side">
                                <div class="br-time">@FormatJalaliDateTime(x.SentAt ?? x.CreatedAt)</div>
                                <i class="fa-solid @(isOpen ? "fa-chevron-up" : "fa-chevron-down") br-chevron"></i>
                            </div>
                        </div>

                        @if (isOpen)
                        {
                            <div class="br-row-details">
                                <div class="br-detail-grid">
                                    <div class="br-detail">
                                        <span class="br-detail-label">زمان ثبت</span>
                                        <span>@FormatJalaliDateTime(x.CreatedAt)</span>
                                    </div>
                                    <div class="br-detail">
                                        <span class="br-detail-label">زمان پاسخ بله</span>
                                        <span>@(x.SentAt.HasValue ? FormatJalaliDateTime(x.SentAt.Value) : "-")</span>
                                    </div>
                                    <div class="br-detail">
                                        <span class="br-detail-label">شناسه پیام بله</span>
                                        <span dir="ltr">@(x.ProviderMessageId?.ToString() ?? "-")</span>
                                    </div>
                                    <div class="br-detail">
                                        <span class="br-detail-label">کد اطلاع‌رسانی</span>
                                        <span dir="ltr">@(x.NotificationId?.ToString() ?? "-")</span>
                                    </div>
                                    <div class="br-detail">
                                        <span class="br-detail-label">وضعیت HTTP</span>
                                        <span dir="ltr">@(x.ApiStatus?.ToString() ?? "-")</span>
                                    </div>
                                    <div class="br-detail">
                                        <span class="br-detail-label">آخرین فعالیت عضو در ربات</span>
                                        <span>@(x.SubscriberLastSeenAt.HasValue ? FormatJalaliDateTime(x.SubscriberLastSeenAt.Value) : "-")</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(x.ApiMessage))
                                {
                                    <div class="br-detail-line">
                                        <span class="br-detail-label">پیام سرور بله</span>
                                        <div class="br-detail-value">@x.ApiMessage</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(x.ErrorMessage))
                                {
                                    <div class="br-detail-line error">
                                        <span class="br-detail-label">خطا</span>
                                        <div class="br-detail-value">@x.ErrorMessage</div>
                                    </div>
                                }

                                <div class="br-detail-line">
                                    <span class="br-detail-label">متن پیام ارسال‌شده</span>
                                    <pre class="br-message">@x.MessageText</pre>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

