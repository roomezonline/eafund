@page "/admin/receipts/household-wizard-v2"
@using System.Globalization
@using MiniBank.Web.Models
@using MiniBank.Web.Infrastructure.Repositories
@using MiniBank.Web.Services
@using MiniBank.Web.Components.DesignSystem
@using MiniBank.Web.Components.Extensions
@using System.Linq
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS
@inject MiniBank.Web.Infrastructure.Repositories.HouseholdReceiptRepository ReceiptRepo
@inject MiniBank.Web.Infrastructure.Repositories.HouseholdReceiptAllocationRepository AllocationRepo
@inject MiniBank.Web.Infrastructure.Repositories.MemberRepository MemberRepo
@inject MiniBank.Web.Infrastructure.Repositories.TransactionRepository TxRepo
@inject MiniBank.Web.Core.Interfaces.IHouseholdRepository HouseholdRepo
@inject MiniBank.Web.Components.DesignSystem.DsToastService Toast
@inject MiniBank.Web.Infrastructure.Repositories.AccountsRepository AccountRepo
@inject MiniBank.Web.Services.BankAccountService BankAccountService
@inject MiniBank.Web.Services.SafeTransactionService SafeTransactionService

<style>
    .deposit-account-info {
        margin-top: 0.5rem;
        padding: 0.75rem;
        border-radius: 8px;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
    }

    .account-display {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .account-display.active {
        color: #198754;
    }

    .account-display.inactive {
        color: #ffc107;
    }

    .account-number {
        font-weight: 500;
        font-family: 'Courier New', monospace;
    }

    .account-status {
        font-size: 0.875rem;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        background-color: #d1edda;
        color: #155724;
    }

    .no-account-text {
        font-size: 0.875rem;
        color: #856404;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        border-radius: 4px;
    }
</style>

<div class="receipt-wizard-container">
    <DsPageHeader Icon="fa-solid fa-receipt" 
                  Title="ثبت رسید خانوار" 
                  Subtitle="سیستم چند مرحله‌ای ثبت و تسهیم دریافت"
                  ShowBackButton="true"
                  ShowRefreshButton="false"
                  ShowAddButton="false" />

    <DsMultiStepForm CurrentStep="@currentStep" 
                     TotalSteps="3"
                     StepLabels="@stepLabels"
                     CanProceedToNext="@CanProceedToNextStep()"
                     CanSubmit="@CanSubmitForm()"
                     IsNavigationDisabled="@isBusy"
                     OnStepChanged="@OnStepChanged"
                     OnFinalSubmit="@OnFinalSubmit">

        @if (currentStep == 1)
        {
            <!-- Step 1: Basic Information -->
            <div class="step-content-wrapper">
                @if (pendingReceiptsLoading)
                {
                    <div class="form-card">
                        <div class="loading-state">
                            <i class="fa-solid fa-spinner fa-spin"></i>
                            <span>در حال بارگذاری رسیدهای تسهیم نشده...</span>
                        </div>
                    </div>
                }
                else if (pendingReceipts.Any())
                {
                    <div class="pending-receipts-section">
                        <div class="section-header">
                            <div class="header-content">
                                <i class="fa-solid fa-clock-rotate-left header-icon-inline"></i>
                                <span class="header-count">@pendingReceipts.Count رسید نیاز به تسهیم دارد</span>
                            </div>
                        </div>
                        
                        <div class="pending-receipts-grid">
                            @foreach (var pr in pendingReceipts)
                            {
                                <div class="pending-receipt-card">
                                    <div class="card-header">
                                        <span class="card-title">رسید تسهیم نشده - @GetHouseholdNameById(pr.TargetHouseholdId)</span>
                                        <button class="delete-btn-card" 
                                                @onclick="(() => RequestDeletePending(pr.HouseholdReceiptId))" 
                                                @onclick:stopPropagation="true"
                                                title="حذف رسید">
                                            <i class="fa-solid fa-times"></i>
                                        </button>
                                    </div>
                                    
                                    <div class="card-amount">
                                        <span class="amount-value">@pr.AmountTotal.ToString("N0", CultureInfo.InvariantCulture)</span>
                                        <span class="amount-unit">ریال</span>
                                    </div>
                                    
                                    <div class="card-description">
                                        <span class="description-text">تاریخ: @pr.CreatedAt.ToString("yyyy/MM/dd", new CultureInfo("fa-IR"))</span>
                                        @if (pr.Remaining > 0)
                                        {
                                            <span class="remaining-info">باقیمانده: @pr.Remaining.ToString("N0", CultureInfo.InvariantCulture) ریال</span>
                                        }
                                    </div>
                                    
                                    <div class="card-progress">
                                        @{
                                            var progressPercent = pr.AmountTotal > 0 ? ((pr.AmountTotal - pr.Remaining) * 100 / pr.AmountTotal) : 0;
                                        }
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: @(progressPercent)%"></div>
                                        </div>
                                        <span class="progress-text">@(progressPercent.ToString("F0"))% تسهیم شده</span>
                                    </div>
                                    
                                    <div class="card-actions">
                                        <button class="continue-btn" 
                                                @onclick="(() => ContinuePending(pr.HouseholdReceiptId))" 
                                                @onclick:stopPropagation="true" 
                                                disabled="@(pr.Remaining <= 0)"
                                                title="ادامه تسهیم">
                                            <i class="fa-solid fa-play"></i>
                                            <span>ادامه تسهیم</span>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- New Receipt Form -->
                <div class="form-card">
                    <div class="form-header">
                        <i class="fa-solid fa-plus"></i>
                        <h2>ثبت دریافت جدید</h2>
                    </div>
                    
                    <div class="form-body">
                        <div class="form-field">
                            <label class="field-label">خانوار مقصد</label>
                            <DsDropdown @bind-Value="selectedHouseholdIdStr" 
                                        Items="@householdDropdownItems" 
                                        Placeholder="انتخاب خانوار..." 
                                        Searchable="true" 
                                        SearchPlaceholder="جستجوی خانوار..." />
                        </div>

                        <div class="form-field">
                            <label class="field-label">نوع پرداخت‌کننده</label>
                            <select class="form-select" @bind="payerType">
                                <option value="1">سرپرست خانوار</option>
                                <option value="2">یکی از اعضا</option>
                                <option value="3">شخص ثالث</option>
                            </select>
                        </div>

                        @if (payerType == 2)
                        {
                            <div class="form-field">
                                <label class="field-label">عضو پرداخت‌کننده</label>
                                <select class="form-select" @bind="payerMemberId">
                                    <option value="">انتخاب عضو...</option>
                                    @foreach (var m in householdMembers)
                                    {
                                        <option value="@m.MemberId">@m.FirstName @m.LastName</option>
                                    }
                                </select>
                            </div>
                        }
                        else if (payerType == 3)
                        {
                            <div class="form-field">
                                <label class="field-label">نام شخص ثالث</label>
                                <input class="form-input" @bind="payerFullName" placeholder="نام کامل" />
                            </div>
                        }

                        <div class="form-row">
                            <div class="form-field amount-field">
                                <label class="field-label">مبلغ کل</label>
                                <DsMoneyInput Value="@AmountTotalString" ValueChanged="@((string v) => AmountTotalString = v)" Placeholder="مبلغ کل دریافت" Class="amount-input" />
                            </div>
                            <div class="form-field">
                                <label class="field-label">کانال پرداخت</label>
                                <select class="form-select" @bind="payChannel">
                                    <option value="3">بانک</option>
                                    <option value="4">بورس</option>
                                </select>
                            </div>
                            @if (payChannel == 3)
                            {
                                <div class="form-field">
                                    <label class="field-label">حساب تفضیلی (نقد و بانک)</label>
                                    <select class="form-select" @bind="selectedCashBankSubsidiaryId">
                                        <option value="">— انتخاب حساب تفضیلی نقد و بانک —</option>
                                        @foreach (var acc in cashBankSubsidiaries)
                                        {
                                            <option value="@acc.AccountId">@acc.Code - @acc.Name</option>
                                        }
                                    </select>
                                </div>
                            }
                            @if (payChannel == 4)
                            {
                                <div class="form-field">
                                    <label class="field-label">حساب تفضیلی (بورس)</label>
                                    <select class="form-select" @bind="selectedCashBankSubsidiaryId">
                                        <option value="">— انتخاب حساب تفضیلی بورس —</option>
                                        @foreach (var acc in stockSubsidiaries)
                                        {
                                            <option value="@acc.AccountId">@acc.Name (@acc.Code)</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        <div class="form-field">
                            <label class="field-label">توضیحات</label>
                            <textarea class="form-textarea" @bind="notes" placeholder="توضیحات اختیاری..." rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (currentStep == 2)
        {
            <!-- Step 2: Allocation -->
            <div class="step-content-wrapper">
                @if (step2Loading)
                {
                    <div class="loading-state">
                        <div class="loading-spinner"></div>
                        <p>در حال بارگذاری اطلاعات تسهیم...</p>
                    </div>
                }
                else
                {
                    <div class="summary-cards">
                        <div class="summary-card">
                            <div class="card-icon">
                                <i class="fa-solid fa-coins"></i>
                            </div>
                            <div class="card-content">
                                <span class="card-label">مبلغ کل</span>
                                <span class="card-value">@amountTotal.ToString("N0", CultureInfo.InvariantCulture) ریال</span>
                            </div>
                        </div>
                        <div class="summary-card">
                            <div class="card-icon">
                                <i class="fa-solid fa-chart-pie"></i>
                            </div>
                            <div class="card-content">
                                <span class="card-label">تخصیص یافته</span>
                                <span class="card-value allocated">@allocations.Sum(a => a.Amount).ToString("N0", CultureInfo.InvariantCulture) ریال</span>
                            </div>
                        </div>
                        <div class="summary-card remaining">
                            <div class="card-icon">
                                <i class="fa-solid fa-wallet"></i>
                            </div>
                            <div class="card-content">
                                <span class="card-label">باقیمانده</span>
                                <span class="card-value remaining">@((amountTotal - allocations.Sum(a => a.Amount)).ToString("N0", CultureInfo.InvariantCulture)) ریال</span>
                            </div>
                        </div>
                    </div>

                    <div class="items-grid @(allocations.Count == 1 ? "single-item" : "multi-items")">
                        @for (int i = 0; i < allocations.Count; i++)
                        {
                            var idx = i;
                            <div class="item-card allocation-item">
                                <div class="allocation-header">
                                    <div class="allocation-title-row">
                                        <h3 class="allocation-title">سطر @(idx + 1)</h3>
                                        <button class="btn-icon btn-delete" @onclick="(() => RemoveRow(idx))">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                    <div class="allocation-amounts-row">
                                        <span class="amount-allocated">@(string.IsNullOrEmpty(GetAllocMoneyString(idx, nameof(HouseholdReceiptAllocation.Amount))) ? "0" : GetAllocMoneyString(idx, nameof(HouseholdReceiptAllocation.Amount))) ریال</span>
                                    </div>
                                </div>
                                
                                <div class="item-details">
                                    <div class="form-field">
                                        <label class="field-label">عضو</label>
                                        <select class="form-select" value="@allocations[idx].MemberId" @onchange="(e => OnAllocMemberChanged(idx, e))">
                                            <option value="0">انتخاب عضو...</option>
                                            @foreach (var m in householdMembers)
                                            {
                                                <option value="@m.MemberId">@m.FirstName @m.LastName</option>
                                            }
                                        </select>
                                    </div>
                                    
                                    <div class="form-field">
                                        <label class="field-label">الگوی حسابداری</label>
                                        <select class="form-select" value="@(allocations[idx].PostingTemplateId?.ToString() ?? "")" @onchange="(e => OnPostingTemplateChanged(idx, e))">
                                            <option value="">انتخاب الگو...</option>
                                            @foreach (var template in postingTemplates)
                                            {
                                                <option value="@template.PostingTemplateId">@template.TemplateName</option>
                                            }
                                        </select>
                                        
                                        @* Template lines preview *@
                                        @if (allocations[idx].PostingTemplateId.HasValue)
                                        {
                                            var lines = GetTemplateLines(allocations[idx].PostingTemplateId);
                                            if (lines.Any())
                                            {
                                                <div class="mt-2 p-2 bg-light rounded template-lines-preview" style="font-size: 0.8em;">
                                                    @foreach (var line in lines)
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <span>@line.LineNo.ToString("D2"): @line.AccountCode - @line.AccountName - <span class="@GetSideClass(line.Side)">@(GetDisplayAmountForLine(idx))</span></span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                    
                                    
                                    <div class="form-field amount-field">
                                        <label class="field-label">مبلغ</label>
                                        <div class="remaining-amount-display" @onclick="(() => FillRemainingAmount(idx))">
                                            <span class="remaining-label">باقیمانده:</span>
                                            <span class="remaining-value">
                                                @{
                                                    var remaining = amountTotal - allocations.Sum(a => a.Amount);
                                                    var remainingClass = remaining == 0 ? "text-success" : (remaining > 0 ? "text-warning" : "text-danger");
                                                }
                                                <span class="remaining-number fw-bold @remainingClass">@remaining.ToString("N0", CultureInfo.InvariantCulture)</span>
                                                ریال
                                            </span>
                                        </div>
                                        <DsMoneyInput Class="amount-input"
                                                      Value="@GetAllocMoneyString(idx, nameof(HouseholdReceiptAllocation.Amount))"
                                                      ValueChanged="(v => OnAllocMoneyChangedWithValidation(idx, v))"
                                                      Placeholder="مبلغ را وارد کنید"
                                                      @oninput="@((ChangeEventArgs e) => OnAmountInputRealTime(idx, e))" />
                                    </div>

                                    <div class="form-field">
                                        <label class="field-label">بابت</label>
                                        <input class="form-control" type="text"
                                               placeholder="مثلاً بابت واریز سپرده / توضیح کوتاه"
                                               @bind="allocations[idx].Notes" />
                                    </div>
                                    
                                    @if (allocations[idx].PurposeType == 2)
                                    {
                                        <div class="info-note">
                                            <i class="fa-solid fa-info-circle"></i>
                                            <span>تفکیک اصل/سود/جریمه به صورت خودکار محاسبه می‌شود</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="add-row-inline">
                        <button class="btn btn-primary btn-add-row" @onclick="AddRow" disabled="@step2Loading">
                            <i class="fa-solid fa-plus me-2"></i>
                            افزودن سطر
                        </button>
                    </div>
                    
                    @if (allocations.Any())
                    {
                        <div class="allocation-summary-card">
                            <div class="summary-header">
                                <i class="fa-solid fa-list-check"></i>
                                <h3>خلاصه تسهیم واریزی</h3>
                            </div>
                            <div class="summary-content">
                                <!-- Desktop View -->
                                <div class="allocations-desktop-list">
                                    @for (int i = 0; i < allocations.Count; i++)
                                    {
                                        var a = allocations[i];
                                        var member = householdMembers.FirstOrDefault(m => m.MemberId == a.MemberId);
                                        var templateText = GetPostingTemplateText(a.PostingTemplateId);
                                        <div class="summary-row">
                                            <span class="row-index">سطر @(i + 1)</span>
                                            <span class="member-name">@(member?.FirstName) @(member?.LastName)</span>
                                            <span class="purpose-text">@templateText</span>
                                            @if (!string.IsNullOrWhiteSpace(a.Notes))
                                            {
                                                <span class="note-chip">@a.Notes</span>
                                            }
                                            <span class="amount-text">@a.Amount.ToString("N0", CultureInfo.InvariantCulture) ریال</span>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Mobile View -->
                                <div class="allocations-mobile-list">
                                    @for (int i = 0; i < allocations.Count; i++)
                                    {
                                        var a = allocations[i];
                                        var member = householdMembers.FirstOrDefault(m => m.MemberId == a.MemberId);
                                        var templateText = GetPostingTemplateText(a.PostingTemplateId);
                                        <div class="allocation-mobile-item">
                                            <div class="allocation-mobile-header">
                                                <div class="member-info-mobile">
                                                    <span class="member-index">@(i + 1)</span>
                                                    <span class="member-name-mobile">@(member?.FirstName) @(member?.LastName)</span>
                                                </div>
                                                <div class="amount-mobile">@a.Amount.ToString("N0", CultureInfo.InvariantCulture) ریال</div>
                                            </div>
                                            <div class="allocation-mobile-details">
                                                <span class="purpose-mobile">@templateText</span>
                                                @if (!string.IsNullOrWhiteSpace(a.Notes))
                                                {
                                                    <span class="note-mobile">@a.Notes</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (currentStep == 3)
        {
            <!-- Step 3: Final Confirmation -->
            <div class="step-content-wrapper">
                <div class="confirmation-card">
                    <div class="confirmation-header">
                        <i class="fa-solid fa-check-circle"></i>
                        <h2>تایید نهایی و ثبت رسید</h2>
                        <p>لطفاً اطلاعات زیر را بررسی کرده و در صورت صحت، تایید نهایی کنید</p>
                    </div>

                    <div class="confirmation-summary">
                        <div class="summary-section">
                            <h3><i class="fa-solid fa-info-circle"></i> اطلاعات پایه</h3>
                            <div class="info-grid">
                                <div class="info-item">
                                    <span class="label">خانوار:</span>
                                    <span class="value">@GetSelectedHouseholdName()</span>
                                </div>
                                <div class="info-item">
                                    <span class="label">مبلغ کل:</span>
                                    <span class="value amount">@amountTotal.ToString("N0", CultureInfo.InvariantCulture) ریال</span>
                                </div>
                                <div class="info-item">
                                    <span class="label">کانال پرداخت:</span>
                                    <span class="value">@GetPayChannelText()</span>
                                </div>
                                <div class="info-item">
                                    <span class="label">پرداخت‌کننده:</span>
                                    <span class="value">@GetPayerText()</span>
                                </div>
                            </div>
                        </div>

                        <div class="summary-section">
                            <h3><i class="fa-solid fa-chart-pie"></i> خلاصه تسهیم واریزی</h3>
                            <div class="allocations-summary">
                                @foreach (var allocation in allocations)
                                {
                                    var member = householdMembers.FirstOrDefault(m => m.MemberId == allocation.MemberId);
                                    <div class="allocation-summary-row">
                                        <div class="member-info">
                                            <span class="member-name">@member?.FirstName @member?.LastName</span>
                                            <span class="purpose-badge">@GetPostingTemplateText(allocation.PostingTemplateId)</span>
                                        </div>
                                        <div class="amount-info">
                                            <span class="amount">@allocation.Amount.ToString("N0", CultureInfo.InvariantCulture) ریال</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="balance-check">
                            @{
                                var totalAllocated = allocations.Sum(a => a.Amount);
                                var remaining = amountTotal - totalAllocated;
                            }
                            @if (remaining == 0)
                            {
                                <div class="balance-success">
                                    <i class="fa-solid fa-check-circle"></i>
                                    <span>تسهیم کامل - آماده ثبت</span>
                                </div>
                            }
                            else
                            {
                                <div class="balance-warning">
                                    <i class="fa-solid fa-exclamation-triangle"></i>
                                    <span>باقیمانده: @remaining.ToString("N0", CultureInfo.InvariantCulture) ریال</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

    </DsMultiStepForm>
</div>

@* Amount exceeds remaining warning dialog *@
<DsConfirm
  Show="@showAmountExceedsWarning"
  Title="هشدار مبلغ بیش از حد"
  Variant="warning"
  ConfirmText="متوجه شدم"
  CancelText=""
  StackButtons="false"
  ShowWarning="true"
  Message="مبلغ وارد شده از مبلغ باقیمانده بیشتر است. مبلغ پاک شد."
  OnConfirm="@OnCloseAmountExceedsWarning"
  OnCancel="@OnCloseAmountExceedsWarning" />

@* Delete receipt confirmation dialog *@
<DsConfirm
  Show="@showDeleteConfirmDialog"
  Title="تایید حذف رسید"
  Variant="danger"
  ConfirmText="حذف کن"
  CancelText="انصراف"
  StackButtons="false"
  ShowWarning="true"
  Message="آیا از حذف این رسید اطمینان دارید؟ این عمل قابل بازگشت نیست."
  OnConfirm="@ConfirmDeleteReceipt"
  OnCancel="@CancelDeleteReceipt" />

@code {
    private int currentStep = 1;
    private bool isBusy = false;
    private bool step2Loading = false;
    private bool pendingReceiptsLoading = true;

    private List<string> stepLabels = new()
    {
        "اطلاعات پایه",
        "تسهیم مبلغ", 
        "تایید نهایی"
    };

    // All the existing fields and properties from the original wizard
    private List<PendingReceiptSummary> pendingReceipts = new();
    private long? expandedReceiptId = null;
    private List<DsDropdown.DsDropdownItem> householdDropdownItems = new();
    private string selectedHouseholdIdStr = "";
    private int payerType = 1;
    private long? payerMemberId = null;
    private string payerFullName = "";
    private decimal amountTotal = 0;
    private int payChannel = 3;
    private long? selectedBankAccountId = null;
    private string notes = "";
    private List<Member> householdMembers = new();
    private List<HouseholdReceiptAllocation> allocations = new();
    private List<PostingTemplate> postingTemplates = new();
    private List<BankAccount> bankAccounts = new();
    private List<Account> cashBankSubsidiaries = new();
    private List<Account> stockSubsidiaries = new();
    private long? selectedCashBankSubsidiaryId = null;
    private long? currentReceiptId = null;
    private bool isNewlyCreatedReceipt = false;
    
    // Warning dialog state
    private bool showAmountExceedsWarning = false;
    
    // Delete confirmation dialog state
    private bool showDeleteConfirmDialog = false;
    private long receiptIdToDelete = 0;
    
    // Template lines cache for preview
    private Dictionary<int, List<PostingTemplateLine>> templateLinesCache = new();
    
    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        try
        {
            Console.WriteLine("=== LoadInitialData Started ===");
            
            // Load all initial data including pending receipts
            Console.WriteLine("Loading pending receipts...");
            await LoadPendingReceipts();
            
            Console.WriteLine("Loading households...");
            await LoadHouseholds();
            
            Console.WriteLine("Loading posting templates...");
            await LoadPostingTemplates();
            
            Console.WriteLine("Loading cash/bank subsidiary accounts (under Moeen 11)...");
            await LoadCashBankSubsidiaries();
            
            Console.WriteLine("Loading stock subsidiary accounts (under Moeen 12)...");
            await LoadStockSubsidiaries();
            
            Console.WriteLine("=== LoadInitialData Completed Successfully ===");
