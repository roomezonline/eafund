    private async Task CreateReceipt()
    {
        try
        {
            Console.WriteLine("=== CreateReceipt Started ===");
            
            if (string.IsNullOrEmpty(selectedHouseholdIdStr) || !long.TryParse(selectedHouseholdIdStr, out var householdId))
            {
                Console.WriteLine("ERROR: Invalid household selection");
                Toast.Error("لطفاً خانوار مقصد را انتخاب کنید");
                return;
            }

            if (amountTotal <= 0)
            {
                Console.WriteLine($"ERROR: Invalid amount: {amountTotal}");
                Toast.Error("لطفاً مبلغ معتبر وارد کنید");
                return;
            }

            var receipt = new
            {
                TargetHouseholdId = householdId,
                PayerType = payerType,
                PayerMemberId = payerMemberId,
                PayerFullName = payerFullName,
                AmountTotal = amountTotal,
                PayChannel = payChannel,
                BankAccountId = selectedBankAccountId,
                SubsidiaryAccountId = selectedCashBankSubsidiaryId,
                Notes = notes,
                OccurredAt = DateTime.Now
            };

            Console.WriteLine($"Sending receipt data: {System.Text.Json.JsonSerializer.Serialize(receipt)}");
            
            var response = await Http.PostAsJsonAsync("/api/receipts/household", receipt);
            
            Console.WriteLine($"Response Status: {response.StatusCode}");
            Console.WriteLine($"Response Headers: {string.Join(", ", response.Headers.Select(h => $"{h.Key}: {string.Join(",", h.Value)}"))}");
            
            var responseContent = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Response Content: {responseContent}");
            
            if (response.IsSuccessStatusCode)
            {
                if (string.IsNullOrWhiteSpace(responseContent))
                {
                    Console.WriteLine("ERROR: Empty response from server");
                    Toast.Error("خطا: پاسخ خالی از سرور");
                    return;
                }
                
                try
                {
                    var result = System.Text.Json.JsonSerializer.Deserialize<JsonElement>(responseContent);
                    Console.WriteLine($"Parsed JSON: {result}");
                    
                    if (result.TryGetProperty("householdReceiptId", out var receiptIdProperty))
                    {
                        currentReceiptId = receiptIdProperty.GetInt64();
                        isNewlyCreatedReceipt = true;
                        Console.WriteLine($"Receipt created successfully with ID: {currentReceiptId}");
                        
                        // Load household members for allocation
                        await LoadHouseholdMembers(householdId);
                        
                        // Initialize with one allocation row
                        allocations.Clear();
                        AddRow();
                        
                        Toast.Success("رسید با موفقیت ثبت شد");
                    }
                    else
                    {
                        Console.WriteLine("ERROR: receiptId not found in response");
                        Toast.Error("خطا: شناسه رسید در پاسخ یافت نشد");
                    }
                }
                catch (Exception jsonEx)
                {
                    Console.WriteLine($"ERROR: JSON parsing failed: {jsonEx.Message}");
                    Console.WriteLine($"JSON Exception Stack: {jsonEx.StackTrace}");
                    Toast.Error($"خطا در پردازش پاسخ سرور: {jsonEx.Message}");
                }
            }
            else
            {
                Console.WriteLine($"ERROR: HTTP {response.StatusCode} - {responseContent}");
                Toast.Error($"خطا در ثبت رسید ({response.StatusCode}): {responseContent}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"FATAL ERROR in CreateReceipt: {ex.Message}");
            Console.WriteLine($"Exception Type: {ex.GetType().Name}");
            Console.WriteLine($"Stack Trace: {ex.StackTrace}");
            if (ex.InnerException != null)
            {
                Console.WriteLine($"Inner Exception: {ex.InnerException.Message}");
                Console.WriteLine($"Inner Stack: {ex.InnerException.StackTrace}");
            }
            Toast.Error($"خطای سیستمی: {ex.Message}");
        }
        finally
        {
            Console.WriteLine("=== CreateReceipt Finished ===");
        }
    }

