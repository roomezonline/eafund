    private async Task LoadCashBankSubsidiaries()
    {
        try
        {
            // Load full hierarchy so we can filter by parent Moeen (Level=3)
            var accounts = (await AccountRepo.GetAllWithHierarchyAsync()).ToList();

            // Find Moeen accounts that represent Cash/Bank (code starts with "11" only)
            var moeenCashBank = accounts.Where(a => a.IsActive
                                                    && (a.Level == 3)
                                                    && (!string.IsNullOrWhiteSpace(a.Code) && a.Code.Trim().StartsWith("11")))
                                           .ToList();

            var subs = new List<Account>();
            foreach (var m in moeenCashBank)
            {
                var children = m.Children.Where(c => c.IsActive && (c.Level == 4 || c.Level == 0)).ToList();
                subs.AddRange(children);
            }

            cashBankSubsidiaries = subs
                .GroupBy(x => x.AccountId)
                .Select(g => g.First())
                .OrderBy(x => x.Code)
                .ThenBy(x => x.Name)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR LoadCashBankSubsidiaries: {ex.Message}");
            Toast.Error($"خطا در بارگذاری حساب‌های تفضیلی نقد و بانک: {ex.Message}");
            cashBankSubsidiaries = new();
        }
    }

    private async Task LoadStockSubsidiaries()
    {
