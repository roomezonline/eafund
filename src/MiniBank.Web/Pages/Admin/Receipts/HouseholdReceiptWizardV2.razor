    /// <summary>
    /// تبدیل خطاهای فنی به پیام‌های کاربرپسند
    /// </summary>
    private string GetUserFriendlyErrorMessage(Exception ex)
    {
        return ex switch
        {
            HttpRequestException httpEx when httpEx.Message.Contains("404") => 
                "اطلاعات مورد نظر یافت نشد. لطفاً صفحه را بازخوانی کنید.",
            
            HttpRequestException httpEx when httpEx.Message.Contains("500") => 
                "خطای داخلی سرور. لطفاً با پشتیبانی تماس بگیرید.",
            
            HttpRequestException httpEx when httpEx.Message.Contains("timeout") => 
                "عملیات بیش از حد طولانی شد. لطفاً دوباره تلاش کنید.",
            
            TaskCanceledException => 
                "عملیات لغو شد یا بیش از حد طولانی شد.",
            
            JsonException => 
                "خطا در پردازش اطلاعات دریافتی از سرور.",
            
            ArgumentException => 
                "اطلاعات وارد شده نامعتبر است. لطفاً مقادیر صحیح وارد کنید.",
            
            InvalidOperationException => 
                "عملیات غیرمجاز. لطفاً مراحل را به ترتیب انجام دهید.",
            
            UnauthorizedAccessException => 
                "شما مجوز انجام این عملیات را ندارید.",
            
            _ => "خطای غیرمنتظره رخ داد. لطفاً با پشتیبانی تماس بگیرید."
        };
    }

    private string GetDisplayAmountForLine(int allocationIndex)
    {
        if (allocationIndex < 0 || allocationIndex >= allocations.Count)
            return "مبلغ";
            
        var allocation = allocations[allocationIndex];
        if (allocation.Amount <= 0)
            return "مبلغ";
            
        return allocation.Amount.ToString("N0", CultureInfo.InvariantCulture);
    }
}
