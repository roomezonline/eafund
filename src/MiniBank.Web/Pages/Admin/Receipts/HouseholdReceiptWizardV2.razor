        catch (Exception ex)
        {
            Console.WriteLine($"ERROR in LoadInitialData: {ex.Message}");
            Console.WriteLine($"Exception Type: {ex.GetType().Name}");
            Console.WriteLine($"Stack Trace: {ex.StackTrace}");
            Toast.Error($"خطا در بارگذاری اطلاعات: {ex.Message}");
        }
        finally
        {
            pendingReceiptsLoading = false;
            StateHasChanged();
        }
    }

    private bool CanProceedToNextStep()
    {
        return currentStep switch
        {
            1 => !string.IsNullOrEmpty(selectedHouseholdIdStr) && 
                 amountTotal > 0 && 
                 (payerType != 2 || payerMemberId.HasValue) && 
                 (payerType != 3 || !string.IsNullOrEmpty(payerFullName)) &&
                 // Require selecting subsidiary account (bank account no longer required at this step)
                 (selectedCashBankSubsidiaryId.HasValue && selectedCashBankSubsidiaryId.Value > 0),
            2 => allocations.Any() && 
                 allocations.All(a => a.Amount > 0 && a.PostingTemplateId.HasValue && a.MemberId > 0),
            _ => false
        };
    }

    private bool CanSubmitForm()
    {
        return currentStep == 3 && 
               allocations.Any() && 
               allocations.Sum(a => a.Amount) == amountTotal;
    }

    private async Task OnStepChanged(int newStep)
    {
        if (newStep == 2 && currentStep == 1)
        {
            // Moving from Step 1 to Step 2
            // Guard: if a receipt already exists (user went back and forward), do NOT create again
            if (currentReceiptId.HasValue && currentReceiptId.Value > 0)
            {
                currentStep = 2;
                return;
            }

            await CreateReceiptAndProceedToStep2();
        }
        else if (newStep == 1 && currentStep == 2)
        {
            // User is going back from Step 2 to Step 1
            // If this receipt was newly created in this session (not a continued pending one), delete it
            if (isNewlyCreatedReceipt && currentReceiptId.HasValue && currentReceiptId.Value > 0)
            {
                try
                {
                    await ReceiptRepo.DeleteAsync(currentReceiptId.Value);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Failed to delete newly created receipt {currentReceiptId}: {ex.Message}");
                }
                finally
                {
                    // Reset state so that re-entering Step 2 will create a clean new receipt
                    currentReceiptId = null;
                    allocations.Clear();
                    isNewlyCreatedReceipt = false;
                }
            }

            currentStep = 1;
        }
        else
        {
            currentStep = newStep;
        }
    }

    private async Task CreateReceiptAndProceedToStep2()
    {
        try
        {
            isBusy = true;
            await CreateReceipt();
            currentStep = 2;
