    private decimal GetRemainingAmountForRow(int index)
    {
        var totalAllocatedOthers = allocations.Where((a, i) => i != index).Sum(a => a.Amount);
        return amountTotal - totalAllocatedOthers;
    }

    private void FillRemainingAmount(int index)
    {
        if (index >= 0 && index < allocations.Count)
        {
            allocations[index].Amount = GetRemainingAmountForRow(index);
        }
    }

    private void OnAmountInputRealTime(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= allocations.Count) return;
        
        var inputValue = e?.Value?.ToString() ?? string.Empty;
        var amount = ParseMoney(inputValue);
        
        // Calculate remaining amount for this specific row BEFORE updating
        var totalAllocatedOthers = allocations.Where((a, i) => i != index).Sum(a => a.Amount);
        var remainingForThisRow = amountTotal - totalAllocatedOthers;
        
        // Check if typed amount exceeds remaining amount
        if (amount > remainingForThisRow)
        {
            // Show warning and clear the amount
            showAmountExceedsWarning = true;
            allocations[index].Amount = 0;
        }
        else
        {
            // Update the amount for live calculation
            allocations[index].Amount = amount;
        }
        
        // Force UI update to show live remaining amounts in all cards and individual rows
        StateHasChanged();
    }

    private static decimal ParseMoney(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return 0m;
        var digits = new string(s.Where(char.IsDigit).ToArray());
        if (string.IsNullOrEmpty(digits)) return 0m;
        if (decimal.TryParse(digits, NumberStyles.None, CultureInfo.InvariantCulture, out var d))
            return d;
        return 0m;
    }

