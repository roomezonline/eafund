    private async Task ContinuePending(long receiptId)
    {
        currentReceiptId = receiptId;
        var receipt = pendingReceipts.FirstOrDefault(r => r.HouseholdReceiptId == receiptId);
        if (receipt != null)
        {
            isNewlyCreatedReceipt = false; // continuing existing receipt, do not delete on back
            selectedHouseholdIdStr = receipt.TargetHouseholdId.ToString();
            amountTotal = receipt.AmountTotal;
            // AmountTotalString = amountTotal.ToString("N0", CultureInfo.InvariantCulture);
            
            await LoadHouseholdMembers(receipt.TargetHouseholdId);
            
            // Load existing allocations
            var response = await Http.GetAsync($"/api/receipts/{receiptId}/allocations");
            if (response.IsSuccessStatusCode)
            {
                allocations = await response.Content.ReadFromJsonAsync<List<HouseholdReceiptAllocation>>() ?? new();
            }
            
            currentStep = 2;
        }
    }

