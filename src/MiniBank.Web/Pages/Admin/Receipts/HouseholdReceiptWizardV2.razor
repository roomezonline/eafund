    private async Task SaveAndProcessAllocations()
    {
        if (!currentReceiptId.HasValue || currentReceiptId <= 0)
        {
            Toast.Error("شناسه رسید معتبر نیست");
            return;
        }

        var sum = allocations.Sum(a => a.Amount);
        if (sum != amountTotal)
        {
            Toast.Error("جمع خلاصه تسهمی واریزی باید دقیقاً برابر مبلغ کل باشد");
            return;
        }

        try
        {
            // Save allocations
            var saveResponse = await Http.PostAsJsonAsync($"/api/receipts/{currentReceiptId}/allocations", allocations);
            if (!saveResponse.IsSuccessStatusCode)
            {
                var error = await saveResponse.Content.ReadAsStringAsync();
                Toast.Error($"خطا در ثبت تسهیم: {error}");
                return;
            }

            // Process allocations
            var processResponse = await Http.PostAsync($"/api/receipts/{currentReceiptId}/process", null);
            if (processResponse.IsSuccessStatusCode)
            {
                Toast.Success("رسید با موفقیت ثبت و پردازش شد");
                
                // Reset form
                currentStep = 1;
                allocations.Clear();
                currentReceiptId = null;
                selectedHouseholdIdStr = "";
                amountTotal = 0;
                AmountTotalString = "";
                notes = "";
                isNewlyCreatedReceipt = false;
                
                await LoadPendingReceipts();
            }
            else
            {
                var error = await processResponse.Content.ReadAsStringAsync();
                Toast.Error($"خطا در پردازش تسهیم: {error}");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در ثبت نهایی: {ex.Message}");
            throw;
        }
    }

