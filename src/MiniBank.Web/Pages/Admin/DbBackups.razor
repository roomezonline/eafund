    private List<DbBackupRun> ApplyHistoryFilters(List<DbBackupRun> runs)
    {
        IEnumerable<DbBackupRun> q = runs;

        var st = (_historyStatusFilter ?? "all").Trim().ToLowerInvariant();
        if (st != "all" && st.Length > 0)
        {
            q = q.Where(r => string.Equals((r.Status ?? string.Empty).Trim(), st, StringComparison.OrdinalIgnoreCase));
        }

        var s = (_historySearch ?? string.Empty).Trim();
        if (s.Length > 0)
        {
            q = q.Where(r =>
                (r.Status ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)
                || ToFaStatus(r.Status).Contains(s, StringComparison.OrdinalIgnoreCase)
                || (r.BackupFilePath ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)
                || (r.ErrorMessage ?? string.Empty).Contains(s, StringComparison.OrdinalIgnoreCase)
                || r.RunId.ToString().Contains(s, StringComparison.OrdinalIgnoreCase));
        }

        q = (_historySort ?? "new") switch
        {
            "old" => q.OrderBy(r => r.CreatedAtUtc),
            "status" => q.OrderBy(r => r.Status).ThenByDescending(r => r.CreatedAtUtc),
            "size" => q.OrderByDescending(r => r.BackupFileSizeBytes ?? -1).ThenByDescending(r => r.CreatedAtUtc),
            _ => q.OrderByDescending(r => r.CreatedAtUtc)
        };

        return q.ToList();
    }

    private static string FormatServerTime(DateTime utc)
    {
        try
        {
            return utc.ToString("yyyy-MM-dd HH:mm");
        }
        catch
        {
            return utc.ToString("yyyy-MM-dd HH:mm");
        }
    }

    private static string FormatServerTimeNullable(DateTime? utc)
    {
        if (!utc.HasValue) return "-";
        return FormatServerTime(utc.Value);
    }

    private static string ToFaStatus(string? status)
    {
        var s = (status ?? string.Empty).Trim().ToLowerInvariant();
        return s switch
        {
            "success" => "موفق",
            "failed" => "ناموفق",
            "running" => "در حال اجرا",
            "" => "-",
            _ => status ?? "-"
        };
    }

    private List<DbBackupRun> ApplyPaging(List<DbBackupRun> runs)
    {
        var totalPages = Math.Max(1, (int)Math.Ceiling((double)runs.Count / Math.Max(1, _historyPageSize)));
        var maxPage = totalPages - 1;
        if (_historyPage > maxPage) _historyPage = maxPage;
        if (_historyPage < 0) _historyPage = 0;

        return runs
            .Skip(_historyPage * _historyPageSize)
            .Take(_historyPageSize)
            .ToList();
    }

    private string GetStatusChipClass(string? status)
    {
        var s = (status ?? string.Empty).Trim().ToLowerInvariant();
        if (s == "success") return "success";
        if (s == "failed") return "failed";
        if (s == "running") return "running";
        return "other";
    }

