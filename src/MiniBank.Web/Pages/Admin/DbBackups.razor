@page "/admin/db-backups"
@using MiniBank.Web.Components.DesignSystem
@using MiniBank.Web.Models.Admin
@inject DsToastService Toasts
@inject MiniBank.Web.Services.DbBackupService BackupService

<PageTitle>پشتیبان‌گیری دیتابیس</PageTitle>

<DsPageHeader Title="پشتیبان‌گیری دیتابیس"
             Icon="fa-solid fa-database"
             Subtitle="تنظیمات، اجرای دستی، زمان‌بندی روزانه و تاریخچه"
             ShowBackButton="true" />

<section class="page" dir="rtl">
    <div class="dbb-card">
        <div class="dbb-title">تنظیمات</div>

        @if (_loading)
        {
            <div>در حال بارگذاری...</div>
        }
        else
        {
            <div class="dbb-grid">
                <div class="dbb-field">
                    <DsToggle Label="فعال بودن بکاپ روزانه" Description="" Icon="fa-solid fa-toggle-on" Value="_settings.IsEnabled" ValueChanged="OnEnabledChanged" />
                    <div class="dbb-help">اگر روشن باشد، روزانه در ساعت مشخص شده بکاپ گرفته می‌شود.</div>
                </div>

                <div class="dbb-section">اطلاعات و زمان‌بندی</div>

                <div class="dbb-grid-2">
                    <div class="dbb-field">
                        <label class="dbb-label">نام دیتابیس</label>
                        <input class="dbb-input" value="@_settings.DatabaseName" @oninput="OnDbNameChanged" placeholder="foodir_EmamAli_minibank" />
                        <div class="dbb-help">اگر خالی بگذارید، از کانکشن‌استرینگ سیستم خوانده می‌شود.</div>
                    </div>

                    <div class="dbb-field">
                        <label class="dbb-label">دوره اجرا</label>
                        <select class="dbb-input" style="direction:rtl;" value="@_frequencyText" @onchange="OnFrequencyChanged">
                            <option value="daily">روزانه</option>
                            <option value="weekly">هفتگی</option>
                            <option value="monthly">ماهانه</option>
                        </select>
                        <div class="dbb-help">انتخاب کنید بکاپ هر روز، هر هفته یا هر ماه اجرا شود.</div>
                    </div>
                </div>

                <div class="dbb-grid-2">
                    <div class="dbb-field">
                        <label class="dbb-label">زمان اجرا (Local)</label>
                        <input class="dbb-input" value="@_runAtTimeText" @oninput="OnRunAtTimeChanged" placeholder="02:00" />
                        <div class="dbb-help">فرمت HH:mm (مثلاً 02:00). طبق ساعت سرور اجرا می‌شود.</div>
                    </div>

                    @if (_settings.Frequency == DbBackupFrequency.Weekly)
                    {
                        <div class="dbb-field">
                            <label class="dbb-label">روز هفته</label>
                            <select class="dbb-input" style="direction:rtl;" value="@_runOnDayOfWeekText" @onchange="OnRunOnDayOfWeekChanged">
                                <option value="">(انتخاب نشده)</option>
                                <option value="0">یکشنبه</option>
                                <option value="1">دوشنبه</option>
                                <option value="2">سه‌شنبه</option>
                                <option value="3">چهارشنبه</option>
                                <option value="4">پنجشنبه</option>
                                <option value="5">جمعه</option>
                                <option value="6">شنبه</option>
                            </select>
                            <div class="dbb-help">اگر انتخاب نشود، اولین اجرای بعد از ساعت تعیین شده انجام می‌شود.</div>
                        </div>
                    }
                    else if (_settings.Frequency == DbBackupFrequency.Monthly)
                    {
                        <div class="dbb-field">
                            <label class="dbb-label">روز ماه</label>
                            <input class="dbb-input" value="@_runOnDayOfMonthText" @oninput="OnRunOnDayOfMonthChanged" placeholder="1" />
                            <div class="dbb-help">عدد بین 1 تا 28 (برای جلوگیری از مشکل ماه‌های کوتاه).</div>
                        </div>
                    }
                </div>

                <div class="dbb-section">مسیر و نگهداری</div>

                <div class="dbb-grid-2">
                    <div class="dbb-field">
                        <label class="dbb-label">مسیر پوشه بکاپ روی سرور</label>
                        <input class="dbb-input" value="@_settings.BackupDirectory" @oninput="OnBackupDirChanged" placeholder="D:\\DbBackups\\MiniBank" />
                        <div class="dbb-help">این مسیر باید از دید SQL Server قابل نوشتن باشد (نه صرفاً وب‌سایت).</div>
                    </div>

                    <div class="dbb-field">
                        <label class="dbb-label">نگهداری فایل‌ها</label>
                        <input class="dbb-input" value="2" disabled />
                        <div class="dbb-help">همیشه فقط ۲ بکاپ آخر نگهداری می‌شود.</div>
                    </div>
                </div>

                <div class="dbb-field">
                    <label class="dbb-label">ایمیل‌های گزارش (CSV)</label>
                    <input class="dbb-input" value="@_settings.NotifyEmailsCsv" @oninput="OnEmailsChanged" placeholder="a@gmail.com,b@gmail.com" />
                    <div class="dbb-help">چند ایمیل را با کاما جدا کنید؛ در صورت خالی بودن، ایمیل ارسال نمی‌شود.</div>
                </div>

                <div class="dbb-section">تنظیمات SMTP</div>

                <div class="dbb-grid-2">
                    <div class="dbb-field">
                        <label class="dbb-label">SMTP Host</label>
                        <input class="dbb-input" value="@_settings.SmtpHost" @oninput="OnSmtpHostChanged" placeholder="smtp.gmail.com" />
                        <div class="dbb-help">برای Gmail معمولاً smtp.gmail.com است.</div>
                    </div>
                    <div class="dbb-field">
                        <label class="dbb-label">SMTP Port</label>
                        <input class="dbb-input" value="@_smtpPortText" @oninput="OnSmtpPortChanged" placeholder="587" />
                        <div class="dbb-help">برای Gmail: 587 (TLS) یا 465 (SSL).</div>
                    </div>
                </div>

                <div class="dbb-grid-2">
                    <div class="dbb-field">
                        <label class="dbb-label">SMTP Username</label>
                        <input class="dbb-input" value="@_settings.SmtpUsername" @oninput="OnSmtpUserChanged" placeholder="clickpardazesh@gmail.com" />
                        <div class="dbb-help">نام کاربری ایمیلی که از آن ارسال می‌شود.</div>
                    </div>
                    <div class="dbb-field">
                        <label class="dbb-label">SMTP From</label>
                        <input class="dbb-input" value="@_settings.SmtpFrom" @oninput="OnSmtpFromChanged" placeholder="clickpardazesh@gmail.com" />
                        <div class="dbb-help">آدرس فرستنده (معمولاً همان Username).</div>
                    </div>
                </div>

                <div class="dbb-field">
                    <label class="dbb-label">SMTP Password (App Password)</label>
                    <input class="dbb-input" value="@_settings.SmtpPassword" @oninput="OnSmtpPassChanged" type="password" />
                    <div class="dbb-help">برای Gmail باید App Password بسازید (نه رمز اصلی Gmail).</div>
                </div>

                <div class="dbb-actions">
                    <button class="dbb-btn dbb-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "در حال ذخیره..." : "ذخیره تنظیمات")</button>
                    <button class="dbb-btn dbb-btn-success" @onclick="RunNowAsync" disabled="@_running">@(_running ? "در حال بکاپ..." : "اجرای بکاپ دستی")</button>
                    <button class="dbb-btn dbb-btn-ghost" @onclick="TestAccessAsync" disabled="@_testing">@(_testing ? "در حال تست..." : "تست دسترسی مسیر بکاپ")</button>
                </div>
            </div>
        }
    </div>

    <div class="dbb-card" style="margin-top:12px;">
        <div class="dbb-history-head">
            <div>
                <div class="dbb-title" style="margin:0;">تاریخچه بکاپ‌ها</div>
                <div class="dbb-help">@(_runs.Count) مورد</div>
            </div>
            <div class="dbb-history-actions">
                <input class="dbb-input" style="height:36px;" placeholder="جستجو (وضعیت/مسیر/خطا...)" value="@_historySearch" @oninput="OnHistorySearchChanged" />
                <select class="dbb-input" style="height:36px; direction:rtl;" value="@_historySort" @onchange="OnHistorySortChanged">
                    <option value="new">جدیدترین</option>
                    <option value="old">قدیمی‌ترین</option>
                    <option value="status">وضعیت</option>
                    <option value="size">حجم</option>
                </select>
                <button class="dbb-btn dbb-btn-ghost" style="height:36px;" @onclick="ReloadRunsAsync" disabled="@_loadingRuns">به‌روزرسانی</button>
            </div>
        </div>

        <div class="dbb-filterbar">
            <button class="dbb-chip-btn @(_historyStatusFilter == "all" ? "is-active" : "")" @onclick="SetHistoryStatusFilterAll">همه</button>
            <button class="dbb-chip-btn @(_historyStatusFilter == "success" ? "is-active" : "")" @onclick="SetHistoryStatusFilterSuccess">موفق</button>
            <button class="dbb-chip-btn @(_historyStatusFilter == "failed" ? "is-active" : "")" @onclick="SetHistoryStatusFilterFailed">ناموفق</button>
            <button class="dbb-chip-btn @(_historyStatusFilter == "running" ? "is-active" : "")" @onclick="SetHistoryStatusFilterRunning">درحال اجرا</button>
        </div>

        @if (_loadingRuns)
        {
            <div style="margin-top:10px;">در حال بارگذاری...</div>
        }
        else if (FilteredRuns.Count == 0)
        {
            <div style="margin-top:10px; font-size:12px; opacity:.75;">موردی ثبت نشده است.</div>
        }
        else
        {
            <div class="dbb-list">
                @foreach (var r in PagedRuns)
                {
                    <details class="dbb-run" open="@(_expandedRunId == r.RunId)">
                        <summary class="dbb-run-summary" @onclick="() => ToggleRunExpanded(r.RunId)">
                            <div class="dbb-run-summary-left">
                                <div class="dbb-run-title">Run #@r.RunId</div>
                                <div class="dbb-chip dbb-chip-@GetStatusChipClass(r.Status)">@ToFaStatus(r.Status)</div>
                            </div>
                            <div class="dbb-run-summary-right">
                                <div class="dbb-help" style="direction:ltr;">@FormatServerTime(r.StartedAtUtc)</div>
                                <div class="dbb-run-size">@(r.BackupFileSizeBytes.HasValue ? r.BackupFileSizeBytes.Value.ToString("N0") : "-")</div>
                            </div>
                        </summary>

                        <div class="dbb-run-body">
                            <div class="dbb-run-grid">
                                <div>
                                    <div class="dbb-label">شروع</div>
                                    <div class="dbb-help" style="direction:ltr;">@FormatServerTime(r.StartedAtUtc)</div>
                                </div>
                                <div>
                                    <div class="dbb-label">پایان</div>
                                    <div class="dbb-help" style="direction:ltr;">@FormatServerTimeNullable(r.FinishedAtUtc)</div>
                                </div>
                                <div>
                                    <div class="dbb-label">حجم</div>
                                    <div class="dbb-help" style="direction:ltr;">@(r.BackupFileSizeBytes.HasValue ? r.BackupFileSizeBytes.Value.ToString("N0") : "-")</div>
                                </div>
                                <div>
                                    <div class="dbb-label">فایل</div>
                                </div>
                                    <div class="dbb-help dbb-path" style="direction:ltr;">@(string.IsNullOrWhiteSpace(r.BackupFilePath) ? "-" : r.BackupFilePath)</div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(r.ErrorMessage))
                            {
                                <div class="dbb-error" style="margin-top:8px; white-space:pre-wrap;">@r.ErrorMessage</div>
                            }

                            <div class="dbb-run-actions">
                                @if (!string.IsNullOrWhiteSpace(r.BackupFilePath))
                                {
                                    <a class="dbb-btn dbb-btn-ghost" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:8px;" href="/api/admin/db-backups/@r.RunId/download" target="_blank">
                                        <i class="fa-solid fa-download"></i>
                                        <span>دانلود</span>
                                    </a>
                                }
                                <button class="dbb-btn dbb-btn-danger" style="display:inline-flex; align-items:center; justify-content:center; gap:8px;" @onclick="() => AskDeleteRun(r.RunId)">
                                    <i class="fa-solid fa-trash"></i>
                                    <span>حذف</span>
                                </button>
                            </div>
                        </div>
                    </details>
                }
            </div>

            <div class="dbb-pagination">
                <div class="dbb-help">صفحه @(_historyPage + 1) از @HistoryTotalPages</div>
                <div class="dbb-pagination-actions">
                    <select class="dbb-input" style="height:30px; width:90px; direction:ltr;" value="@_historyPageSizeText" @onchange="OnHistoryPageSizeChanged">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    <button class="dbb-btn dbb-btn-ghost" style="height:30px; padding:0 10px;" @onclick="PrevPage" disabled="@(_historyPage <= 0)">قبلی</button>
                    <button class="dbb-btn dbb-btn-ghost" style="height:30px; padding:0 10px;" @onclick="NextPage" disabled="@(_historyPage >= HistoryTotalPages - 1)">بعدی</button>
                </div>
            </div>
        }
    </div>

    <DsConfirm Show="@_showDeleteConfirm"
               Title="تأیید حذف"
               Message="آیا از حذف این بکاپ و فایل مربوطه مطمئن هستید؟"
               Variant="danger"
               ConfirmText="حذف"
               CancelText="انصراف"
               OnConfirm="ConfirmDeleteRun"
               OnCancel="CancelDeleteRun" />
</section>

