</style>

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _running;
    private bool _testing;

    private DbBackupSettings _settings = new();
    private string _frequencyText = "daily";
    private string _runAtTimeText = "02:00";
    private string _runOnDayOfWeekText = "";
    private string _runOnDayOfMonthText = "";
    private string _smtpPortText = "587";

    private bool _loadingRuns;
    private List<DbBackupRun> _runs = new();
    private long? _expandedRunId;
    private string _historySearch = string.Empty;
    private string _historySort = "new";
    private string _historyStatusFilter = "all";
    private int _historyPage;
    private int _historyPageSize = 20;
    private string _historyPageSizeText = "20";

    private bool _showDeleteConfirm;
    private long? _pendingDeleteRunId;

    private List<DbBackupRun> FilteredRuns => ApplyHistoryFilters(_runs);
    private List<DbBackupRun> PagedRuns => ApplyPaging(FilteredRuns);
    private int HistoryTotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredRuns.Count / Math.Max(1, _historyPageSize)));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await ReloadRunsAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _settings = await BackupService.GetSettingsAsync();
            _settings.RetainLastCount = 2;

            if (string.IsNullOrWhiteSpace(_settings.SmtpHost))
                _settings.SmtpHost = "smtp.gmail.com";
            if (string.IsNullOrWhiteSpace(_settings.SmtpFrom) && string.IsNullOrWhiteSpace(_settings.SmtpUsername) && string.IsNullOrWhiteSpace(_settings.NotifyEmailsCsv))
            {
                // no-op (do not force emails)
            }

            _frequencyText = _settings.Frequency switch
            {
                DbBackupFrequency.Weekly => "weekly",
                DbBackupFrequency.Monthly => "monthly",
                _ => "daily"
            };
            _runAtTimeText = MinutesToTimeText(_settings.RunAtTimeLocalMinutes);
            _runOnDayOfWeekText = _settings.RunOnDayOfWeek.HasValue ? _settings.RunOnDayOfWeek.Value.ToString() : "";
            _runOnDayOfMonthText = _settings.RunOnDayOfMonth.HasValue ? _settings.RunOnDayOfMonth.Value.ToString() : "";
            _smtpPortText = _settings.SmtpPort.ToString();
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در بارگذاری تنظیمات: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

