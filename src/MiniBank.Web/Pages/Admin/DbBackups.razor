    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            _settings.Frequency = _frequencyText switch
            {
                "weekly" => DbBackupFrequency.Weekly,
                "monthly" => DbBackupFrequency.Monthly,
                _ => DbBackupFrequency.Daily
            };

            _settings.RunAtTimeLocalMinutes = ParseTimeTextToMinutes(_runAtTimeText, defaultMinutes: 120);

            if (_settings.Frequency == DbBackupFrequency.Weekly)
            {
                if (int.TryParse(new string((_runOnDayOfWeekText ?? "").Where(char.IsDigit).ToArray()), out var dow))
                {
                    if (dow < 0) dow = 0;
                    if (dow > 6) dow = 6;
                    _settings.RunOnDayOfWeek = dow;
                }
                else
                {
                    _settings.RunOnDayOfWeek = null;
                }
                _settings.RunOnDayOfMonth = null;
            }
            else if (_settings.Frequency == DbBackupFrequency.Monthly)
            {
                if (int.TryParse(new string((_runOnDayOfMonthText ?? "").Where(char.IsDigit).ToArray()), out var dom))
                {
                    if (dom < 1) dom = 1;
                    if (dom > 28) dom = 28;
                    _settings.RunOnDayOfMonth = dom;
                }
                else
                {
                    _settings.RunOnDayOfMonth = 1;
                }
                _settings.RunOnDayOfWeek = null;
            }
            else
            {
                _settings.RunOnDayOfWeek = null;
                _settings.RunOnDayOfMonth = null;
            }

            if (int.TryParse(new string((_smtpPortText ?? "").Where(char.IsDigit).ToArray()), out var p))
            {
                if (p < 1) p = 1;
                _settings.SmtpPort = p;
            }
            _settings.RetainLastCount = 2;

            await BackupService.SaveSettingsAsync(_settings);
            Toasts.Success("تنظیمات ذخیره شد");
        }
        catch (Exception ex)
        {
            Toasts.Error($"خطا در ذخیره تنظیمات: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private static int ParseTimeTextToMinutes(string? text, int defaultMinutes)
    {
        var t = (text ?? string.Empty).Trim();
        if (t.Length == 0) return defaultMinutes;

        var parts = t.Split(':', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 2 && int.TryParse(parts[0], out var hh) && int.TryParse(parts[1], out var mm))
        {
            if (hh < 0) hh = 0;
            if (hh > 23) hh = 23;
            if (mm < 0) mm = 0;
            if (mm > 59) mm = 59;
            return hh * 60 + mm;
        }

        var digits = new string(t.Where(char.IsDigit).ToArray());
        if (digits.Length >= 3)
        {
            var last2 = digits[^2..];
            var first = digits[..^2];
            if (int.TryParse(first, out var hh2) && int.TryParse(last2, out var mm2))
            {
                if (hh2 < 0) hh2 = 0;
                if (hh2 > 23) hh2 = 23;
                if (mm2 < 0) mm2 = 0;
                if (mm2 > 59) mm2 = 59;
                return hh2 * 60 + mm2;
            }
        }

        return defaultMinutes;
    }

    private static string MinutesToTimeText(int minutes)
    {
        if (minutes < 0) minutes = 0;
        if (minutes > 23 * 60 + 59) minutes = 23 * 60 + 59;
        var hh = minutes / 60;
        var mm = minutes % 60;
        return hh.ToString("00") + ":" + mm.ToString("00");
    }

