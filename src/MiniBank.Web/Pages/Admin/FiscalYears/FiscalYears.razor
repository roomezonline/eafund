@page "/admin/fiscal-years"
@using MiniBank.Web.Components.DesignSystem
@using MiniBank.Web.Models
@inject MiniBank.Web.Services.FiscalYearService FiscalYearService
@inject MiniBank.Web.Services.FiscalYearContext FyContext
@inject MiniBank.Web.Components.DesignSystem.DsToastService Toasts
@inject NavigationManager Navigation

<div class="fy-duo">
  <DsPageHeader Icon="fa-solid fa-calendar"
                Title="سال‌های مالی"
                Subtitle="@($"تعداد: {_items.Count}")"
                ShowBackButton="true"
                ShowRefreshButton="true"
                ShowAddButton="true"
                AddButtonTitle="افزودن"
                OnRefreshClick="LoadAsync"
                OnAddClick="ShowCreate">
  </DsPageHeader>

  <div class="duo-controls">
    <DsSearchCard @bind-Value="_keyword"
                  Placeholder="جستجو در عنوان یا کد سال..." />
  </div>

  <div class="fy-active-bar">
    <div class="fy-active-info">
      <i class="fa-solid fa-filter"></i>
      <span class="lbl">سال مالیِ در حالِ نمایش:</span>
      @if (_activeYearCode.HasValue)
      {
        <strong class="val">@_activeYearCode</strong>
        <span class="tag @(_activeIsClosed ? "closed" : "open")">@(_activeIsClosed ? "بسته" : "باز")</span>
        @if (!_activeIsCurrent)
        {
          <span class="warn"><i class="fa-solid fa-triangle-exclamation"></i> سالِ غیرجاری — داده‌ها فقط خواندنی نمایش داده می‌شوند</span>
        }
      }
      else
      {
        <strong class="val">سال جاری</strong>
      }
    </div>
    @if (_activeYearCode.HasValue && !_activeIsCurrent)
    {
      <button class="fy-current-btn" @onclick="ResetToCurrentAsync">
        <i class="fa-solid fa-rotate-left"></i>
        <span>بازگشت به سال جاری</span>
      </button>
    }
  </div>

  <div class="duo-filters">
    <DsPillGroup Mode="filter"
                 Items="@_filterItems"
                 ActiveKey="@_activeFilter"
                 OnFilterChanged="@OnFilterChanged" />
  </div>
  <div class="duo-sort">
    <DsPillGroup Mode="sort"
                 Items="@_sortItems"
                 ActiveKey="@_sortKey"
                 ActiveKeyChanged="@(k => _sortKey = k)"
                 Desc="@_sortDesc"
                 DescChanged="@(d => _sortDesc = d)"
                 OnSortChanged="@(EventCallback.Factory.Create<(string, bool)>(this, args => OnSortChanged(args.Item1, args.Item2)))" />
  </div>

  <main class="duo-content">
    @if (_loading)
    {
      <div class="duo-list">
        @for (int i = 0; i < 6; i++)
        {
          <div class="duo-item skeleton"></div>
        }
      </div>
    }
    else if (_items.Count == 0)
    {
      <div class="duo-empty">
        <div class="emoji">📅</div>
        <div>موردی یافت نشد</div>
      </div>
    }
    else
    {
      <div class="duo-list">
        @foreach (var fy in _items)
        {
          <article class="duo-item @(_activeYearCode == fy.YearCode ? "fy-picked" : "")" @onclick="@(() => ShowDetail(fy))">
            <div class="top">
              <div class="name">@fy.Title</div>
              <span class="fy-status @StatusClass(fy)">@StatusText(fy)</span>
            </div>
            <div class="bottom">
              <div class="code"><span class="label">کد سال:</span> @fy.YearCode</div>
              <div class="date-range">
                @($"{fy.StartDate:yyyy/MM/dd} - {fy.EndDate:yyyy/MM/dd}")
              </div>
              <button class="fy-pick @(_activeYearCode == fy.YearCode ? "active" : "")"
                      title="@(_activeYearCode == fy.YearCode ? "در حال نمایش این سال است" : "نمایش همه‌ی داده‌ها بر اساس این سال مالی")"
                      @onclick:stopPropagation
                      @onclick="@(() => SelectYearAsync(fy))">
                <i class="fa-solid @(_activeYearCode == fy.YearCode ? "fa-circle-check" : "fa-check")"></i>
                <span>@(_activeYearCode == fy.YearCode ? "در حال نمایش" : "انتخاب")</span>
              </button>
            </div>
          </article>
        }
      </div>
    }
  </main>

  <DsFab Title="افزودن" Icon="fa-plus" OnClick="ShowCreate" />
</div>

@if (_showSheet)
{
  <FiscalYearIOSSheet Model="_currentModel" IsNew="_isNewSheet" OnClose="OnSheetClose" />
}

@if (_showDetail)
{
  <div class="fy-detail-overlay" @onclick="CloseDetail">
    <div class="fy-detail-sheet" @onclick:stopPropagation>
      <div class="detail-header">
        <div class="detail-title">@(_selectedFy?.Title)</div>
        <button class="detail-close" @onclick="CloseDetail">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="detail-body">
        <div class="detail-kv">
          <div class="kv-row">
            <span class="kv-lbl">کد سال</span>
            <span class="kv-val">@(_selectedFy?.YearCode)</span>
          </div>
          <div class="kv-row">
            <span class="kv-lbl">تاریخ شروع</span>
            <span class="kv-val">@(_selectedFy?.StartDate.ToString("yyyy/MM/dd"))</span>
          </div>
          <div class="kv-row">
            <span class="kv-lbl">تاریخ پایان</span>
            <span class="kv-val">@(_selectedFy?.EndDate.ToString("yyyy/MM/dd"))</span>
          </div>
          <div class="kv-row">
            <span class="kv-lbl">وضعیت</span>
            <span class="kv-val">@(_selectedFy == null ? "" : StatusText(_selectedFy))</span>
          </div>
          @if (_selectedFy?.ClosedAt != null)
          {
            <div class="kv-row">
              <span class="kv-lbl">تاریخ بسته شدن</span>
              <span class="kv-val">@(_selectedFy?.ClosedAt?.ToString("yyyy/MM/dd HH:mm"))</span>
            </div>
            <div class="kv-row">
              <span class="kv-lbl">بسته شده توسط</span>
              <span class="kv-val">@(_selectedFy?.ClosedBy)</span>
            </div>
          }
          @if (!string.IsNullOrEmpty(_selectedFy?.Notes))
          {
            <div class="kv-row">
              <span class="kv-lbl">توضیحات</span>
              <span class="kv-val">@(_selectedFy?.Notes)</span>
            </div>
          }
        </div>

        <div class="detail-actions">
          @if (_selectedFy != null && _activeYearCode != _selectedFy.YearCode)
          {
            <button class="detail-btn select-fy" @onclick="@(() => SelectYearAsync(_selectedFy!))">
              <i class="fa-solid fa-circle-check"></i>
              <span>انتخاب این سال و نمایش داده‌ها بر اساس آن</span>
            </button>
          }
          else if (_selectedFy != null)
          {
            <button class="detail-btn select-fy is-active" disabled>
              <i class="fa-solid fa-circle-check"></i>
              <span>در حال نمایش این سال مالی</span>
            </button>
          }

          <button class="detail-btn edit-fy" @onclick="ShowEdit">
            <i class="fa-solid fa-pen"></i>
            <span>ویرایش</span>
          </button>

          @if (_selectedFy?.IsClosed == false)
          {
            <button class="detail-btn close-fy" @onclick="@(() => NavigateToClosing(_selectedFy!.FiscalYearId))">
              <i class="fa-solid fa-lock"></i>
              <span>اختتامیه سال مالی</span>
            </button>
          }
          @if (_selectedFy?.IsClosed == true)
          {
            var nextYearCode = (_selectedFy.YearCode + 1);
            <div class="detail-btn transfer-done">
              <i class="fa-solid fa-circle-check"></i>
              <span>انتقال به سال @nextYearCode انجام شد — فقط با «تأیید و انتقال»</span>
            </div>
            <button class="detail-btn revert-fy" @onclick="RevertClosing">
              <i class="fa-solid fa-rotate-left"></i>
              <span>برگشت انتقال</span>
            </button>
          }

          <button class="detail-btn delete-fy" @onclick="ShowDelete" disabled="@(_selectedFy?.IsClosed == true)"
                  title="@(_selectedFy?.IsClosed == true ? "سال بسته قابل حذف نیست" : "فقط سال مالی خالی قابل حذف است")">
            <i class="fa-solid fa-trash"></i>
            <span>حذف سال مالی</span>
          </button>
        </div>
      </div>
    </div>
  </div>
}

<DsConfirm Show="@_showRevertConfirm"
           Title="@_revertConfirmTitle"
           Message="@_revertConfirmMessage"
           Variant="warning"
           ConfirmText="برگشت انتقال"
           CancelText="انصراف"
           Loading="@_revertBusy"
           OnConfirm="ConfirmRevert"
           OnCancel="CancelRevert" />

<DsConfirm Show="@_showDeleteConfirm"
           Title="@_deleteConfirmTitle"
           Message="@_deleteConfirmMessage"
           Variant="danger"
           ConfirmText="حذف"
           CancelText="انصراف"
           Loading="@_deleteBusy"
           OnConfirm="ConfirmDelete"
           OnCancel="CancelDelete" />

@code {
  private List<FiscalYear> _items = new();
  private List<FiscalYear> _allItems = new();
  private bool _loading;
  private string _kw = string.Empty;
  private string _keyword
  {
    get => _kw;
    set { _kw = value; ApplyFiltersAndSort(); }
  }

  private bool _showSheet;
  private bool _isNewSheet;
  private FiscalYear _currentModel = new();
  private bool _showDetail;
  private FiscalYear? _selectedFy;

  private string _activeFilter = "all";
  private string _sortKey = "code";
  private bool _sortDesc = false;

  private readonly List<DsPillGroup.DsPillItem> _filterItems = new()
  {
    new() { Key = "all", Text = "همه", Icon = "fa-solid fa-list" },
    new() { Key = "open", Text = "باز", Icon = "fa-solid fa-lock-open" },
    new() { Key = "closed", Text = "بسته", Icon = "fa-solid fa-lock" }
  };

  private readonly List<DsPillGroup.DsPillItem> _sortItems = new()
  {
    new() { Key = "code", Text = "کد سال", Icon = "fa-solid fa-hashtag" },
    new() { Key = "title", Text = "عنوان", Icon = "fa-solid fa-font" }
  };

  protected override async Task OnInitializedAsync()
  {
    await RefreshActiveAsync();
    await LoadAsync();
  }

  private int? _activeYearCode;
  private bool _activeIsClosed;
  private bool _activeIsCurrent = true;

  private async Task RefreshActiveAsync()
  {
    try
    {
      await FyContext.EnsureLoadedAsync();
      var selected = FyContext.Selected;
      var openToday = await FyContext.GetOpenTodayAsync();

      _activeYearCode = selected?.YearCode ?? openToday?.YearCode;
      _activeIsClosed = selected?.IsClosed ?? false;
      _activeIsCurrent = selected == null
                         || (openToday != null && selected.FiscalYearId == openToday.FiscalYearId);
    }
    catch
    {
      _activeYearCode = null;
      _activeIsClosed = false;
      _activeIsCurrent = true;
    }
  }

  private async Task SelectYearAsync(FiscalYear fy)
  {
    try
    {
      await FyContext.SetAsync(fy.YearCode);
      await RefreshActiveAsync();
      _showDetail = false;
      _selectedFy = null;
      Toasts.Success($"سال مالی {fy.YearCode} انتخاب شد — همه‌ی داده‌ها از این پس بر اساس آن بارگذاری می‌شوند");
      StateHasChanged();
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در انتخاب سال مالی: {ex.Message}");
    }
  }

  private async Task ResetToCurrentAsync()
  {
    try
    {
      await FyContext.ResetAsync();
      await RefreshActiveAsync();
      Toasts.Success("سال جاری فعال شد — همه‌ی داده‌ها بر اساس سال جاری بارگذاری می‌شوند");
      StateHasChanged();
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در بازگشت به سال جاری: {ex.Message}");
    }
  }

  private async Task LoadAsync()
  {
    _loading = true;
    try
    {
      _allItems = (await FiscalYearService.GetAllAsync()).ToList();
      ApplyFiltersAndSort();
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در بارگذاری سال‌های مالی: {ex.Message}");
    }
    finally
    {
      _loading = false;
    }
  }

  private void ApplyFiltersAndSort()
  {
    var filtered = _allItems.AsEnumerable();
    if (!string.IsNullOrWhiteSpace(_keyword))
    {
      filtered = filtered.Where(x =>
        (x.Title?.Contains(_keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
        x.YearCode.ToString().Contains(_keyword));
    }
    if (_activeFilter == "open")
      filtered = filtered.Where(x => !x.IsClosed);
    else if (_activeFilter == "closed")
      filtered = filtered.Where(x => x.IsClosed);
    filtered = _sortKey switch
    {
      "code" => _sortDesc ? filtered.OrderByDescending(x => x.YearCode) : filtered.OrderBy(x => x.YearCode),
      "title" => _sortDesc ? filtered.OrderByDescending(x => x.Title) : filtered.OrderBy(x => x.Title),
      _ => filtered.OrderByDescending(x => x.YearCode)
    };
    _items = filtered.ToList();
    StateHasChanged();
  }

  private void OnFilterChanged(string key) { _activeFilter = key; ApplyFiltersAndSort(); }
  private void OnSortChanged(string key, bool desc) { _sortKey = key; _sortDesc = desc; ApplyFiltersAndSort(); }

  private void ShowCreate()
  {
    _currentModel = new FiscalYear { IsOpen = true, IsClosed = false };
    _isNewSheet = true;
    _showSheet = true;
  }

  private void ShowEdit()
  {
    if (_selectedFy == null) return;
    _currentModel = _selectedFy;
    _isNewSheet = false;
    _showSheet = true;
    _showDetail = false;
  }

  private void ShowDetail(FiscalYear fy)
  {
    _selectedFy = fy;
    _showDetail = true;
  }

  private void CloseDetail()
  {
    _showDetail = false;
    _selectedFy = null;
  }

  private async Task OnSheetClose(bool hasChanges)
  {
    _showSheet = false;
    if (hasChanges) await LoadAsync();
  }

  private bool _showRevertConfirm;
  private string _revertConfirmTitle = string.Empty;
  private string _revertConfirmMessage = string.Empty;
  private bool _revertBusy;

  private void RevertClosing()
  {
    if (_selectedFy == null) return;
    var nextYearCode = _selectedFy.YearCode + 1;
    _revertConfirmTitle = $"برگشت انتقال سال {_selectedFy.YearCode}";
    _revertConfirmMessage = $@"
      سند افتتاحیه سال {nextYearCode} حذف و سال مالی {_selectedFy.YearCode} دوباره <b>باز</b> می‌شود.
      <br/><br/>
      <small style='color:#6b7280;'>
        <i class='fa-solid fa-triangle-exclamation'></i>
        این عمل فقط زمانی مجاز است که سال مالی {nextYearCode} اسناد دیگری نداشته باشد.
      </small>";
    _showRevertConfirm = true;
    StateHasChanged();
  }

  private async Task ConfirmRevert()
  {
    if (_selectedFy == null) return;
    _revertBusy = true;
    try
    {
      var docNum = await FiscalYearService.RevertClosingAsync(_selectedFy.FiscalYearId);
      _showRevertConfirm = false;
      Toasts.Success(docNum > 0
        ? $"انتقال سال {_selectedFy.YearCode} با موفقیت برگردانده شد (سند شماره {docNum} حذف شد)"
        : $"انتقال سال {_selectedFy.YearCode} با موفقیت برگردانده شد");
      _showDetail = false;
      _selectedFy = null;
      await LoadAsync();
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در برگشت انتقال: {ex.Message}");
    }
    finally
    {
      _revertBusy = false;
      StateHasChanged();
    }
  }

  private Task CancelRevert()
  {
    _showRevertConfirm = false;
    StateHasChanged();
    return Task.CompletedTask;
  }

  private bool _showDeleteConfirm;
  private string _deleteConfirmTitle = string.Empty;
  private string _deleteConfirmMessage = string.Empty;
  private bool _deleteBusy;

  private void ShowDelete()
  {
    if (_selectedFy == null) return;
    _deleteConfirmTitle = $"حذف سال مالی {_selectedFy.YearCode}";
    _deleteConfirmMessage = $@"
      آیا از حذف سال مالی <b>{_selectedFy.Title}</b> اطمینان دارید؟
      <br/><br/>
      <small style='color:#6b7280;'>
        فقط «تعریف» این سال مالی حذف می‌شود؛ اسناد و مانده‌ها حذف نمی‌شوند.
        <br/>سال مالی باید <b>خالی</b> باشد (هیچ سند و مانده‌ای نداشته باشد) و <b>بسته نشده</b> باشد،
        در غیر این صورت حذف انجام نمی‌شود.
      </small>";
    _showDeleteConfirm = true;
    StateHasChanged();
  }

  private async Task ConfirmDelete()
  {
    if (_selectedFy == null) return;
    _deleteBusy = true;
    try
    {
      await FiscalYearService.DeleteAsync(_selectedFy.FiscalYearId);
      _showDeleteConfirm = false;
      Toasts.Success($"سال مالی {_selectedFy.YearCode} حذف شد");
      _showDetail = false;
      _selectedFy = null;
      await LoadAsync();
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در حذف: {ex.Message}");
    }
    finally
    {
      _deleteBusy = false;
      StateHasChanged();
    }
  }

  private Task CancelDelete()
  {
    _showDeleteConfirm = false;
    StateHasChanged();
    return Task.CompletedTask;
  }

  private void NavigateToClosing(int fiscalYearId)
  {
    Navigation.NavigateTo($"/admin/fiscal-years/closing/{fiscalYearId}");
  }

  private static string StatusText(FiscalYear fy)
    => fy.IsClosed ? "بسته شده" : (fy.IsOpen ? "باز" : "افتتاح نشده");

  private static string StatusClass(FiscalYear fy)
    => fy.IsClosed ? "closed" : (fy.IsOpen ? "open" : "pending");
}
