  private async Task PostFinalAsync()
  {
    if (_postingBusy) return;

    try
    {
      _postingBusy = true;
      await InvokeAsync(StateHasChanged);

      var startOfMonth = GetPersianMonthStart(_targetDate);
      var endPrevMonth = GetPersianMonthEnd(startOfMonth.AddPersianMonths(-1));
      var endThisMonth = GetPersianMonthEnd(startOfMonth);
      var creditsToExclusive = endPrevMonth.AddDays(1);
      var debitsToExclusive = endThisMonth.AddDays(1);

      var notes = $"واریز سود سپرده {ToPersianMonthTitle(startOfMonth)}";

      var items = _allRows.Where(x => x.IsSelected).Select(r => new DepositInterestRunItem
      {
        RunItemId = 0,
        RunId = 0,
        MemberId = r.MemberId,
        MemberCode = r.MemberCode,
        MemberName = r.MemberName,
        NetPrincipal = r.NetPrincipal,
        NetInterest = r.NetInterest,
        TotalNet = r.TotalNet,
        MonthProfit = r.MonthProfit,
        IsNeutral = !r.IsActiveForCalc,
        JournalId = null
      }).ToList();

      var req = new DepositInterestPostingService.PostRequest(
        PeriodStartDate: startOfMonth,
        PostingOccurredAt: _postingDate,
        AnnualRatePercent: _annualRatePercent,
        DaysInMonth: _daysInMonth,
        CreditsCutoffToExclusive: creditsToExclusive,
        DebitsCutoffToExclusive: debitsToExclusive,
        Items: items,
        Notes: notes,
        CreatedBy: "admin");

      var runId = await DepositInterestPostingService.PostAsync(req);

      var summary = new InterestNotifySummary(0, 0, 0, 0, 0);
      if (_postNotifyEnabled)
      {
        try
        {
          summary = await NotifyInterestPostedAsync(runId, items, startOfMonth, _postingDate, _postRequiresApproval);
        }
        catch (Exception ex)
        {
          Toasts.Warning($"سود ثبت شد اما اطلاع‌رسانی بله انجام نشد: {ex.Message}");
        }
      }

      _notifySummary = summary;
      _notifySummaryRunId = runId;

      if (!_postNotifyEnabled)
        Toasts.Warning("اطلاع‌رسانی بله برای واریز سود در تنظیمات غیرفعال است؛ فقط اسناد سود ثبت شد.");
      else if (summary.PendingApproval > 0)
        Toasts.Success($"ثبت نهایی سود انجام شد؛ {summary.PendingApproval} اطلاع‌رسانی بله در انتظار تایید مدیر است.");
      else if (summary.Sent > 0)
        Toasts.Success($"ثبت نهایی سود انجام شد؛ {summary.Sent} اطلاع‌رسانی بله ارسال شد.");
      else if (summary.Queued > 0)
        Toasts.Success($"ثبت نهایی سود انجام شد؛ {summary.Queued} اطلاع‌رسانی بله در صف ارسال قرار گرفت.");
      else
        Toasts.Success("ثبت نهایی سود با موفقیت انجام شد");

      if (summary.NoChannel > 0)
        Toasts.Warning($"{summary.NoChannel} عضو به پیام‌رسان بله متصل نیست و اعلانی دریافت نکرد.");

      if (summary.Failed > 0)
        Toasts.Warning($"{summary.Failed} اطلاع‌رسانی ثبت نشد؛ وضعیت را در پنل اطلاع‌رسانی بررسی کنید.");

      await LoadHistoryAsync();
      _expandedYears.Add(new PersianCalendar().GetYear(startOfMonth));
      await LoadRunDetailsAsync(runId);
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در ثبت: {ex.Message}");
    }
    finally
    {
      _postingBusy = false;
      await InvokeAsync(StateHasChanged);
    }
  }

