  private async Task LoadPreviewAsync()
  {
    try
    {
      _loading = true;
      await InvokeAsync(StateHasChanged);

      _allRows.Clear();
      _rows.Clear();
      _sumPrincipal = 0;
      _sumInterest = 0;
      _sumNet = 0;
      _sumProfit = 0;
      _selectedCount = 0;

      var startOfMonth = GetPersianMonthStart(_targetDate);
      var endPrevMonth = GetPersianMonthEnd(startOfMonth.AddPersianMonths(-1));
      var endThisMonth = GetPersianMonthEnd(startOfMonth);

      _creditsCutoffText = endPrevMonth.ToPersianDate();
      _debitsCutoffText = endThisMonth.ToPersianDate();

      var creditsToExclusive = endPrevMonth.AddDays(1);
      var debitsToExclusive = endThisMonth.AddDays(1);

      _daysInMonth = GetPersianDaysInMonth(startOfMonth);
      _daysText = _daysInMonth > 0 ? _daysInMonth.ToString(CultureInfo.InvariantCulture) : "-";

      var activePlan = await DepositRateService.GetActivePlanAsync(startOfMonth);
      if (activePlan == null)
      {
        _annualRatePercent = 0m;
        _rateText = "-";
      }
      else
      {
        _annualRatePercent = DepositRateService.ComputeRatePercentForAmount(activePlan.Value.Plan, activePlan.Value.Tiers, 0m);
        _rateText = _annualRatePercent > 0 ? _annualRatePercent.ToString("0.##", CultureInfo.InvariantCulture) + "%" : "-";
      }

      var rows = await TxReports.GetMemberEffectiveDepositAggForPeriodAsync(creditsToExclusive, debitsToExclusive, activeMembersOnly: true);

      foreach (var r in rows)
      {
        var netP = r.PrincipalCredit - r.PrincipalDebit;
        var netI = r.InterestCredit - r.InterestDebit;
        var total = netP + netI;

        var isActiveForCalc = total > 0.01m;
        var monthProfit = 0m;
        if (isActiveForCalc && _annualRatePercent > 0m && _daysInMonth > 0)
        {
          monthProfit = total * (_annualRatePercent / 100m) * (_daysInMonth / 365m);
        }

        var vm = new RowVm
        {
          MemberId = r.MemberId,
          MemberName = r.MemberName,
          FatherName = r.FatherName,
          MemberCode = r.MemberCode,
          NetPrincipal = netP,
          NetInterest = netI,
          TotalNet = total,
          IsActiveForCalc = isActiveForCalc,
          StatusText = isActiveForCalc ? "فعال" : "خنثی",
          MonthProfit = monthProfit,
          IsSelected = isActiveForCalc
        };

        _allRows.Add(vm);
      }

      ApplyView();
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در محاسبه سود: {ex.Message}");
    }
    finally
    {
      _loading = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private void SortByColumn(string columnName)
  {
    if (_sortColumn == columnName)
      _sortAscending = !_sortAscending;
    else
    {
      _sortColumn = columnName;
      _sortAscending = true;
    }

    ApplyView();
  }

  private string GetSortIconClass(string columnName)
  {
    if (_sortColumn != columnName)
      return string.Empty;
    return _sortAscending ? "fas fa-sort-up" : "fas fa-sort-down";
  }

  private void ApplyView()
  {
    _rows.Clear();

    IEnumerable<RowVm> q = _allRows;
    if (_hideNeutral)
      q = q.Where(x => x.IsActiveForCalc);

    var list = q.ToList();

    list.Sort(CompareRows);

    _rows.AddRange(list);

    RecomputeSums();
  }

  private void RecomputeSums()
  {
    var sel = _allRows.Where(x => x.IsSelected).ToList();
    _selectedCount = sel.Count;
    _sumNet = sel.Sum(x => x.TotalNet);
    _sumProfit = sel.Sum(x => x.MonthProfit);
  }

  private int CompareRows(RowVm a, RowVm b)
  {
    var dir = _sortAscending ? 1 : -1;
    int cmp;

    if (_sortColumn == nameof(RowVm.MemberCode))
      cmp = CompareMemberCodes(a.MemberCode, b.MemberCode);
    else if (_sortColumn == nameof(RowVm.MemberName))
      cmp = string.Compare(a.MemberName, b.MemberName, StringComparison.OrdinalIgnoreCase);
    else if (_sortColumn == nameof(RowVm.TotalNet))
      cmp = a.TotalNet.CompareTo(b.TotalNet);
    else if (_sortColumn == nameof(RowVm.MonthProfit))
      cmp = a.MonthProfit.CompareTo(b.MonthProfit);
    else if (_sortColumn == nameof(RowVm.StatusText))
      cmp = string.Compare(a.StatusText, b.StatusText, StringComparison.OrdinalIgnoreCase);
    else
      cmp = CompareMemberCodes(a.MemberCode, b.MemberCode);

    if (cmp != 0)
      return cmp * dir;

    return string.Compare(a.MemberName, b.MemberName, StringComparison.OrdinalIgnoreCase);
  }

  private static int CompareMemberCodes(string? a, string? b)
  {
    var (hasA, numA, rawA) = ParseMemberCode(a);
    var (hasB, numB, rawB) = ParseMemberCode(b);

    if (hasA && hasB)
      return numA.CompareTo(numB);
    if (hasA && !hasB)
      return -1;
    if (!hasA && hasB)
      return 1;

    return string.Compare(rawA, rawB, StringComparison.OrdinalIgnoreCase);
  }

  private static (bool HasNumber, int Number, string Raw) ParseMemberCode(string? code)
  {
    var raw = (code ?? string.Empty).Trim();
    if (raw.Length == 0)
      return (false, int.MaxValue, "~");

    if (raw.StartsWith("M-", StringComparison.OrdinalIgnoreCase))
    {
      var s = raw.Substring(2);
      if (int.TryParse(s, NumberStyles.Integer, CultureInfo.InvariantCulture, out var n))
        return (true, n, raw);
    }

    return (false, int.MaxValue, raw);
  }

  private static DateTime GetPersianMonthStart(DateTime anyDate)
  {
    var pc = new PersianCalendar();
    var y = pc.GetYear(anyDate);
    var m = pc.GetMonth(anyDate);
    return pc.ToDateTime(y, m, 1, 0, 0, 0, 0).Date;
  }

  private static DateTime GetPersianMonthEnd(DateTime anyDateInThatMonth)
  {
    var pc = new PersianCalendar();
    var y = pc.GetYear(anyDateInThatMonth);
    var m = pc.GetMonth(anyDateInThatMonth);
    var days = pc.GetDaysInMonth(y, m);
    return pc.ToDateTime(y, m, days, 0, 0, 0, 0).Date;
  }

  private static int GetPersianDaysInMonth(DateTime anyDateInThatMonth)
  {
    var pc = new PersianCalendar();
    var y = pc.GetYear(anyDateInThatMonth);
    var m = pc.GetMonth(anyDateInThatMonth);
    return pc.GetDaysInMonth(y, m);
  }

  private static string ToMoney(decimal v)
    => v.ToString("N0", CultureInfo.InvariantCulture);

  private static string ToPersianMonthTitle(DateTime anyDateInMonth)
  {
    var pc = new PersianCalendar();
    var y = pc.GetYear(anyDateInMonth);
    var m = pc.GetMonth(anyDateInMonth);
    var name = m switch
    {
      1 => "فروردین",
      2 => "اردیبهشت",
      3 => "خرداد",
      4 => "تیر",
      5 => "مرداد",
      6 => "شهریور",
      7 => "مهر",
      8 => "آبان",
      9 => "آذر",
      10 => "دی",
      11 => "بهمن",
      12 => "اسفند",
      _ => m.ToString(CultureInfo.InvariantCulture)
    };
    return $"{name} {y}";
  }

  private async Task<InterestNotifySummary> NotifyInterestPostedAsync(
    long runId,
    IReadOnlyList<DepositInterestRunItem> items,
    DateTime periodStart,
    DateTime postingDate,
    bool approvalRequired)
  {
    var rowsById = _allRows
      .Where(x => x.IsSelected)
      .GroupBy(x => x.MemberId)
      .ToDictionary(g => g.Key, g => g.First());

    var monthTitle = ToPersianInterestMonthTitle(periodStart);
    var date = ToPersianDigits(postingDate.ToPersianDate());
    var dispatchNow = !approvalRequired;

    var sent = 0;
    var queued = 0;
    var pending = 0;
    var noChannel = 0;
    var failed = 0;

    _showSendProgress = true;
    _liveSending = true;
    _liveApprovalMode = approvalRequired;
    _liveTotal = items.Count(x => Math.Round(x.MonthProfit, 0, MidpointRounding.AwayFromZero) > 0m);
    _liveProcessed = 0;
    _liveSent = 0;
    _liveQueued = 0;
    _livePendingApproval = 0;
    _liveNoChannel = 0;
    _liveFailed = 0;
    await SafeRefreshAsync();

    try
    {
      foreach (var item in items)
      {
        var amount = Math.Round(item.MonthProfit, 0, MidpointRounding.AwayFromZero);
        if (amount <= 0m)
          continue;

        var owner = rowsById.TryGetValue(item.MemberId, out var row)
          ? BuildStatementOwnerName(row.MemberName, row.FatherName)
          : BuildStatementOwnerName(item.MemberName, null);

        var total = Math.Round(item.TotalNet, 0, MidpointRounding.AwayFromZero) + amount;
        var text = BuildInterestBaleText(
          owner,
          amount.ToString("N0", CultureInfo.InvariantCulture),
          total.ToString("N0", CultureInfo.InvariantCulture),
          monthTitle,
          date);

        try
        {
          var result = await Notifications.NotifyAsync(new NotificationRequest
          {
            FeatureKey = "deposit_interest_run",
            MessageText = text,
            BaleMessageText = text,
            MemberId = item.MemberId,
            HeadMemberId = item.MemberId,
            RecipientName = owner,
            EventKey = $"deposit_interest:{runId}:{item.MemberId}",
            CreatedBy = "deposit-interest",
            DispatchNow = dispatchNow
          });

          if (!result.Ok)
          {
            if (result.Status == NotificationStatuses.Skipped)
            {
              noChannel++;
              _liveNoChannel++;
            }
            else if (result.Status == NotificationStatuses.PendingApproval)
            {
              pending++;
              _livePendingApproval++;
            }
            else if (result.Status == NotificationStatuses.Queued)
            {
              queued++;
              _liveQueued++;
            }
            else
            {
              failed++;
              _liveFailed++;
            }
          }
          else if (result.NotificationId.HasValue)
          {
            if (result.PendingApproval)
            {
              pending++;
              _livePendingApproval++;
            }
            else if (result.SmsSent || result.BaleSent)
            {
              sent++;
              _liveSent++;
            }
            else
            {
              queued++;
              _liveQueued++;
            }
          }
          else
          {
            // همین اعلان قبلاً برای این ثبت ایجاد شده است.
            queued++;
            _liveQueued++;
          }
        }
        catch
        {
          // یک خطای ارسال نباید ثبت سود و بقیه اطلاع‌رسانی‌ها را متوقف کند.
          failed++;
          _liveFailed++;
        }

        _liveProcessed++;
        await SafeRefreshAsync();
      }
    }
    finally
    {
      _liveSending = false;
      await SafeRefreshAsync();
    }

    return new InterestNotifySummary(sent, queued, pending, noChannel, failed);
  }

  private async Task SafeRefreshAsync()
  {
    try
    {
      await InvokeAsync(StateHasChanged);
    }
    catch
    {
      // قطع شدن اتصال کاربر نباید ادامه ارسال پیام‌ها را متوقف کند.
    }
  }

  private void CloseSendProgress()
  {
    _showSendProgress = false;
    StateHasChanged();
  }

  private static string RunEventKeyPrefix(long runId) => $"deposit_interest:{runId}:";

  private async Task LoadRunNotifyStatusAsync(long runId)
  {
    try
    {
      _runNotifyStatus = await NotificationRepo.GetRunStatusAsync("deposit_interest_run", RunEventKeyPrefix(runId));
      _runNotifyError = null;
    }
    catch (Exception ex)
    {
      _runNotifyError = ex.Message;
    }

    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshRunNotifyStatusAsync()
  {
    if (!_selectedRunId.HasValue || _runNotifyBusy)
      return;

    _runNotifyBusy = true;
    await InvokeAsync(StateHasChanged);

    try
    {
      await LoadRunNotifyStatusAsync(_selectedRunId.Value);
    }
    finally
    {
      _runNotifyBusy = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task ApproveRunNotificationsAsync()
  {
    if (!_selectedRunId.HasValue || _runNotifyBusy)
      return;

    _runNotifyBusy = true;
    await InvokeAsync(StateHasChanged);

    try
    {
      var user = await CurrentUserAsync();
      var approved = await NotificationRepo.ApprovePendingByEventKeyPrefixAsync(RunEventKeyPrefix(_selectedRunId.Value), user);

      Toasts.Success(approved > 0
        ? $"{approved} اطلاع‌رسانی تایید شد و در صف ارسال پس‌زمینه قرار گرفت."
        : "موردی در انتظار تایید نبود.");

      await LoadRunNotifyStatusAsync(_selectedRunId.Value);
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در تایید اطلاع‌رسانی‌ها: {ex.Message}");
    }
    finally
    {
      _runNotifyBusy = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task RetryRunNotificationsAsync()
  {
    if (!_selectedRunId.HasValue || _runNotifyBusy)
      return;

    _runNotifyBusy = true;
    await InvokeAsync(StateHasChanged);

    try
    {
      var retried = await NotificationRepo.RetryByEventKeyPrefixAsync(RunEventKeyPrefix(_selectedRunId.Value));

      Toasts.Success(retried > 0
        ? $"{retried} اطلاع‌رسانی برای تلاش مجدد در صف قرار گرفت."
        : "مورد ناموفقی برای تلاش مجدد وجود ندارد.");

      await LoadRunNotifyStatusAsync(_selectedRunId.Value);
    }
    catch (Exception ex)
    {
      Toasts.Error($"خطا در تلاش مجدد: {ex.Message}");
    }
    finally
    {
      _runNotifyBusy = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task<string?> CurrentUserAsync()
  {
    var state = await AuthStateProvider.GetAuthenticationStateAsync();
    return state.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
           ?? state.User.Identity?.Name
           ?? "admin";
  }

  private static string BuildInterestBaleText(string owner, string amount, string total, string monthTitle, string postingDate)
  {
    return "عضو محترم صندوق امام علی(ع)\n" +
           "با سلام\n" +
           $"به اطلاع می‌رساند که مبلغ {amount} ریال بابت سود سپرده {monthTitle} متعلق به {owner} در تاریخ {postingDate} ثبت سامانه گردید.\n" +
           $"مانده کل سپرده شما تاکنون: {total} ریال می باشد.\n\n" +
           "صندوق امام علی (ع)";
  }

  private static string BuildStatementOwnerName(string? memberName, string? fatherName)
  {
    var owner = (memberName ?? string.Empty).Trim();
    if (owner.Length == 0)
      owner = "عضو";

    if (!string.IsNullOrWhiteSpace(fatherName) && !owner.Contains('☆'))
      owner = $"{owner}☆{fatherName.Trim()}";

    return owner;
  }

  private static string ToPersianInterestMonthTitle(DateTime anyDateInMonth)
  {
    var title = ToPersianMonthTitle(anyDateInMonth);
    var parts = title.Split(' ', 2);
    return parts.Length == 2 ? $"{parts[0]}ماه {ToPersianDigits(parts[1])}" : title;
  }

  private static string ToPersianDigits(string value)
  {
    return value
      .Replace('0', '۰').Replace('1', '۱').Replace('2', '۲').Replace('3', '۳').Replace('4', '۴')
      .Replace('5', '۵').Replace('6', '۶').Replace('7', '۷').Replace('8', '۸').Replace('9', '۹');
  }

  private static string StatusClass(RowVm r)
    => r.IsActiveForCalc ? "status-active" : "status-neutral";

  private static string RowClass(RowVm r)
    => r.IsActiveForCalc ? "row-active" : "row-neutral";
}
