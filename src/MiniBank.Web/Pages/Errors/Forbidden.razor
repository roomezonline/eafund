@page "/forbidden"
@inject NavigationManager Nav

<div class="err-shell" dir="rtl">
  <div class="err-bg" aria-hidden="true">
    <div class="err-orb a"></div>
    <div class="err-orb b"></div>
    <div class="err-orb c"></div>
    <div class="err-grid"></div>
  </div>

  <div class="err-card">
    <div class="err-icon warn">
      <i class="fa-solid fa-ban"></i>
    </div>
    <div class="err-title">عدم دسترسی</div>
    <div class="err-subtitle">شما مجوز دسترسی به این صفحه را ندارید.</div>
    <div class="err-actions">
      <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GoDashboard">داشبورد</MudButton>
    </div>
  </div>
</div>

@code {
  private void GoDashboard() => Nav.NavigateTo("/admin/dashboard2", forceLoad: true);
}

<style>
  .err-shell{
    position: relative;
    min-height: min(84vh, 760px);
    display: grid;
    place-items: center;
    padding: 22px;
    overflow: hidden;
  }
  .err-bg{position:absolute; inset:-40px; pointer-events:none;}
  .err-orb{position:absolute; width:520px; height:520px; border-radius:999px; filter: blur(28px); opacity:.55; animation: errFloat 10s ease-in-out infinite;}
  .err-orb.a{background: radial-gradient(circle at 30% 30%, rgba(251,191,36,.50), rgba(245,158,11,.10) 60%, transparent 70%); top:-140px; inset-inline-start:-160px;}
  .err-orb.b{background: radial-gradient(circle at 30% 30%, rgba(96,165,250,.45), rgba(59,130,246,.10) 60%, transparent 70%); bottom:-180px; inset-inline-end:-200px; animation-delay:-2.5s;}
  .err-orb.c{width:420px; height:420px; background: radial-gradient(circle at 30% 30%, rgba(167,139,250,.35), rgba(124,58,237,.08) 60%, transparent 70%); bottom:-160px; inset-inline-start:-120px; animation-delay:-5s;}
  .err-grid{position:absolute; inset:0; opacity:.08; background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,.45) 1px, transparent 0); background-size: 18px 18px; mix-blend-mode: overlay;}

  .err-card{
    position: relative;
    width: min(92vw, 560px);
    padding: 22px;
    border-radius: 18px;
    background: rgba(255,255,255,.96);
    border: 1px solid rgba(15,23,42,.12);
    box-shadow: 0 18px 60px rgba(2,6,23,.22);
    text-align: center;
    backdrop-filter: blur(10px);
    animation: errPop .35s ease-out;
  }
  .err-icon{width:72px; height:72px; margin: 0 auto 10px; border-radius: 22px; display:grid; place-items:center;
    background: linear-gradient(135deg, rgba(14,165,233,.18), rgba(124,58,237,.18));
    border: 1px solid rgba(255,255,255,.16);
  }
  .err-icon.warn{background: linear-gradient(135deg, rgba(245,158,11,.18), rgba(251,191,36,.18));}
  .err-icon i{font-size: 30px; color: var(--mud-palette-warning, #fbbf24);}
  .err-title{font-weight: 900; font-size: 22px; margin-bottom: 6px; color: #0f172a;}
  .err-subtitle{font-size: 13px; opacity: .9; margin-bottom: 16px; color: #334155;}
  .err-actions{display:flex; gap:10px; justify-content:center; flex-wrap:wrap;}

  .err-card :global(.mud-button-root){
    border-radius: 12px;
    font-weight: 800;
  }

  @@keyframes errFloat{0%,100%{transform: translate3d(0,0,0) scale(1);}50%{transform: translate3d(0,-18px,0) scale(1.03);}}
  @@keyframes errPop{from{transform: translateY(10px); opacity:0;}to{transform: translateY(0); opacity:1;}}

  /* Hide bottom nav on error pages */
  :global(.footer-nav),
  :global(.member-footer-nav),
  :global(.admin-footer-nav) {
    display: none !important;
  }
</style>
