<InstallPromptDialog @ref="_installDialog" />

@* Centralized confirmation dialog for app-level confirmations (e.g., Exit) *@

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;
    [Inject] MiniBank.Web.Services.Auth.AuthActivityService Activity { get; set; } = default!;
    [Inject] MemberRepository MemberRepo { get; set; } = default!;
    [Inject] MiniBank.Web.Services.FiscalYearContext FyContext { get; set; } = default!;

    private bool _fyBannerVisible;
    private string _fyBannerYear = "";
    private bool _fyBannerClosed;
    private bool _fyDisposed;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private bool _showLoading;
    private EventHandler<LocationChangedEventArgs>? _locationChangedHandler;
    private DateTime _today = DateTime.Now;
    private InstallPromptDialog? _installDialog;
    private string? _currentVersion;
    private int _unreadCount = 3; // test data for unread notifications

    private bool _isMemberArea;
    private bool _isMemberDashboard;
    private bool _isAdminArea;
    private bool _drawerOpen;

    private string _userDisplayName = "کاربر";
    private string _userUsername = "";
    private string _userRole = "";
    private long? _userMemberId;
    private string _userNationalCode = "";
    private string _userInitials = "—";

    protected override void OnInitialized()
    {
        UpdateMemberAreaFlag(Nav.Uri);
        _locationChangedHandler = (_, args) =>
        {
            _showLoading = true;
            UpdateMemberAreaFlag(args.Location);
            InvokeAsync(StateHasChanged);
            _ = HideSoonAsync();

            try { _ = Activity.TouchSeenThrottledAsync(TimeSpan.FromMinutes(5)); } catch { }
            
            // حذف نمایش خودکار دیالوگ نصب در داشبورد — فقط از منوی سه‌نقطه نشان داده می‌شود

            // Inform app-nav about navigation to manage back barrier on dashboard
            try { JS.InvokeVoidAsync("appNav.onNavigated", args.Location); } catch {}
        };
        Nav.LocationChanged += _locationChangedHandler;

        FyContext.OnChange += OnFiscalYearChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadFiscalYearBannerAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MainLayout.OnInitializedAsync failed: {ex}");
        }
    }

    private void OnFiscalYearChanged()
    {
        _ = InvokeAsync(RefreshFiscalYearBannerAsync);
    }

    private async Task RefreshFiscalYearBannerAsync()
    {
        await LoadFiscalYearBannerAsync();

        if (_fyDisposed)
            return;

        try
        {
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MainLayout banner StateHasChanged failed: {ex}");
        }
    }

    private async Task LoadFiscalYearBannerAsync()
    {
        try
        {
            await FyContext.EnsureLoadedAsync();
            var selected = FyContext.Selected;
            var openToday = await FyContext.GetOpenTodayAsync();

            _fyBannerVisible = selected != null
                && (openToday == null || selected.FiscalYearId != openToday.FiscalYearId);
            _fyBannerYear = selected?.YearCode.ToString() ?? "";
            _fyBannerClosed = selected?.IsClosed ?? false;
        }
        catch (Exception ex)
        {
            _fyBannerVisible = false;
            Console.WriteLine($"MainLayout banner load failed: {ex}");
        }
    }

    private async Task ResetFiscalYearAsync()
    {
        try
        {
            await FyContext.ResetAsync();
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch
        {
            // ignore
        }
    }

    private void UpdateMemberAreaFlag(string location)
    {
        try
        {
            var rel = Nav.ToBaseRelativePath(location);
            rel = rel.StartsWith("/") ? rel : "/" + rel;
            _isMemberArea = rel.Equals("/dashboard", StringComparison.OrdinalIgnoreCase)
                || rel.StartsWith("/me/", StringComparison.OrdinalIgnoreCase)
                || rel.Equals("/me", StringComparison.OrdinalIgnoreCase);

            _isMemberDashboard = rel.Equals("/dashboard", StringComparison.OrdinalIgnoreCase);

            _isAdminArea = rel.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _isMemberArea = false;
            _isMemberDashboard = false;
            _isAdminArea = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var local = await JS.InvokeAsync<LocalVersion>("SWUpdate.getLocalVersion");
                _currentVersion = local?.version;
                StateHasChanged();
                // Initialize back barrier for current URL (handles direct land on dashboard)
                try { await JS.InvokeVoidAsync("appNav.onNavigated", Nav.Uri); } catch {}
                try { await Activity.TouchSeenThrottledAsync(TimeSpan.FromMinutes(5)); } catch { }
            }
            catch { }

            await LoadUserInfoAsync();
        }
    }

    private async Task LoadUserInfoAsync()
    {
        try
        {
            if (AuthenticationStateTask == null)
                return;

            var auth = await AuthenticationStateTask;
            var user = auth.User;
            if (user?.Identity?.IsAuthenticated != true)
                return;

            _userUsername = user.FindFirstValue(ClaimTypes.Name) ?? string.Empty;
            _userRole = ToFaRoleName(user.FindFirstValue(ClaimTypes.Role) ?? string.Empty);
            _userDisplayName = _userUsername;

            var memberIdStr = user.FindFirstValue("MemberId");
            if (long.TryParse(memberIdStr, out var mid) && mid > 0)
            {
                _userMemberId = mid;
                try
                {
                    var member = await MemberRepo.GetByIdAsync(mid);
                    if (member != null)
                    {
                        _userDisplayName = member.FullName;
                        _userNationalCode = member.NationalCode ?? string.Empty;
                    }
                }
                catch { }
            }

            _userInitials = BuildInitials(_userDisplayName);
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private static string BuildInitials(string? name)
    {
        var n = (name ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(n)) return "—";
        var parts = n.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return SafeTwoChars(parts[0]);
        return SafeOneChar(parts[0]) + SafeOneChar(parts[^1]);
    }

    private static string SafeOneChar(string s)
    {
        var t = (s ?? string.Empty).Trim();
        if (t.Length == 0) return "";
        return t.Substring(0, 1);
    }

    private static string SafeTwoChars(string s)
    {
        var t = (s ?? string.Empty).Trim();
        if (t.Length == 0) return "—";
        if (t.Length == 1) return t;
        return t.Substring(0, 2);
    }

    private static string ToFaRoleName(string? role)
    {
        var r = (role ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(r)) return string.Empty;

        return r switch
        {
            "Admin" => "مدیر سیستم",
            "Developer" => "توسعه‌دهنده",
            "Accountant" => "حسابدار",
            "Member" => "عضو",
            "Manager" => "مدیر",
            _ => r
        };
    }

    private Task GoToProfile()
    {
        Nav.NavigateTo("/admin/profile");
        return Task.CompletedTask;
    }

    private Task GoToAccountSettings()
    {
        Nav.NavigateTo("/settings");
        return Task.CompletedTask;
    }

    private async Task LogoutAsync()
    {
        try { await JS.InvokeVoidAsync("appNav.closeMenus"); } catch { }
        Nav.NavigateTo("/logout", forceLoad: true);
    }

    private async Task ShowInstallDialog()
    {
        try { await JS.InvokeVoidAsync("appNav.closeMenus"); } catch {}
        if (_installDialog is not null)
        {
            // نمایش دیالوگ نصب فقط به صورت دستی
            await _installDialog.ForceShowOnDashboard();
        }
    }

    private async Task HideSoonAsync()
    {
        try
        {
            await Task.Delay(600);
        }
        catch { }
        _showLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }

    public void Dispose()
    {
        _fyDisposed = true;

        if (_locationChangedHandler is not null)
        {
            Nav.LocationChanged -= _locationChangedHandler;
            _locationChangedHandler = null;
        }

        FyContext.OnChange -= OnFiscalYearChanged;
    }

    private Task Back()
    {
        return JS.InvokeVoidAsync("appNav.goBack").AsTask();
    }


    private class LocalVersion
    {
        public string? version { get; set; }
        public string? date { get; set; }
        public List<string> notes { get; set; } = new();
    }

}
