    .app-shell.member-area .menu-card.user-menu-card,
    .app-shell.member-area .menu-card.user-menu-card .user-menu__name,
    .app-shell.member-area .menu-card.user-menu-card .user-chip,
    .app-shell.member-area .menu-card.user-menu-card .menu-item {
        color: #0f172a !important;
    }

    .app-shell.member-area .menu-card.user-menu-card .menu-item.danger {
        color: #b91c1c !important;
    }

    .app-shell.member-area .menu-card.user-menu-card .user-chip {
        background: #f1f5f9 !important;
        border-color: #e2e8f0 !important;
    }

    .app-shell.member-area .menu-card.user-menu-card .menu-item:hover {
        background: #f1f5f9 !important;
    }

    .app-shell.member-area .menu-card.user-menu-card .menu-item.danger:hover {
        background: #fee2e2 !important;
    }

    .app-shell.member-area .app-title {
        color: #ffffff !important;
        text-shadow: 0 1px 1px rgba(0,0,0,.18);
    }
    .fy-row {
        display: flex;
        align-items: center;
        padding: 0px 16px 4px;
        margin-top: -14px;
    }
    .fiscal-year-badge {
        font-size: 12px;
        color: #ffffffcc;
        background: rgba(255,255,255,.10);
        padding: 1px 10px;
        border-radius: 999px;
        white-space: nowrap;
        font-weight: 500;
    }
    .app-shell.member-area .header-row-2 {
        color: #ffffff;
    }
    .app-shell.member-area .header-row-2 .header-date-full {
        color: #ffffff;
    }
    .app-shell.member-area .header-actions,
    .app-shell.member-area .header-actions i,
    .app-shell.member-area .header-actions summary,
    .app-shell.member-area .header-actions button {
        color: #ffffff !important;
    }
    .app-shell.member-area .user-trigger,
    .app-shell.member-area .md-text-button {
        background: rgba(255,255,255,.18) !important;
        border-color: rgba(255,255,255,.35) !important;
    }
    .app-shell.member-area .app-header::after {
        opacity: 1;
    }

    .member-footer-nav,
    .admin-footer-nav{
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 0;
        z-index: 1200;
        pointer-events: none;
    }
    .member-footer-nav .nav-list,
    .admin-footer-nav .nav-list{
        --ink: #0f172a;
        --shadow: 0 22px 34px -18px rgba(15,23,42,.30);

        pointer-events: auto;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        align-items: center;
        list-style: none;
        margin: 0;
        max-width: none;
        height: 76px;
        padding: 18px 0 10px;
        border-radius: 0;
        position: relative;
        box-shadow: var(--shadow);
        overflow: visible;
        background: transparent;
    }

    /* The bar background (wave + center notch) */
    .member-footer-nav .nav-list::before,
    .admin-footer-nav .nav-list::before{
        content:"";
        position:absolute;
        inset:0;
        border-radius: 0;
        background:
          url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 80' preserveAspectRatio='none'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='0'%3E%3Cstop offset='0' stop-color='%230ea5e9'/%3E%3Cstop offset='1' stop-color='%237c3aed'/%3E%3C/linearGradient%3E%3Cmask id='m'%3E%3Crect x='0' y='0' width='400' height='80' fill='white'/%3E%3Ccircle cx='200' cy='16' r='40' fill='black'/%3E%3C/mask%3E%3C/defs%3E%3Cpath mask='url(%23m)' fill='url(%23g)' d='M0,18 C55,18 70,2 110,2 C150,2 158,18 200,18 C242,18 250,2 290,2 C330,2 345,18 400,18 L400,80 L0,80 Z'/%3E%3C/svg%3E") center/100% 100% no-repeat;
        z-index: 0;
    }
    .member-footer-nav .nav-list::after,
    .admin-footer-nav .nav-list::after{content:none}

    .member-footer-nav .nav-link,
    .admin-footer-nav .nav-link{
        position: relative;
        z-index: 2;
        text-decoration: none;
        display: grid;
        place-items: center;
        gap: 6px;
        min-height: 52px;
        padding: 8px 0 6px;
        color: #ffffff;
        -webkit-tap-highlight-color: transparent;
        transition: transform .18s ease, filter .18s ease;
    }
    .member-footer-nav .nav-link .nav-icon,
    .admin-footer-nav .nav-link .nav-icon{
        width: 46px;
        height: 34px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        position: relative;
        transition: transform .18s ease, background-color .18s ease, color .18s ease;
    }
    .member-footer-nav .nav-link:not(.nav-center) .nav-icon,
    .admin-footer-nav .nav-link:not(.nav-center) .nav-icon{
        margin-top: -8px;
        background: rgba(255,255,255,.92);
        color: #0f172a;
        border: 2px dashed rgba(255,255,255,.65);
        box-shadow: 0 10px 22px rgba(15,23,42,.18);
        backdrop-filter: blur(6px);
    }
    .member-footer-nav .nav-link .nav-icon i,
    .admin-footer-nav .nav-link .nav-icon i{font-size:20px;line-height:1}
    .member-footer-nav .nav-link .nav-text,
    .admin-footer-nav .nav-link .nav-text{display:none}

    .member-footer-nav .nav-link:not(.nav-center)::after,
    .admin-footer-nav .nav-link:not(.nav-center)::after{
        content: attr(data-tip);
        position: absolute;
        bottom: calc(100% - 8px);
        left: 50%;
        transform: translate(-50%, 8px);
        background: rgba(15,23,42,.82);
        color: #ffffff;
        font-size: 11px;
        font-weight: 900;
        padding: 6px 9px;
        border-radius: 999px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity .14s ease, transform .14s ease;
        box-shadow: 0 10px 22px rgba(15,23,42,.22);
    }
    .member-footer-nav .nav-link:not(.nav-center):hover::after,
    .member-footer-nav .nav-link:not(.nav-center):focus-visible::after,
    .member-footer-nav .nav-link:not(.nav-center).active::after,
    .admin-footer-nav .nav-link:not(.nav-center):hover::after,
    .admin-footer-nav .nav-link:not(.nav-center):focus-visible::after,
    .admin-footer-nav .nav-link:not(.nav-center).active::after{
        opacity: 1;
        transform: translate(-50%, 0);
    }

    /* Active state (non-center) */
    .member-footer-nav .nav-link.active:not(.nav-center),
    .admin-footer-nav .nav-link.active:not(.nav-center){
        transform: translateY(-1px);
        filter: drop-shadow(0 6px 12px rgba(15,23,42,.22));
    }
    .member-footer-nav .nav-link.active:not(.nav-center) .nav-icon,
    .admin-footer-nav .nav-link.active:not(.nav-center) .nav-icon{
        background: rgba(255, 255, 255, 0.1);
        color: var(--ink);
        transform: translateY(-1px) scale(1.04);
        margin-top: -10px;
        border-style: solid;
    }

    /* Center floating action button */
    .member-footer-nav .nav-link.nav-center,
    .admin-footer-nav .nav-link.nav-center{
        position: absolute;
        left: 50%;
        top: 18px;
        transform: translate(-50%, -42px);
        z-index: 3;
    }
    .member-footer-nav .nav-link.nav-center .nav-icon,
    .admin-footer-nav .nav-link.nav-center .nav-icon{
        margin-top: -10px;
        width: 64px;
        height: 64px;
        border-radius: 999px;
        background: rgba(255,255,255,.98);
        color: #0f172a;
        box-shadow: 0 14px 30px rgba(15,23,42,.28);
        border: 1px solid rgba(226,232,240,.9);
    }
    .member-footer-nav .nav-link.nav-center .nav-icon::before,
    .admin-footer-nav .nav-link.nav-center .nav-icon::before{
        content:"";
        position:absolute;
        inset: -4px;
        border-radius: 999px;
        background: linear-gradient(135deg, #0ea5e9, #7c3aed, #22c55e, #0ea5e9);
        background-size: 300% 300%;
        animation: homeRing 3.2s ease-in-out infinite;
        z-index: -1;
        filter: saturate(1.1);
    }
    .member-footer-nav .nav-link.nav-center .nav-icon::after,
    .admin-footer-nav .nav-link.nav-center .nav-icon::after{
        content:"";
        position:absolute;
        inset: 0;
        border-radius: 999px;
        background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,.75) 45%, transparent 70%);
        transform: translateX(-120%) rotate(-12deg);
        opacity: .55;
        animation: homeShine 2.8s ease-in-out infinite;
        pointer-events:none;
    }

    @@keyframes homeRing{
        0%{background-position: 0% 50%}
        50%{background-position: 100% 50%}
        100%{background-position: 0% 50%}
    }
    @@keyframes homeShine{
        0%, 45%{transform: translateX(-130%) rotate(-12deg); opacity: .0}
        60%{opacity: .55}
        100%{transform: translateX(130%) rotate(-12deg); opacity: .0}
    }
    .member-footer-nav .nav-link.nav-center.active .nav-icon,
    .admin-footer-nav .nav-link.nav-center.active .nav-icon{
        background: rgba(255,255,255,.96);
        color: #0f172a;
        transform: scale(1.04);
    }

    @@media (max-width: 520px){
        .member-footer-nav{padding: 0;}
        .member-footer-nav .nav-list{height: 72px; padding: 18px 8px 10px; border-radius: 24px;}
        .member-footer-nav .nav-link{padding: 8px 0 6px; gap: 0;}
        .member-footer-nav .nav-link .nav-icon{width: 44px; height: 34px;}
        .member-footer-nav .nav-link:not(.nav-center) .nav-icon{margin-top: -6px;}
        .member-footer-nav .nav-link.nav-center{top: 18px; transform: translate(-50%, -40px);}

        .admin-footer-nav{padding: 0;}
        .admin-footer-nav .nav-list{height: 72px; padding: 18px 8px 10px; border-radius: 24px;}
        .admin-footer-nav .nav-link{padding: 8px 0 6px; gap: 0;}
        .admin-footer-nav .nav-link .nav-icon{width: 44px; height: 34px;}
        .admin-footer-nav .nav-link:not(.nav-center) .nav-icon{margin-top: -6px;}
        .admin-footer-nav .nav-link.nav-center{top: 18px; transform: translate(-50%, -40px);}
    }

    @@media (min-width: 900px){
        .member-footer-nav{display:none}
        .admin-footer-nav{display:none}
    }

    @@media (prefers-reduced-motion: reduce){
        .member-footer-nav .nav-link,
        .member-footer-nav .nav-link .nav-icon,
        .admin-footer-nav .nav-link,
        .admin-footer-nav .nav-link .nav-icon{transition:none}
        .member-footer-nav .nav-link.active:not(.nav-center),
        .admin-footer-nav .nav-link.active:not(.nav-center){transform:none; filter:none}
        .member-footer-nav .nav-link.active:not(.nav-center) .nav-icon,
        .admin-footer-nav .nav-link.active:not(.nav-center) .nav-icon{transform:none}
        .member-footer-nav .nav-link.nav-center,
        .admin-footer-nav .nav-link.nav-center{transform: translate(-50%, -42px)}
        .member-footer-nav .nav-link.nav-center.active .nav-icon,
        .admin-footer-nav .nav-link.nav-center.active .nav-icon{transform:none}
        .member-footer-nav .nav-link.nav-center .nav-icon::before,
        .member-footer-nav .nav-link.nav-center .nav-icon::after,
        .admin-footer-nav .nav-link.nav-center .nav-icon::before,
        .admin-footer-nav .nav-link.nav-center .nav-icon::after{animation:none}
        .member-footer-nav .nav-link:not(.nav-center)::after,
        .admin-footer-nav .nav-link:not(.nav-center)::after{transition:none}
    }

    .header-menu { position: relative; }
    .header-menu > summary { list-style: none; }
    .header-menu > summary::-webkit-details-marker { display: none; }

    .user-trigger {
        list-style: none;
        cursor: pointer;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.35);
        color: #fff;
        border-radius: 999px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 34px;
    }

    .user-avatar {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        overflow: hidden;
        background: rgba(255,255,255,.22);
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .5px;
    }

    .menu-card {
        position: absolute;
        inset-inline-end: 0;
        margin-top: 10px;
        background: #ffffff;
        color: #111827;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 14px 35px rgba(0,0,0,.18);
        width: clamp(240px, calc(100vw - 16px), 340px);
        max-width: calc(100vw - 16px);
        z-index: 2000;
        padding: 10px;
        direction: rtl;
        text-align: right;
        overflow: hidden;
    }

    .user-menu__header {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 12px;
        align-items: center;
        padding: 8px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        margin-bottom: 10px;
    }

    .user-menu__avatarLg {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        background: #eef2ff;
        color: #3730a3;
        font-weight: 900;
    }

    .user-menu__name { font-weight: 900; line-height: 1.2; }
    .user-menu__sub { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; }

    .user-chip {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        column-gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        color: #111827;
        white-space: nowrap;
        max-width: 100%;
    }

    .user-chip i { opacity: .9; }

    .user-chip .chip-text { grid-column: 1; min-width: 0; }
    .user-chip .chip-icon { grid-column: 2; }

    .menu-item {
        width: 100%;
        text-align: inherit;
        background: transparent;
        border: 0;
        color: inherit;
        padding: 10px;
        border-radius: 12px;
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        column-gap: 10px;
        cursor: pointer;
        transition: background .15s ease, transform .15s ease;
    }

    .menu-item:hover { background: rgba(255,255,255,.07); }
    .menu-item:active { transform: translateY(1px); }

    .menu-item .mi-icon {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: #e0f2fe;
        border: 1px solid #bae6fd;
        color: #0369a1;
        grid-column: 2;
    }

    .menu-item.danger { color: #fecaca; }
    .menu-item.danger .mi-icon {
        background: #fee2e2;
        border-color: #fecaca;
        color: #b91c1c;
    }

    @@media (max-width: 640px) {
        .user-menu-card {
            position: fixed;
            inset-inline-start: 8px;
            inset-inline-end: 8px;
            top: 62px;
            width: auto;
            max-width: none;
        }

        .user-menu__sub {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .user-chip {
            width: 100%;
            justify-content: flex-end;
        }
    }

    /* ========== Hamburger ========== */
    .hamburger-btn {
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 10px;
        padding: 8px 6px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 4px;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        min-height: 36px;
    }
    .hamburger-btn:hover {
        background: rgba(255,255,255,.28);
    }
    .hamburger-line {
        display: block;
        width: 18px;
        height: 2px;
        background: #fff;
        border-radius: 2px;
    }

    /* ========== Drawer ========== */
    .drawer-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.55);
        z-index: 10001;
        opacity: 0;
        pointer-events: none;
        transition: opacity .25s ease;
    }
    .drawer-overlay.open {
        opacity: 1;
        pointer-events: auto;
    }

    .drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(320px, calc(100vw - 50px));
        background: #fff;
        z-index: 10002;
        transform: translateX(100%);
        transition: transform .3s cubic-bezier(.4,0,.2,1);
        display: flex;
        flex-direction: column;
        direction: rtl;
        box-shadow: -4px 0 24px rgba(0,0,0,.15);
    }
    .drawer.open {
        transform: translateX(0);
    }

    .drawer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
    }
    .drawer-title {
        font-weight: 900;
        font-size: 16px;
        color: #0f172a;
    }
    .drawer-close {
        border: none;
        background: #f1f5f9;
        color: #475569;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        font-size: 22px;
        line-height: 22px;
        cursor: pointer;
        display: grid;
        place-items: center;
    }
    .drawer-close:hover {
        background: #e2e8f0;
    }

    .drawer-body {
        flex: 1;
        overflow-y: auto;
        padding: 8px 0;
    }

    .drawer-category {
        padding: 4px 0;
    }
    .drawer-cat-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 900;
        font-size: 13px;
        color: #1e40af;
        padding: 10px 16px 6px;
        border-bottom: 1px solid #eef2f7;
        margin-bottom: 2px;
    }
    .drawer-cat-title i {
        width: 18px;
        text-align: center;
        font-size: 14px;
    }
    .drawer-cat-title.cat-popular {
        color: #b91c1c;
    }

    .drawer-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 16px 9px 16px;
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        text-decoration: none;
        transition: background .15s;
        margin: 0 8px;
        border-radius: 8px;
    }
    .drawer-item:hover {
        background: #eff6ff;
        color: #1d4ed8;
    }
    .drawer-item i {
        width: 18px;
        text-align: center;
        font-size: 13px;
        color: #64748b;
    }
    .drawer-item:hover i {
        color: #1d4ed8;
    }

</style>

<div class="app-shell @(_isMemberArea ? "member-area" : null)">
    <OnlinePresencePing />
    <header class="app-header">
        <div class="header-inner">
            <div style="display:flex; align-items:center; gap:10px;">
                @if (!_isMemberArea)
                {
                    <button type="button" class="hamburger-btn" @onclick="ToggleDrawer" aria-label="فهرست">
                        <span class="hamburger-line"></span>
                        <span class="hamburger-line"></span>
                        <span class="hamburger-line"></span>
                    </button>
                }
                <h1 class="app-title">صندوق امام علی (ع)</h1>
            </div>
            <div class="header-actions" style="display:flex; align-items:center; gap:6px;">
                @if (!_isMemberArea)
                {
                    <button id="theme-toggle" class="theme-toggle" title="تغییر حالت"></button>
                }
                <!-- Notifications dropdown -->
                <details class="header-menu header-notifications" style="position:relative;">
                    <summary class="md-text-button" style="list-style:none; cursor:pointer; background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.35); color:#fff; border-radius:10px; padding:6px 10px; display:grid; place-items:center; position:relative;">
                        <i class="fa-regular fa-bell" title="اعلان‌ها"></i>
                        @if (_unreadCount > 0)
                        {
                            <span style="position:absolute; top:-6px; inset-inline-start:-6px; min-width:18px; height:18px; padding:0 5px; border-radius:999px; background:#ef4444; color:#fff; font-size:11px; font-weight:900; display:grid; place-items:center; border:1px solid rgba(255,255,255,.7);">@_unreadCount</span>
                        }
                    </summary>
