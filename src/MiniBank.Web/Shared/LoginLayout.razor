@inherits LayoutComponentBase

@using MiniBank.Web.Components.DesignSystem

<style>
  .login-shell {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 20px;
    position: relative;
    overflow: hidden;
    background: radial-gradient(1200px 900px at 50% -10%, rgba(124, 58, 237, .45), transparent 60%),
                radial-gradient(900px 700px at 15% 110%, rgba(59, 130, 246, .35), transparent 55%),
                radial-gradient(900px 700px at 85% 110%, rgba(16, 185, 129, .22), transparent 60%),
                linear-gradient(180deg, #0b1220, #070b12);
  }

  .login-bg {
    position: absolute;
    inset: -40px;
    pointer-events: none;
    animation: hueCycle 14s linear infinite;
    will-change: filter;
  }

  .login-orb {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 999px;
    filter: blur(28px);
    opacity: .65;
    animation: floaty 10s ease-in-out infinite;
  }

  .login-orb.purple {
    background: radial-gradient(circle at 30% 30%, rgba(167, 139, 250, .95), rgba(124, 58, 237, .12) 60%, transparent 70%);
    top: -120px;
    inset-inline-start: -140px;
  }

  .login-orb.blue {
    background: radial-gradient(circle at 30% 30%, rgba(96, 165, 250, .85), rgba(59, 130, 246, .10) 60%, transparent 70%);
    bottom: -180px;
    inset-inline-end: -160px;
    animation-delay: -2.5s;
  }

  .login-orb.green {
    width: 420px;
    height: 420px;
    background: radial-gradient(circle at 30% 30%, rgba(52, 211, 153, .65), rgba(16, 185, 129, .08) 60%, transparent 70%);
    bottom: -140px;
    inset-inline-start: -120px;
    animation-delay: -5s;
  }

  .login-noise {
    position: absolute;
    inset: 0;
    opacity: .08;
    background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 160 160"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" stitchTiles="stitch"/></filter><rect width="160" height="160" filter="url(%23n)" opacity="0.35"/></svg>');
    mix-blend-mode: overlay;
  }

  .login-content {
    width: 100%;
    max-width: 420px;
    position: relative;
    z-index: 1;
  }

  @@keyframes hueCycle {
    0%   { filter: hue-rotate(0deg) saturate(1.05); }
    50%  { filter: hue-rotate(150deg) saturate(1.10); }
    100% { filter: hue-rotate(360deg) saturate(1.05); }
  }

  @@keyframes floaty {
    0%, 100% { transform: translate3d(0,0,0) scale(1); }
    50% { transform: translate3d(0,-18px,0) scale(1.03); }
  }

  @@media (max-width: 420px) {
    .login-shell { padding: 14px; }
    .login-content { max-width: 100%; }
  }
</style>

<div class="login-shell">
  <div class="login-bg" aria-hidden="true">
    <div class="login-orb purple"></div>
    <div class="login-orb blue"></div>
    <div class="login-orb green"></div>
    <div class="login-noise"></div>
  </div>
  <div class="login-content">
    @Body
  </div>

  <DsToastContainer />
</div>
