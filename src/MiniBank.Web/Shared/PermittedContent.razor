@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject MiniBank.Web.Services.Auth.AuthPermissionService Perms
@inject MiniBank.Web.Infrastructure.Repositories.AuthRepository Repo

@if (_canShow)
{
    @ChildContent
}
else if (NotAllowed != null)
{
    @NotAllowed
}

@code {
    [Parameter] public string Path { get; set; } = string.Empty;
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public RenderFragment? NotAllowed { get; set; }

    private bool _canShow;

    protected override async Task OnParametersSetAsync()
    {
        _canShow = false;

        var path = NormalizePath(Path);

        if (Perms.IsPublicPath(path))
        {
            _canShow = true;
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user?.Identity?.IsAuthenticated != true)
            return;

        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!long.TryParse(userIdClaim, out var userId) || userId <= 0)
            return;

        long roleId;
        try
        {
            var dbUser = await Repo.GetUserByIdAsync(userId);
            if (dbUser == null || !dbUser.IsActive)
                return;

            if (string.Equals(dbUser.Role?.Name, "Admin", StringComparison.OrdinalIgnoreCase))
            {
                _canShow = true;
                return;
            }

            roleId = dbUser.RoleId;
            if (roleId <= 0)
                return;
        }
        catch
        {
            return;
        }

        bool allowed;
        try
        {
            allowed = await Perms.IsAllowedAsync(roleId, path);
        }
        catch
        {
            allowed = false;
        }

        _canShow = allowed;
    }

    private static string NormalizePath(string absoluteOrRelative)
    {
        var p = (absoluteOrRelative ?? string.Empty).Trim();
        if (p.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            try { p = new Uri(p).AbsolutePath; } catch { }
        }
        if (!p.StartsWith('/')) p = "/" + p;
        if (p.Length > 1 && p.EndsWith('/')) p = p.TrimEnd('/');
        return p;
    }
}
