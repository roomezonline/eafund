@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MiniBank.Web.Models.Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject MiniBank.Web.Services.Auth.AuthPermissionService Perms
@inject MiniBank.Web.Infrastructure.Repositories.AuthRepository Repo
@inject MiniBank.Web.Infrastructure.Repositories.BaleBotRepository BaleRepo

@if (_canRender)
{
    @if (_baleRequired)
    {
        <BaleConnectionGate MemberId="@_baleMemberId" OnConnected="OnBaleConnected" />
    }
    else
    {
        <RouteView RouteData="@RouteData" DefaultLayout="@DefaultLayout" />
    }
}

@code {
    [Parameter] public RouteData RouteData { get; set; } = default!;
    [Parameter] public Type DefaultLayout { get; set; } = typeof(MiniBank.Web.Shared.MainLayout);

    private bool _canRender;
    private bool _baleRequired;
    private long _baleMemberId;

    protected override async Task OnParametersSetAsync()
    {
        _canRender = false;
        _baleRequired = false;
        _baleMemberId = 0;

        var path = NormalizePath(Nav.Uri);

        // Always allow login
        if (path.Equals("/login", StringComparison.OrdinalIgnoreCase))
        {
            _canRender = true;
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        // Always allow root so it can redirect based on role
        if (path.Equals("/", StringComparison.OrdinalIgnoreCase))
        {
            _canRender = true;
            return;
        }

        // Admin has full access
        // Note: Claims can be stale if user role changed while logged in. We re-check role from DB below.

        // Allow forbidden page for authenticated users
        if (path.Equals("/forbidden", StringComparison.OrdinalIgnoreCase))
        {
            _canRender = true;
            return;
        }

        // Resolve latest role from DB (claims can be stale until next login)
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!long.TryParse(userIdClaim, out var userId) || userId <= 0)
        {
            Nav.NavigateTo("/forbidden", forceLoad: true);
            return;
        }

        long roleId;
        try
        {
            var dbUser = await Repo.GetUserByIdAsync(userId);
            if (dbUser == null || !dbUser.IsActive)
            {
                Nav.NavigateTo("/forbidden", forceLoad: true);
                return;
            }

            // Admin has full access
            if (string.Equals(dbUser.Role?.Name, "Admin", StringComparison.OrdinalIgnoreCase))
            {
                _canRender = true;
                return;
            }

            // Members can always access their dashboard
            if (path.Equals("/dashboard", StringComparison.OrdinalIgnoreCase))
            {
                if (dbUser.MemberId.HasValue || string.Equals(dbUser.Role?.Name, "Member", StringComparison.OrdinalIgnoreCase))
                {
                    await AllowMemberAreaAsync(dbUser);
                    return;
                }
            }

            // Members can access their self-service area
            if (path.StartsWith("/me", StringComparison.OrdinalIgnoreCase))
            {
                if (dbUser.MemberId.HasValue || string.Equals(dbUser.Role?.Name, "Member", StringComparison.OrdinalIgnoreCase))
                {
                    await AllowMemberAreaAsync(dbUser);
                    return;
                }
            }

            roleId = dbUser.RoleId;
            if (roleId <= 0)
            {
                Nav.NavigateTo("/forbidden", forceLoad: true);
                return;
            }
        }
        catch
        {
            Nav.NavigateTo("/forbidden", forceLoad: true);
            return;
        }

        // Public paths such as static resources are not routed here.
        // Enforce permission per page path.
        bool allowed;
        try
        {
            allowed = await Perms.IsAllowedAsync(roleId, path);
        }
        catch
        {
            allowed = false;
        }

        if (!allowed)
        {
            Nav.NavigateTo("/forbidden", forceLoad: true);
            return;
        }

        _canRender = true;
    }

    private async Task AllowMemberAreaAsync(AuthUser dbUser)
    {
        _canRender = true;
        _baleRequired = false;

        if (!dbUser.MemberId.HasValue)
            return;

        try
        {
            var settings = await BaleRepo.GetSettingsAsync();
            if (!settings.IsEnabled || !settings.RequireBaleConnectionForMembers)
                return;

            if (string.IsNullOrWhiteSpace(settings.BotToken) || string.IsNullOrWhiteSpace(settings.BotUsername))
                return;

            if (await BaleRepo.GetActiveByMemberAsync(dbUser.MemberId.Value) != null)
                return;

            _baleMemberId = dbUser.MemberId.Value;
            _baleRequired = true;
        }
        catch
        {
            // Fail open so a Bale/database hiccup cannot lock members out of the dashboard.
        }
    }

    private void OnBaleConnected()
    {
        _baleRequired = false;
        StateHasChanged();
    }

    private static string NormalizePath(string absoluteOrRelative)
    {
        var p = (absoluteOrRelative ?? string.Empty).Trim();
        if (p.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            try { p = new Uri(p).AbsolutePath; } catch { }
        }
        if (!p.StartsWith('/')) p = "/" + p;
        if (p.Length > 1 && p.EndsWith('/')) p = p.TrimEnd('/');
        return p;
    }
}
