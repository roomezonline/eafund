@namespace MiniBank.Web.Components.DesignSystem
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Linq

<div class="ds-dropdown @(Disabled ? "disabled" : null) @(IsOpen ? "open" : null)" @onkeydown="HandleKeyDown">
  @if (!string.IsNullOrWhiteSpace(Label))
  {
    <label class="ds-dropdown-label">@Label</label>
  }

  <div id="@_buttonId" class="ds-dropdown-button @(HasError ? "error" : null)" @onclick="Toggle">
    <span class="ds-dropdown-value">@DisplayText</span>
    @if (!string.IsNullOrWhiteSpace(Value))
    {
      <button type="button" class="dropdown-clear" title="پاک کردن" aria-label="پاک کردن" @onclick="ClearSelection" @onclick:stopPropagation="true">
        <i class="fa-solid fa-xmark"></i>
      </button>
    }
    else
    {
      <i class="fa-solid fa-chevron-down caret @(IsOpen ? "open" : null)"></i>
    }
  </div>
  @if (!string.IsNullOrWhiteSpace(HelperText) || HasError)
  {
    <div class="ds-dropdown-helper @(HasError ? "error" : null)">
      @if (HasError)
      {
        <span>@ErrorMessage</span>
      }
      else if (!string.IsNullOrWhiteSpace(HelperText))
      {
        <span>@HelperText</span>
      }
    </div>
  }
  @if (IsOpen)
  {
    <div id="@_menuId" class="ds-dropdown-menu @(UseFixedMenu ? "fixed-menu" : null)" tabindex="-1" @onclick:stopPropagation="true" style="max-height:@(MaxMenuHeight)px; overflow:auto;">
      @if (Searchable)
      {
        <div class="ds-dropdown-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input class="search-input" placeholder="@SearchPlaceholder" value="@_query" @oninput="OnQueryInput" @onkeydown="OnSearchKeyDown" @ref="_searchInput" />
          @if (!string.IsNullOrEmpty(_query))
          {
            <button type="button" class="search-clear" title="پاک کردن" aria-label="پاک کردن" @onclick="ClearQuery"><i class="fa-solid fa-xmark"></i></button>
          }
        </div>
      }
      @if (FilteredItems != null)
      {
        var i = 0;
        foreach (var it in FilteredItems)
        {
          var idx = i;
          <button class="ds-dropdown-item @(IsSelected(it) ? "selected" : null) @(IsHighlighted(idx) ? "highlight" : null)" 
                  title="@it.Text" @onclick="(() => Select(it.Value))" @onmouseenter="(() => _highlightIndex = idx)">
            @((MarkupString)BuildItemContent(it))
          </button>
          i++;
        }
        if (i == 0)
        {
          <div class="ds-dropdown-empty">موردی یافت نشد</div>
        }
      }
    </div>
  }
</div>

@code {
  [Inject] public IJSRuntime JS { get; set; } = default!;

  [Parameter] public string? Label { get; set; }
  [Parameter] public string? Placeholder { get; set; }
  [Parameter] public IEnumerable<DsDropdownItem>? Items { get; set; }
  [Parameter] public string? Value { get; set; }
  [Parameter] public EventCallback<string?> ValueChanged { get; set; }
  [Parameter] public bool Disabled { get; set; }
  [Parameter] public string? ErrorMessage { get; set; }
  [Parameter] public string? HelperText { get; set; }
  [Parameter] public int MaxMenuHeight { get; set; } = 220;
  [Parameter] public bool Searchable { get; set; } = false;
  [Parameter] public string SearchPlaceholder { get; set; } = "جستجو...";
  [Parameter] public bool UseFixedMenu { get; set; } = false;

  private readonly string _id = $"dsdd_{Guid.NewGuid():N}";
  private string _buttonId => _id + "-btn";
  private string _menuId => _id + "-menu";

  private bool IsOpen { get; set; }
  private int _highlightIndex = -1; // -1 represents placeholder
  private string _query = string.Empty;
  private ElementReference _searchInput;
  private bool _pendingFixedOpen;
  private bool _fixedHandlersAttached;

  private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);
  private bool ShowPlaceholder => false;

  private string DisplayText
    => !string.IsNullOrWhiteSpace(GetText(Value)) ? GetText(Value)! : (Placeholder ?? "انتخاب کنید");

  private string? GetText(string? val)
  {
    if (Items is null || val is null) return null;
    foreach (var it in Items)
      if (string.Equals(it.Value, val, StringComparison.Ordinal))
        return it.Text;
    return null;
  }

  private bool IsSelected(DsDropdownItem it) => string.Equals(it.Value, Value, StringComparison.Ordinal);
  private bool IsHighlighted(int idx) => _highlightIndex == idx;

  private IEnumerable<DsDropdownItem> FilteredItems =>
    string.IsNullOrWhiteSpace(_query)
      ? (Items ?? Enumerable.Empty<DsDropdownItem>())
      : (Items ?? Enumerable.Empty<DsDropdownItem>()).Where(it =>
            (it.Text?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false)
            || (it.Value?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false));

  private async Task Toggle()
  {
    if (Disabled) return;
    IsOpen = !IsOpen;
    if (UseFixedMenu)
    {
      if (IsOpen) _pendingFixedOpen = true;
      else await TryCloseFixedAsync();
    }
    if (IsOpen && Searchable)
    {
      _query = string.Empty;
      _highlightIndex = ShowPlaceholder ? -1 : 0;
      try { await _searchInput.FocusAsync(); } catch { }
    }
    StateHasChanged();
    await Task.CompletedTask;
  }

  private async Task Select(string? val)
  {
    IsOpen = false;
    if (UseFixedMenu)
      await TryCloseFixedAsync();
    await ValueChanged.InvokeAsync(val);
  }

  private void Close()
  {
    if (IsOpen)
    {
      IsOpen = false; StateHasChanged();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (UseFixedMenu && IsOpen && _pendingFixedOpen)
    {
      _pendingFixedOpen = false;
      try
      {
        await JS.InvokeVoidAsync("dsDropdownFixed.open", _id);
        _fixedHandlersAttached = true;
      }
      catch
      {
      }
    }
  }

  private async Task TryCloseFixedAsync()
  {
    if (!_fixedHandlersAttached) return;
    try
    {
      await JS.InvokeVoidAsync("dsDropdownFixed.close", _id);
    }
    catch
    {
    }
    _fixedHandlersAttached = false;
  }

  private void OnQueryInput(ChangeEventArgs e)
  {
    _query = e.Value?.ToString() ?? string.Empty;
    // Reset highlight to first filtered item (or placeholder)
    _highlightIndex = ShowPlaceholder ? -1 : 0;
    StateHasChanged();
  }

  private void ClearQuery()
  {
    _query = string.Empty;
    _highlightIndex = 0;
    StateHasChanged();
  }

  private async Task ClearSelection()
  {
    await ValueChanged.InvokeAsync(null);
  }

  private void OnSearchKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Escape")
    {
      if (!string.IsNullOrEmpty(_query))
      {
        _query = string.Empty;
        _highlightIndex = ShowPlaceholder ? -1 : 0;
      }
      else
      {
        Close();
      }
      StateHasChanged();
    }
  }

  private async Task HandleKeyDown(KeyboardEventArgs e)
  {
    if (Disabled) return;
    if (e.Key == "Escape") { Close(); return; }
    if (!IsOpen && (e.Key == "Enter" || e.Key == " " || e.Key == "ArrowDown"))
    {
      IsOpen = true; StateHasChanged(); return;
    }
    if (!IsOpen) return;

    var count = FilteredItems?.Count() ?? 0;
    var start = ShowPlaceholder ? -1 : 0;
    var end = count - 1;

    if (e.Key == "ArrowDown")
    {
      if (_highlightIndex < end) _highlightIndex++; else _highlightIndex = start;
      StateHasChanged();
    }
    else if (e.Key == "ArrowUp")
    {
      if (_highlightIndex > start) _highlightIndex--; else _highlightIndex = end;
      StateHasChanged();
    }
    else if (e.Key == "Enter")
    {
      if (_highlightIndex == -1) await Select(null);
      else if (FilteredItems != null)
      {
        var item = FilteredItems.ElementAt(_highlightIndex);
        await Select(item.Value);
      }
    }
  }

  private string BuildItemContent(DsDropdownItem it)
  {
    if (string.IsNullOrEmpty(it.Text)) return string.Empty;
    return it.Text.Replace("(عمومی)", "<span style=\"color:#dc2626\">(عمومی)</span>");
  }

  public class DsDropdownItem
  {
    public string Value { get; set; } = string.Empty;
    public string Text { get; set; } = string.Empty;
  }
}
