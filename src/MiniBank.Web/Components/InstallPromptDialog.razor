@inject IJSRuntime JS

@if (_showDialog)
{
  <div class="install-prompt-overlay" @onclick="CloseDialog">
    <div class="install-prompt-dialog" @onclick:stopPropagation="true">
      <!-- Header -->
      <div class="install-header">
        <div class="install-icon">
          <i class="fa-solid fa-mobile-screen-button"></i>
        </div>
        <h3 class="install-title">نصب اپلیکیشن</h3>
        <p class="install-subtitle">برای تجربه بهتر، اپلیکیشن را روی دستگاه خود نصب کنید</p>
      </div>

      <!-- Benefits -->
      <div class="install-benefits">
        <div class="benefit-item">
          <i class="fa-solid fa-bolt"></i>
          <span>دسترسی سریع‌تر</span>
        </div>
        <div class="benefit-item">
          <i class="fa-solid fa-wifi"></i>
          <span>کار آفلاین</span>
        </div>
        <div class="benefit-item">
          <i class="fa-solid fa-bell"></i>
          <span>اعلان‌های فوری</span>
        </div>
      </div>

      <!-- Instructions -->
      <div class="install-instructions">
        @if (_isIOS)
        {
          <div class="instruction-step">
            <div class="step-number">1</div>
            <div class="step-text">روی دکمه اشتراک‌گذاری <i class="fa-solid fa-share"></i> ضربه بزنید</div>
          </div>
          <div class="instruction-step">
            <div class="step-number">2</div>
            <div class="step-text">گزینه "Add to Home Screen" را انتخاب کنید</div>
          </div>
          <div class="instruction-step">
            <div class="step-number">3</div>
            <div class="step-text">روی "Add" ضربه بزنید</div>
          </div>
        }
        else
        {
          <div class="instruction-step">
            <div class="step-number">1</div>
            <div class="step-text">روی منوی مرورگر <i class="fa-solid fa-ellipsis-vertical"></i> ضربه بزنید</div>
          </div>
          <div class="instruction-step">
            <div class="step-number">2</div>
            <div class="step-text">گزینه "Add to Home screen" را انتخاب کنید</div>
          </div>
          <div class="instruction-step">
            <div class="step-number">3</div>
            <div class="step-text">روی "Add" ضربه بزنید</div>
          </div>
        }
      </div>

      <!-- Actions -->
      <div class="install-actions">
        <button class="install-btn primary" @onclick="TryInstall">
          <i class="fa-solid fa-download"></i>
          نصب اپلیکیشن
        </button>
        <button class="install-btn secondary" @onclick="RemindLater">
          بعداً یادآوری کن
        </button>
      </div>
    </div>
  </div>
}

@code {
  [Parameter] public EventCallback OnClose { get; set; }
  
  private bool _showDialog = false;
  private bool _isIOS = false;
  private bool _isMobile = false;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await CheckAndShowPrompt();
    }
  }

  private async Task CheckAndShowPrompt()
  {
    try
    {
      // Check if mobile device
      _isMobile = await JS.InvokeAsync<bool>("eval", "window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)");
      
      if (!_isMobile) return;

      // Check if iOS
      _isIOS = await JS.InvokeAsync<bool>("eval", "/iPad|iPhone|iPod/.test(navigator.userAgent)");

      // Check if already installed
      var isInstalled = await JS.InvokeAsync<bool>("eval", 
        "window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone || document.referrer.includes('android-app://')");
      
      if (isInstalled) return;

      // Check if user clicked "remind later" - if so, don't show automatically
      var remindLaterClicked = await JS.InvokeAsync<string>("localStorage.getItem", "pwa-install-remind-later");
      if (!string.IsNullOrEmpty(remindLaterClicked) && remindLaterClicked == "true")
      {
        return;
      }

      // Show dialog after a short delay
      await Task.Delay(2000);
      _showDialog = true;
      StateHasChanged();
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Error checking install prompt: {ex.Message}");
    }
  }

  private async Task TryInstall()
  {
    try
    {
      // Try to trigger native install prompt
      var hasPrompt = await JS.InvokeAsync<bool>("eval", "window.deferredPrompt != null");
      if (hasPrompt)
      {
        await JS.InvokeVoidAsync("eval", @"
          if (window.deferredPrompt) {
            window.deferredPrompt.prompt();
            window.deferredPrompt.userChoice.then((choiceResult) => {
              window.deferredPrompt = null;
            });
          }
        ");
      }
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Error triggering install: {ex.Message}");
    }
    
    await CloseDialog();
  }

  private async Task RemindLater()
  {
    await JS.InvokeVoidAsync("localStorage.setItem", "pwa-install-remind-later", "true");
    await CloseDialog();
  }


  private async Task CloseDialog()
  {
    _showDialog = false;
    StateHasChanged();
    await OnClose.InvokeAsync();
  }

  public async Task ShowDialog()
  {
    await CheckAndShowPrompt();
  }

  public async Task ForceShowOnDashboard()
  {
    try
    {
      // Check if mobile device
      _isMobile = await JS.InvokeAsync<bool>("eval", "window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)");
      
      if (!_isMobile) return;

      // Check if iOS
      _isIOS = await JS.InvokeAsync<bool>("eval", "/iPad|iPhone|iPod/.test(navigator.userAgent)");

      // Check if already installed
      var isInstalled = await JS.InvokeAsync<bool>("eval", 
        "window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone || document.referrer.includes('android-app://')");
      
      if (isInstalled) return;

      // Reset the remind later flag when user enters dashboard
      await JS.InvokeVoidAsync("localStorage.removeItem", "pwa-install-remind-later");

      // Force show on dashboard
      await Task.Delay(1000);
      _showDialog = true;
      StateHasChanged();
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Error forcing install prompt: {ex.Message}");
    }
  }

  public async Task ResetRemindLater()
  {
    try
    {
      await JS.InvokeVoidAsync("localStorage.removeItem", "pwa-install-remind-later");
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Error resetting remind later: {ex.Message}");
    }
  }
}
